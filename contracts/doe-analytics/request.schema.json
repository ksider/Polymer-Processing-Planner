{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im-planner.local/contracts/doe-analytics/request-1.0.schema.json",
  "title": "DOE analytics request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "dataset", "specification"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataset": {
      "type": "object",
      "required": ["contractVersion", "datasetRevision", "experimentId", "doe", "columns", "rows"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "datasetRevision": { "type": "string", "minLength": 1 },
        "experimentId": { "type": "integer", "minimum": 1 },
        "doe": {
          "type": "object",
          "required": ["id", "designType"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "designType": { "type": "string", "minLength": 1 }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "code", "dataType", "role", "active"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 1 },
              "dataType": { "enum": ["number", "text", "boolean", "tags", "category", "date"] },
              "role": { "enum": ["meta", "factor", "response", "block", "replicate"] },
              "active": { "type": "boolean" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["runId", "runCode", "done", "excluded", "values", "codedValues"],
            "properties": {
              "runId": { "type": "integer", "minimum": 1 },
              "runCode": { "type": "string" },
              "done": { "type": "boolean" },
              "excluded": { "type": "boolean" },
              "values": { "type": "object" },
              "codedValues": { "type": "object" }
            }
          }
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseKey",
        "factorKeys",
        "modelFamily",
        "useCodedFactors",
        "includeExcluded",
        "includeIncomplete",
        "confidenceLevel"
      ],
      "properties": {
        "responseKey": { "type": "string", "minLength": 1 },
        "factorKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "modelFamily": { "enum": ["factorial", "response_surface", "regression"] },
        "useCodedFactors": { "type": "boolean" },
        "includeExcluded": { "type": "boolean" },
        "includeIncomplete": { "type": "boolean" },
        "confidenceLevel": { "type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1 }
      }
    }
  }
}
