{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im-planner.local/contracts/doe-analytics/response-1.0.schema.json",
  "title": "DOE analytics response 1.0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok",
        "contractVersion",
        "requestId",
        "datasetRevision",
        "engine",
        "specification",
        "summary",
        "coefficients",
        "anova",
        "diagnostics",
        "warnings"
      ],
      "properties": {
        "ok": { "const": true },
        "contractVersion": { "const": "1.0" },
        "requestId": { "type": "string", "minLength": 1 },
        "datasetRevision": { "type": "string", "minLength": 1 },
        "engine": { "$ref": "#/$defs/engine" },
        "specification": { "type": "object" },
        "summary": {
          "type": "object",
          "required": ["rowsAvailable", "rowsUsed", "rowsExcluded", "rowsMissingResponse", "metrics"]
        },
        "coefficients": { "type": "array" },
        "anova": { "type": "array" },
        "diagnostics": { "type": "array" },
        "warnings": { "type": "array" }
      }
    },
    {
      "type": "object",
      "required": ["ok", "contractVersion", "requestId", "error"],
      "properties": {
        "ok": { "const": false },
        "contractVersion": { "const": "1.0" },
        "requestId": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          }
        }
      }
    }
  ],
  "$defs": {
    "engine": {
      "type": "object",
      "required": ["name", "version", "mode", "packages"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["mock", "r"] },
        "packages": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
