<%- include('partials/head', { title: `Polymer Processing Planner | Report ${report.experiment.id}`, uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<main class="min-h-[calc(100vh-4rem)] bg-gray-50">
  <div class="w-full max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
  <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <% const reportSetupEditable = typeof canEditReportSetup !== 'undefined' && canEditReportSetup; %>
    <div class="flex flex-wrap items-start gap-3 border-b border-gray-200 px-5 py-4">
      <a class="inline-flex size-9 items-center justify-center rounded-lg text-gray-500 no-underline hover:bg-gray-100 hover:text-gray-900" href="<%= experimentPath(report.experiment.id) %>" aria-label="Back to experiment">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
      </a>
      <div>
        <h1 class="text-lg font-semibold text-gray-900">Report setup #<%= report.experiment.id %></h1>
        <div class="mt-0.5 text-sm text-gray-500"><%- formatInline(report.experiment.name) %></div>
      </div>
      <% if (typeof reportConfig !== 'undefined' && reportConfig) { %>
        <div class="ml-auto flex items-center gap-2">
          <% if (reportConfig.signed_at) { %>
            <span class="status-pill status-done">Signed</span>
          <% } else if (reportConfig.submitted_for_signature_at) { %>
            <span class="status-pill status-progress">Awaiting signature</span>
          <% } %>
        </div>
      <% } %>
    </div>
    <% if (reportSetupEditable) { %>
      <% const reportSetupManager = typeof canManageReportSetup !== 'undefined' && canManageReportSetup; %>
      <form class="grid gap-5 p-5" action="/reports/<%= reportConfig.id %>/setup" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="min-w-0 rounded-lg border border-gray-200 p-4">
          <legend class="px-1 text-sm font-semibold text-gray-900">Document</legend>
          <div class="grid gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(150px,.7fr)_minmax(190px,1fr)]">
            <div class="report-title-field">
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportSetupName">Report title</label>
              <input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" id="reportSetupName" name="name" type="text" maxlength="160" required value="<%= reportConfig.name %>">
            </div>
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportNumber">Report number</label>
              <input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="reportNumber" name="report_number" type="text" maxlength="64" required <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.report_number || `RPT-${String(reportConfig.created_at || '').slice(0, 10).replace(/-/g, '')}-${String(reportConfig.id).padStart(4, '0')}` %>">
              <% if (!reportSetupManager) { %><input type="hidden" name="report_number" value="<%= reportConfig.report_number || `RPT-${reportConfig.id}` %>"><% } %>
            </div>
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportType">Type and template</label>
              <select class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="reportType" name="report_type" <%= reportSetupManager ? '' : 'disabled' %>>
                <option value="QUALIFICATION" <%= reportConfig.report_type === 'QUALIFICATION' ? 'selected' : '' %>>Qualification — standard template</option>
                <option value="DOE" <%= reportConfig.report_type === 'DOE' ? 'selected' : '' %>>DOE — standard template</option>
                <option value="COMBINED" <%= reportConfig.report_type === 'COMBINED' ? 'selected' : '' %>>Combined — standard template</option>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="report_type" value="<%= reportConfig.report_type %>"><% } %>
            </div>
          </div>
        </fieldset>
        <fieldset class="min-w-0 rounded-lg border border-gray-200 p-4">
          <legend class="px-1 text-sm font-semibold text-gray-900">Roles and approval</legend>
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportAuthor">Author — prepares the report</label>
              <select class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="reportAuthor" name="author_user_id" <%= reportSetupManager ? '' : 'disabled' %>>
                <% if (!reportSetupManager && reportConfig.author_user_id) { %>
                  <option value="<%= reportConfig.author_user_id %>" selected><%= author?.name || author?.email || 'Assigned author' %></option>
                <% } else { %>
                  <option value="">Not assigned</option>
                  <% assignableUsers.forEach((user) => { %>
                    <option value="<%= user.id %>" <%= reportConfig.author_user_id === user.id ? 'selected' : '' %>><%= user.name || user.email %></option>
                  <% }); %>
                <% } %>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="author_user_id" value="<%= reportConfig.author_user_id || '' %>"><% } %>
            </div>
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportResponsible">Responsible signer</label>
              <select class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="reportResponsible" name="responsible_user_id" <%= reportSetupManager ? '' : 'disabled' %>>
                <% if (!reportSetupManager && reportConfig.responsible_user_id) { %>
                  <option value="<%= reportConfig.responsible_user_id %>" selected><%= responsible?.name || responsible?.email || 'Assigned signer' %></option>
                <% } else { %>
                  <option value="">Not assigned</option>
                  <% assignableUsers.forEach((user) => { %>
                    <option value="<%= user.id %>" <%= reportConfig.responsible_user_id === user.id ? 'selected' : '' %>><%= user.name || user.email %></option>
                  <% }); %>
                <% } %>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="responsible_user_id" value="<%= reportConfig.responsible_user_id || '' %>"><% } %>
            </div>
          </div>
        </fieldset>
        <fieldset class="min-w-0 rounded-lg border border-gray-200 p-4">
          <legend class="px-1 text-sm font-semibold text-gray-900">Dates</legend>
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="reportDueAt">Author due date</label>
              <input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="reportDueAt" name="due_at" type="date" <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.due_at || '' %>">
              <% if (!reportSetupManager) { %><input type="hidden" name="due_at" value="<%= reportConfig.due_at || '' %>"><% } %>
            </div>
            <div>
              <label class="mb-2 block text-sm font-medium text-gray-900" for="signatureSlaDays">Signature SLA</label>
              <div class="flex items-center gap-3">
                <input class="block w-20 rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 disabled:cursor-not-allowed disabled:opacity-60" id="signatureSlaDays" name="signature_sla_days" type="number" min="0" max="30" required <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.signature_sla_days %>">
                <% if (!reportSetupManager) { %><input type="hidden" name="signature_sla_days" value="<%= reportConfig.signature_sla_days %>"><% } %>
                <span class="text-sm text-gray-500">calendar days after sending</span>
              </div>
            </div>
          </div>
        </fieldset>
        <fieldset class="min-w-0 rounded-lg border border-gray-200 p-4">
          <legend class="px-1 text-sm font-semibold text-gray-900">Report brief</legend>
          <label class="mb-2 block text-sm font-medium text-gray-900" for="reportSetupDescription">Description</label>
          <textarea class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" id="reportSetupDescription" name="description" rows="4" maxlength="4000" placeholder="Purpose, scope or notes for this report"><%= reportDescription %></textarea>
        </fieldset>
        <div class="flex justify-end">
          <button class="inline-flex items-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" type="submit">Save setup</button>
        </div>
      </form>
    <% } else if (typeof reportConfig !== 'undefined' && reportConfig) { %>
      <div class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
          <div class="text-sm text-gray-500">Author</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%- formatInline(author?.name || author?.email || '-') %></strong></div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
          <div class="text-sm text-gray-500">Responsible</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%- formatInline(responsible?.name || responsible?.email || '-') %></strong></div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
          <div class="text-sm text-gray-500">Due date</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= reportConfig.due_at || '-' %></strong></div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
          <div class="text-sm text-gray-500">Signature due</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= reportConfig.signature_due_at || '-' %></strong></div>
        </div>
      </div>
      <div class="mx-5 mb-5 rounded-lg border border-gray-200 bg-gray-50 p-4">
        <div class="text-sm text-gray-500">Description</div>
        <div class="mt-1 text-sm text-gray-900"><%- formatInline(reportDescription || '-') %></div>
      </div>
    <% } %>
    <% if (reportSetupEditable) { %>
      <div class="grid gap-3 border-t border-gray-200 px-5 py-4 sm:grid-cols-2 lg:grid-cols-4">
        <% const currentTaskOwner = reportConfig.submitted_for_signature_at ? responsible : author; %>
        <div class="text-sm"><span class="block text-gray-500">Current task owner</span><strong class="mt-1 block text-gray-900"><%- formatInline(currentTaskOwner?.name || currentTaskOwner?.email || '-') %></strong></div>
        <div class="text-sm"><span class="block text-gray-500">Responsible signer</span><strong class="mt-1 block text-gray-900"><%- formatInline(responsible?.name || responsible?.email || '-') %></strong></div>
        <div class="text-sm"><span class="block text-gray-500">Due date</span><strong class="mt-1 block text-gray-900"><%= reportConfig.due_at || '-' %></strong></div>
        <div class="text-sm"><span class="block text-gray-500">Signature due</span><strong class="mt-1 block text-gray-900"><%= reportConfig.signature_due_at || 'Calculated when sent' %></strong></div>
      </div>
    <% } %>
    <% if (typeof reportConfig !== 'undefined' && reportConfig) { %>
      <% if (typeof canOpenTextEditor !== 'undefined' && canOpenTextEditor) { %>
        <section class="mx-5 mb-4 flex flex-col gap-4 rounded-xl border border-blue-200 bg-blue-50 p-4 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="reportEditorEntryTitle">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-blue-700">Next step</div>
            <h2 class="mt-1 text-base font-semibold text-gray-900" id="reportEditorEntryTitle">Write the report</h2>
            <p class="mt-1 text-sm text-gray-600">Use the structured outline, add research data and prepare the document for signature.</p>
          </div>
          <a class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white no-underline shadow-sm hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href="/reports/<%= reportConfig.id %>/editor">
            <span class="material-symbols-rounded" aria-hidden="true">edit_note</span>
            Open text editor
          </a>
        </section>
      <% } %>
      <% if (typeof canSubmitForSignature !== 'undefined' && canSubmitForSignature) { %>
        <section class="mx-5 mb-4 flex flex-col gap-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="reportSignatureEntryTitle">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Final step</div>
            <h2 class="mt-1 text-base font-semibold text-gray-900" id="reportSignatureEntryTitle">Send for signature</h2>
            <p class="mt-1 text-sm text-gray-600">The writing task will be completed and reassigned to the responsible signer. The signature deadline is calculated from the SLA in setup.</p>
          </div>
          <form class="pure-form" action="/reports/<%= reportConfig.id %>/submit-for-signature" method="post" data-confirm="Send this report to the responsible signer?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-300" type="submit">
              <span class="material-symbols-rounded" aria-hidden="true">draw</span>
              Send for signature
            </button>
          </form>
        </section>
      <% } %>
      <div class="flex flex-wrap gap-2 px-5 pb-5">
        <% if (typeof canRecallSignatureSubmission !== 'undefined' && canRecallSignatureSubmission) { %>
          <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/recall-from-signature" method="post" data-confirm="Return this report to the author for revision?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" type="submit">Return to author</button>
          </form>
        <% } %>
        <% if (canSignReport) { %>
          <% if (reportConfig.signed_at) { %>
            <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/unsign" method="post" data-confirm="Withdraw signature?">
              <button class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" type="submit">Withdraw signature</button>
            </form>
          <% } else { %>
            <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/sign" method="post" data-confirm="Sign this report?">
              <button class="inline-flex items-center rounded-lg bg-blue-700 px-3.5 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" type="submit">Sign report</button>
            </form>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </section>

  <%- include('partials/entity_notes', {
    experimentId: report.experiment.id,
    entityType: (typeof reportConfig !== 'undefined' && reportConfig) ? 'report' : 'experiment',
    entityId: (typeof reportConfig !== 'undefined' && reportConfig) ? reportConfig.id : report.experiment.id,
    title: 'Report Notes',
    canWrite: currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer')
  }) %>

  <section class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Recipes</h2>
    </div>
    <% if (!report.recipes.length) { %>
      <div class="p-5 text-sm text-gray-500">No recipes linked.</div>
    <% } else { %>
      <div class="grid gap-4 p-5 sm:grid-cols-2 xl:grid-cols-3">
        <% report.recipes.forEach((recipe) => { %>
          <div class="rounded-lg border border-gray-200 bg-white p-4">
            <div>
              <h3 class="text-sm font-semibold text-gray-900"><%- formatInline(recipe.name) %></h3>
            </div>
            <% if (recipe.description) { %>
              <div class="mt-2 text-sm text-gray-500"><%- formatInline(recipe.description) %></div>
            <% } %>
            <div class="mt-3 divide-y divide-gray-100 rounded-lg bg-gray-50 px-3">
              <% (recipe.components || []).forEach((component) => { %>
                <div class="flex items-center justify-between gap-3 py-2 text-sm">
                  <span class="min-w-0 truncate text-gray-700"><%- formatInline(component.component_name) %></span>
                  <span class="shrink-0 font-medium text-gray-900"><%= formatNumber(component.phr) %></span>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <% if (options.includeQualification && report.qualification) { %>
    <section class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 class="text-base font-semibold text-gray-900">Recommended Settings</h2>
      </div>
      <div class="grid gap-3 p-5 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="text-sm text-gray-500">Injection speed</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= formatNumber(report.qualification.recommended_inj_speed) %></strong> cm3/s</div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="text-sm text-gray-500">Process window center</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= formatNumber(report.qualification.window.center_temp) %></strong> °C</div>
          <div class="text-sm text-gray-900"><strong><%= formatNumber(report.qualification.window.center_pressure) %></strong> bar</div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="text-sm text-gray-500">Gate seal time</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= formatNumber(report.qualification.gate_seal_time_s) %></strong> s</div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="text-sm text-gray-500">Min cooling time</div>
          <div class="mt-1 text-sm text-gray-900"><strong><%= formatNumber(report.qualification.min_cooling_time_s) %></strong> s</div>
        </div>
      </div>
    </section>

    <section class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 class="text-base font-semibold text-gray-900">Qualification Charts</h2>
      </div>
      <div class="grid gap-4 p-5 xl:grid-cols-2">
        <div class="overflow-hidden rounded-lg border border-gray-200 bg-white p-3"><div id="reportRheoChart" style="width: 100%; height: 320px;"></div></div>
        <div class="overflow-hidden rounded-lg border border-gray-200 bg-white p-3"><div id="reportWindowChart" style="width: 100%; height: 320px;"></div></div>
      </div>
    </section>
  <% } %>

  <% if (options.includeDoe && report.doe) { %>
    <section class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 class="text-base font-semibold text-gray-900">DOE Studies</h2>
      </div>
      <% if (!report.doe.length) { %>
        <div class="p-5 text-sm text-gray-500">No DOE studies.</div>
      <% } else { %>
        <div class="overflow-x-auto p-5">
          <table class="w-full min-w-[680px] text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-3">ID</th>
                <th class="px-4 py-3">Name</th>
                <th class="px-4 py-3">Type</th>
                <th class="px-4 py-3">Runs</th>
                <th class="px-4 py-3">Factors</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% report.doe.forEach((study) => { %>
                <tr>
                  <td class="px-4 py-3"><%= study.id %></td>
                  <td class="px-4 py-3 font-medium text-gray-900"><%- formatInline(study.name) %></td>
                  <td class="px-4 py-3"><%= study.design_type %></td>
                  <td class="px-4 py-3"><%= study.run_count %></td>
                  <td class="px-4 py-3">
                    <% study.factors.forEach((factor) => { %>
                      <div class="text-xs text-gray-500"><strong class="text-gray-700"><%- formatInline(factor.code) %></strong> <%= factor.mode %> <%= factor.values %></div>
                    <% }); %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% } %>

  <section class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Downloads</h2>
    </div>
    <div class="flex flex-wrap gap-2 p-5">
      <a class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 no-underline shadow-sm hover:bg-gray-50" href="/experiments/<%= report.experiment.id %>/report.csv?section=qualification">qualification.csv</a>
      <a class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 no-underline shadow-sm hover:bg-gray-50" href="/experiments/<%= report.experiment.id %>/report.csv?section=doe">doe.csv</a>
      <a class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 no-underline shadow-sm hover:bg-gray-50" href="/experiments/<%= report.experiment.id %>/report.csv?section=outputs">outputs.csv</a>
    </div>
  </section>
  </div>
</main>

<% if (options.includeQualification && report.qualification) { %>
  <script nonce="<%= cspNonce %>" src="/vendor/echarts/dist/echarts.min.js"></script>
  <script nonce="<%= cspNonce %>">
    const rheoData = <%- jsonForScript(report.qualification.charts.rheology) %>;
    const windowData = <%- jsonForScript(report.qualification.charts.processWindow) %>;
    const rheoChart = echarts.init(document.getElementById('reportRheoChart'));
    const windowChart = echarts.init(document.getElementById('reportWindowChart'));
    const rheoSeries = rheoData
      .filter((p) => p && Number.isFinite(p.x) && Number.isFinite(p.y))
      .map((p) => [p.x, p.y]);
    rheoChart.setOption({
      grid: { left: 60, right: 40, top: 20, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Injection speed (cm3/s)' },
      yAxis: { type: 'value', name: 'Relative viscosity' },
      series: [{ type: 'line', symbol: 'circle', data: rheoSeries }]
    });
    const good = windowData.good || [];
    const defect = windowData.defect || [];
    const windowPoly = windowData.window || [];
    const center = windowData.center ? [windowData.center] : [];
    const windowSeries = [
      { type: 'scatter', data: good, symbolSize: 8, itemStyle: { color: '#2f8f5b' } },
      { type: 'scatter', data: defect, symbolSize: 8, itemStyle: { color: '#d45f5f' } }
    ];
    if (windowPoly.length) {
      windowSeries.push({ type: 'line', data: windowPoly, lineStyle: { color: '#4a86d4' }, areaStyle: { color: 'rgba(74, 134, 212, 0.1)' } });
    }
    if (center.length) {
      windowSeries.push({ type: 'scatter', data: center, symbolSize: 10, itemStyle: { color: '#d97a2b' } });
    }
    windowChart.setOption({
      grid: { left: 60, right: 40, top: 20, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Temperature (°C)' },
      yAxis: { type: 'value', name: 'Hold pressure (bar)' },
      series: windowSeries
    });
  </script>
<% } %>
