<%- include('partials/head', { title: `Polymer Processing Planner | Report ${report.experiment.id}` }) %>
<%- include('partials/nav') %>
<div class="container">
  <div class="card">
    <% const reportSetupEditable = typeof canEditReportSetup !== 'undefined' && canEditReportSetup; %>
    <div class="card-header">
      <a class="back-link" href="<%= experimentPath(report.experiment.id) %>" aria-label="Back to experiment">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
      </a>
      <div>
        <h1 class="card-title">Report setup #<%= report.experiment.id %></h1>
        <div class="small-note"><%- formatInline(report.experiment.name) %></div>
      </div>
      <% if (typeof reportConfig !== 'undefined' && reportConfig) { %>
        <div class="section-actions">
          <% if (reportConfig.signed_at) { %>
            <span class="status-pill status-done">Signed</span>
          <% } else if (reportConfig.submitted_for_signature_at) { %>
            <span class="status-pill status-progress">Awaiting signature</span>
          <% } %>
        </div>
      <% } %>
    </div>
    <% if (reportSetupEditable) { %>
      <% const reportSetupManager = typeof canManageReportSetup !== 'undefined' && canManageReportSetup; %>
      <form class="pure-form form-grid report-setup-form" action="/reports/<%= reportConfig.id %>/setup" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="report-setup-group form-wide">
          <legend>Document</legend>
          <div class="report-setup-fields report-setup-fields-document">
            <div class="report-title-field">
              <label for="reportSetupName">Report title</label>
              <input id="reportSetupName" name="name" type="text" maxlength="160" required value="<%= reportConfig.name %>">
            </div>
            <div>
              <label for="reportNumber">Report number</label>
              <input id="reportNumber" name="report_number" type="text" maxlength="64" required <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.report_number || `RPT-${String(reportConfig.created_at || '').slice(0, 10).replace(/-/g, '')}-${String(reportConfig.id).padStart(4, '0')}` %>">
              <% if (!reportSetupManager) { %><input type="hidden" name="report_number" value="<%= reportConfig.report_number || `RPT-${reportConfig.id}` %>"><% } %>
            </div>
            <div>
              <label for="reportType">Type and template</label>
              <select id="reportType" name="report_type" <%= reportSetupManager ? '' : 'disabled' %>>
                <option value="QUALIFICATION" <%= reportConfig.report_type === 'QUALIFICATION' ? 'selected' : '' %>>Qualification — standard template</option>
                <option value="DOE" <%= reportConfig.report_type === 'DOE' ? 'selected' : '' %>>DOE — standard template</option>
                <option value="COMBINED" <%= reportConfig.report_type === 'COMBINED' ? 'selected' : '' %>>Combined — standard template</option>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="report_type" value="<%= reportConfig.report_type %>"><% } %>
            </div>
          </div>
        </fieldset>
        <fieldset class="report-setup-group form-wide">
          <legend>Roles and approval</legend>
          <div class="report-setup-fields">
            <div>
              <label for="reportAuthor">Author — prepares the report</label>
              <select id="reportAuthor" name="author_user_id" <%= reportSetupManager ? '' : 'disabled' %>>
                <% if (!reportSetupManager && reportConfig.author_user_id) { %>
                  <option value="<%= reportConfig.author_user_id %>" selected><%= author?.name || author?.email || 'Assigned author' %></option>
                <% } else { %>
                  <option value="">Not assigned</option>
                  <% assignableUsers.forEach((user) => { %>
                    <option value="<%= user.id %>" <%= reportConfig.author_user_id === user.id ? 'selected' : '' %>><%= user.name || user.email %></option>
                  <% }); %>
                <% } %>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="author_user_id" value="<%= reportConfig.author_user_id || '' %>"><% } %>
            </div>
            <div>
              <label for="reportResponsible">Responsible signer</label>
              <select id="reportResponsible" name="responsible_user_id" <%= reportSetupManager ? '' : 'disabled' %>>
                <% if (!reportSetupManager && reportConfig.responsible_user_id) { %>
                  <option value="<%= reportConfig.responsible_user_id %>" selected><%= responsible?.name || responsible?.email || 'Assigned signer' %></option>
                <% } else { %>
                  <option value="">Not assigned</option>
                  <% assignableUsers.forEach((user) => { %>
                    <option value="<%= user.id %>" <%= reportConfig.responsible_user_id === user.id ? 'selected' : '' %>><%= user.name || user.email %></option>
                  <% }); %>
                <% } %>
              </select>
              <% if (!reportSetupManager) { %><input type="hidden" name="responsible_user_id" value="<%= reportConfig.responsible_user_id || '' %>"><% } %>
            </div>
          </div>
        </fieldset>
        <fieldset class="report-setup-group form-wide">
          <legend>Dates</legend>
          <div class="report-setup-fields">
            <div>
              <label for="reportDueAt">Author due date</label>
              <input id="reportDueAt" name="due_at" type="date" <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.due_at || '' %>">
              <% if (!reportSetupManager) { %><input type="hidden" name="due_at" value="<%= reportConfig.due_at || '' %>"><% } %>
            </div>
            <div>
              <label for="signatureSlaDays">Signature SLA</label>
              <div class="report-sla-field">
                <input id="signatureSlaDays" name="signature_sla_days" type="number" min="0" max="30" required <%= reportSetupManager ? '' : 'disabled' %> value="<%= reportConfig.signature_sla_days %>">
                <% if (!reportSetupManager) { %><input type="hidden" name="signature_sla_days" value="<%= reportConfig.signature_sla_days %>"><% } %>
                <span>calendar days after sending</span>
              </div>
            </div>
          </div>
        </fieldset>
        <fieldset class="report-setup-group form-wide">
          <legend>Report brief</legend>
          <label for="reportSetupDescription">Description</label>
          <textarea id="reportSetupDescription" name="description" rows="4" maxlength="4000" placeholder="Purpose, scope or notes for this report"><%= reportDescription %></textarea>
        </fieldset>
        <div class="section-actions form-wide">
          <button class="pure-button pure-button-primary" type="submit">Save setup</button>
        </div>
      </form>
    <% } else if (typeof reportConfig !== 'undefined' && reportConfig) { %>
      <div class="report-meta">
        <div>
          <div class="small-note">Author</div>
          <div><strong><%- formatInline(author?.name || author?.email || '-') %></strong></div>
        </div>
        <div>
          <div class="small-note">Responsible</div>
          <div><strong><%- formatInline(responsible?.name || responsible?.email || '-') %></strong></div>
        </div>
        <div>
          <div class="small-note">Due date</div>
          <div><strong><%= reportConfig.due_at || '-' %></strong></div>
        </div>
        <div>
          <div class="small-note">Signature due</div>
          <div><strong><%= reportConfig.signature_due_at || '-' %></strong></div>
        </div>
      </div>
      <div class="report-description">
        <div class="small-note">Description</div>
        <div><%- formatInline(reportDescription || '-') %></div>
      </div>
    <% } %>
    <% if (reportSetupEditable) { %>
      <div class="report-meta report-setup-summary">
        <% const currentTaskOwner = reportConfig.submitted_for_signature_at ? responsible : author; %>
        <div><span class="small-note">Current task owner</span><strong><%- formatInline(currentTaskOwner?.name || currentTaskOwner?.email || '-') %></strong></div>
        <div><span class="small-note">Responsible signer</span><strong><%- formatInline(responsible?.name || responsible?.email || '-') %></strong></div>
        <div><span class="small-note">Due date</span><strong><%= reportConfig.due_at || '-' %></strong></div>
        <div><span class="small-note">Signature due</span><strong><%= reportConfig.signature_due_at || 'Calculated when sent' %></strong></div>
      </div>
    <% } %>
    <% if (typeof reportConfig !== 'undefined' && reportConfig) { %>
      <% if (typeof canOpenTextEditor !== 'undefined' && canOpenTextEditor) { %>
        <section class="report-editor-entry" aria-labelledby="reportEditorEntryTitle">
          <div>
            <div class="report-editor-step">Next step</div>
            <h2 id="reportEditorEntryTitle">Write the report</h2>
            <p>Use the structured outline, add research data and prepare the document for signature.</p>
          </div>
          <a class="pure-button pure-button-primary report-editor-entry-button" href="/reports/<%= reportConfig.id %>/editor">
            <span class="material-symbols-rounded" aria-hidden="true">edit_note</span>
            Open text editor
          </a>
        </section>
      <% } %>
      <% if (typeof canSubmitForSignature !== 'undefined' && canSubmitForSignature) { %>
        <section class="report-signature-entry" aria-labelledby="reportSignatureEntryTitle">
          <div>
            <div class="report-editor-step">Final step</div>
            <h2 id="reportSignatureEntryTitle">Send for signature</h2>
            <p>The writing task will be completed and reassigned to the responsible signer. The signature deadline is calculated from the SLA in setup.</p>
          </div>
          <form class="pure-form" action="/reports/<%= reportConfig.id %>/submit-for-signature" method="post" data-confirm="Send this report to the responsible signer?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="pure-button pure-button-primary report-editor-entry-button" type="submit">
              <span class="material-symbols-rounded" aria-hidden="true">draw</span>
              Send for signature
            </button>
          </form>
        </section>
      <% } %>
      <div class="section-actions" style="margin-top: 0.75rem;">
        <% if (typeof canRecallSignatureSubmission !== 'undefined' && canRecallSignatureSubmission) { %>
          <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/recall-from-signature" method="post" data-confirm="Return this report to the author for revision?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="pure-button" type="submit">Return to author</button>
          </form>
        <% } %>
        <% if (canSignReport) { %>
          <% if (reportConfig.signed_at) { %>
            <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/unsign" method="post" data-confirm="Withdraw signature?">
              <button class="pure-button" type="submit">Withdraw signature</button>
            </form>
          <% } else { %>
            <form class="pure-form inline-form" action="/reports/<%= reportConfig.id %>/sign" method="post" data-confirm="Sign this report?">
              <button class="pure-button pure-button-primary" type="submit">Sign report</button>
            </form>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </div>

  <%- include('partials/entity_notes', {
    experimentId: report.experiment.id,
    entityType: (typeof reportConfig !== 'undefined' && reportConfig) ? 'report' : 'experiment',
    entityId: (typeof reportConfig !== 'undefined' && reportConfig) ? reportConfig.id : report.experiment.id,
    title: 'Report Notes',
    canWrite: currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer')
  }) %>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Recipes</h2>
    </div>
    <% if (!report.recipes.length) { %>
      <div class="small-note">No recipes linked.</div>
    <% } else { %>
      <div class="recipe-card-grid">
        <% report.recipes.forEach((recipe) => { %>
          <div class="recipe-card">
            <div class="recipe-card-header">
              <h3><%- formatInline(recipe.name) %></h3>
            </div>
            <% if (recipe.description) { %>
              <div class="recipe-desc"><%- formatInline(recipe.description) %></div>
            <% } %>
            <div class="recipe-components">
              <% (recipe.components || []).forEach((component) => { %>
                <div class="recipe-comp-line">
                  <span class="recipe-comp-name"><%- formatInline(component.component_name) %></span>
                  <span class="recipe-comp-qty"><%= formatNumber(component.phr) %></span>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <% if (options.includeQualification && report.qualification) { %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Recommended Settings</h2>
      </div>
      <div class="outputs-grid">
        <div class="output-card">
          <div class="small-note">Injection speed</div>
          <div><strong><%= formatNumber(report.qualification.recommended_inj_speed) %></strong> cm3/s</div>
        </div>
        <div class="output-card">
          <div class="small-note">Process window center</div>
          <div><strong><%= formatNumber(report.qualification.window.center_temp) %></strong> °C</div>
          <div><strong><%= formatNumber(report.qualification.window.center_pressure) %></strong> bar</div>
        </div>
        <div class="output-card">
          <div class="small-note">Gate seal time</div>
          <div><strong><%= formatNumber(report.qualification.gate_seal_time_s) %></strong> s</div>
        </div>
        <div class="output-card">
          <div class="small-note">Min cooling time</div>
          <div><strong><%= formatNumber(report.qualification.min_cooling_time_s) %></strong> s</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Qualification Charts</h2>
      </div>
      <div class="chart-card">
        <div id="reportRheoChart" style="width: 100%; height: 320px;"></div>
      </div>
      <div class="chart-card" style="margin-top: 1rem;">
        <div id="reportWindowChart" style="width: 100%; height: 320px;"></div>
      </div>
    </div>
  <% } %>

  <% if (options.includeDoe && report.doe) { %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">DOE Studies</h2>
      </div>
      <% if (!report.doe.length) { %>
        <div class="small-note">No DOE studies.</div>
      <% } else { %>
        <div class="table-scroll">
          <table class="pure-table table-compact">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Runs</th>
                <th>Factors</th>
              </tr>
            </thead>
            <tbody>
              <% report.doe.forEach((study) => { %>
                <tr>
                  <td><%= study.id %></td>
                  <td><%- formatInline(study.name) %></td>
                  <td><%= study.design_type %></td>
                  <td><%= study.run_count %></td>
                  <td>
                    <% study.factors.forEach((factor) => { %>
                      <div class="small-note"><strong><%- formatInline(factor.code) %></strong> <%= factor.mode %> <%= factor.values %></div>
                    <% }); %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Downloads</h2>
    </div>
    <div class="section-actions">
      <a class="pure-button" href="/experiments/<%= report.experiment.id %>/report.csv?section=qualification">qualification.csv</a>
      <a class="pure-button" href="/experiments/<%= report.experiment.id %>/report.csv?section=doe">doe.csv</a>
      <a class="pure-button" href="/experiments/<%= report.experiment.id %>/report.csv?section=outputs">outputs.csv</a>
    </div>
  </div>
</div>

<% if (options.includeQualification && report.qualification) { %>
  <script nonce="<%= cspNonce %>" src="/vendor/echarts/dist/echarts.min.js"></script>
  <script nonce="<%= cspNonce %>">
    const rheoData = <%- jsonForScript(report.qualification.charts.rheology) %>;
    const windowData = <%- jsonForScript(report.qualification.charts.processWindow) %>;
    const rheoChart = echarts.init(document.getElementById('reportRheoChart'));
    const windowChart = echarts.init(document.getElementById('reportWindowChart'));
    const rheoSeries = rheoData
      .filter((p) => p && Number.isFinite(p.x) && Number.isFinite(p.y))
      .map((p) => [p.x, p.y]);
    rheoChart.setOption({
      grid: { left: 60, right: 40, top: 20, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Injection speed (cm3/s)' },
      yAxis: { type: 'value', name: 'Relative viscosity' },
      series: [{ type: 'line', symbol: 'circle', data: rheoSeries }]
    });
    const good = windowData.good || [];
    const defect = windowData.defect || [];
    const windowPoly = windowData.window || [];
    const center = windowData.center ? [windowData.center] : [];
    const windowSeries = [
      { type: 'scatter', data: good, symbolSize: 8, itemStyle: { color: '#2f8f5b' } },
      { type: 'scatter', data: defect, symbolSize: 8, itemStyle: { color: '#d45f5f' } }
    ];
    if (windowPoly.length) {
      windowSeries.push({ type: 'line', data: windowPoly, lineStyle: { color: '#4a86d4' }, areaStyle: { color: 'rgba(74, 134, 212, 0.1)' } });
    }
    if (center.length) {
      windowSeries.push({ type: 'scatter', data: center, symbolSize: 10, itemStyle: { color: '#d97a2b' } });
    }
    windowChart.setOption({
      grid: { left: 60, right: 40, top: 20, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Temperature (°C)' },
      yAxis: { type: 'value', name: 'Hold pressure (bar)' },
      series: windowSeries
    });
  </script>
<% } %>
<%- include('partials/foot') %>
