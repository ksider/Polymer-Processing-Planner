<%- include('partials/head', { title: 'Polymer Processing Planner | Work', uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<main class="min-h-[calc(100vh-4rem)] bg-gray-50"><div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5" data-work-shell data-work-density="<%= preferences?.density || 'comfortable' %>">
  <% const overdueCount = queue.items.filter((item) => item.urgency === 'overdue').length; const soonCount = queue.items.filter((item) => item.urgency === 'soon').length; %>
  <section class="overflow-hidden rounded-lg border border-blue-200 bg-white shadow-sm">
    <div class="bg-gradient-to-r from-blue-800 via-blue-700 to-cyan-700 px-5 py-5 text-white lg:flex lg:items-start lg:justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-cyan-100">Unified work queue</p><h1 class="mt-1 text-2xl font-semibold">Work</h1><p class="mt-1 max-w-2xl text-sm text-blue-100">Real work from the source records, limited only by your access.</p></div><div class="mt-4 flex flex-wrap gap-2 lg:mt-0"><span class="rounded-lg bg-white/15 px-3 py-2 text-sm font-medium"><%= queue.total %> items</span><% if (soonCount) { %><span class="rounded-lg bg-amber-300 px-3 py-2 text-sm font-bold text-amber-950"><%= soonCount %> due ≤ 3 days</span><% } %><% if (overdueCount) { %><span class="rounded-lg bg-red-500 px-3 py-2 text-sm font-bold text-white"><%= overdueCount %> overdue</span><% } %></div></div>
    <form class="grid gap-3 border-b border-gray-200 bg-gray-50 p-4 sm:grid-cols-2 xl:grid-cols-4" method="get" data-work-filters>
      <input type="hidden" name="view" value="<%= initialView || 'table' %>" data-work-view-input>
      <label class="min-w-0 text-xs font-medium text-heading">Work ownership<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="scope"><% [['mine', 'Mine — owner or assignee'], ['others', 'Assigned to other participants'], ['all', 'All accessible work']].forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.scope === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading">Responsible person<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="responsible_user_id"><option value="">Anyone</option><% queue.people.forEach((person) => { %><option value="<%= person.id %>" <%= filters.responsibleUserId === person.id ? 'selected' : '' %>><%= person.label %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading">Process<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="process_id"><option value="">All processes</option><% queue.processes.forEach((process) => { %><option value="<%= process.id %>" <%= filters.processId === process.id ? 'selected' : '' %>><%= process.name %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading">Experiment<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="experiment_id"><option value="">All experiments</option><% queue.experiments.forEach((experiment) => { %><option value="<%= experiment.id %>" <%= filters.experimentId === experiment.id ? 'selected' : '' %>><%= experiment.name %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading">Type<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="type"><% [['all', 'All types'], ['task', 'Tasks'], ['qualification', 'Qualification'], ['doe', 'DOE'], ['report', 'Reports']].forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.type === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading">Attention<select class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="state"><% [['all', 'All states'], ['open', 'Open'], ['blocked', 'Blocked'], ['overdue', 'Overdue']].forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.state === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="min-w-0 text-xs font-medium text-heading xl:col-span-2">Search<span class="relative mt-1 block"><span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-body"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">search</span></span><input class="block w-full rounded-base border border-default-medium bg-neutral-secondary-medium py-2 pe-3 ps-10 text-sm text-heading shadow-xs placeholder:text-body focus:border-brand focus:ring-brand" name="q" value="<%= filters.query %>" placeholder="Task, experiment, process or person"></span></label>
      <noscript><button class="rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white" type="submit">Apply filters</button></noscript>
    </form>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-3"><p class="text-sm text-gray-600" aria-live="polite" data-work-count><strong class="text-gray-900"><%= queue.total %></strong> items · filters apply automatically</p><div class="flex items-center gap-2"><button class="rounded-lg border border-default-medium bg-neutral-primary px-3 py-1.5 text-sm font-medium text-heading hover:bg-neutral-secondary" type="button" data-work-density><%= preferences?.density === 'compact' ? 'Comfortable density' : 'Compact density' %></button><div class="inline-flex rounded-lg border border-gray-200 bg-white p-1" role="group" aria-label="Work view"><button class="rounded-md bg-blue-700 px-3 py-1.5 text-sm font-medium text-white" type="button" data-work-view="table">Table</button><button class="rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-100" type="button" data-work-view="board">Board</button><button class="rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-100" type="button" data-work-view="calendar">Calendar</button></div></div></div>
    <div data-work-results>
      <div class="relative overflow-x-auto" data-work-table><table class="w-full min-w-[1000px] text-left text-sm text-gray-600"><thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-700"><tr><th class="px-5 py-3">Work item</th><th class="px-5 py-3">Experiment</th><th class="px-5 py-3">Type</th><th class="px-5 py-3">Responsible</th><th class="px-5 py-3">Execution / data</th><th class="px-5 py-3">Due</th><th class="px-5 py-3">Next action</th></tr></thead><tbody class="divide-y divide-gray-200"><% if (!queue.items.length) { %><tr><td class="px-5 py-12 text-center text-gray-500" colspan="7">No accessible work matches these filters.</td></tr><% } %><% queue.items.forEach((item) => { %><% const typeClass = item.entityType === 'task' ? 'bg-blue-100 text-blue-800' : item.entityType === 'qualification' ? 'bg-violet-100 text-violet-800' : item.entityType === 'doe' ? 'bg-cyan-100 text-cyan-800' : 'bg-amber-100 text-amber-800'; const urgencyClass = item.urgency === 'overdue' ? 'bg-red-50' : item.urgency === 'soon' ? 'bg-amber-50' : 'bg-white'; %><tr class="<%= urgencyClass %> align-top hover:bg-blue-50/60"><td class="px-5 py-3"><% if (item.entityType === 'task') { %><button class="font-medium text-gray-900 hover:text-blue-700 hover:underline" type="button" data-work-task-id="<%= item.sourceId %>"><%- formatInline(item.title) %></button><% } else { %><a class="font-medium text-gray-900 no-underline hover:text-blue-700 hover:underline" href="<%= item.href %>"><%- formatInline(item.title) %></a><% } %><% if (item.blocker) { %><p class="mt-1 inline-flex rounded bg-red-100 px-1.5 py-0.5 text-xs font-bold text-red-800"><%= item.blocker %></p><% } %></td><td class="px-5 py-3"><p class="font-medium text-gray-800"><%= item.experimentName %></p><p class="mt-0.5 text-xs text-gray-500"><%= item.processName || 'No process' %></p></td><td class="px-5 py-3"><span class="rounded-full px-2 py-1 text-xs font-medium <%= typeClass %>"><%= item.entityType %></span></td><td class="px-5 py-3"><%= item.responsible %></td><td class="px-5 py-3"><p class="font-medium text-gray-800"><%= item.execution %></p><p class="mt-0.5 text-xs <%= item.dataStatus.includes('missing') || item.dataStatus.includes('refresh') ? 'font-medium text-amber-700' : 'text-gray-500' %>"><%= item.dataStatus %></p></td><td class="px-5 py-3"><% if (item.urgency === 'overdue') { %><span class="rounded bg-red-600 px-2 py-1 text-xs font-bold text-white">OVERDUE · <%= item.dueAt %></span><% } else if (item.urgency === 'soon') { %><span class="rounded bg-amber-300 px-2 py-1 text-xs font-bold text-amber-950">DUE SOON · <%= item.dueAt %></span><% } else { %><%= item.dueAt || '—' %><% } %></td><td class="px-5 py-3"><% if (item.entityType === 'task') { %><button class="font-medium text-blue-700 hover:underline" type="button" data-work-task-id="<%= item.sourceId %>"><%= item.nextAction %></button><% } else { %><a class="font-medium text-blue-700 no-underline hover:underline" href="<%= item.href %>"><%= item.nextAction %></a><% } %></td></tr><% }) %></tbody></table></div>
      <% const columns = [['init', 'To do', 'border-blue-300 bg-blue-50'], ['in_progress', 'In progress', 'border-cyan-300 bg-cyan-50'], ['failed', 'Failed / blocked', 'border-red-300 bg-red-50'], ['done', 'Completed', 'border-emerald-300 bg-emerald-50']]; const boardColumn = (item) => item.boardStatus; %>
      <div class="hidden overflow-x-auto p-4" data-work-board><div class="grid min-w-[1000px] grid-cols-4 gap-4"><% columns.forEach(([key, label, color]) => { const columnItems = queue.items.filter((item) => boardColumn(item) === key); %><section class="rounded-lg border-t-4 <%= color %> p-3"><div class="mb-3 flex items-center justify-between"><h2 class="text-sm font-semibold text-gray-900"><%= label %></h2><span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold text-gray-700"><%= columnItems.length %></span></div><div class="space-y-3"><% columnItems.forEach((item) => { %><article class="rounded-lg border <%= item.urgency === 'overdue' ? 'border-red-400 bg-red-50 shadow-sm' : item.urgency === 'soon' ? 'border-amber-400 bg-amber-50' : 'border-gray-200 bg-white' %> p-3"><div class="flex items-start justify-between gap-2"><span class="rounded-full px-2 py-0.5 text-[11px] font-medium <%= item.entityType === 'task' ? 'bg-blue-100 text-blue-800' : item.entityType === 'qualification' ? 'bg-violet-100 text-violet-800' : item.entityType === 'doe' ? 'bg-cyan-100 text-cyan-800' : 'bg-amber-100 text-amber-800' %>"><%= item.entityType %></span><% if (item.urgency === 'overdue') { %><span class="text-xs font-extrabold text-red-700">OVERDUE</span><% } else if (item.urgency === 'soon') { %><span class="text-xs font-extrabold text-amber-800">DUE SOON</span><% } %></div><% if (item.entityType === 'task') { %><button class="mt-2 text-left text-sm font-semibold text-gray-900 hover:text-blue-700 hover:underline" type="button" data-work-task-id="<%= item.sourceId %>"><%- formatInline(item.title) %></button><% } else { %><a class="mt-2 block text-sm font-semibold text-gray-900 no-underline hover:text-blue-700 hover:underline" href="<%= item.href %>"><%- formatInline(item.title) %></a><% } %><p class="mt-1 text-xs text-gray-600"><%= item.experimentName %> · <%= item.responsible %></p><p class="mt-2 text-xs font-medium text-gray-700"><%= item.execution %></p><% if (item.dueAt) { %><p class="mt-1 text-xs <%= item.urgency === 'normal' ? 'text-gray-500' : 'font-bold text-red-700' %>">Due <%= item.dueAt %></p><% } %><% if (item.blocker) { %><p class="mt-2 rounded bg-red-100 px-2 py-1 text-xs font-bold text-red-800"><%= item.blocker %></p><% } %></article><% }) %><% if (!columnItems.length) { %><p class="rounded-lg border border-dashed border-gray-300 bg-white/60 p-3 text-xs text-gray-500">No items</p><% } %></div></section><% }) %></div></div>
      <script type="application/json" data-work-capabilities><%- JSON.stringify(queue.items.filter((item) => item.entityType === 'task').map((item) => ({ id: item.sourceId, changeStatus: item.actions.changeStatus }))) %></script>
      <div class="hidden p-4" data-work-calendar><div class="rounded-lg border border-gray-200 bg-white p-3"><div data-work-calendar-host></div></div></div>
    </div>
  </section>
  <dialog id="workTaskDialog" class="w-full max-w-xl rounded-xl border border-gray-200 p-0 shadow-xl backdrop:bg-gray-900/40"><div class="border-b border-gray-200 bg-blue-700 px-5 py-4 text-white"><div class="flex items-center justify-between gap-4"><h2 class="text-lg font-semibold">Task details</h2><button class="rounded-lg px-2 py-1 hover:bg-blue-800" type="button" data-work-task-close aria-label="Close">×</button></div></div><div class="p-5" data-work-task-body>Loading…</div></dialog>
</div></main>
<script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script nonce="<%= cspNonce %>">
  (() => {
    let searchTimer;
    const init = (shell = document.querySelector('[data-work-shell]')) => {
      if (!shell) return;
      const form = shell.querySelector('[data-work-filters]'); const table = shell.querySelector('[data-work-table]'); const board = shell.querySelector('[data-work-board]'); const calendarPanel = shell.querySelector('[data-work-calendar]'); const viewInput = shell.querySelector('[data-work-view-input]'); const densityButton = shell.querySelector('[data-work-density]'); let calendar;
      let view = new URLSearchParams(location.search).get('view') || '<%= initialView || 'table' %>'; if (!['table', 'board', 'calendar'].includes(view)) view = 'table';
      const savePreferences = (changes) => fetch('/work/preferences', { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify(changes) });
      const setDensity = (density, persist = false) => { shell.dataset.workDensity = density; shell.querySelectorAll('[data-work-table] th, [data-work-table] td').forEach((cell) => { cell.classList.toggle('py-2', density === 'compact'); cell.classList.toggle('py-3', density !== 'compact'); }); if (densityButton) densityButton.textContent = density === 'compact' ? 'Comfortable density' : 'Compact density'; if (persist) savePreferences({ density }); };
      const initCalendar = () => { const host = shell.querySelector('[data-work-calendar-host]'); if (calendar || !host || !window.FullCalendar) return; calendar = new window.FullCalendar.Calendar(host, { initialView: 'dayGridMonth', height: 'auto', firstDay: 1, headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,listWeek' }, events: async (_info, success, failure) => { try { const data = new URLSearchParams(new FormData(form)); const personal = data.get('scope') === 'mine'; data.set('scope', personal ? 'my' : 'workspace'); const response = await fetch(`/calendar/events?${data}`); if (!response.ok) throw new Error('Calendar unavailable'); const payload = await response.json(); const processId = data.get('process_id'); const experimentId = data.get('experiment_id'); const events = (Array.isArray(payload.events) ? payload.events : []).filter((event) => (!processId || String(event.processId) === processId) && (!experimentId || String(event.experimentId) === experimentId)); success(events); } catch (error) { failure(error); } }, eventClick: (info) => { if (info.event.url) { info.jsEvent.preventDefault(); location.href = info.event.url; } } }); calendar.render(); };
      const setView = (next, persist = false) => { view = next; if (viewInput) viewInput.value = next; table?.classList.toggle('hidden', next !== 'table'); board?.classList.toggle('hidden', next !== 'board'); calendarPanel?.classList.toggle('hidden', next !== 'calendar'); if (next === 'calendar') initCalendar(); shell.querySelectorAll('[data-work-view]').forEach((button) => { const active = button.dataset.workView === next; button.className = active ? 'rounded-md bg-blue-700 px-3 py-1.5 text-sm font-medium text-white' : 'rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-100'; }); if (persist) savePreferences({ default_view: next }); };
      const load = async () => { if (!form) return; const params = new URLSearchParams(new FormData(form)); params.set('view', view); const url = `/work?${params}`; const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }); if (!response.ok) return; const page = new DOMParser().parseFromString(await response.text(), 'text/html'); const nextShell = page.querySelector('[data-work-shell]'); if (!nextShell) return; shell.replaceWith(nextShell); history.replaceState({}, '', url); init(nextShell); };
      setDensity(shell.dataset.workDensity || 'comfortable'); setView(view); shell.querySelectorAll('[data-work-view]').forEach((button) => button.addEventListener('click', () => { setView(button.dataset.workView, true); const url = new URL(location.href); url.searchParams.set('view', button.dataset.workView); history.replaceState({}, '', url); })); densityButton?.addEventListener('click', () => setDensity(shell.dataset.workDensity === 'compact' ? 'comfortable' : 'compact', true));
      form?.querySelectorAll('select').forEach((control) => control.addEventListener('change', () => { if (control.name === 'scope') savePreferences({ last_scope: control.value }); load(); })); form?.querySelector('input[name="q"]')?.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(load, 250); }); form?.addEventListener('submit', (event) => { event.preventDefault(); load(); });
      const capabilityNode = shell.querySelector('[data-work-capabilities]'); let capabilities = []; try { capabilities = JSON.parse(capabilityNode?.textContent || '[]'); } catch { capabilities = []; } const movableTaskIds = new Set(capabilities.filter((item) => item.changeStatus).map((item) => String(item.id))); let draggedTaskId = ''; const boardStatuses = ['init', 'in_progress', 'failed', 'done']; board?.querySelectorAll('section').forEach((column, index) => { const status = boardStatuses[index]; if (!status) return; column.addEventListener('dragover', (event) => { if (!draggedTaskId) return; event.preventDefault(); column.classList.add('ring-2', 'ring-blue-400'); }); column.addEventListener('dragleave', () => column.classList.remove('ring-2', 'ring-blue-400')); column.addEventListener('drop', async (event) => { event.preventDefault(); column.classList.remove('ring-2', 'ring-blue-400'); const taskId = draggedTaskId; draggedTaskId = ''; if (!taskId) return; const response = await fetch(`/tasks/${taskId}/status`, { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) }); if (response.ok) load(); }); }); board?.querySelectorAll('[data-work-task-id]').forEach((button) => { const taskId = String(button.dataset.workTaskId || ''); if (!movableTaskIds.has(taskId)) return; const card = button.closest('article'); if (!card || card.dataset.workDragReady) return; card.dataset.workDragReady = 'true'; card.draggable = true; card.classList.add('cursor-grab'); card.title = 'Drag to change status'; card.addEventListener('dragstart', (event) => { draggedTaskId = taskId; event.dataTransfer?.setData('text/plain', taskId); card.classList.add('opacity-50'); }); card.addEventListener('dragend', () => { draggedTaskId = ''; card.classList.remove('opacity-50'); }); });
      const dialog = shell.querySelector('#workTaskDialog'); const body = dialog?.querySelector('[data-work-task-body]'); shell.querySelectorAll('[data-work-task-id]').forEach((button) => button.addEventListener('click', async () => { if (!dialog || !body) return; body.textContent = 'Loading…'; dialog.showModal(); try { const response = await fetch(`/tasks/${button.dataset.workTaskId}`); if (!response.ok) throw new Error('Task is unavailable'); const task = await response.json(); const details = document.createElement('div'); details.className = 'space-y-3 text-sm text-gray-700'; [['Title', task.task.title], ['Status', String(task.task.status || '').replaceAll('_', ' ')], ['Responsible', task.owner_name || task.owner_email || 'Unassigned'], ['Due', task.task.due_at ? String(task.task.due_at).slice(0, 10) : '—'], ['Description', task.task.description || 'No description.']].forEach(([label, value]) => { const row = document.createElement('p'); row.textContent = `${label}: ${value}`; details.append(row); }); body.replaceChildren(details); } catch (error) { body.textContent = error instanceof Error ? error.message : 'Could not load task details.'; } })); dialog?.querySelector('[data-work-task-close]')?.addEventListener('click', () => dialog.close());
    };
    init();
  })();
</script>
<%- include('partials/foot', { uiKit: true }) %>
