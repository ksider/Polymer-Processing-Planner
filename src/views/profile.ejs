<%- include('partials/head', { title: title, uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<main class="min-h-[calc(100vh-4rem)] bg-gray-50"><div class="w-full max-w-none space-y-4 px-3 py-3 sm:px-4 lg:px-5">
  <section class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
      <div class="flex min-w-0 items-center gap-3">
        <img class="size-16 shrink-0 rounded-full border border-default-medium bg-neutral-secondary object-cover" data-profile-hero-avatar src="<%= avatarUrl(currentUser?.id) %>" alt="<%= currentUser?.name || currentUser?.email || 'User' %> avatar">
        <div>
        <p class="text-xs font-medium text-brand">Personal workspace</p>
        <h1 class="mt-0.5 text-xl font-semibold tracking-tight text-heading" id="profileName">
          <%= currentUser?.name || currentUser?.email || 'Profile' %>
        </h1>
        <div class="mt-1 text-sm text-body" id="profileMeta">
          <%= (currentUser?.role || 'user') %> · <%= currentUser?.email || '-' %>
        </div>
        </div>
      </div>
      <button class="inline-flex size-10 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary" type="button" id="openProfileDialog" title="Edit profile">
        <span class="material-symbols-rounded">edit</span>
      </button>
  </section>

  <dialog class="m-auto w-[min(96vw,58rem)] rounded-xl border border-default-medium bg-neutral-primary p-0 text-heading shadow-2xl backdrop:bg-black/40" id="profileDialog">
    <div class="flex items-center justify-between gap-4 border-b border-default px-5 py-4">
      <strong>Profile settings</strong>
      <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary" type="button" data-close title="Close">
        <span class="material-symbols-rounded">close</span>
      </button>
    </div>
    <div class="grid gap-5 p-5">
      <% if (error) { %>
        <div class="rounded-base border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert"><%= error %></div>
      <% } %>
      <% if (notice) { %>
        <div class="rounded-base border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800" role="status"><%= notice %></div>
      <% } %>
      <form class="grid gap-2" action="/me/name" method="post">
        <%- include('partials/csrf_token') %>
        <label for="name">Name</label>
        <input class="w-full rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" id="name" name="name" type="text" value="<%= currentUser?.name ?? '' %>" placeholder="Your name">
        <button class="inline-flex w-fit items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="submit">Update name</button>
      </form>
      <section class="rounded-xl border border-default-medium bg-neutral-secondary p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <strong>Avatar Generator</strong>
          <span class="text-sm text-body">Changes apply automatically.</span>
        </div>
        <form class="mt-4 grid gap-4" action="/me/avatar-style" method="post" data-avatar-style-form>
          <%- include('partials/csrf_token') %>
          <div class="flex items-center gap-3">
            <img class="size-24 rounded-full border border-default-medium bg-neutral-primary object-cover" id="profileAvatarPreview" src="<%= avatarUrl(currentUser?.id) %>" alt="Avatar preview">
            <div class="text-sm text-body" id="profileAvatarStatus">Changes apply automatically.</div>
          </div>
          <input type="hidden" name="palette" value="<%= currentAvatarStyle?.palette || 'amber' %>">
          <input type="hidden" name="presentation" value="<%= currentAvatarStyle?.presentation || 'neutral' %>">
          <input type="hidden" name="skin_tone" value="<%= currentAvatarStyle?.skinTone || 'warm' %>">
          <input type="hidden" name="hair" value="<%= currentAvatarStyle?.hair || 'short' %>">
          <input type="hidden" name="accessory" value="<%= currentAvatarStyle?.accessory || 'none' %>">
          <input type="hidden" name="facial_hair" value="<%= currentAvatarStyle?.facialHair || 'none' %>">
          <input type="hidden" name="eyes" value="<%= currentAvatarStyle?.eyes || 'calm' %>">
          <input type="hidden" name="mouth" value="<%= currentAvatarStyle?.mouth || 'default' %>">

          <div class="grid gap-3 md:grid-cols-2">
            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Presentation</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="presentation">
                <% (avatarStyleOptions?.presentation || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.presentation === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="presentation"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'feminine' ? 'face_4' : (item === 'masculine' ? 'face_6' : 'face') %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Skin Tone</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="skin_tone">
                <% (avatarStyleOptions?.skinTone || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.skinTone === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="skin_tone"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="profile-avatar-swatch skin-<%= item %>"></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Palette</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="palette">
                <% (avatarStyleOptions?.palette || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.palette === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="palette"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="profile-avatar-swatch palette-<%= item %>"></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Hair</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="hair">
                <% (avatarStyleOptions?.hair || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.hair === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="hair"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'spiky' ? 'air' : (item === 'round' ? 'face_3' : 'face') %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Accessory</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="accessory">
                <% (avatarStyleOptions?.accessory || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.accessory === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="accessory"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'glasses' ? 'glasses' : 'visibility' %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Facial Hair</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="facial_hair">
                <% (avatarStyleOptions?.facialHair || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.facialHair === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="facial_hair"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'mustache' ? 'mood' : 'do_not_disturb_on' %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Eyes</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="eyes">
                <% (avatarStyleOptions?.eyes || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.eyes === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="eyes"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'wink' ? 'waving_hand' : (item === 'happy' ? 'sentiment_satisfied' : 'visibility') %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>

            <section class="rounded-base border border-default-medium bg-neutral-primary p-3">
              <div class="text-sm font-medium text-heading">Mouth</div>
              <div class="mt-2 flex flex-wrap gap-2" data-avatar-group="mouth">
                <% (avatarStyleOptions?.mouth || []).forEach((item) => { %>
                  <button
                    class="profile-avatar-chip inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading hover:bg-neutral-tertiary <%= currentAvatarStyle?.mouth === item ? 'is-active' : '' %>"
                    type="button"
                    data-avatar-option
                    data-field="mouth"
                    data-value="<%= item %>"
                    title="<%= item %>"
                  >
                    <span class="material-symbols-rounded"><%= item === 'twinkle' ? 'mood' : (item === 'smile' ? 'sentiment_satisfied' : 'horizontal_rule') %></span>
                    <span><%= item %></span>
                  </button>
                <% }) %>
              </div>
            </section>
          </div>
        </form>
      </section>
      <form class="grid gap-2 border-t border-default pt-5" action="/me/password" method="post">
        <%- include('partials/csrf_token') %>
        <label for="current_password">Current password</label>
        <input class="w-full rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" id="current_password" name="current_password" type="password" autocomplete="current-password" required>
        <label for="new_password">New password</label>
        <input class="w-full rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" id="new_password" name="new_password" type="password" autocomplete="new-password" required>
        <label for="confirm_password">Confirm password</label>
        <input class="w-full rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
        <button class="inline-flex w-fit items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="submit">Update password</button>
      </form>
    </div>
  </dialog>

  <section class="grid gap-4 xl:grid-cols-3" aria-label="My work">
    <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs xl:col-span-2" aria-labelledby="myTasksTitle">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-heading" id="myTasksTitle">My Tasks</h2>
          <p class="mt-1 text-sm text-body">Your current work and completion progress.</p>
        </div>
        <button class="inline-flex items-center justify-center gap-2 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary" type="button" id="openProfileCalendar">
          <span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
          Calendar
        </button>
      </div>
      <div class="mt-4 grid gap-3">
        <% if (!tasks || tasks.length === 0) { %>
          <p class="rounded-base border border-dashed border-default-medium bg-neutral-secondary px-3 py-4 text-sm text-body">No tasks assigned.</p>
        <% } %>
        <% tasks.forEach((task) => { %>
          <% const taskStatusTone = task.status === 'done' ? 'border-s-emerald-500 bg-emerald-50/60' : (task.status === 'in_progress' ? 'border-s-amber-500 bg-amber-50/70' : (task.status === 'failed' ? 'border-s-red-500 bg-red-50/70' : 'border-s-slate-400 bg-slate-50')); %>
          <% const taskStatusBadge = task.status === 'done' ? 'bg-emerald-100 text-emerald-800' : (task.status === 'in_progress' ? 'bg-amber-100 text-amber-800' : (task.status === 'failed' ? 'bg-red-100 text-red-800' : 'bg-slate-200 text-slate-700')); %>
          <% const taskStatusLabel = task.status === 'in_progress' ? 'In progress' : (task.status === 'init' ? 'New' : task.status); %>
          <% const dueDate = task.due_at ? new Date(task.due_at) : null; %>
          <% const dueTime = dueDate && !Number.isNaN(dueDate.getTime()) ? dueDate.getTime() : null; %>
          <% const isOverdue = dueTime !== null && task.status !== 'done' && dueTime < Date.now() - 86400000; %>
          <% const isUrgent = dueTime !== null && task.status !== 'done' && !isOverdue && dueTime < Date.now() + 2 * 86400000; %>
          <% const dueTone = isOverdue ? 'bg-red-100 text-red-800' : (isUrgent ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'); %>
          <% const taskPath = `${experimentPath({ id: task.experiment_id, process_route_code: task.process_route_code, process_type_code: task.process_type_code })}?task_id=${task.task_id}#tasks`; %>
          <a class="group grid gap-3 rounded-base border border-default-medium border-s-4 <%= taskStatusTone %> p-3 text-inherit no-underline shadow-xs transition hover:-translate-y-0.5 hover:shadow-sm sm:grid-cols-[minmax(0,1fr)_auto]" href="<%= taskPath %>" aria-label="Open task <%= task.title %>">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <strong class="truncate text-sm text-heading group-hover:text-brand"><%- formatInline(task.title) %></strong>
                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= taskStatusBadge %>"><%= taskStatusLabel %></span>
              </div>
              <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-body">
                <span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-[16px] text-violet-600" aria-hidden="true">account_tree</span><%= task.process_name || 'Process not set' %></span>
                <span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-[16px] text-blue-600" aria-hidden="true">science</span><%- formatInline(task.experiment_name) %></span>
              </div>
            </div>
            <div class="flex items-center gap-2 sm:flex-col sm:items-end">
              <% if (dueDate) { %><span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium <%= dueTone %>"><span class="material-symbols-rounded text-[15px]" aria-hidden="true">event</span><%= isOverdue ? 'Overdue · ' : (isUrgent ? 'Due soon · ' : '') %><%= dueDate.toLocaleDateString() %></span><% } else { %><span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-600">No deadline</span><% } %>
              <span class="text-xs font-medium text-brand"><%= typeof task.progress_percent === 'number' ? `${task.progress_percent}% complete` : 'Open task' %> <span aria-hidden="true">→</span></span>
            </div>
            <span class="h-1 overflow-hidden rounded-full bg-white/80 sm:col-span-2"><span class="block h-full rounded-full <%= task.status === 'done' ? 'bg-emerald-500' : (task.status === 'failed' ? 'bg-red-500' : 'bg-brand') %>" style="width: <%= Math.max(0, Math.min(100, Number(task.progress_percent || 0))) %>%"></span></span>
          </a>
        <% }); %>
      </div>
    </section>

    <aside class="flex min-h-[18rem] flex-col rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs" aria-labelledby="profileNotificationsTitle">
      <div class="mb-3 flex items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-heading" id="profileNotificationsTitle">Notifications</h2>
          <p class="mt-1 text-sm text-body">The same operational messages as in Messenger.</p>
        </div>
        <a class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary" href="/messages" title="Open Messenger"><span class="material-symbols-rounded">open_in_new</span></a>
      </div>
      <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto">
        <% if (!notifications || notifications.length === 0) { %>
          <p class="text-sm text-body">No technical notifications yet.</p>
        <% } %>
        <% notifications.forEach((note) => { %>
          <% const noteTone = note.kind === 'assignment' ? 'border-s-violet-500 bg-violet-50/60' : (note.kind === 'task' ? 'border-s-amber-500 bg-amber-50/70' : 'border-s-blue-500 bg-blue-50/60'); %>
          <% const noteIcon = note.kind === 'assignment' ? 'person_add' : (note.kind === 'task' ? 'assignment' : 'info'); %>
          <% const noteIconTone = note.kind === 'assignment' ? 'bg-violet-100 text-violet-700' : (note.kind === 'task' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'); %>
          <a class="rounded-base border border-default-medium border-s-4 <%= noteTone %> p-3 text-inherit no-underline shadow-xs transition hover:-translate-y-0.5 hover:shadow-sm" href="/messages/<%= note.id %>/open">
            <div class="flex items-start gap-2 text-sm">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full <%= noteIconTone %>"><span class="material-symbols-rounded text-[16px]" aria-hidden="true"><%= noteIcon %></span></span>
              <strong class="min-w-0 flex-1"><%- formatInline(note.subject || 'Notification') %></strong>
              <% if (note.status === 'unread') { %><span class="rounded-full bg-brand-soft px-2 py-0.5 text-xs font-medium text-brand">new</span><% } %>
            </div>
            <% if (note.body) { %><div class="mt-2 text-sm text-body"><%- formatInline(note.body) %></div><% } %>
            <div class="mt-2 text-xs text-body"><%= new Date(note.message_created_at || note.created_at).toLocaleString() %></div>
          </a>
        <% }); %>
      </div>
    </aside>
  </section>

  <dialog class="m-auto w-[min(96vw,72rem)] rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/40" id="profileCalendarDialog">
    <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-4 sm:px-6">
      <div><p class="text-sm font-medium text-blue-700">Schedule</p><h2 class="mt-0.5 text-lg font-semibold tracking-tight" id="profileCalendarTitle">My calendar</h2><p class="mt-1 text-sm text-gray-500">Tasks and runs assigned to you.</p></div>
      <button class="inline-flex size-9 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-900" type="button" data-profile-calendar-close aria-label="Close calendar" title="Close calendar"><span class="material-symbols-rounded" aria-hidden="true">close</span></button>
    </div>
    <div class="p-4 sm:p-6">
      <div class="mb-4 flex flex-nowrap items-center gap-2 overflow-x-auto pb-1 calendar-tools">
        <span id="calendarSelectionCount" class="shrink-0 rounded-full bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700">Selected: 0</span>
        <button class="inline-flex shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" type="button" id="calendarClearSelection">Clear</button>
        <input class="w-40 shrink-0 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-600 focus:ring-blue-600" type="date" id="calendarBatchDate">
        <button class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-800" type="button" id="calendarBatchMove"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">drive_file_move</span>Move selected</button>
      </div>
      <div class="profile-calendar rounded-xl border border-gray-200 bg-white p-3 shadow-sm sm:p-4"><div id="myCalendar" class="calendar-host min-h-96"></div></div>
      <div class="mt-4 flex flex-wrap gap-3 text-xs text-gray-500"><span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-blue-500"></i>Task</span><span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-violet-500"></i>Run</span><span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-amber-500"></i>Selection</span></div>
    </div>
  </dialog>

  <dialog class="m-auto w-[min(96vw,34rem)] rounded-xl border border-default-medium bg-neutral-primary p-0 text-heading shadow-2xl backdrop:bg-black/40" id="calendarEventDialog">
    <div class="flex items-center justify-between gap-4 border-b border-default px-5 py-4">
      <strong id="calendarEventTitle">Calendar event</strong>
      <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary" type="button" data-close title="Close">
        <span class="material-symbols-rounded">close</span>
      </button>
    </div>
    <div class="grid gap-2 p-5 text-sm text-body">
      <div><strong>Type:</strong> <span id="calendarEventType">-</span></div>
      <div><strong>Status:</strong> <span id="calendarEventStatus">-</span></div>
      <div><strong>Due:</strong> <span id="calendarEventDue">-</span></div>
      <div><strong>Responsible:</strong> <span id="calendarEventOwner">-</span></div>
      <div><strong>Entity:</strong> <span id="calendarEventEntity">-</span></div>
      <div><strong>Process:</strong> <span id="calendarEventProcess">-</span></div>
      <div class="mt-3 flex flex-wrap gap-2">
        <a class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white no-underline shadow-xs hover:bg-brand-strong" id="calendarEventDetailLink" href="#">Open run/task</a>
        <a class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" id="calendarEventEntityLink" href="#">Open entity</a>
      </div>
    </div>
  </dialog>

  <section class="grid gap-4 lg:grid-cols-2" aria-label="Quick access">
    <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
      <h2 class="text-sm font-semibold text-heading">Assigned Entities</h2>
      <div class="mt-3 grid gap-3">
        <% if (!assignedEntities || assignedEntities.length === 0) { %><p class="text-sm text-body">No entity assignments.</p><% } %>
        <% assignedEntities.forEach((item) => { %>
          <% const entityTone = item.entity_type === 'qualification_step' ? 'border-s-blue-600 bg-blue-50/60' : (item.entity_type === 'report' ? 'border-s-violet-600 bg-violet-50/60' : 'border-s-amber-600 bg-amber-50/60'); %>
          <% const entityLabelTone = item.entity_type === 'qualification_step' ? 'text-blue-700' : (item.entity_type === 'report' ? 'text-violet-700' : 'text-amber-700'); %>
          <a class="grid gap-1 rounded-base border border-default-medium border-s-4 <%= entityTone %> p-3 text-inherit no-underline shadow-xs hover:bg-neutral-secondary" href="<%= item.entityPath %>">
            <span class="text-xs font-semibold uppercase tracking-wide <%= entityLabelTone %>"><%= item.entity_type === 'qualification_step' ? 'Qualification' : (item.entity_type === 'report' ? 'Report' : 'DOE') %></span>
            <strong><%- formatInline(item.entityTitle) %></strong>
            <span class="text-xs text-body"><%- formatInline(item.experiment_name) %></span>
          </a>
        <% }); %>
      </div>
    </section>
    <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
      <h2 class="text-sm font-semibold text-heading">My Experiments</h2>
      <div class="mt-3 grid gap-3">
        <% if (!experiments || experiments.length === 0) { %><p class="text-sm text-body">No experiments assigned.</p><% } %>
        <% experiments.forEach((exp) => { %>
          <% const processTone = exp.process_type_code === 'extrusion' ? 'bg-emerald-100 text-emerald-800' : (exp.process_type_code === 'injection' ? 'bg-blue-100 text-blue-800' : 'bg-violet-100 text-violet-800'); %>
          <% const experimentStatusTone = exp.status === 'done' ? 'bg-emerald-100 text-emerald-800' : (exp.status === 'in_progress' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700'); %>
          <a class="group grid gap-2 rounded-base border border-default-medium border-s-4 border-s-violet-500 bg-neutral-primary p-3 text-inherit no-underline shadow-xs transition hover:-translate-y-0.5 hover:shadow-sm" href="<%= experimentPath(exp) %>">
            <div class="flex flex-wrap items-center justify-between gap-2"><span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= processTone %>"><span class="material-symbols-rounded text-[15px]" aria-hidden="true">account_tree</span><%= exp.process_name || 'Process not set' %></span><span class="text-xs text-body">#<%= exp.id %></span></div>
            <strong class="group-hover:text-brand"><%- formatInline(exp.name) %></strong>
            <div class="flex flex-wrap items-center justify-between gap-2"><span class="text-xs text-body"><%= new Date(exp.created_at).toLocaleDateString() %></span><span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= experimentStatusTone %>"><%= exp.statusLabel %></span></div>
          </a>
        <% }); %>
      </div>
    </section>
  </section>

  <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs" aria-labelledby="aiUsageTitle">
    <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 class="text-sm font-semibold text-heading" id="aiUsageTitle">My AI usage</h2><p class="mt-1 text-sm text-body">Tokens used by your Planner AI requests.</p></div><span class="material-symbols-rounded text-brand" aria-hidden="true">auto_awesome</span></div>
    <nav class="mt-4 flex flex-wrap gap-2" data-ai-usage-periods aria-label="AI usage period"><% [['7d', '7 days'], ['30d', '30 days'], ['90d', '90 days'], ['all', 'All time']].forEach(([key, label]) => { %><a class="rounded-full border px-3 py-1.5 text-xs font-medium no-underline <%= aiUsagePeriod?.key === key ? 'border-brand bg-brand text-white' : 'border-default-medium bg-neutral-secondary text-heading hover:bg-neutral-tertiary' %>" href="/me?ai_usage_period=<%= key %>#aiUsageTitle" <%= aiUsagePeriod?.key === key ? 'aria-current="page"' : '' %>><%= label %></a><% }) %></nav>
    <p class="mt-3 text-xs text-body"><%= aiUsagePeriod?.label || 'All time' %></p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="AI token totals"><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><span class="text-xs text-body">Input</span><strong class="mt-1 block text-lg text-heading"><%= Number(llmUsageTotals?.inputTokens || 0).toLocaleString() %></strong></div><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><span class="text-xs text-body">Output</span><strong class="mt-1 block text-lg text-heading"><%= Number(llmUsageTotals?.outputTokens || 0).toLocaleString() %></strong></div><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><span class="text-xs text-body">Total</span><strong class="mt-1 block text-lg text-heading"><%= Number(llmUsageTotals?.totalTokens || 0).toLocaleString() %></strong></div><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><span class="text-xs text-body">Requests</span><strong class="mt-1 block text-lg text-heading"><%= Number(llmUsageTotals?.requestCount || 0).toLocaleString() %></strong></div></div>
    <% if (llmUsageBreakdown && llmUsageBreakdown.length) { %><div class="mt-4 overflow-x-auto"><table class="min-w-full text-left text-sm text-body"><thead class="border-b border-default text-xs uppercase"><tr><th class="px-3 py-2">Provider</th><th class="px-3 py-2">Model</th><th class="px-3 py-2">Input</th><th class="px-3 py-2">Output</th><th class="px-3 py-2">Total</th><th class="px-3 py-2">Requests</th></tr></thead><tbody class="divide-y divide-default"><% llmUsageBreakdown.forEach((item) => { %><tr><td class="px-3 py-2"><%= item.providerName %></td><td class="px-3 py-2"><code><%= item.model %></code></td><td class="px-3 py-2"><%= Number(item.inputTokens).toLocaleString() %></td><td class="px-3 py-2"><%= Number(item.outputTokens).toLocaleString() %></td><td class="px-3 py-2 font-medium text-heading"><%= Number(item.totalTokens).toLocaleString() %></td><td class="px-3 py-2"><%= item.requestCount %><% if (item.failedRequestCount) { %><small> · <%= item.failedRequestCount %> failed</small><% } %></td></tr><% }) %></tbody></table></div><% } else { %><p class="mt-4 text-sm text-body">No AI requests have been made from this account yet.</p><% } %>
  </section>
</div></main>
<%- include('partials/foot', { uiKit: true }) %>
<script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script nonce="<%= cspNonce %>">
  let profileCalendar = null;
  const renderUserCalendar = () => {
    if (profileCalendar) {
      profileCalendar.updateSize();
      return profileCalendar;
    }
    const host = document.getElementById('myCalendar');
    if (!host || !window.FullCalendar) return;
    host.addEventListener('selectstart', (event) => {
      event.preventDefault();
    });
    host.addEventListener('mousedown', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
      event.preventDefault();
    });
    const selectedCountEl = document.getElementById('calendarSelectionCount');
    const clearSelectionBtn = document.getElementById('calendarClearSelection');
    const batchDateInput = document.getElementById('calendarBatchDate');
    const batchMoveBtn = document.getElementById('calendarBatchMove');
    const eventDialog = document.getElementById('calendarEventDialog');
    const eventTitle = document.getElementById('calendarEventTitle');
    const eventType = document.getElementById('calendarEventType');
    const eventStatus = document.getElementById('calendarEventStatus');
    const eventDue = document.getElementById('calendarEventDue');
    const eventOwner = document.getElementById('calendarEventOwner');
    const eventEntity = document.getElementById('calendarEventEntity');
    const eventProcess = document.getElementById('calendarEventProcess');
    const eventDetailLink = document.getElementById('calendarEventDetailLink');
    const eventEntityLink = document.getElementById('calendarEventEntityLink');
    const selectedEventIds = new Set();
    const eventElementMap = new Map();
    let lassoEl = null;
    let lassoActive = false;
    let lassoMoved = false;
    let lassoStartX = 0;
    let lassoStartY = 0;
    let lassoBaseSelection = new Set();

    const toDateOnly = (date) => {
      if (!(date instanceof Date) || Number.isNaN(date.getTime())) return '';
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, '0');
      const d = String(date.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    };
    const addDays = (date, days) => {
      if (!(date instanceof Date) || Number.isNaN(date.getTime())) return null;
      const next = new Date(date.getTime());
      next.setDate(next.getDate() + days);
      return next;
    };
    const updateSelectionCount = () => {
      if (selectedCountEl) selectedCountEl.textContent = `Selected: ${selectedEventIds.size}`;
    };
    const refreshSelectionUi = (calendar) => {
      const availableIds = new Set(eventElementMap.keys());
      Array.from(selectedEventIds.values()).forEach((id) => {
        if (!availableIds.has(String(id))) selectedEventIds.delete(id);
      });
      updateSelectionCount();
      applySelectionToEvents();
    };
    const intersectsRect = (a, b) => {
      return !(a.right < b.left || a.left > b.right || a.bottom < b.top || a.top > b.bottom);
    };
    const applySelectionToEvents = () => {
      const applySelectedStyle = (node, selected) => {
        if (!(node instanceof HTMLElement)) return;
        if (selected) {
          node.style.borderColor = '#d32f2f';
          node.style.boxShadow = '';
          node.style.outline = '';
          node.style.outlineOffset = '';
          node.style.transform = '';
          node.style.zIndex = '';
          node.style.filter = '';
        } else {
          node.style.borderColor = '';
          node.style.boxShadow = '';
          node.style.outline = '';
          node.style.outlineOffset = '';
          node.style.transform = '';
          node.style.zIndex = '';
          node.style.filter = '';
        }
      };
      eventElementMap.forEach((elements, eventId) => {
        const isSelected = selectedEventIds.has(eventId);
        elements.forEach((el) => {
          el.classList.toggle('calendar-event-selected', isSelected);
          const innerEvent = el.matches('.fc-event') ? el : el.querySelector('.fc-event');
          if (innerEvent) innerEvent.classList.toggle('calendar-event-selected', isSelected);
          applySelectedStyle(el, isSelected);
          applySelectedStyle(innerEvent, isSelected);
        });
      });
    };
    const clearSelection = (calendar) => {
      selectedEventIds.clear();
      refreshSelectionUi(calendar);
    };
    const patchMove = async (eventId, day) => {
      const resp = await fetch(`/calendar/events/${encodeURIComponent(eventId)}/move`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ starts_at: day })
      });
      if (!resp.ok) throw new Error('move failed');
    };
    const openEventDetails = (event) => {
      if (!eventDialog) return;
      const props = event.extendedProps || {};
      if (eventTitle) eventTitle.textContent = event.title || 'Calendar event';
      if (eventType) eventType.textContent = props.kindLabel || '-';
      if (eventStatus) eventStatus.textContent = props.status || '-';
      if (eventDue) eventDue.textContent = event.start ? new Date(event.start).toLocaleDateString() : '-';
      if (eventOwner) eventOwner.textContent = props.ownerLabel || '-';
      if (eventEntity) eventEntity.textContent = props.entityLabel || '-';
      if (eventProcess) eventProcess.textContent = props.processName || '-';
      if (eventDetailLink) eventDetailLink.href = props.detailUrl || event.url || '#';
      if (eventEntityLink) eventEntityLink.href = props.entityUrl || '#';
      if (typeof eventDialog.showModal === 'function') eventDialog.showModal();
    };
    const clearLasso = () => {
      if (lassoEl && lassoEl.parentNode) lassoEl.parentNode.removeChild(lassoEl);
      lassoEl = null;
      lassoActive = false;
      lassoMoved = false;
    };
    const updateLassoSelection = (calendar, clientX, clientY) => {
      if (!lassoEl) return;
      const hostRect = host.getBoundingClientRect();
      const left = Math.min(lassoStartX, clientX);
      const top = Math.min(lassoStartY, clientY);
      const right = Math.max(lassoStartX, clientX);
      const bottom = Math.max(lassoStartY, clientY);
      const width = right - left;
      const height = bottom - top;
      lassoEl.style.left = `${left - hostRect.left}px`;
      lassoEl.style.top = `${top - hostRect.top}px`;
      lassoEl.style.width = `${width}px`;
      lassoEl.style.height = `${height}px`;
      if (width > 3 || height > 3) lassoMoved = true;

      const lassoRect = { left, top, right, bottom };
      const nextSelection = new Set(lassoBaseSelection);
      eventElementMap.forEach((elements, eventId) => {
        const hit = elements.some((el) => intersectsRect(el.getBoundingClientRect(), lassoRect));
        if (hit) nextSelection.add(eventId);
      });
      selectedEventIds.clear();
      nextSelection.forEach((id) => selectedEventIds.add(id));
      refreshSelectionUi(calendar);
    };
    const startLasso = (calendar, event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.fc-event')) return;
      if (target.closest('.fc-button')) return;
      if (target.closest('.calendar-tools')) return;
      if (event.button !== 0) return;

      const additive = Boolean(event.shiftKey || event.metaKey || event.ctrlKey);
      if (additive) lassoBaseSelection = new Set(selectedEventIds);
      else {
        lassoBaseSelection = new Set();
        selectedEventIds.clear();
        refreshSelectionUi(calendar);
      }

      lassoActive = true;
      lassoMoved = false;
      lassoStartX = event.clientX;
      lassoStartY = event.clientY;
      lassoEl = document.createElement('div');
      lassoEl.className = 'calendar-lasso';
      host.appendChild(lassoEl);
      updateLassoSelection(calendar, event.clientX, event.clientY);
      event.preventDefault();

      const onMove = (moveEvent) => {
        if (!lassoActive) return;
        updateLassoSelection(calendar, moveEvent.clientX, moveEvent.clientY);
      };
      const onUp = (upEvent) => {
        if (!lassoActive) return;
        updateLassoSelection(calendar, upEvent.clientX, upEvent.clientY);
        if (!lassoMoved && !additive) {
          selectedEventIds.clear();
          refreshSelectionUi(calendar);
        }
        clearLasso();
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
      };
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    };

    const decorateCalendarToolbar = () => {
      [
        ['.fc-prev-button', 'Previous month', '<svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4"/></svg>'],
        ['.fc-next-button', 'Next month', '<svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/></svg>']
      ].forEach(([selector, label, icon]) => {
        const button = host.querySelector(selector);
        if (!button) return;
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
        button.innerHTML = icon;
      });
    };

    const calendar = new window.FullCalendar.Calendar(host, {
      initialView: 'dayGridMonth',
      height: 'auto',
      firstDay: 1,
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      editable: true,
      eventDurationEditable: false,
      datesSet: () => window.requestAnimationFrame(decorateCalendarToolbar),
      eventsSet: () => {
        refreshSelectionUi(calendar);
      },
      eventDidMount: (arg) => {
        const eventId = String(arg.event.id);
        const eventKind = String(arg.event.extendedProps?.kind || '').replace(/[^a-z0-9_-]/gi, '');
        if (eventKind) arg.el.classList.add(`profile-calendar-event-${eventKind}`);
        const list = eventElementMap.get(eventId) || [];
        list.push(arg.el);
        eventElementMap.set(eventId, list);
        arg.el.classList.toggle('calendar-event-selected', selectedEventIds.has(eventId));
      },
      eventWillUnmount: (arg) => {
        const eventId = String(arg.event.id);
        const list = eventElementMap.get(eventId) || [];
        const next = list.filter((el) => el !== arg.el);
        if (next.length) eventElementMap.set(eventId, next);
        else eventElementMap.delete(eventId);
      },
      events: async (_fetchInfo, success, failure) => {
        try {
          const resp = await fetch('/calendar/events?scope=my');
          if (!resp.ok) throw new Error('Failed to load events');
          const data = await resp.json();
          success(Array.isArray(data?.events) ? data.events : []);
        } catch (err) {
          failure(err);
        }
      },
      eventDrop: async (info) => {
        const day = info.event.start ? toDateOnly(info.event.start) : '';
        const draggedId = String(info.event.id);
        const isBatchMove = selectedEventIds.size > 1 && selectedEventIds.has(draggedId);
        try {
          if (!isBatchMove) {
            await patchMove(info.event.id, day);
            return;
          }
          const oldDate = info.oldEvent?.start;
          const newDate = info.event?.start;
          if (!oldDate || !newDate) throw new Error('missing dates');
          const dayMs = 24 * 60 * 60 * 1000;
          const deltaDays = Math.round((newDate.getTime() - oldDate.getTime()) / dayMs);
          const selectedIds = Array.from(selectedEventIds.values()).sort((a, b) => {
            const aEvent = calendar.getEventById(a);
            const bEvent = calendar.getEventById(b);
            const aTime = aEvent?.start?.getTime() ?? 0;
            const bTime = bEvent?.start?.getTime() ?? 0;
            if (aTime !== bTime) return aTime - bTime;
            return String(a).localeCompare(String(b));
          });
          for (const eventId of selectedIds) {
            if (eventId === draggedId) {
              await patchMove(eventId, day);
              continue;
            }
            const event = calendar.getEventById(eventId);
            if (!event?.start) continue;
            const shifted = addDays(event.start, deltaDays);
            const shiftedDay = shifted ? toDateOnly(shifted) : '';
            if (!shiftedDay) continue;
            await patchMove(eventId, shiftedDay);
          }
          await calendar.refetchEvents();
          refreshSelectionUi(calendar);
          return;
        } catch (_err) {
          info.revert();
          await calendar.refetchEvents();
          window.alert('Failed to move date.');
        }
      },
      eventClick: (info) => {
        info.jsEvent.preventDefault();
        const toggleMode = Boolean(info.jsEvent?.shiftKey || info.jsEvent?.metaKey || info.jsEvent?.ctrlKey);
        if (toggleMode) {
          const eventId = String(info.event.id);
          if (selectedEventIds.has(eventId)) selectedEventIds.delete(eventId);
          else selectedEventIds.add(eventId);
          refreshSelectionUi(calendar);
          return;
        }
        openEventDetails(info.event);
      }
    });

    clearSelectionBtn?.addEventListener('click', () => clearSelection(calendar));
    batchMoveBtn?.addEventListener('click', async () => {
      const targetDate = String(batchDateInput?.value || '');
      const selectedIds = Array.from(selectedEventIds.values());
      if (!selectedIds.length) {
        window.alert('Select events first.');
        return;
      }
      if (!targetDate) {
        window.alert('Pick a target date.');
        return;
      }
      const anchor = calendar.getEventById(selectedIds[0]);
      if (!anchor?.start) return;
      const anchorDate = anchor.start;
      const targetBase = new Date(`${targetDate}T00:00:00`);
      const dayMs = 24 * 60 * 60 * 1000;
      const deltaDays = Math.round((targetBase.getTime() - anchorDate.getTime()) / dayMs);
      try {
        for (const eventId of selectedIds) {
          const event = calendar.getEventById(eventId);
          if (!event?.start) continue;
          const next = addDays(event.start, deltaDays);
          const nextDay = next ? toDateOnly(next) : '';
          if (!nextDay) continue;
          await patchMove(eventId, nextDay);
        }
        selectedEventIds.clear();
        await calendar.refetchEvents();
        refreshSelectionUi(calendar);
      } catch (_err) {
        await calendar.refetchEvents();
        window.alert('Failed to move selected events.');
      }
    });

    eventDialog?.querySelectorAll('[data-close]').forEach((btn) => {
      btn.addEventListener('click', () => eventDialog.close());
    });
    host.addEventListener('pointerdown', (event) => {
      startLasso(calendar, event);
    });

    document.addEventListener('mousedown', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (host.contains(target)) {
        if (!target.closest('.fc-event') && selectedEventIds.size > 0) {
          clearSelection(calendar);
        }
        return;
      }
      if (target.closest('.calendar-tools')) return;
      if (eventDialog && eventDialog.contains(target)) return;
      if (selectedEventIds.size === 0) return;
      clearSelection(calendar);
    });

    updateSelectionCount();
    calendar.render();
    decorateCalendarToolbar();
    profileCalendar = calendar;
    return calendar;
  };

  const profileDialog = document.getElementById('profileDialog');
  const openProfileDialog = document.getElementById('openProfileDialog');
  if (openProfileDialog && profileDialog) {
    openProfileDialog.addEventListener('click', () => profileDialog.showModal());
  }
  profileDialog?.querySelectorAll('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => profileDialog.close());
  });

  const nameInput = document.getElementById('name');
  const nameOutput = document.getElementById('profileName');
  const metaOutput = document.getElementById('profileMeta');
  const avatarStyleForm = document.querySelector('[data-avatar-style-form]');
  const avatarPreview = document.getElementById('profileAvatarPreview');
  const avatarStatus = document.getElementById('profileAvatarStatus');
  const navAvatar = document.querySelector('.nav-user-avatar');
  const emailValue = "<%= (currentUser?.email ?? '').replace(/\"/g, '&quot;') %>";
  const roleValue = "<%= (currentUser?.role ?? 'user').replace(/\"/g, '&quot;') %>";
  const syncProfile = () => {
    if (!nameInput || !nameOutput || !metaOutput) return;
    const nextName = nameInput.value.trim();
    nameOutput.textContent = nextName || emailValue || 'Profile';
    metaOutput.textContent = `${roleValue} · ${emailValue || '-'}`;
  };
  nameInput?.addEventListener('input', syncProfile);
  syncProfile();

  if (avatarStyleForm instanceof HTMLFormElement) {
    const hiddenField = (name) => avatarStyleForm.querySelector(`input[name="${name}"]`);
    const buildAvatarUrl = (forSave = false) => {
      const params = new URLSearchParams();
      ['palette', 'presentation', 'skin_tone', 'hair', 'accessory', 'facial_hair', 'eyes', 'mouth'].forEach((name) => {
        const input = hiddenField(name);
        if (input instanceof HTMLInputElement && input.value) params.set(name, input.value);
      });
      if (forSave) params.set('ts', String(Date.now()));
      return `${avatarStyleForm.dataset.avatarBaseUrl || '<%= avatarUrl(currentUser?.id) %>'}?${params.toString()}`;
    };
    let avatarTimer = null;
    const setActiveChip = (field, value) => {
      avatarStyleForm.querySelectorAll(`[data-field="${field}"]`).forEach((btn) => {
        btn.classList.toggle('is-active', btn.getAttribute('data-value') === value);
      });
    };
    const saveAvatar = async () => {
      const body = new URLSearchParams();
      ['palette', 'presentation', 'skin_tone', 'hair', 'accessory', 'facial_hair', 'eyes', 'mouth'].forEach((name) => {
        const input = hiddenField(name);
        if (input instanceof HTMLInputElement) body.set(name, input.value);
      });
      avatarStatus.textContent = 'Saving...';
      try {
        const csrfMeta = document.querySelector('meta[name="csrf-token"]');
        const csrfHeader = csrfMeta ? String(csrfMeta.getAttribute('content') || '') : '';
        const resp = await fetch('/me/avatar-style.json', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-CSRF-Token': csrfHeader
          },
          body: body.toString()
        });
        const data = await resp.json();
        if (!resp.ok || !data?.ok) throw new Error('save failed');
        const nextUrl = String(data.avatar_url || buildAvatarUrl(true));
        if (avatarPreview instanceof HTMLImageElement) avatarPreview.src = nextUrl;
        if (navAvatar instanceof HTMLImageElement) navAvatar.src = nextUrl;
        const heroAvatar = document.querySelector('[data-profile-hero-avatar]');
        if (heroAvatar instanceof HTMLImageElement) heroAvatar.src = nextUrl;
        avatarStatus.textContent = 'Saved';
        window.setTimeout(() => {
          if (avatarStatus.textContent === 'Saved') avatarStatus.textContent = 'Changes apply automatically.';
        }, 1200);
      } catch {
        avatarStatus.textContent = 'Failed to save';
      }
    };
    const scheduleAvatarSave = () => {
      if (avatarTimer) window.clearTimeout(avatarTimer);
      avatarTimer = window.setTimeout(saveAvatar, 180);
    };
    avatarStyleForm.querySelectorAll('[data-avatar-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.getAttribute('data-field');
        const value = btn.getAttribute('data-value');
        if (!field || !value) return;
        const input = hiddenField(field);
        if (!(input instanceof HTMLInputElement)) return;
        input.value = value;
        setActiveChip(field, value);
        if (avatarPreview instanceof HTMLImageElement) {
          avatarPreview.src = buildAvatarUrl(true);
        }
        avatarStatus.textContent = 'Updating...';
        scheduleAvatarSave();
      });
    });
  }

  if ("<%= error ? '1' : '' %>" || "<%= notice ? '1' : '' %>") {
    profileDialog?.showModal();
  }

  const profileCalendarDialog = document.getElementById('profileCalendarDialog');
  const openProfileCalendar = document.getElementById('openProfileCalendar');
  openProfileCalendar?.addEventListener('click', () => {
    if (typeof profileCalendarDialog?.showModal !== 'function') return;
    profileCalendarDialog.showModal();
    window.requestAnimationFrame(() => renderUserCalendar()?.updateSize());
  });
  profileCalendarDialog?.querySelectorAll('[data-profile-calendar-close]').forEach((button) => {
    button.addEventListener('click', () => profileCalendarDialog.close());
  });
</script>
