<%- include('partials/head', { title: 'Polymer Processing Planner | Machines', uiKit: true }) %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased"><div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row"><%- include('partials/admin_sidebar') %><main class="min-w-0 flex-1"><header class="border-b border-gray-200 bg-white"><div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"><div><p class="text-sm font-medium text-blue-700">Library</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900">Equipment</h1><p class="mt-1 text-sm text-gray-500">Injection machines available for experiments and qualification.</p></div><% if (canManageMachines) { %><a class="inline-flex items-center rounded-lg bg-blue-700 px-3.5 py-2.5 text-sm font-medium text-white no-underline hover:bg-blue-800" href="/machines/new"><span class="material-symbols-rounded me-2 text-[20px]" aria-hidden="true">add</span>Add machine</a><% } %></div></header><div class="px-4 py-6 sm:px-6 lg:px-8"><% if (!machines || machines.length === 0) { %><section class="rounded-lg border border-gray-200 bg-white px-5 py-14 text-center shadow-sm"><span class="material-symbols-rounded text-4xl text-gray-400" aria-hidden="true">precision_manufacturing</span><p class="mt-3 text-sm text-gray-500">No equipment has been added yet.</p></section><% } else { %><section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3"><% machines.forEach((machine) => { %><article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm"><div class="flex h-44 items-center justify-center bg-gray-100"><% if (machine.image_url) { %><img class="h-full w-full object-cover" src="<%= machine.image_url %>" alt="<%= machine.name %>"><% } else { %><span class="material-symbols-rounded text-5xl text-gray-400" aria-hidden="true">precision_manufacturing</span><% } %></div><div class="p-5"><h2 class="text-lg font-semibold text-gray-900"><%= machine.name %></h2><p class="mt-1 text-sm text-gray-500"><%= [machine.vendor, machine.model].filter(Boolean).join(' · ') || 'No vendor or model' %></p><dl class="mt-5 grid grid-cols-3 gap-3 border-t border-gray-100 pt-4 text-sm"><div><dt class="text-xs text-gray-500">Clamp</dt><dd class="mt-1 font-medium text-gray-900"><%= machine.clamp_force_kN ? `${machine.clamp_force_kN} kN` : '—' %></dd></div><div><dt class="text-xs text-gray-500">Pressure</dt><dd class="mt-1 font-medium text-gray-900"><%= machine.injection_pressure_bar ? `${machine.injection_pressure_bar} bar` : '—' %></dd></div><div><dt class="text-xs text-gray-500">Ratio</dt><dd class="mt-1 font-medium text-gray-900"><%= machine.intensification_ratio || '—' %></dd></div></dl><div class="mt-5 flex items-center justify-between"><a class="text-sm font-medium text-blue-700 no-underline hover:underline" href="/machines/<%= machine.id %>">Open card</a><% if (canManageMachines) { %><form action="/machines/<%= machine.id %>/delete" method="post" data-confirm="Delete this machine?"><button class="inline-flex size-9 items-center justify-center rounded-lg text-red-600 hover:bg-red-50" type="submit" aria-label="Delete machine"><span class="material-symbols-rounded" aria-hidden="true">delete</span></button></form><% } %></div></div></article><% }); %></section><% } %></div></main></div></div>
<%- include('partials/foot', { uiKit: true }) %>
