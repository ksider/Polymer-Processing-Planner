<%- include('partials/head', { title: 'Polymer Processing Planner | Processes', uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<main class="min-h-[calc(100vh-4rem)] bg-gray-50"><div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5">
  <section class="mb-4 rounded-xl border border-default-medium bg-neutral-primary px-4 py-3 shadow-xs">
    <h1 class="text-base font-semibold tracking-tight text-heading">Processes</h1>
    <p class="mt-0.5 text-xs text-body">Choose a process type to enter its experiment workspace.</p>
  </section>

  <section class="mb-4 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
    <h2 class="text-sm font-semibold text-heading">Available process types</h2>
    <% if (!processCards || processCards.length === 0) { %>
      <div class="small-note">No visible processes yet.</div>
    <% } %>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <% (processCards || []).forEach((process) => { %>
        <% const processDisplayName = String(process.name || '').replace(/\bDefault\b/gi, '').replace(/\s{2,}/g, ' ').trim(); %>
        <a class="group rounded-base border border-default-medium bg-neutral-primary p-4 text-inherit no-underline shadow-xs transition-colors hover:bg-neutral-secondary focus:outline-none focus:ring-4 focus:ring-brand-soft" href="<%= process.route_code ? `/${process.route_code}` : `/?process_id=${process.id}` %>">
          <div class="flex items-start justify-between gap-3"><div><h3 class="text-sm font-semibold text-heading"><%- formatInline(processDisplayName || process.name) %></h3><p class="mt-1 text-xs text-body">Owner: <%- formatInline(process.owner_label || 'Unassigned') %></p></div><span class="material-symbols-rounded text-body transition-transform group-hover:translate-x-0.5" aria-hidden="true">arrow_forward</span></div>
          <div class="mt-4 text-sm text-body">Experiments: <strong class="font-medium text-heading"><%= Number(process.experiment_count || 0) %></strong></div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-heading">Recent experiments</h2>
      <% if (selectedProcess) { %>
        <div class="flex items-center gap-3">
          <span class="text-xs text-body">Process: <%- formatInline(selectedProcess.name) %></span>
          <a class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="/">Show all</a>
        </div>
      <% } %>
    </div>
    <div class="mt-3 overflow-x-auto"><table class="min-w-full border-separate border-spacing-y-2 text-left text-sm text-body [&_thead_th]:whitespace-nowrap [&_thead_th]:px-3 [&_thead_th]:py-2 [&_thead_th]:text-xs [&_thead_th]:font-medium [&_thead_th]:uppercase [&_thead_th]:text-body [&_tbody_td]:border-y [&_tbody_td]:border-default-medium [&_tbody_td]:bg-neutral-primary [&_tbody_td]:px-3 [&_tbody_td]:py-2 [&_tbody_td:first-child]:rounded-s-base [&_tbody_td:first-child]:border-s [&_tbody_td:last-child]:rounded-e-base [&_tbody_td:last-child]:border-e">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Process</th>
          <th>Owner</th>
          <th>Status</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (experiments.length === 0) { %>
          <tr>
            <td colspan="7">No experiments yet.</td>
          </tr>
        <% } %>
        <% experiments.forEach((exp) => { %>
          <tr>
            <td><%= exp.id %></td>
            <td><a class="font-medium text-brand no-underline hover:underline" href="<%= experimentPath(exp) %>"><%- formatInline(exp.name) %></a></td>
            <td>
              <div><%- formatInline(exp.process_label) %></div>
              <div class="small-note"><%- formatInline(exp.process_type_label) %></div>
            </td>
            <td>
              <% if (exp.owner_user_id) { %>
                <a href="/users/<%= exp.owner_user_id %>"><%= exp.owner_label %></a>
              <% } else { %>
                <%= exp.owner_label %>
              <% } %>
            </td>
            <td><span class="inline-flex rounded-full bg-neutral-secondary px-2 py-0.5 text-xs font-medium text-heading"><%= exp.statusLabel %></span></td>
            <td><%= new Date(exp.created_at).toLocaleDateString() %></td>
            <td>
              <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager')) { %>
                <form action="/experiments/<%= exp.id %>/archive" method="post" data-confirm="Archive this experiment?">
                  <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary" type="submit">Archive</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  </section>
</div></main>
<%- include('partials/foot', { uiKit: true }) %>
