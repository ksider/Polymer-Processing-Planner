<%- include('../partials/head', { title: `DOE Analysis V2 | ${doe.name}` }) %>
<%- include('../partials/nav') %>
<%
  const displayCell = (value) => {
    if (value === null || typeof value === 'undefined') return '—';
    if (Array.isArray(value)) return value.length ? value.join(', ') : '[]';
    if (typeof value === 'boolean') return value ? 'Yes' : 'No';
    return String(value);
  };
  const completeness = overview.responseCompleteness === null
    ? '—'
    : `${Math.round(overview.responseCompleteness * 100)}%`;
  const analysisArchived = Boolean(selectedAnalysis?.archivedAt);
  const blocks = dataset.columns.filter((column) => column.role === 'block' && column.active && (column.dataType === 'category' || column.dataType === 'text'));
  const numericResponses = responses.filter((column) => column.dataType === 'number');
  const tagResponses = responses.filter((column) => column.dataType === 'tags');
  const graphNumbers = dataset.columns.filter((column) => column.active && column.dataType === 'number' && (column.role === 'factor' || column.role === 'response'));
  const graphGroups = dataset.columns.filter((column) => column.active && (column.dataType === 'category' || column.dataType === 'text'));
%>

<main class="container doe-analysis-page" data-analysis-workspace
  data-engine-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/engine"
  data-calculate-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/calculate"
  data-multi-optimize-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/multi-optimize"
  data-comparison-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/comparison"
  data-templates-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/templates"
  data-views-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/views"
  data-interpret-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/interpret"
  data-confirmation-run-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/confirmation-runs"
  data-analyses-url="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/analyses"
  data-run-base-url="/experiments/<%= experiment.id %>/runs"
  data-analysis-id="<%= selectedAnalysis?.id || '' %>"
  data-analysis-revision-id="<%= latestSuccessfulRevision?.id || '' %>"
  data-llm-enabled="<%= llmAssistantEnabled ? '1' : '0' %>"
  data-pending-job-id="<%= pendingCalculationJob?.id || '' %>"
  data-analysis-state="<%= selectedAnalysis?.state || 'draft' %>">
  <header class="card doe-analysis-header">
    <a class="back-link" href="/experiments/<%= experiment.id %>/doe/<%= doe.id %>?tab=design" aria-label="Back to DOE design">
      <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
    </a>
    <div class="doe-analysis-heading">
      <div class="doe-analysis-title-row">
        <h1 class="card-title"><%- formatInline(doe.name) %> · Analysis V2</h1>
        <span class="badge"><%= selectedAnalysis ? selectedAnalysis.state : 'Preview' %></span>
      </div>
      <p class="small-note"><%- formatInline(experiment.name) %> · <%= doe.designType %> · dataset <code><%= dataset.datasetRevision.slice(0, 12) %></code></p>
    </div>
    <div class="doe-analysis-header-tools">
      <div class="doe-analysis-switcher">
        <label>
          <span class="visually-hidden">Analysis</span>
          <select data-analysis-nav-select aria-label="Choose analysis">
            <option value="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2" <%= selectedAnalysis ? '' : 'selected' %>>Unsaved analysis · Draft</option>
            <% analyses.filter((analysis) => !analysis.archivedAt).forEach((analysis) => { %>
              <option value="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2?analysis_id=<%= analysis.id %>" <%= selectedAnalysis?.id === analysis.id ? 'selected' : '' %>><%= analysis.name %> · <%= analysis.state %></option>
            <% }); %>
            <% if (analyses.some((analysis) => analysis.archivedAt)) { %>
              <optgroup label="Archived analyses">
                <% analyses.filter((analysis) => analysis.archivedAt).forEach((analysis) => { %>
                  <option value="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2?analysis_id=<%= analysis.id %>" <%= selectedAnalysis?.id === analysis.id ? 'selected' : '' %>><%= analysis.name %> · archived</option>
                <% }); %>
              </optgroup>
            <% } %>
          </select>
        </label>
        <a class="icon-button" href="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2" title="New analysis" aria-label="New analysis">
          <span class="material-symbols-rounded" aria-hidden="true">add</span>
        </a>
      </div>
      <div class="doe-analysis-engine-row">
        <button class="doe-analysis-link" type="button" data-open-comparison hidden>Compare models</button>
        <button class="doe-analysis-link" type="button" data-open-saved-views hidden>Saved graphs</button>
        <button class="doe-analysis-link" type="button" data-open-templates hidden>Model templates</button>
        <div class="doe-analysis-engine" data-engine-status aria-live="polite">Checking engine…</div>
      </div>
    </div>
  </header>

  <div class="doe-analysis-layout">
    <section class="doe-analysis-canvas">
      <nav class="card doe-analysis-section-nav" aria-label="Analysis sections">
        <a href="#analysis-overview">Overview</a>
        <a href="#analysis-data">Data</a>
        <a href="#analysis-custom-graph" data-reveal-custom-graph>Custom graph</a>
        <a href="#analysis-results">Results</a>
      </nav>

      <section class="card" id="analysis-overview">
        <div class="doe-analysis-section-heading">
          <div>
            <h2 class="card-title">Overview</h2>
            <p class="small-note">What will enter the calculation before a model is fitted.</p>
          </div>
        </div>
        <div class="doe-analysis-metrics">
          <div><span>Total runs</span><strong><%= overview.totalRuns %></strong></div>
          <div><span>Complete</span><strong><%= overview.completeRuns %></strong></div>
          <div><span>Included now</span><strong><%= overview.includedRuns %></strong></div>
          <div><span>Excluded</span><strong><%= overview.excludedRuns %></strong></div>
          <div><span>Factors</span><strong><%= overview.factorCount %></strong></div>
          <div><span>Responses</span><strong><%= overview.responseCount %></strong></div>
          <div><span>Measurement completeness</span><strong><%= completeness %></strong></div>
        </div>

        <% if (dataset.responseAudit.hasConflicts || dataset.responseAudit.hasLegacyOnlyValues || dataset.warnings.length) { %>
          <div class="doe-analysis-notice" role="status">
            <strong>Data provenance needs attention</strong>
            <span>
              <%= dataset.responseAudit.counts.legacy_only %> legacy-only values,
              <%= dataset.responseAudit.counts.conflict %> conflicts,
              <%= dataset.responseAudit.counts.ambiguous_legacy %> ambiguous values.
            </span>
          </div>
        <% } %>
        <% if (overview.includesIncomplete) { %>
          <div class="doe-analysis-notice" role="status">
            <strong>Historical completion flags are missing</strong>
            <span>No usable run is marked complete, so “Include unfinished runs” is enabled explicitly for this draft. Review the worksheet before calculating.</span>
          </div>
        <% } %>

        <div class="doe-analysis-column-groups">
          <div>
            <h3>Factors</h3>
            <% if (!factors.length) { %><p class="small-note">No numeric factors.</p><% } %>
            <% factors.forEach((column) => { %>
              <div class="doe-analysis-column-item">
                <span><%- formatInline(column.label) %></span>
                <small><%= column.unit || 'no unit' %> · <%= column.factor?.coding || 'uncoded' %></small>
              </div>
            <% }); %>
          </div>
          <div>
            <h3>Measured responses</h3>
            <% if (!responses.length) { %><p class="small-note">No active numeric, boolean, or tags measured responses.</p><% } %>
            <% responses.forEach((column) => { %>
              <div class="doe-analysis-column-item">
                <span><%- formatInline(column.label) %></span>
                <small><%= column.unit || 'no unit' %> · <code><%= column.code %></code></small>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="card" id="analysis-custom-graph" data-custom-graph-card>
        <div class="doe-analysis-section-heading"><div><h2 class="card-title">Custom graph</h2><p class="small-note">Explore raw measurements or means with confidence intervals without changing the fitted DOE model.</p></div><button class="doe-analysis-link" type="button" data-toggle-custom-graph aria-expanded="false">Show graph</button></div>
        <div data-custom-graph-body hidden>
          <div class="doe-analysis-section-actions"><button class="doe-analysis-link" type="button" data-open-custom-graph>Configure graph</button></div>
          <div class="doe-analysis-chart" data-custom-graph-chart role="img" aria-label="Custom DOE graph"></div>
          <p class="small-note" data-custom-graph-note></p>
        </div>
      </section>

      <section class="card" id="analysis-data">
        <div class="doe-analysis-section-heading">
          <h2 class="card-title"><button class="doe-analysis-heading-toggle" type="button" data-toggle-data-worksheet aria-expanded="false" aria-controls="analysis-data-body"><span>Data worksheet</span><span class="material-symbols-rounded" aria-hidden="true">expand_more</span></button></h2>
          <div class="doe-analysis-section-actions">
            <button class="icon-button tiny" type="button" data-copy-table="#analysis-data .doe-analysis-data-table" data-copy-icon title="Copy table as TSV" aria-label="Copy table as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
            <a class="icon-button tiny" href="/experiments/<%= experiment.id %>/doe/<%= doe.id %>/analysis-v2/export.csv" title="Download analysis-ready CSV" aria-label="Download analysis-ready CSV"><span class="material-symbols-rounded" aria-hidden="true">download</span></a>
          </div>
        </div>
        <div id="analysis-data-body" data-data-worksheet-body hidden>
          <p class="small-note">One row per run. Raw values are shown; coded factor values remain available to the model.</p>
          <div class="doe-analysis-table-scroll" tabindex="0">
          <table class="pure-table pure-table-bordered table-compact doe-analysis-data-table">
            <thead>
              <tr>
                <% dataset.columns.forEach((column) => { %>
                  <th scope="col">
                    <span><%- formatInline(column.label) %></span>
                    <small><%= column.role %><%= column.unit ? ` · ${column.unit}` : '' %></small>
                  </th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% dataset.rows.forEach((row) => { %>
                <tr class="<%= row.excluded ? 'is-excluded' : !row.done ? 'is-incomplete' : '' %>" data-run-row data-run-id="<%= row.runId %>" data-run-code="<%= row.runCode %>" tabindex="0" aria-selected="false">
                  <% dataset.columns.forEach((column) => { %>
                    <td><%= displayCell(row.values[column.key]) %></td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
          </div>
        </div>
      </section>

      <section class="card" id="analysis-results" data-results-panel>
        <div class="doe-analysis-section-heading">
          <div>
            <h2 class="card-title">Calculation result <button class="doe-analysis-link" type="button" data-open-multi-optimize hidden>Optimize multiple responses</button></h2>
            <p class="small-note" data-result-meta></p>
          </div>
          <div class="doe-analysis-section-actions">
            <button class="icon-button doe-analysis-ai-trigger" type="button" data-open-ai-interpretation title="Interpret calculation with AI" aria-label="Interpret calculation with AI"><span class="material-symbols-rounded" aria-hidden="true">auto_awesome</span></button>
          </div>
        </div>
        <div class="doe-analysis-empty-result" data-results-empty>
          <span class="material-symbols-rounded" aria-hidden="true">query_stats</span>
          <strong>Waiting for the analytics engine</strong>
          <span>The default model will calculate automatically when a real R engine is connected.</span>
        </div>
        <div data-results-content hidden>
          <div class="doe-analysis-notice" data-result-warnings hidden></div>
          <section class="doe-analysis-optimizer" data-optimizer-result hidden>
            <div>
              <h3>Recommended settings</h3>
              <p class="small-note" data-optimizer-summary></p>
            </div>
            <div class="doe-analysis-optimizer-values" data-optimizer-values></div>
          </section>
          <section class="doe-analysis-optimizer" data-model-opportunities hidden>
            <div><h3>Model opportunities</h3><p class="small-note">Two model-based settings inside the studied factor range. Choose one only as a candidate for a confirmation run.</p></div>
            <div class="doe-analysis-optimizer-values" data-model-opportunity-values></div>
          </section>
          <div class="doe-analysis-notice doe-analysis-term-selection" data-term-selection hidden>
            <span data-selected-term-label></span>
            <button class="pure-button button-small" type="button" data-clear-selected-term>Clear selection</button>
          </div>
          <div class="doe-analysis-metrics" data-result-metrics></div>
          <p class="small-note doe-analysis-quality-note">R-squared describes the fitted runs. Adjusted R-squared penalizes unnecessary terms. Predicted R-squared estimates performance on a run left out of fitting and may be negative when prediction is poor.</p>
          <div class="doe-analysis-chart-grid">
            <section class="doe-analysis-chart-card">
              <h3>Effect strength</h3>
              <p class="small-note">Absolute t-value: estimated effect divided by its uncertainty. A longer bar means stronger statistical evidence; the intercept is omitted. Select a bar to link it to its ANOVA and coefficient rows.</p>
              <div class="doe-analysis-chart" data-effects-chart role="img" aria-label="Pareto chart of standardized effects"></div>
            </section>
            <section class="doe-analysis-chart-card">
              <h3>Prediction errors</h3>
              <p class="small-note">X is the model prediction. Y is measured response minus prediction. A random cloud around zero is desirable. Select a point to open its run.</p>
              <div class="doe-analysis-chart" data-residual-chart role="img" aria-label="Residuals versus fitted values"></div>
            </section>
            <section class="doe-analysis-chart-card" data-observed-predicted-card hidden>
              <h3>Observed vs predicted</h3>
              <p class="small-note">Points near the diagonal are predicted accurately. This gives fractional-factorial models a direct fit check alongside effect and residual plots.</p>
              <div class="doe-analysis-chart" data-observed-predicted-chart role="img" aria-label="Observed response versus predicted response"></div>
            </section>
            <section class="doe-analysis-chart-card" data-main-effects-card hidden>
              <h3>Main effects</h3>
              <p class="small-note">Model prediction while one factor changes and the others stay at their reference values.</p>
              <div class="doe-analysis-chart" data-main-effects-chart role="img" aria-label="Main effects plot"></div>
            </section>
            <section class="doe-analysis-chart-card" data-mean-factor-card hidden>
              <div class="doe-analysis-chart-heading">
                <h3 data-mean-factor-title>Mean response by factor</h3>
                <label>
                  <span class="visually-hidden">Factor for measured means</span>
                  <select data-mean-factor-select aria-label="Choose factor for measured means"></select>
                </label>
              </div>
              <p class="small-note">Observed mean at each physical factor setting. Whiskers show the selected confidence interval for the mean; no interval is shown when a setting has one measurement.</p>
              <div class="doe-analysis-chart" data-mean-factor-chart role="img" aria-label="Observed mean response by factor with confidence interval"></div>
            </section>
            <section class="doe-analysis-chart-card" data-interaction-card hidden>
              <div class="doe-analysis-chart-heading">
                <h3 data-interaction-title>Factor interaction</h3>
                <label>
                  <span class="visually-hidden">Factor pair</span>
                  <select data-interaction-pair aria-label="Choose factor pair"></select>
                </label>
              </div>
              <p class="small-note">Non-parallel lines indicate that one factor changes the effect of another.</p>
              <div class="doe-analysis-chart" data-interaction-chart role="img" aria-label="Factor interaction plot"></div>
            </section>
            <section class="doe-analysis-chart-card" data-qq-card hidden>
              <h3>Normal probability plot</h3>
              <p class="small-note">Residuals close to the diagonal are more consistent with a normal-error assumption.</p>
              <div class="doe-analysis-chart" data-qq-chart role="img" aria-label="Normal probability plot of standardized errors"></div>
            </section>
            <section class="doe-analysis-chart-card" data-run-order-card hidden>
              <h3>Prediction errors by run order</h3>
              <p class="small-note">Drift, cycles, or clusters can reveal time-related process changes.</p>
              <div class="doe-analysis-chart" data-run-order-chart role="img" aria-label="Prediction errors by run order"></div>
            </section>
            <section class="doe-analysis-chart-card doe-analysis-chart-wide" data-surface-card hidden>
              <div class="doe-analysis-chart-heading">
                <h3 data-surface-title>Response contour</h3>
                <label>
                  <span class="visually-hidden">Surface factor pair</span>
                  <select data-surface-pair aria-label="Choose response-surface factor pair"></select>
                </label>
                <label>
                  <span class="visually-hidden">Surface view</span>
                  <select data-surface-view aria-label="Choose surface view">
                    <option value="contour">Contour</option>
                    <option value="3d">3D surface</option>
                  </select>
                </label>
              </div>
              <p class="small-note">Color is the model prediction. Circles are measured runs and open the source run when selected. <span data-surface-held></span></p>
              <div class="doe-analysis-notice" data-surface-render-status hidden></div>
              <div class="doe-analysis-chart doe-analysis-contour-chart" data-surface-chart role="img" aria-label="Predicted response contour"></div>
            </section>
          </div>
          <div class="doe-analysis-result-grid">
            <section id="analysis-anova">
              <div class="doe-analysis-table-heading">
                <h3>ANOVA</h3>
                <button class="icon-button tiny" type="button" data-copy-table="#analysis-anova table" data-copy-icon title="Copy ANOVA table as TSV" aria-label="Copy ANOVA table as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
              </div>
              <p class="small-note" data-anova-note>Lack of fit compares model mismatch with repeat-to-repeat variation. A small p-value indicates that the selected model form may be inadequate. Pure error is variation between runs at identical factor settings.</p>
              <div class="doe-analysis-table-scroll">
                <table class="pure-table pure-table-bordered table-compact">
                  <thead><tr><th>Term</th><th>DF</th><th data-anova-sum-heading>SS</th><th>MS</th><th data-anova-stat-heading>F</th><th>p</th></tr></thead>
                  <tbody data-anova-body></tbody>
                </table>
              </div>
            </section>
            <section id="analysis-coefficients">
              <div class="doe-analysis-table-heading">
                <h3>Coefficients</h3>
                <button class="icon-button tiny" type="button" data-copy-table="#analysis-coefficients table" data-copy-icon title="Copy coefficients table as TSV" aria-label="Copy coefficients table as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
              </div>
              <p class="small-note" data-coefficients-note>Estimate is the fitted contribution of a term while the other selected terms are held in the model. Standard uncertainty measures its precision; t and p test whether that contribution is distinguishable from zero. The sign indicates direction.</p>
              <div class="doe-analysis-table-scroll">
                <table class="pure-table pure-table-bordered table-compact">
                  <thead><tr><th>Term</th><th>Estimate</th><th>Standard uncertainty</th><th data-coefficient-stat-heading>Signal / uncertainty (t)</th><th>p-value</th></tr></thead>
                  <tbody data-coefficients-body></tbody>
                </table>
              </div>
            </section>
          </div>
          <section id="analysis-diagnostics">
            <div class="doe-analysis-table-heading">
              <h3>Run diagnostics</h3>
              <button class="icon-button tiny" type="button" data-copy-table="#analysis-diagnostics table" data-copy-icon title="Copy diagnostics table as TSV" aria-label="Copy diagnostics table as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
            </div>
            <div class="doe-analysis-table-scroll">
              <table class="pure-table pure-table-bordered table-compact">
                <thead><tr><th>Run</th><th>Predicted response</th><th>Prediction error</th><th>Standardized error</th><th>Leverage</th><th>Cook's distance</th></tr></thead>
                <tbody data-diagnostics-body></tbody>
              </table>
            </div>
          </section>
        </div>
      </section>
      <dialog class="modal-frame doe-analysis-dialog" data-multi-optimize-dialog>
        <div class="modal-header"><h2>Optimize multiple responses</h2><button class="icon-button" type="button" data-close-multi-optimize aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
        <div class="modal-body"><p class="small-note">Only saved models using the same dataset snapshot, factor set, and block adjustment are available together.</p><form class="pure-form pure-form-stacked" data-multi-optimize-form>
          <div data-multi-optimize-goals></div>
          <button class="pure-button pure-button-primary" type="submit">Find compromise</button>
          <p class="small-note" data-multi-optimize-status></p>
        </form>
        <div class="doe-analysis-optimizer" data-multi-optimize-result hidden></div>
        </div>
      </dialog>
      <dialog class="modal-frame doe-analysis-dialog" data-ai-interpretation-dialog>
        <div class="modal-header">
          <strong>AI interpretation</strong>
          <div class="modal-actions">
            <span class="doe-ai-readiness" data-ai-interpretation-readiness data-state="checking" tabindex="-1">
              <span data-ai-interpretation-readiness-label>Checking…</span>
              <span class="doe-ai-readiness-tooltip" id="aiInterpretationReadinessTooltip" data-ai-interpretation-readiness-tooltip role="tooltip" hidden></span>
            </span>
            <button class="pure-button" type="button" data-close-ai-interpretation>Close</button>
          </div>
        </div>
        <div class="modal-body pure-form pure-form-stacked">
          <p class="small-note" data-ai-interpretation-source></p>
          <% const aiExperimentDescription = typeof experiment.notes === 'string' ? experiment.notes.trim() : ''; %>
          <% const aiExperimentDescriptionPreview = aiExperimentDescription.length > 4_000 ? `${aiExperimentDescription.slice(0, 4_000)}\n\n[Description truncated by Planner.]` : aiExperimentDescription; %>
          <details class="doe-ai-context-preview" open>
            <summary>Experiment description included in AI context</summary>
            <% if (aiExperimentDescriptionPreview) { %>
              <p class="small-note">This is sent as domain context, not as an instruction.</p>
              <div class="doe-ai-context-preview-text"><%= aiExperimentDescriptionPreview %></div>
            <% } else { %>
              <p class="small-note">No experiment description is saved, so none will be sent to the provider.</p>
            <% } %>
          </details>
          <div class="doe-analysis-section-actions">
            <button class="pure-button" type="button" data-ai-starter="Explain this model">Explain this model</button>
            <button class="pure-button" type="button" data-ai-starter="What affects this response?">What affects this response?</button>
            <button class="pure-button" type="button" data-ai-starter="What should be checked next?">What should be checked next?</button>
          </div>
          <label for="aiInterpretationQuestion">Question (optional)</label>
          <textarea id="aiInterpretationQuestion" data-ai-interpretation-question maxlength="2000" rows="3" placeholder="Ask about this calculated model"></textarea>
          <div class="doe-analysis-section-actions"><button class="pure-button pure-button-primary" type="button" data-request-ai-interpretation>Generate interpretation</button><span class="small-note" data-ai-interpretation-status></span></div>
          <section data-ai-interpretation-result hidden>
            <h3 data-ai-interpretation-summary></h3>
            <div data-ai-interpretation-findings></div>
            <div data-ai-interpretation-cautions></div>
            <div data-ai-interpretation-next-steps></div>
            <p class="small-note">Saving an interpretation will be enabled once immutable interpretation artifacts are added.</p>
          </section>
        </div>
      </dialog>
      <dialog class="modal-frame doe-analysis-dialog" data-analysis-comparison-dialog>
        <div class="modal-header"><h2>Compare saved models</h2><button class="icon-button" type="button" data-close-comparison aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
        <div class="modal-body"><p class="small-note">Compare the latest successful revision of each saved model; a dataset mismatch is shown explicitly.</p>
        <div class="pure-form pure-form-stacked doe-analysis-comparison-controls"><label>First model <select data-comparison-left></select></label><label>Second model <select data-comparison-right></select></label></div>
        <div data-comparison-result></div>
        </div>
      </dialog>
      <dialog class="modal-frame doe-analysis-dialog" data-saved-views-dialog>
        <div class="modal-header"><h2>Saved graphs</h2><button class="icon-button" type="button" data-close-saved-views aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
        <div class="modal-body">
          <form class="pure-form pure-form-stacked" data-save-view-form>
            <label for="savedViewName">Save current interaction, response-surface, or custom graph as</label>
            <div class="doe-analysis-view-save"><input id="savedViewName" name="name" maxlength="120" required placeholder="Graph name"><button class="pure-button pure-button-primary" type="submit">Save graph</button></div>
            <p class="small-note" data-save-view-status></p>
          </form>
          <div data-saved-views-list></div>
        </div>
      </dialog>
      <dialog class="modal-frame doe-analysis-dialog" data-custom-graph-dialog>
        <div class="modal-header"><h2>Configure custom graph</h2><button class="icon-button" type="button" data-close-custom-graph aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
        <form class="modal-body pure-form pure-form-stacked" data-custom-graph-form>
          <label>X axis<select name="xKey"><% graphNumbers.forEach((column) => { %><option value="<%= column.key %>"><%- formatInline(column.label) %><%= column.unit ? ` (${column.unit})` : '' %></option><% }); %></select></label>
          <label>Y axis<select name="yKey"><% graphNumbers.forEach((column) => { %><option value="<%= column.key %>" <%= column.role === 'response' ? 'selected' : '' %>><%- formatInline(column.label) %><%= column.unit ? ` (${column.unit})` : '' %></option><% }); %></select></label>
          <label>Group/color<select name="groupKey"><option value="">No grouping</option><% graphGroups.forEach((column) => { %><option value="<%= column.key %>"><%- formatInline(column.label) %></option><% }); %></select></label>
          <label>Point size<select name="sizeKey"><option value="">Fixed size</option><% graphNumbers.forEach((column) => { %><option value="<%= column.key %>"><%- formatInline(column.label) %><%= column.unit ? ` (${column.unit})` : '' %></option><% }); %></select></label>
          <label>Display<select name="mode"><option value="raw">Raw measurements</option><option value="mean_ci">Mean with 95% confidence interval</option></select></label>
          <label class="pure-checkbox"><input name="labelRuns" type="checkbox"> Label raw points with run code</label>
          <label class="pure-checkbox"><input name="modelOverlay" type="checkbox"> Overlay current DOE model when X/Y match it</label>
          <fieldset class="doe-analysis-fieldset"><legend>Axis limits (optional)</legend><div class="doe-analysis-axis-limits"><label>X min<input name="xMin" type="number" step="any"></label><label>X max<input name="xMax" type="number" step="any"></label><label>Y min<input name="yMin" type="number" step="any"></label><label>Y max<input name="yMax" type="number" step="any"></label></div></fieldset>
          <div class="modal-footer"><button class="pure-button pure-button-primary" type="submit">Apply graph</button></div>
        </form>
      </dialog>

      <dialog class="modal-frame doe-analysis-dialog" data-templates-dialog>
        <div class="modal-header"><h2>Model templates</h2><button class="icon-button" type="button" data-close-templates aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
        <div class="modal-body">
          <p class="small-note">Templates are shared by every DOE in this process type. When applied, field codes are matched to this DOE and validated before changing the form.</p>
          <div class="doe-analysis-revisions" data-templates-list></div>
          <form class="pure-form pure-form-stacked" data-save-template-form>
            <label for="analysisTemplateName">Save current model as a template</label>
            <input id="analysisTemplateName" name="name" maxlength="120" placeholder="For example: Defect probability — factorial">
            <button class="pure-button pure-button-primary" type="submit">Save template</button>
          </form>
          <p class="small-note" data-template-status aria-live="polite"></p>
        </div>
      </dialog>
    </section>

    <aside class="card doe-analysis-inspector">
      <div class="doe-analysis-panel-title">
        <h2>Model</h2>
        <span class="badge"><%= selectedAnalysis ? `#${selectedAnalysis.id}` : 'Basic' %></span>
      </div>
      <div class="doe-analysis-field-links">
        <a href="/experiments/<%= experiment.id %>/doe/<%= doe.id %>?tab=design">Configure input factors</a>
        <a href="/experiments/<%= experiment.id %>/doe/<%= doe.id %>?tab=design&amp;manage_fields=1">Configure measured responses</a>
      </div>
      <p class="small-note">Input factors define run settings. Measured response values are entered inside each run.</p>
      <% if (defaultSpecification) { %>
        <form class="pure-form pure-form-stacked" data-analysis-form>
          <label for="analysisName">Analysis name</label>
          <input id="analysisName" name="analysisName" maxlength="120" value="<%= selectedAnalysis?.name || '' %>" placeholder="For example: Cycle time — quadratic model" <%= analysisArchived ? 'readonly' : '' %>>

          <label for="analysisResponse">Measured response</label>
          <select id="analysisResponse" name="responseKey" <%= analysisArchived ? 'disabled' : '' %>>
            <% const primaryResponseKey = defaultSpecification.derivedResponse?.leftKey || defaultSpecification.responseKey; responses.forEach((response) => { %>
              <option value="<%= response.key %>" <%= response.key === primaryResponseKey ? 'selected' : '' %>><%- formatInline(response.label) %></option>
            <% }); %>
          </select>

          <% if (tagResponses.length) { const selectedTag = defaultSpecification.tagResponse?.tag || ''; %>
            <fieldset class="doe-analysis-fieldset" data-tag-response-controls>
              <legend>Tag response</legend>
              <label for="analysisTagResponse">Analyse presence of tag</label>
              <select id="analysisTagResponse" name="tagResponseTag" <%= analysisArchived ? 'disabled' : '' %>>
                <option value="">Select a tag</option>
                <% tagResponses.forEach((response) => response.allowedValues.forEach((tag) => { %>
                  <option value="<%= tag %>" data-response-key="<%= response.key %>" <%= response.key === primaryResponseKey && tag === selectedTag ? 'selected' : '' %>><%- formatInline(response.label) %>: <%- formatInline(tag) %></option>
                <% })); %>
              </select>
              <p class="small-note">A selected tag becomes a binary response: Yes when the tag is present in the run and No when it is absent. This is fitted as a logistic model.</p>
            </fieldset>
          <% } %>

          <label for="analysisFamily">Model family</label>
          <select id="analysisFamily" name="modelFamily" <%= analysisArchived ? 'disabled' : '' %>>
            <option value="factorial" <%= defaultSpecification.modelFamily === 'factorial' ? 'selected' : '' %>>Factorial</option>
            <option value="response_surface" <%= defaultSpecification.modelFamily === 'response_surface' ? 'selected' : '' %>>Response surface</option>
            <option value="regression" <%= defaultSpecification.modelFamily === 'regression' ? 'selected' : '' %>>Regression</option>
          </select>

          <fieldset class="doe-analysis-fieldset">
            <legend>Factors</legend>
            <% factors.forEach((factor) => { %>
              <label class="pure-checkbox">
                <input type="checkbox" name="factorKeys" value="<%= factor.key %>" <%= defaultSpecification.factorKeys.includes(factor.key) ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
                <span><%- formatInline(factor.label) %></span>
              </label>
            <% }); %>
          </fieldset>

          <% if (blocks.length) { %>
            <fieldset class="doe-analysis-fieldset">
              <legend>Blocks</legend>
              <p class="small-note">Blocks adjust the model for categorical execution differences. They are not process factors and are held at a representative level in model plots and recommendations.</p>
              <% blocks.forEach((block) => { %>
                <label class="pure-checkbox">
                  <input type="checkbox" name="blockKeys" value="<%= block.key %>" <%= defaultSpecification.blockKeys.includes(block.key) ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
                  <span><%- formatInline(block.label) %></span>
                </label>
              <% }); %>
            </fieldset>
          <% } %>

          <fieldset class="doe-analysis-fieldset" data-model-terms>
            <legend>Model terms</legend>
            <p class="small-note">Only selected terms are fitted. Interactions and quadratic terms require their main effects.</p>
            <p class="small-note" data-model-term-feedback aria-live="polite"></p>
            <% factors.forEach((factor) => { const term = `main:${factor.key}`; %>
              <label class="pure-checkbox" data-model-term-label>
                <input type="checkbox" name="modelTerms" value="<%= term %>" data-model-families="factorial response_surface regression" data-model-factor-keys="<%= factor.key %>" <%= defaultSpecification.modelTerms.includes(term) ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
                <span><%- formatInline(factor.label) %></span>
              </label>
            <% }); %>
            <% factors.forEach((left, index) => { factors.slice(index + 1).forEach((right) => { const term = `interaction:${left.key}|${right.key}`; %>
              <label class="pure-checkbox" data-model-term-label>
                <input type="checkbox" name="modelTerms" value="<%= term %>" data-model-families="factorial response_surface" data-model-factor-keys="<%= left.key %>|<%= right.key %>" <%= defaultSpecification.modelTerms.includes(term) ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
                <span><%- formatInline(left.label) %> × <%- formatInline(right.label) %></span>
              </label>
            <% }); }); %>
            <% factors.forEach((factor) => { const term = `quadratic:${factor.key}`; %>
              <label class="pure-checkbox" data-model-term-label>
                <input type="checkbox" name="modelTerms" value="<%= term %>" data-model-families="response_surface" data-model-factor-keys="<%= factor.key %>" <%= defaultSpecification.modelTerms.includes(term) ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
                <span><%- formatInline(factor.label) %>²</span>
              </label>
            <% }); %>
          </fieldset>

          <fieldset class="doe-analysis-fieldset">
            <legend>Dataset</legend>
            <label class="pure-checkbox">
              <input type="checkbox" name="useCodedFactors" <%= defaultSpecification.useCodedFactors ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
              Use coded factor values
            </label>
            <label class="pure-checkbox">
              <input type="checkbox" name="includeIncomplete" <%= defaultSpecification.includeIncomplete ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
              Include unfinished runs
            </label>
            <label class="pure-checkbox">
              <input type="checkbox" name="includeExcluded" <%= defaultSpecification.includeExcluded ? 'checked' : '' %> <%= analysisArchived ? 'disabled' : '' %>>
              Include excluded runs
            </label>
          </fieldset>

          <fieldset class="doe-analysis-fieldset" data-optimization-controls>
            <legend>Optimize this response</legend>
            <p class="small-note">Optional. Recommendations stay within the physical factor bounds below and are saved with the calculation revision.</p>
            <label for="optimizationObjective">Goal</label>
            <select id="optimizationObjective" name="optimizationObjective" <%= analysisArchived ? 'disabled' : '' %>>
              <option value="">No optimization</option>
              <option value="maximize" <%= defaultSpecification.optimization?.objective === 'maximize' ? 'selected' : '' %>>Maximize response</option>
              <option value="minimize" <%= defaultSpecification.optimization?.objective === 'minimize' ? 'selected' : '' %>>Minimize response</option>
              <option value="target" <%= defaultSpecification.optimization?.objective === 'target' ? 'selected' : '' %>>Hit a target</option>
            </select>
            <label data-optimization-target for="optimizationTarget">Target value</label>
            <input data-optimization-target id="optimizationTarget" name="optimizationTarget" type="number" step="any" value="<%= defaultSpecification.optimization?.target ?? '' %>" <%= analysisArchived ? 'disabled' : '' %>>
            <div class="doe-analysis-optimization-bounds" data-optimization-bounds>
              <% factors.forEach((factor) => { const levels = factor.factor?.levels || []; const configured = defaultSpecification.optimization?.factorBounds?.[factor.key]; const low = configured?.min ?? levels[0] ?? ''; const high = configured?.max ?? levels[levels.length - 1] ?? ''; %>
                <div data-optimization-factor="<%= factor.key %>">
                  <strong><%- formatInline(factor.label) %><%= factor.unit ? ` (${factor.unit})` : '' %></strong>
                  <label>Min <input name="optimizationMin:<%= factor.key %>" type="number" step="any" value="<%= low %>" <%= analysisArchived ? 'disabled' : '' %>></label>
                  <label>Max <input name="optimizationMax:<%= factor.key %>" type="number" step="any" value="<%= high %>" <%= analysisArchived ? 'disabled' : '' %>></label>
                </div>
              <% }); %>
            </div>
          </fieldset>

          <label for="analysisConfidence">Confidence level</label>
          <select id="analysisConfidence" name="confidenceLevel" <%= analysisArchived ? 'disabled' : '' %>>
            <option value="0.90" <%= defaultSpecification.confidenceLevel === 0.90 ? 'selected' : '' %>>90%</option>
            <option value="0.95" <%= defaultSpecification.confidenceLevel === 0.95 ? 'selected' : '' %>>95%</option>
            <option value="0.99" <%= defaultSpecification.confidenceLevel === 0.99 ? 'selected' : '' %>>99%</option>
          </select>

          <label for="analysisResponseTransform">Response transformation</label>
          <select id="analysisResponseTransform" name="responseTransform" <%= analysisArchived ? 'disabled' : '' %>>
            <option value="none" <%= defaultSpecification.responseTransform === 'none' ? 'selected' : '' %>>None</option>
            <option value="log" <%= defaultSpecification.responseTransform === 'log' ? 'selected' : '' %>>log(response)</option>
            <option value="sqrt" <%= defaultSpecification.responseTransform === 'sqrt' ? 'selected' : '' %>>sqrt(response)</option>
          </select>
          <p class="small-note">A transformation changes the fitted response scale and is saved with this analysis revision.</p>

          <% if (numericResponses.length >= 2) { const derived = defaultSpecification.derivedResponse; const derivedLeftKey = derived?.leftKey || numericResponses.find((response) => response.key === primaryResponseKey)?.key || numericResponses[0].key; const derivedRightKey = derived?.rightKey || numericResponses.find((response) => response.key !== derivedLeftKey)?.key || derivedLeftKey; %>
            <fieldset class="doe-analysis-fieldset" data-derived-response-controls>
              <legend>Calculated response <span class="small-note">(optional)</span></legend>
              <p class="small-note">Use this only when the quantity to optimise is calculated from two measurements in every run. The original measurements remain unchanged.</p>
              <label for="analysisDerivedOperation">What should be calculated?</label>
              <select id="analysisDerivedOperation" name="derivedOperation" <%= analysisArchived ? 'disabled' : '' %>>
                <option value="">Use the measured response selected above</option>
                <option value="difference" <%= derived?.operation === 'difference' ? 'selected' : '' %>>Difference: A − B</option>
                <option value="sum" <%= derived?.operation === 'sum' ? 'selected' : '' %>>Sum: A + B</option>
                <option value="ratio" <%= derived?.operation === 'ratio' ? 'selected' : '' %>>Ratio: A ÷ B</option>
              </select>
              <div data-derived-operands>
                <label for="analysisDerivedLeft" data-derived-left-label>Measurement A</label>
                <select id="analysisDerivedLeft" name="derivedLeftKey" <%= analysisArchived ? 'disabled' : '' %>>
                  <% numericResponses.forEach((response) => { %>
                    <option value="<%= response.key %>" <%= response.key === derivedLeftKey ? 'selected' : '' %>><%- formatInline(response.label) %></option>
                  <% }); %>
                </select>
                <label for="analysisDerivedRight" data-derived-right-label>Measurement B</label>
                <select id="analysisDerivedRight" name="derivedRightKey" <%= analysisArchived ? 'disabled' : '' %>>
                  <% numericResponses.forEach((response) => { %>
                    <option value="<%= response.key %>" <%= response.key === derivedRightKey ? 'selected' : '' %>><%- formatInline(response.label) %></option>
                  <% }); %>
                </select>
              </div>
              <p class="small-note" data-derived-preview aria-live="polite"></p>
            </fieldset>
          <% } %>

          <button class="pure-button pure-button-primary" type="submit" data-calculate-button disabled><%= selectedAnalysis ? 'Recalculate and save' : 'Calculate preview' %></button>
          <% if (!selectedAnalysis) { %>
            <button class="pure-button" type="button" data-save-analysis disabled>Save analysis</button>
          <% } %>
          <% if (selectedAnalysis) { %>
            <div class="doe-analysis-analysis-actions" role="group" aria-label="Analysis actions">
              <% if (!analysisArchived) { %>
                <button class="pure-button" type="button" data-rename-analysis>Rename</button>
              <% } %>
              <button class="pure-button" type="button" data-duplicate-analysis>Duplicate</button>
              <% if (analysisArchived) { %>
                <button class="pure-button pure-button-primary" type="button" data-restore-analysis>Restore</button>
              <% } else { %>
                <button class="pure-button button-danger" type="button" data-archive-analysis>Archive</button>
              <% } %>
            </div>
          <% } %>
          <p class="small-note" data-calculation-status aria-live="polite">Checking analytics engine…</p>
          <% if (analysisArchived) { %>
            <div class="doe-analysis-notice">This analysis is archived. Its saved revisions remain available, but the model cannot be changed or recalculated until restored.</div>
          <% } %>
          <% if (selectedAnalysis?.state === 'stale') { %>
            <div class="doe-analysis-notice">Source data changed after the saved calculation. The previous result remains available until you recalculate.</div>
          <% } %>
          <% if (selectedAnalysis?.state === 'failed' && latestSuccessfulRevision) { %>
            <div class="doe-analysis-notice">The last recalculation failed. The previous successful revision is shown.</div>
          <% } %>
          <% if (selectedAnalysis) { %>
            <section class="doe-analysis-revisions">
              <h3>Calculation revisions</h3>
              <% if (!selectedRevisions.length) { %>
                <p class="small-note">No calculations saved yet.</p>
              <% } %>
              <% selectedRevisions.forEach((revision) => { %>
                <div class="doe-analysis-revision-item">
                  <div>
                    <strong>#<%= revision.id %></strong>
                    <span class="badge"><%= revision.status.toLowerCase() %></span>
                  </div>
                  <small><%= revision.calculatedAt.slice(0, 19).replace('T', ' ') %></small>
                  <small>dataset <code><%= revision.datasetRevision.slice(0, 10) %></code></small>
                  <% if (revision.error) { %><small><%= revision.error.message %></small><% } %>
                </div>
              <% }); %>
            </section>
            <section class="doe-analysis-revisions">
              <h3>Activity</h3>
              <% if (!selectedEvents.length) { %>
                <p class="small-note">No activity recorded yet.</p>
              <% } %>
              <% selectedEvents.forEach((event) => { %>
                <div class="doe-analysis-revision-item">
                  <div>
                    <strong><%= event.action.replaceAll('_', ' ').toLowerCase() %></strong>
                    <% if (event.actorName) { %><small>by <%= event.actorName %></small><% } %>
                  </div>
                  <small><%= event.createdAt.slice(0, 19).replace('T', ' ') %></small>
                  <% if (event.details.copiedFromAnalysisId) { %><small>copied from #<%= event.details.copiedFromAnalysisId %></small><% } %>
                  <% if (event.details.revisionId) { %><small>revision #<%= event.details.revisionId %></small><% } %>
                </div>
              <% }); %>
            </section>
          <% } %>
        </form>
      <% } else { %>
        <div class="doe-analysis-notice">
          Add at least one active numeric, boolean, or tags response and numeric factor before calculating a model.
        </div>
      <% } %>
    </aside>
  </div>

  <div class="doe-analysis-run-selection" data-run-selection role="status" hidden>
    <span>Selected <strong data-selected-run-label></strong></span>
    <div>
      <button class="pure-button" type="button" data-show-selected-run>Show in worksheet</button>
      <a class="pure-button pure-button-primary" data-open-selected-run href="#">Open run</a>
      <button class="icon-button" type="button" data-clear-selected-run aria-label="Clear run selection" title="Clear selection">
        <span class="material-symbols-rounded" aria-hidden="true">close</span>
      </button>
    </div>
  </div>
</main>

<script nonce="<%= cspNonce %>" id="analysis-initial-result" type="application/json"><%- jsonForScript(latestSuccessfulRevision?.result || null) %></script>
<script nonce="<%= cspNonce %>" id="analysis-column-labels" type="application/json"><%- jsonForScript(Object.fromEntries(dataset.columns.map((column) => [column.key, column.label]))) %></script>
<script nonce="<%= cspNonce %>" id="analysis-column-units" type="application/json"><%- jsonForScript(Object.fromEntries(dataset.columns.map((column) => [column.key, column.unit]))) %></script>
<script nonce="<%= cspNonce %>" id="analysis-dataset" type="application/json"><%- jsonForScript(dataset) %></script>
<script nonce="<%= cspNonce %>" src="/vendor/echarts/dist/echarts.min.js" defer></script>
<script nonce="<%= cspNonce %>" src="/vendor/echarts-gl/dist/echarts-gl.min.js?v=2.0.9" defer></script>
<script nonce="<%= cspNonce %>" src="/doe_analysis_workspace.js?v=20261005-ai-interpretation5" defer></script>
<%- include('../partials/foot') %>
