<%- include('partials/head', { title: `Polymer Processing Planner | Report Editor ${report.experiment.id}` }) %>
<main class="report-workspace" id="reportWorkspace">
  <header class="report-workspace-header">
    <div class="report-workspace-title">
      <a class="back-link" href="/reports/<%= reportConfig.id %>" aria-label="Back to report">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
      </a>
      <div>
        <h1><%- formatInline(reportConfig.name) %></h1>
        <div class="small-note"><%= reportConfig?.signed_at ? 'Signed report (read-only)' : 'Draft document' %></div>
      </div>
    </div>
    <div class="document-toolbar-slot" id="documentToolbarSlot" aria-label="Document formatting tools"></div>
    <div class="report-workspace-actions">
      <button class="pure-button pure-button-secondary workspace-sources-toggle" type="button" id="toggleSources" aria-controls="reportSources" aria-expanded="true">
        <span class="material-symbols-rounded" aria-hidden="true">source</span>
        <span>Sources</span>
      </button>
      <details class="workspace-overflow-menu">
        <summary class="icon-button" aria-label="Document actions" title="Document actions">
          <span class="material-symbols-rounded" aria-hidden="true">more_vert</span>
        </summary>
        <div class="workspace-overflow-actions">
          <button class="pure-button pure-button-secondary" type="button" id="printReport">Export PDF</button>
          <button class="pure-button pure-button-secondary" type="button" id="exportDocx">Export DOCX</button>
          <button class="pure-button pure-button-primary" type="button" id="saveReport">Save</button>
        </div>
      </details>
    </div>
  </header>

  <% if (reportConfig?.signed_at) { %>
    <div class="auth-error report-workspace-notice">Signed report is read-only.</div>
  <% } %>

  <div class="report-workspace-layout">
    <aside class="report-source-rail" id="reportSources" aria-label="Report sources">
      <div class="report-source-rail-header">
        <div>
          <span class="workspace-eyebrow">Research data</span>
          <h2>Sources</h2>
        </div>
        <button class="icon-button report-source-close" type="button" id="closeSources" aria-label="Close sources">
          <span class="material-symbols-rounded" aria-hidden="true">close</span>
        </button>
      </div>
      <label class="source-search-label" for="sourceSearch">Find a source</label>
      <div class="report-source-search">
        <span class="material-symbols-rounded" aria-hidden="true">search</span>
        <input id="sourceSearch" type="search" placeholder="Search data">
      </div>
      <nav class="report-source-tree" id="sourceTree" aria-label="Source groups"></nav>
      <p class="report-source-hint" id="sourceEmptyState" hidden>No matching source data.</p>
    </aside>
    <div class="report-source-scrim" id="sourceScrim" aria-hidden="true"></div>

    <section class="report-document-pane" aria-label="Report document">
    <div class="editor-toolbar" id="editorToolbar">
      <div class="editor-toolbar-tabs" role="tablist" aria-label="Document tools">
        <button class="editor-toolbar-tab is-active" type="button" role="tab" aria-selected="true" data-toolbar-tab-button="font">Font</button>
        <button class="editor-toolbar-tab" type="button" role="tab" aria-selected="false" data-toolbar-tab-button="text">Text</button>
        <button class="editor-toolbar-tab" type="button" role="tab" aria-selected="false" data-toolbar-tab-button="insert">Insert</button>
        <button class="editor-toolbar-tab" type="button" role="tab" aria-selected="false" data-toolbar-tab-button="table">Tables</button>
      </div>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="undo" title="Undo"><span class="material-symbols-rounded">undo</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="redo" title="Redo"><span class="material-symbols-rounded">redo</span></button>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <select class="toolbar-select" id="fontFamilySelect" title="Font family">
        <option value="">Font</option>
        <option value="Trebuchet MS">Trebuchet</option>
        <option value="Georgia">Georgia</option>
        <option value="Arial">Arial</option>
        <option value="Courier New">Courier</option>
      </select>
      <select class="toolbar-select" id="fontSizeSelect" title="Font size">
        <option value="">Size</option>
        <option value="12px">12</option>
        <option value="14px">14</option>
        <option value="16px">16</option>
        <option value="18px">18</option>
        <option value="20px">20</option>
        <option value="24px">24</option>
        <option value="28px">28</option>
      </select>
      <select class="toolbar-select" id="lineHeightSelect" title="Line height">
        <option value="">Line</option>
        <option value="1.2">1.2</option>
        <option value="1.35">1.35</option>
        <option value="1.5">1.5</option>
        <option value="1.65">1.65</option>
        <option value="1.8">1.8</option>
        <option value="2">2</option>
      </select>
      <select class="toolbar-select" id="textPresetSelect" title="Text style preset">
        <option value="">Preset</option>
        <option value="body">Body</option>
        <option value="subtitle">Subtitle</option>
        <option value="note">Note</option>
        <option value="emphasis">Emphasis</option>
      </select>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <button class="pure-button button-sm" type="button" data-cmd="h1">H1</button>
      <button class="pure-button button-sm" type="button" data-cmd="h2">H2</button>
      <button class="pure-button button-sm" type="button" data-cmd="h3">H3</button>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="bold" title="Bold"><span class="material-symbols-rounded">format_bold</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="italic" title="Italic"><span class="material-symbols-rounded">format_italic</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="underline" title="Underline"><span class="material-symbols-rounded">format_underlined</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="strike" title="Strike"><span class="material-symbols-rounded">strikethrough_s</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="highlight" title="Highlight"><span class="material-symbols-rounded">ink_highlighter</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="superscript" title="Superscript"><span class="material-symbols-rounded">superscript</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="subscript" title="Subscript"><span class="material-symbols-rounded">subscript</span></button>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="bullet" title="Bullet list"><span class="material-symbols-rounded">format_list_bulleted</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="ordered" title="Ordered list"><span class="material-symbols-rounded">format_list_numbered</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="checklist" title="Checklist"><span class="material-symbols-rounded">checklist</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="quote" title="Quote"><span class="material-symbols-rounded">format_quote</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="code" title="Code block"><span class="material-symbols-rounded">code_blocks</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="hr" title="Divider"><span class="material-symbols-rounded">horizontal_rule</span></button>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="align-left" title="Align left"><span class="material-symbols-rounded">format_align_left</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="align-center" title="Align center"><span class="material-symbols-rounded">format_align_center</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="align-right" title="Align right"><span class="material-symbols-rounded">format_align_right</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="align-justify" title="Justify"><span class="material-symbols-rounded">format_align_justify</span></button>
      <span class="toolbar-sep" aria-hidden="true"></span>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="link" title="Link"><span class="material-symbols-rounded">link</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="image" title="Image"><span class="material-symbols-rounded">image</span></button>
      <button class="pure-button button-sm icon-only" type="button" data-cmd="chemical-structure" title="Chemical structure"><span class="material-symbols-rounded">schema</span></button>
      <div class="toolbar-image-placeholder" id="imageToolsGroup" hidden aria-hidden="true"></div>
      <div class="table-tools" title="Table tools">
        <button class="pure-button button-sm icon-only" type="button" id="tablePickerToggle" title="Insert table">
          <span class="material-symbols-rounded">table</span>
        </button>
        <div class="table-picker" id="tablePicker" hidden>
          <div class="table-picker-label" id="tablePickerLabel">3 x 3</div>
          <div class="table-picker-grid" id="tablePickerGrid"></div>
        </div>
        <div class="table-ops toolbar-conditional" id="tableOpsGroup">
          <button class="pure-button button-sm table-op" type="button" data-cmd="table-row-add" title="Add row">R+</button>
          <button class="pure-button button-sm table-op" type="button" data-cmd="table-row-del" title="Delete row">R-</button>
          <button class="pure-button button-sm table-op" type="button" data-cmd="table-col-add" title="Add column">C+</button>
          <button class="pure-button button-sm table-op" type="button" data-cmd="table-col-del" title="Delete column">C-</button>
          <button class="pure-button button-sm table-op danger" type="button" data-cmd="table-del" title="Delete table">Del</button>
        </div>
      </div>
    </div>
    <div class="image-tools image-context-bar toolbar-conditional" id="imageContextBar" title="Selected image">
      <label class="image-size-control" for="imageWidthRange" title="Image width">
        <span>Width</span>
        <input id="imageWidthRange" type="range" min="20" max="100" step="5" value="80">
        <output id="imageWidthValue" for="imageWidthRange">80%</output>
      </label>
      <button class="pure-button button-sm image-op" type="button" data-cmd="image-width-100" title="Fit to text width">Fit</button>
      <button class="pure-button button-sm image-op" type="button" data-cmd="image-align-left" title="Align image left">L</button>
      <button class="pure-button button-sm image-op" type="button" data-cmd="image-align-center" title="Align image center">C</button>
      <button class="pure-button button-sm image-op" type="button" data-cmd="image-align-right" title="Align image right">R</button>
      <button class="pure-button button-sm image-op chemical-structure-edit" type="button" data-cmd="chemical-structure-edit" title="Edit chemical structure" hidden><span class="material-symbols-rounded">schema</span></button>
      <button class="pure-button button-sm image-op danger" type="button" data-cmd="image-delete" title="Delete image">Del</button>
    </div>
    <div id="editorRoot" class="editor-surface"></div>
    <div class="save-status small-note" id="saveStatus"></div>
    </section>
  </div>
</main>

<dialog class="modal-frame source-preview-dialog" id="sourcePreviewDialog">
  <div class="modal-header">
    <strong id="sourcePreviewTitle">Source preview</strong>
    <button class="pure-button" type="button" id="closeSourcePreview">Close</button>
  </div>
  <div class="modal-body" id="sourcePreviewBody"></div>
  <div class="modal-footer source-preview-actions" id="sourcePreviewActions">
    <button class="pure-button" type="button" data-source-insert="value">Insert value</button>
    <button class="pure-button pure-button-primary" type="button" data-source-insert="label">Insert label + value</button>
    <button class="pure-button" type="button" data-source-insert="table">Insert table</button>
    <button class="pure-button pure-button-primary" type="button" data-source-insert="section">Insert section</button>
    <button class="pure-button pure-button-primary" type="button" data-source-insert="figure">Insert figure</button>
  </div>
</dialog>

<dialog class="modal-frame doe-analysis-dialog" id="doeAnalysisDialog">
  <div class="modal-header">
    <div>
      <span class="workspace-eyebrow">DOE analysis</span>
      <strong id="doeAnalysisTitle">Analysis</strong>
    </div>
    <button class="pure-button" type="button" id="closeDoeAnalysis">Close</button>
  </div>
  <div class="modal-body doe-dialog-body">
    <div class="doe-analysis-controls">
      <label>View
        <select id="doeAnalysisMode">
          <option value="overall">Overall summary</option>
          <option value="factor">By factor</option>
          <option value="matrix">Factor matrix</option>
          <option value="regression">Linear model</option>
        </select>
      </label>
      <label>Output
        <select id="doeAnalysisOutput"></select>
      </label>
      <label id="doeAnalysisFactorField">Factor
        <select id="doeAnalysisFactor"></select>
      </label>
      <label id="doeAnalysisSecondFactorField">Second factor
        <select id="doeAnalysisSecondFactor"></select>
      </label>
    </div>
    <p class="small-note" id="doeAnalysisMessage" hidden></p>
    <div class="doe-table-scroll" id="doeAnalysisTable"></div>
  </div>
  <div class="modal-footer source-preview-actions">
    <button class="pure-button" type="button" id="insertDoeAnalysisTable">Insert table</button>
    <button class="pure-button pure-button-primary" type="button" id="insertDoeAnalysisSection">Insert section</button>
    <button class="pure-button pure-button-primary" type="button" id="insertDoeAnalysisChart">Insert chart</button>
  </div>
</dialog>

<dialog class="modal-frame doe-runs-dialog" id="doeRunsDialog">
  <div class="modal-header">
    <div>
      <span class="workspace-eyebrow">DOE run data</span>
      <strong id="doeRunsTitle">Runs</strong>
    </div>
    <button class="pure-button" type="button" id="closeDoeRuns">Close</button>
  </div>
  <div class="modal-body doe-dialog-body">
    <p class="small-note" id="doeRunsMeta"></p>
    <div class="doe-table-scroll" id="doeRunsTable"></div>
  </div>
  <div class="modal-footer doe-runs-footer">
    <div class="doe-runs-pagination">
      <button class="pure-button" type="button" id="doeRunsPrevious">Previous</button>
      <span class="small-note" id="doeRunsPage">Page 1</span>
      <button class="pure-button" type="button" id="doeRunsNext">Next</button>
    </div>
    <button class="pure-button pure-button-primary" type="button" id="insertDoeRunReferences">Insert selected runs</button>
  </div>
</dialog>

<script nonce="<%= cspNonce %>" src="/vendor/echarts/dist/echarts.min.js"></script>

<script nonce="<%= cspNonce %>" type="module">
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Underline from '@tiptap/extension-underline';
  import Link from '@tiptap/extension-link';
  import Image from '@tiptap/extension-image';
  import TextAlign from '@tiptap/extension-text-align';
  import { Table, TableRow, TableHeader, TableCell } from '@tiptap/extension-table';
  import TaskList from '@tiptap/extension-task-list';
  import TaskItem from '@tiptap/extension-task-item';
  import Superscript from '@tiptap/extension-superscript';
  import Subscript from '@tiptap/extension-subscript';
  import Highlight from '@tiptap/extension-highlight';
  import { TextStyle, FontSize, LineHeight, FontFamily } from '@tiptap/extension-text-style';
  import TurndownService from 'turndown';

  // Seed data is produced on the server from the report content. This keeps the
  // editor structure stable and predictable.
  const editorData = <%- jsonForScript(editorData) %>;
  const sourceCatalog = <%- jsonForScript(sourceCatalog) %>;
  const hasSavedDoc = <%= hasSavedDoc ? 'true' : 'false' %>;
  const htmlSnapshot = <%- jsonForScript(htmlSnapshot || '') %>;
  const rheoData = <%- jsonForScript(report.qualification?.charts.rheology || []) %>;
  const windowData = <%- jsonForScript(report.qualification?.charts.processWindow || {}) %>;
  const isSigned = <%= reportConfig?.signed_at ? 'true' : 'false' %>;
  const turndown = new TurndownService({
    headingStyle: 'atx',
    codeBlockStyle: 'fenced',
    bulletListMarker: '-'
  });

  const reportWorkspace = document.getElementById('reportWorkspace');
  const sourceToggle = document.getElementById('toggleSources');
  const sourceClose = document.getElementById('closeSources');
  const sourceScrim = document.getElementById('sourceScrim');
  const documentToolbarSlot = document.getElementById('documentToolbarSlot');
  const editorToolbar = document.getElementById('editorToolbar');
  if (documentToolbarSlot && editorToolbar) documentToolbarSlot.appendChild(editorToolbar);

  const toolbarTabButtons = document.querySelectorAll('[data-toolbar-tab-button]');
  const toolbarControls = editorToolbar
    ? Array.from(editorToolbar.children).filter((child) => !child.classList.contains('editor-toolbar-tabs'))
    : [];
  toolbarControls.forEach((control, index) => {
    if (control.classList.contains('toolbar-image-placeholder')) control.dataset.toolbarTab = 'none';
    else if (control.querySelector('[data-cmd="chemical-structure"]')) control.dataset.toolbarTab = 'insert';
    else if (control.classList.contains('table-tools')) control.dataset.toolbarTab = 'table';
    else if (index <= 2) control.dataset.toolbarTab = 'history';
    else if (index === 19 || index === 31) control.dataset.toolbarTab = 'none';
    else if (index <= 18) control.dataset.toolbarTab = 'font';
    else if (index <= 31) control.dataset.toolbarTab = 'text';
    else if (index <= 34) control.dataset.toolbarTab = 'insert';
    else control.dataset.toolbarTab = 'table';
  });
  const setToolbarTab = (tab) => {
    toolbarControls.forEach((control) => {
      control.hidden = !['history', tab].includes(control.dataset.toolbarTab || 'none');
    });
    toolbarTabButtons.forEach((button) => {
      const active = button.dataset.toolbarTabButton === tab;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
  };
  toolbarTabButtons.forEach((button) => {
    button.addEventListener('click', () => setToolbarTab(button.dataset.toolbarTabButton || 'font'));
  });
  setToolbarTab('font');

  const setSourcesOpen = (open) => {
    reportWorkspace?.classList.toggle('sources-open', open);
    sourceToggle?.setAttribute('aria-expanded', String(open));
  };

  sourceToggle?.addEventListener('click', () => {
    setSourcesOpen(!reportWorkspace?.classList.contains('sources-open'));
  });
  sourceClose?.addEventListener('click', () => setSourcesOpen(false));
  sourceScrim?.addEventListener('click', () => setSourcesOpen(false));

  const syncWorkspaceHeight = () => {
    const navHeight = document.querySelector('.top-nav')?.getBoundingClientRect().height || 0;
    reportWorkspace?.style.setProperty('--report-workspace-height', `${Math.max(0, window.innerHeight - navHeight)}px`);
  };
  syncWorkspaceHeight();
  window.addEventListener('resize', syncWorkspaceHeight);

  const normalizeImageWidth = (rawWidth) => {
    const parsed = Number.parseFloat(String(rawWidth ?? ''));
    if (!Number.isFinite(parsed)) return '80%';
    return `${Math.min(100, Math.max(20, Math.round(parsed / 5) * 5))}%`;
  };

  const ReportImage = Image.extend({
    addAttributes() {
      return {
        ...this.parent?.(),
        width: {
          default: '80%',
          parseHTML: (element) => normalizeImageWidth(element.getAttribute('data-width') || element.style.width),
          renderHTML: (attributes) => {
            const width = normalizeImageWidth(attributes.width);
            return { 'data-width': width, style: `width: ${width};` };
          }
        },
        align: {
          default: 'center',
          parseHTML: (element) => ['left', 'center', 'right'].includes(element.getAttribute('data-align') || '')
            ? element.getAttribute('data-align')
            : 'center',
          renderHTML: (attributes) => ({ 'data-align': attributes.align || 'center' })
        },
        chemicalKet: {
          default: null,
          parseHTML: (element) => element.getAttribute('data-chemical-ket') || null,
          renderHTML: (attributes) => attributes.chemicalKet ? { 'data-chemical-ket': attributes.chemicalKet } : {}
        },
        chemicalMolfile: {
          default: null,
          parseHTML: (element) => element.getAttribute('data-chemical-molfile') || null,
          renderHTML: (attributes) => attributes.chemicalMolfile ? { 'data-chemical-molfile': attributes.chemicalMolfile } : {}
        },
        chemicalSmiles: {
          default: null,
          parseHTML: (element) => element.getAttribute('data-chemical-smiles') || null,
          renderHTML: (attributes) => attributes.chemicalSmiles ? { 'data-chemical-smiles': attributes.chemicalSmiles } : {}
        }
      };
    }
  });

  const escapeHtml = (value) =>
    String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

  const allowInlineTags = (value) =>
    String(value || '')
      .replace(/&lt;(\/?)(sup|sub|b|strong|i|em|u|s|strike|small|mark|code)&gt;/gi, '<$1$2>')
      .replace(/&amp;lt;(\/?)(sup|sub|b|strong|i|em|u|s|strike|small|mark|code)&amp;gt;/gi, '<$1$2>')
      .replace(/&lt;br\s*\/?&gt;/gi, '<br>')
      .replace(/&amp;lt;br\s*\/?&amp;gt;/gi, '<br>');

  const safeInlineHtml = (value) => allowInlineTags(escapeHtml(value));
  const normalizeSavedHtmlInlineTags = (value) => allowInlineTags(String(value || ''));

  const renderChartImage = (buildOption) => {
    const container = document.createElement('div');
    container.style.width = '640px';
    container.style.height = '360px';
    container.style.position = 'absolute';
    container.style.left = '-9999px';
    container.style.top = '0';
    container.style.visibility = 'hidden';
    document.body.appendChild(container);
    const chart = echarts.init(container, null, { renderer: 'canvas' });
    chart.setOption(buildOption());
    chart.resize();
    const url = chart.getDataURL({ type: 'png', pixelRatio: 2, backgroundColor: '#ffffff' });
    chart.dispose();
    document.body.removeChild(container);
    return url;
  };

  const injectImageAfterHeader = (data, headerText, imageUrl, captionText) => {
    const headerIndex = data.blocks.findIndex(
      (block) => block.type === 'header' && String(block.data?.text || '').includes(headerText)
    );
    if (headerIndex === -1) return data;

    for (let i = headerIndex + 1; i < data.blocks.length; i += 1) {
      const block = data.blocks[i];
      if (block.type === 'image') {
        block.data = { ...(block.data || {}), url: imageUrl, caption: '' };
        const next = data.blocks[i + 1];
        if (!next || next.type !== 'paragraph') {
          data.blocks.splice(i + 1, 0, { type: 'paragraph', data: { text: captionText } });
        }
        return data;
      }
      if (block.type === 'header') break;
    }
    data.blocks.splice(headerIndex + 1, 0, { type: 'image', data: { url: imageUrl, caption: '' } });
    data.blocks.splice(headerIndex + 2, 0, { type: 'paragraph', data: { text: captionText } });
    return data;
  };

  const isTipTapDoc = (value) =>
    value && typeof value === 'object' && value.type === 'doc' && Array.isArray(value.content);

  const renderListItems = (items, ordered) => {
    if (!Array.isArray(items) || !items.length) return '';
    const tag = ordered ? 'ol' : 'ul';
    const list = items
      .map((item) => {
        if (typeof item === 'string') return `<li>${safeInlineHtml(item)}</li>`;
        if (!item || typeof item !== 'object') return '<li></li>';
        const text = safeInlineHtml(item.content || '');
        const sub = item.items?.length
          ? renderListItems(item.items, item.meta?.counterType === 'numeric')
          : '';
        return `<li>${text}${sub}</li>`;
      })
      .join('');
    return `<${tag}>${list}</${tag}>`;
  };

  const blocksToHtml = (blocks) => {
    if (!Array.isArray(blocks)) return '<p>-</p>';
    return blocks
      .map((block) => {
        const type = String(block?.type || '');
        const data = block?.data || {};
        if (type === 'header') {
          const level = Number.isFinite(Number(data.level)) ? Math.max(1, Math.min(4, Number(data.level))) : 2;
          return `<h${level}>${safeInlineHtml(data.text || '')}</h${level}>`;
        }
        if (type === 'paragraph') {
          return `<p>${safeInlineHtml(data.text || '')}</p>`;
        }
        if (type === 'list') {
          const ordered = data.style === 'ordered';
          const html = renderListItems(data.items || [], ordered);
          return html || '<p>-</p>';
        }
        if (type === 'table') {
          const rows = Array.isArray(data.content) ? data.content : [];
          const body = rows
            .map((row) => {
              const cols = Array.isArray(row) ? row : [];
              const tds = cols.map((cell) => `<td>${safeInlineHtml(cell)}</td>`).join('');
              return `<tr>${tds}</tr>`;
            })
            .join('');
          return `<table><tbody>${body}</tbody></table>`;
        }
        if (type === 'image') {
          const src = escapeHtml(data.url || '');
          const caption = safeInlineHtml(data.caption || '');
          if (!src) return '';
          return `<p><img src="${src}" alt="${caption}" /></p>${caption ? `<p><em>${caption}</em></p>` : ''}`;
        }
        if (type === 'delimiter') {
          return '<hr />';
        }
        return `<p>${safeInlineHtml(data.text || '')}</p>`;
      })
      .join('');
  };

  const buildRheoOption = () => {
    const series = rheoData
      .filter((p) => p && Number.isFinite(p.x) && Number.isFinite(p.y))
      .map((p) => [p.x, p.y]);
    return {
      grid: { left: 60, right: 40, top: 30, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Injection speed (cm3/s)' },
      yAxis: { type: 'value', name: 'Relative viscosity' },
      series: [{ type: 'line', symbol: 'circle', data: series }]
    };
  };

  const buildWindowOption = () => {
    const good = windowData.good || [];
    const defect = windowData.defect || [];
    const windowPoly = windowData.window || [];
    const center = windowData.center ? [windowData.center] : [];
    const series = [
      { type: 'scatter', data: good, symbolSize: 8, itemStyle: { color: '#2f8f5b' } },
      { type: 'scatter', data: defect, symbolSize: 8, itemStyle: { color: '#d45f5f' } }
    ];
    if (windowPoly.length) {
      series.push({
        type: 'line',
        data: windowPoly,
        lineStyle: { color: '#4a86d4' },
        areaStyle: { color: 'rgba(74, 134, 212, 0.12)' }
      });
    }
    if (center.length) {
      series.push({ type: 'scatter', data: center, symbolSize: 10, itemStyle: { color: '#d97a2b' } });
    }
    return {
      grid: { left: 60, right: 40, top: 30, bottom: 60, containLabel: true },
      xAxis: { type: 'value', name: 'Temperature (°C)' },
      yAxis: { type: 'value', name: 'Hold pressure (bar)' },
      series
    };
  };

  const buildRunSeriesOption = (chartData, title) => ({
    grid: { left: 60, right: 30, top: 45, bottom: 70, containLabel: true },
    title: { text: title, left: 'center', textStyle: { fontSize: 14 } },
    xAxis: { type: 'category', data: chartData?.categories || [], axisLabel: { rotate: 35 } },
    yAxis: { type: 'value', name: chartData?.unit || '' },
    series: [{ type: 'line', symbol: 'circle', connectNulls: false, data: chartData?.values || [] }]
  });

  const buildInitialContent = () => {
    if (htmlSnapshot) return normalizeSavedHtmlInlineTags(htmlSnapshot);
    if (isTipTapDoc(editorData)) return editorData;
    let seedData = editorData;
    const isEditorJsBlocks = seedData && typeof seedData === 'object' && Array.isArray(seedData.blocks);
    if (isEditorJsBlocks && !hasSavedDoc) {
      const rheoUrl = renderChartImage(buildRheoOption);
      const windowUrl = renderChartImage(buildWindowOption);
      seedData = injectImageAfterHeader(seedData, '4. Rheology', rheoUrl, 'Rheology curve');
      seedData = injectImageAfterHeader(seedData, '5. Process Window', windowUrl, 'Process window');
    }
    if (isEditorJsBlocks) {
      return blocksToHtml(seedData.blocks);
    }
    return '<p>-</p>';
  };

  const editor = new Editor({
    element: document.getElementById('editorRoot'),
    editable: !isSigned,
    extensions: [
      StarterKit.configure({
        heading: { levels: [1, 2, 3, 4] },
        link: false,
        underline: false
      }),
      Underline,
      TextStyle,
      FontFamily,
      FontSize,
      LineHeight,
      Superscript,
      Subscript,
      Highlight.configure({ multicolor: true }),
      Link.configure({
        openOnClick: true
      }),
      ReportImage.configure({
        allowBase64: true
      }),
      TextAlign.configure({
        types: ['heading', 'paragraph']
      }),
      TaskList,
      TaskItem.configure({
        nested: true
      }),
      Table.configure({
        resizable: true
      }),
      TableRow,
      TableHeader,
      TableCell
    ],
    content: buildInitialContent()
  });

  const sourceTree = document.getElementById('sourceTree');
  const sourceSearch = document.getElementById('sourceSearch');
  const sourceEmptyState = document.getElementById('sourceEmptyState');
  const sourcePreviewDialog = document.getElementById('sourcePreviewDialog');
  const sourcePreviewTitle = document.getElementById('sourcePreviewTitle');
  const sourcePreviewBody = document.getElementById('sourcePreviewBody');
  const reportId = <%= Number(reportConfig.id) %>;
  const doeAnalysisDialog = document.getElementById('doeAnalysisDialog');
  const doeAnalysisTitle = document.getElementById('doeAnalysisTitle');
  const doeAnalysisMode = document.getElementById('doeAnalysisMode');
  const doeAnalysisOutput = document.getElementById('doeAnalysisOutput');
  const doeAnalysisFactor = document.getElementById('doeAnalysisFactor');
  const doeAnalysisSecondFactor = document.getElementById('doeAnalysisSecondFactor');
  const doeAnalysisFactorField = document.getElementById('doeAnalysisFactorField');
  const doeAnalysisSecondFactorField = document.getElementById('doeAnalysisSecondFactorField');
  const doeAnalysisMessage = document.getElementById('doeAnalysisMessage');
  const doeAnalysisTable = document.getElementById('doeAnalysisTable');
  const insertDoeAnalysisTable = document.getElementById('insertDoeAnalysisTable');
  const insertDoeAnalysisSection = document.getElementById('insertDoeAnalysisSection');
  const insertDoeAnalysisChart = document.getElementById('insertDoeAnalysisChart');
  const doeRunsDialog = document.getElementById('doeRunsDialog');
  const doeRunsTitle = document.getElementById('doeRunsTitle');
  const doeRunsMeta = document.getElementById('doeRunsMeta');
  const doeRunsTable = document.getElementById('doeRunsTable');
  const doeRunsPrevious = document.getElementById('doeRunsPrevious');
  const doeRunsNext = document.getElementById('doeRunsNext');
  const doeRunsPage = document.getElementById('doeRunsPage');
  const insertDoeRunReferences = document.getElementById('insertDoeRunReferences');
  let selectedSource = null;
  let selectedDoeStudyId = null;
  let doeAnalysisData = null;
  let doeRunsData = null;
  const selectedDoeRuns = new Map();

  const sourceText = (value) => String(value ?? '').trim();
  const makeTextNode = (text) => ({ type: 'text', text: sourceText(text) });
  const makeParagraphNode = (text = '') => {
    const value = sourceText(text);
    return value ? { type: 'paragraph', content: [makeTextNode(value)] } : { type: 'paragraph' };
  };
  const makeHeadingNode = (text, level = 3) => ({
    type: 'heading',
    attrs: { level },
    content: [makeTextNode(text)]
  });
  const makeRecipeTable = (components) => ({
    type: 'table',
    content: [
      {
        type: 'tableRow',
        content: ['Component', 'PHR'].map((value) => ({
          type: 'tableHeader',
          content: [makeParagraphNode(value)]
        }))
      },
      ...(Array.isArray(components) && components.length
        ? components.map((component) => ({
          type: 'tableRow',
          content: [component.component_name, component.phr].map((value) => ({
            type: 'tableCell',
            content: [makeParagraphNode(value)]
          }))
        }))
        : [{
          type: 'tableRow',
          content: ['-', '-'].map((value) => ({
            type: 'tableCell',
            content: [makeParagraphNode(value)]
          }))
        }])
    ]
  });
  const makeRowsTable = (rows) => ({
    type: 'table',
    content: [
      { type: 'tableRow', content: ['Result', 'Value'].map((value) => ({ type: 'tableHeader', content: [makeParagraphNode(value)] })) },
      ...(rows || []).map((row) => ({
        type: 'tableRow',
        content: [row.label, row.value].map((value) => ({ type: 'tableCell', content: [makeParagraphNode(value)] }))
      }))
    ]
  });
  const makeDataTable = (columns, rows) => ({
    type: 'table',
    content: [
      { type: 'tableRow', content: (columns || []).map((value) => ({ type: 'tableHeader', content: [makeParagraphNode(value)] })) },
      ...(rows || []).map((row) => ({
        type: 'tableRow',
        content: row.map((value) => ({ type: 'tableCell', content: [makeParagraphNode(value)] }))
      }))
    ]
  });
  const makeRunReference = (source, addObservation) => {
    const reference = {
      type: 'paragraph',
      content: [{
        type: 'text',
        text: `Qualification run: ${source.label}`,
        marks: [{ type: 'link', attrs: { href: source.runUrl, target: '_blank', rel: 'noopener noreferrer' } }]
      }]
    };
    return [
      reference,
      ...(source.rows?.length ? [makeRowsTable(source.rows)] : []),
      ...(addObservation ? [makeParagraphNode('Test observation / artifact: ')] : [])
    ];
  };

  const makeDoeRunReference = (run, fields) => {
    const reference = {
      type: 'paragraph',
      content: [{
        type: 'text',
        text: `DOE run: ${run.code}`,
        marks: [{ type: 'link', attrs: { href: run.url, target: '_blank', rel: 'noopener noreferrer' } }]
      }]
    };
    const rows = [
      { label: 'Responsible', value: run.responsible },
      { label: 'Status', value: run.excluded ? 'Excluded from analysis' : run.done ? 'Done' : 'In progress' },
      ...(fields || []).map((field) => ({ label: field.unit ? `${field.label} (${field.unit})` : field.label, value: run.values?.[field.key] || '–' }))
    ];
    return [reference, makeRowsTable(rows), makeParagraphNode('Run observation / error / artifact: ')];
  };

  const buildDoeAnalysisOption = (chart) => {
    if (chart?.type === 'heatmap') {
      const values = (chart.values || []).map((value) => value[2]).filter((value) => Number.isFinite(value));
      return {
        title: { text: chart.title, left: 'center', textStyle: { fontSize: 14 } },
        grid: { left: 70, right: 90, top: 50, bottom: 70, containLabel: true },
        xAxis: { type: 'category', name: chart.xLabel || '', data: chart.xValues || [] },
        yAxis: { type: 'category', name: chart.yLabel || '', data: chart.yValues || [] },
        visualMap: { min: values.length ? Math.min(...values) : 0, max: values.length ? Math.max(...values) : 1, calculable: true, orient: 'vertical', right: 8, top: 'middle' },
        series: [{ type: 'heatmap', data: chart.values || [], label: { show: true } }]
      };
    }
    return {
      title: { text: chart?.title || 'DOE analysis', left: 'center', textStyle: { fontSize: 14 } },
      grid: { left: 65, right: 30, top: 50, bottom: 75, containLabel: true },
      xAxis: { type: 'category', data: chart?.categories || [], axisLabel: { rotate: 32 } },
      yAxis: { type: 'value', name: chart?.unit || '' },
      series: [{ type: chart?.type === 'bar' ? 'bar' : 'line', symbol: 'circle', data: chart?.values || [] }]
    };
  };

  const makePreviewTable = (columns, rows, emptyText) => {
    const fragment = document.createDocumentFragment();
    if (!rows?.length) {
      const empty = document.createElement('p');
      empty.className = 'small-note';
      empty.textContent = emptyText || 'No data available.';
      fragment.appendChild(empty);
      return fragment;
    }
    const table = document.createElement('table');
    table.className = 'pure-table table-compact source-preview-table';
    const head = table.createTHead().insertRow();
    (columns || []).forEach((label) => {
      const cell = document.createElement('th');
      cell.textContent = label;
      head.appendChild(cell);
    });
    const body = table.createTBody();
    rows.forEach((values) => {
      const row = body.insertRow();
      values.forEach((value) => {
        const cell = row.insertCell();
        cell.textContent = sourceText(value) || '–';
      });
    });
    fragment.appendChild(table);
    return fragment;
  };

  const setSelectOptions = (select, options, selectedId) => {
    if (!(select instanceof HTMLSelectElement)) return;
    select.replaceChildren();
    (options || []).forEach((optionData) => {
      const option = document.createElement('option');
      option.value = String(optionData.id);
      option.textContent = optionData.unit ? `${optionData.label} (${optionData.unit})` : optionData.label;
      select.appendChild(option);
    });
    if (selectedId != null) select.value = String(selectedId);
  };

  const setDoeAnalysisLoading = (message) => {
    if (doeAnalysisTable) doeAnalysisTable.replaceChildren();
    if (doeAnalysisMessage) {
      doeAnalysisMessage.hidden = false;
      doeAnalysisMessage.textContent = message;
    }
  };

  const renderDoeAnalysis = (data) => {
    doeAnalysisData = data;
    if (doeAnalysisTitle) doeAnalysisTitle.textContent = data?.study?.name || 'DOE analysis';
    setSelectOptions(doeAnalysisOutput, data?.outputs, data?.selected?.outputId);
    setSelectOptions(doeAnalysisFactor, data?.factors, data?.selected?.factorId);
    setSelectOptions(doeAnalysisSecondFactor, data?.factors, data?.selected?.secondFactorId);
    if (doeAnalysisMode instanceof HTMLSelectElement && data?.selected?.mode) doeAnalysisMode.value = data.selected.mode;
    const mode = data?.selected?.mode || 'overall';
    if (doeAnalysisFactorField) doeAnalysisFactorField.hidden = mode === 'overall';
    if (doeAnalysisSecondFactorField) doeAnalysisSecondFactorField.hidden = mode !== 'matrix' && mode !== 'regression';
    const noOutputs = !(data?.outputs || []).length;
    [doeAnalysisMode, doeAnalysisOutput, doeAnalysisFactor, doeAnalysisSecondFactor].forEach((control) => {
      if (control instanceof HTMLSelectElement) control.disabled = noOutputs;
    });
    const analysis = data?.analysis;
    if (doeAnalysisMessage) {
      doeAnalysisMessage.hidden = !analysis?.message;
      doeAnalysisMessage.textContent = analysis?.message || '';
    }
    if (doeAnalysisTable) {
      doeAnalysisTable.replaceChildren(makePreviewTable(analysis?.columns, analysis?.rows, analysis?.message));
    }
    if (insertDoeAnalysisTable instanceof HTMLButtonElement) insertDoeAnalysisTable.disabled = isSigned || !analysis?.rows?.length;
    if (insertDoeAnalysisSection instanceof HTMLButtonElement) insertDoeAnalysisSection.disabled = isSigned || !analysis?.rows?.length;
    if (insertDoeAnalysisChart instanceof HTMLButtonElement) {
      insertDoeAnalysisChart.hidden = !analysis?.chart;
      insertDoeAnalysisChart.disabled = isSigned || !analysis?.chart;
    }
  };

  const loadDoeAnalysis = async () => {
    if (!selectedDoeStudyId) return;
    setDoeAnalysisLoading('Loading analysis…');
    const params = new URLSearchParams({
      mode: sourceText(doeAnalysisMode?.value) || 'overall',
      output: sourceText(doeAnalysisOutput?.value),
      factor: sourceText(doeAnalysisFactor?.value),
      second_factor: sourceText(doeAnalysisSecondFactor?.value)
    });
    try {
      const response = await fetch(`/reports/${reportId}/sources/doe/${selectedDoeStudyId}/analysis?${params}`);
      if (!response.ok) throw new Error('Analysis is unavailable.');
      renderDoeAnalysis(await response.json());
    } catch (error) {
      setDoeAnalysisLoading(error instanceof Error ? error.message : 'Analysis is unavailable.');
    }
  };

  const renderDoeRuns = (data) => {
    doeRunsData = data;
    if (doeRunsTitle) doeRunsTitle.textContent = data?.study?.name || 'DOE runs';
    if (doeRunsMeta) doeRunsMeta.textContent = `${data?.total || 0} runs · data and responsible person`;
    if (doeRunsTable) {
      doeRunsTable.replaceChildren();
      if (!data?.runs?.length) {
        const empty = document.createElement('p');
        empty.className = 'small-note';
        empty.textContent = 'No runs in this study.';
        doeRunsTable.appendChild(empty);
      } else {
        const table = document.createElement('table');
        table.className = 'pure-table table-compact source-preview-table doe-runs-table';
        const head = table.createTHead().insertRow();
        ['', 'Run', 'Responsible', 'Status', ...(data.fields || []).map((field) => field.unit ? `${field.label} (${field.unit})` : field.label)].forEach((label) => {
          const cell = document.createElement('th');
          cell.textContent = label;
          head.appendChild(cell);
        });
        const body = table.createTBody();
        data.runs.forEach((run) => {
          const row = body.insertRow();
          const selection = document.createElement('input');
          selection.type = 'checkbox';
          selection.checked = selectedDoeRuns.has(run.id);
          selection.setAttribute('aria-label', `Select ${run.code}`);
          selection.addEventListener('change', () => {
            if (selection.checked) selectedDoeRuns.set(run.id, run);
            else selectedDoeRuns.delete(run.id);
            if (insertDoeRunReferences instanceof HTMLButtonElement) insertDoeRunReferences.disabled = isSigned || selectedDoeRuns.size === 0;
          });
          row.insertCell().appendChild(selection);
          const runLink = document.createElement('a');
          runLink.href = run.url;
          runLink.target = '_blank';
          runLink.rel = 'noopener noreferrer';
          runLink.textContent = run.code;
          row.insertCell().appendChild(runLink);
          row.insertCell().textContent = run.responsible;
          row.insertCell().textContent = run.excluded ? 'Excluded' : run.done ? 'Done' : 'In progress';
          (data.fields || []).forEach((field) => {
            row.insertCell().textContent = run.values?.[field.key] || '–';
          });
        });
        doeRunsTable.appendChild(table);
      }
    }
    if (doeRunsPage) doeRunsPage.textContent = `Page ${data?.page || 1} of ${data?.pageCount || 1}`;
    if (doeRunsPrevious instanceof HTMLButtonElement) doeRunsPrevious.disabled = !data || data.page <= 1;
    if (doeRunsNext instanceof HTMLButtonElement) doeRunsNext.disabled = !data || data.page >= data.pageCount;
    if (insertDoeRunReferences instanceof HTMLButtonElement) insertDoeRunReferences.disabled = isSigned || selectedDoeRuns.size === 0;
  };

  const loadDoeRuns = async (page = 1) => {
    if (!selectedDoeStudyId) return;
    if (doeRunsTable) {
      doeRunsTable.replaceChildren();
      const loading = document.createElement('p');
      loading.className = 'small-note';
      loading.textContent = 'Loading runs…';
      doeRunsTable.appendChild(loading);
    }
    try {
      const response = await fetch(`/reports/${reportId}/sources/doe/${selectedDoeStudyId}/runs?page=${page}&page_size=25`);
      if (!response.ok) throw new Error('Run data is unavailable.');
      renderDoeRuns(await response.json());
    } catch (error) {
      if (doeRunsTable) {
        doeRunsTable.replaceChildren();
        const message = document.createElement('p');
        message.className = 'small-note';
        message.textContent = error instanceof Error ? error.message : 'Run data is unavailable.';
        doeRunsTable.appendChild(message);
      }
    }
  };

  const renderSourcePreview = (source) => {
    if (!sourcePreviewBody || !sourcePreviewTitle) return;
    sourcePreviewTitle.textContent = source.label;
    sourcePreviewBody.replaceChildren();
    if (source.kind === 'recipe') {
      if (source.description) {
        const description = document.createElement('p');
        description.textContent = source.description;
        sourcePreviewBody.appendChild(description);
      }
      const table = document.createElement('table');
      table.className = 'pure-table table-compact source-preview-table';
      const head = table.createTHead().insertRow();
      ['Component', 'PHR'].forEach((label) => {
        const cell = document.createElement('th');
        cell.textContent = label;
        head.appendChild(cell);
      });
      const body = table.createTBody();
      (source.components || []).forEach((component) => {
        const row = body.insertRow();
        const componentCell = row.insertCell();
        componentCell.textContent = sourceText(component.component_name) || '-';
        const phrCell = row.insertCell();
        phrCell.textContent = sourceText(component.phr) || '-';
      });
      if (!source.components?.length) {
        const row = body.insertRow();
        ['-', '-'].forEach((value) => {
          const cell = row.insertCell();
          cell.textContent = value;
        });
      }
      sourcePreviewBody.appendChild(table);
    } else if (source.rows) {
      const table = document.createElement('table');
      table.className = 'pure-table table-compact source-preview-table';
      const body = table.createTBody();
      source.rows.forEach((row) => {
        const tableRow = body.insertRow();
        [row.label, row.value].forEach((entry) => {
          const cell = tableRow.insertCell();
          cell.textContent = sourceText(entry) || '-';
        });
      });
      sourcePreviewBody.appendChild(table);
    } else if (source.kind === 'chart') {
      const note = document.createElement('p');
      note.textContent = 'Insert a PNG snapshot of the current qualification chart.';
      sourcePreviewBody.appendChild(note);
    } else {
      const list = document.createElement('dl');
      list.className = 'source-preview-value';
      const term = document.createElement('dt');
      term.textContent = source.label;
      const value = document.createElement('dd');
      value.textContent = sourceText(source.value) || '-';
      list.append(term, value);
      sourcePreviewBody.appendChild(list);
    }

    document.querySelectorAll('[data-source-insert]').forEach((button) => {
      const action = button.getAttribute('data-source-insert');
      const visible = source.kind === 'recipe'
        ? action === 'table' || action === 'section'
        : source.kind === 'results'
          ? action === 'table' || action === 'section'
          : source.kind === 'run'
            ? action === 'value' || action === 'label'
            : source.kind === 'chart'
              ? action === 'figure'
              : action === 'value' || action === 'label';
      button.hidden = !visible;
      if (action === 'value') button.textContent = source.kind === 'run' ? 'Insert run reference' : 'Insert value';
      if (action === 'label') button.textContent = source.kind === 'run' ? 'Insert reference + observation' : 'Insert label + value';
      button.toggleAttribute('disabled', isSigned);
    });
  };

  const openSourcePreview = (source) => {
    if (source.kind === 'doe-analysis') {
      selectedDoeStudyId = source.studyId;
      doeAnalysisData = null;
      if (doeAnalysisMode instanceof HTMLSelectElement) doeAnalysisMode.value = 'overall';
      if (doeAnalysisDialog instanceof HTMLDialogElement) doeAnalysisDialog.showModal();
      loadDoeAnalysis();
      return;
    }
    if (source.kind === 'doe-runs') {
      selectedDoeStudyId = source.studyId;
      selectedDoeRuns.clear();
      doeRunsData = null;
      if (doeRunsDialog instanceof HTMLDialogElement) doeRunsDialog.showModal();
      loadDoeRuns(1);
      return;
    }
    selectedSource = source;
    renderSourcePreview(source);
    if (sourcePreviewDialog instanceof HTMLDialogElement) sourcePreviewDialog.showModal();
  };

  const renderSourceTree = () => {
    if (!sourceTree) return;
    const query = sourceText(sourceSearch?.value).toLowerCase();
    sourceTree.replaceChildren();
    let shownItems = 0;
    const filterSources = (items) => (items || []).flatMap((source) => {
      const children = filterSources(source.children);
      const searchable = [source.label, source.value, source.description]
        .filter(Boolean).join(' ').toLowerCase();
      return !query || searchable.includes(query) || children.length ? [{ ...source, children }] : [];
    });
    const appendSources = (parent, items) => {
      items.forEach((source) => {
        if (source.children?.length) {
          const branch = document.createElement('details');
          branch.className = 'report-source-branch';
          branch.open = Boolean(query);
          const summary = document.createElement('summary');
          summary.textContent = source.label;
          branch.appendChild(summary);
          appendSources(branch, source.children);
          parent.appendChild(branch);
          return;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'report-source-item';
        const name = document.createElement('strong');
        name.textContent = source.label;
        const detail = document.createElement('small');
        detail.textContent = source.kind === 'doe-analysis'
          ? 'Choose a calculation and insert the result'
          : source.kind === 'doe-runs'
            ? `${source.runCount || 0} runs · data and responsible person`
            : source.kind === 'run' ? 'Run result and reference' : source.kind === 'chart' ? 'Preview and insert figure' : source.kind === 'results' ? 'Preview and insert results' : source.kind === 'recipe' ? `${source.components?.length || 0} components` : 'Preview and insert';
        button.append(name, detail);
        button.addEventListener('click', () => openSourcePreview(source));
        parent.appendChild(button);
        shownItems += 1;
      });
    };
    (sourceCatalog || []).forEach((group) => {
      const items = filterSources(group.items);
      if (!items.length) return;
      const section = document.createElement('section');
      section.className = 'report-source-section';
      const heading = document.createElement('h3');
      const icon = document.createElement('span');
      icon.className = 'material-symbols-rounded';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = group.icon;
      const label = document.createElement('span');
      label.textContent = group.label;
      heading.append(icon, label);
      section.appendChild(heading);
      appendSources(section, items);
      sourceTree.appendChild(section);
    });
    if (sourceEmptyState) sourceEmptyState.hidden = shownItems > 0;
  };

  sourceSearch?.addEventListener('input', renderSourceTree);
  renderSourceTree();

  document.getElementById('closeSourcePreview')?.addEventListener('click', () => {
    if (sourcePreviewDialog instanceof HTMLDialogElement) sourcePreviewDialog.close();
  });

  document.getElementById('closeDoeAnalysis')?.addEventListener('click', () => {
    if (doeAnalysisDialog instanceof HTMLDialogElement) doeAnalysisDialog.close();
  });
  document.getElementById('closeDoeRuns')?.addEventListener('click', () => {
    if (doeRunsDialog instanceof HTMLDialogElement) doeRunsDialog.close();
  });
  [doeAnalysisMode, doeAnalysisOutput, doeAnalysisFactor, doeAnalysisSecondFactor].forEach((control) => {
    control?.addEventListener('change', loadDoeAnalysis);
  });
  doeRunsPrevious?.addEventListener('click', () => loadDoeRuns(Math.max((doeRunsData?.page || 1) - 1, 1)));
  doeRunsNext?.addEventListener('click', () => loadDoeRuns((doeRunsData?.page || 1) + 1));

  const insertDoeAnalysis = (kind) => {
    const analysis = doeAnalysisData?.analysis;
    if (!analysis || isSigned) return;
    let content = [];
    if (kind === 'chart' && analysis.chart) {
      const imageUrl = renderChartImage(() => buildDoeAnalysisOption(analysis.chart));
      content = [
        makeHeadingNode(`${doeAnalysisData.study.name} — ${analysis.title}`),
        { type: 'image', attrs: { src: imageUrl, alt: analysis.title, title: null } },
        makeParagraphNode(analysis.title)
      ];
    } else if (analysis.rows?.length) {
      const table = makeDataTable(analysis.columns, analysis.rows);
      content = kind === 'section'
        ? [makeHeadingNode(`${doeAnalysisData.study.name} — ${analysis.title}`), table]
        : [table];
    }
    if (content.length) editor.chain().focus().insertContent(content).run();
    if (doeAnalysisDialog instanceof HTMLDialogElement) doeAnalysisDialog.close();
  };
  insertDoeAnalysisTable?.addEventListener('click', () => insertDoeAnalysis('table'));
  insertDoeAnalysisSection?.addEventListener('click', () => insertDoeAnalysis('section'));
  insertDoeAnalysisChart?.addEventListener('click', () => insertDoeAnalysis('chart'));
  insertDoeRunReferences?.addEventListener('click', () => {
    if (isSigned || !selectedDoeRuns.size || !doeRunsData) return;
    const content = [makeHeadingNode(`${doeRunsData.study.name} — selected runs`)];
    selectedDoeRuns.forEach((run) => content.push(...makeDoeRunReference(run, doeRunsData.fields)));
    editor.chain().focus().insertContent(content).run();
    if (doeRunsDialog instanceof HTMLDialogElement) doeRunsDialog.close();
  });

  document.querySelectorAll('[data-source-insert]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!selectedSource || isSigned) return;
      const action = button.getAttribute('data-source-insert');
      let content = [];
      if (selectedSource.kind === 'recipe') {
        const table = makeRecipeTable(selectedSource.components);
        content = action === 'section'
          ? [
            makeHeadingNode(selectedSource.label),
            ...(selectedSource.description ? [makeParagraphNode(selectedSource.description)] : []),
            table
          ]
          : [table];
      } else if (selectedSource.kind === 'results') {
        const table = makeRowsTable(selectedSource.rows);
        content = action === 'section' ? [makeHeadingNode('Qualification results'), table] : [table];
      } else if (selectedSource.kind === 'run') {
        content = makeRunReference(selectedSource, action === 'label');
      } else if (selectedSource.kind === 'chart') {
        const imageUrl = selectedSource.chartType === 'rheology'
          ? renderChartImage(buildRheoOption)
          : selectedSource.chartType === 'process-window'
            ? renderChartImage(buildWindowOption)
            : renderChartImage(() => buildRunSeriesOption(selectedSource.chartData, selectedSource.label));
        content = [
          makeHeadingNode(selectedSource.label),
          { type: 'image', attrs: { src: imageUrl, alt: selectedSource.label, title: null } },
          makeParagraphNode(selectedSource.label)
        ];
      } else {
        const value = sourceText(selectedSource.value) || '-';
        content = [makeParagraphNode(action === 'label' ? `${selectedSource.label}: ${value}` : value)];
      }
      editor.chain().focus().insertContent(content).run();
      if (sourcePreviewDialog instanceof HTMLDialogElement) sourcePreviewDialog.close();
    });
  });

  const execCommand = (command) => {
    if (!editor || isSigned) return;
    const chain = editor.chain().focus();
    if (command === 'h1') chain.toggleHeading({ level: 1 }).run();
    if (command === 'h2') chain.toggleHeading({ level: 2 }).run();
    if (command === 'h3') chain.toggleHeading({ level: 3 }).run();
    if (command === 'bold') chain.toggleBold().run();
    if (command === 'italic') chain.toggleItalic().run();
    if (command === 'underline') chain.toggleUnderline().run();
    if (command === 'strike') chain.toggleStrike().run();
    if (command === 'highlight') chain.toggleHighlight().run();
    if (command === 'superscript') chain.toggleSuperscript().run();
    if (command === 'subscript') chain.toggleSubscript().run();
    if (command === 'bullet') chain.toggleBulletList().run();
    if (command === 'ordered') chain.toggleOrderedList().run();
    if (command === 'checklist') chain.toggleTaskList().run();
    if (command === 'quote') chain.toggleBlockquote().run();
    if (command === 'code') chain.toggleCodeBlock().run();
    if (command === 'align-left') chain.setTextAlign('left').run();
    if (command === 'align-center') chain.setTextAlign('center').run();
    if (command === 'align-right') chain.setTextAlign('right').run();
    if (command === 'align-justify') chain.setTextAlign('justify').run();
    if (command === 'hr') chain.setHorizontalRule().run();
    if (command === 'undo') chain.undo().run();
    if (command === 'redo') chain.redo().run();
    if (command === 'table') chain.insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
    if (command === 'table-row-add') chain.addRowAfter().run();
    if (command === 'table-row-del') chain.deleteRow().run();
    if (command === 'table-col-add') chain.addColumnAfter().run();
    if (command === 'table-col-del') chain.deleteColumn().run();
    if (command === 'table-del') chain.deleteTable().run();
    if (command === 'link') {
      const previous = editor.getAttributes('link').href || '';
      const href = window.prompt('Link URL', previous);
      if (href === null) return;
      if (href.trim() === '') {
        chain.extendMarkRange('link').unsetLink().run();
      } else {
        chain.extendMarkRange('link').setLink({ href: href.trim() }).run();
      }
    }
    if (command === 'image') {
      const src = window.prompt('Image URL');
      if (!src) return;
      chain.setImage({ src: src.trim(), width: '80%', align: 'center' }).run();
    }
    if (command === 'chemical-structure' || command === 'chemical-structure-edit') {
      const chemicalEditor = window.ChemicalStructureEditor;
      if (!chemicalEditor) {
        window.alert('Chemical editor is still loading. Please try again in a moment.');
        return;
      }
      const editing = command === 'chemical-structure-edit' && editor.isActive('image');
      const current = editing ? editor.getAttributes('image') : {};
      const initialStructure = current.chemicalKet || current.chemicalMolfile || current.chemicalSmiles || '';
      chemicalEditor.open({ initialStructure }).then((structure) => {
        if (!structure || isSigned) return;
        const attrs = {
          src: structure.pngDataUrl,
          alt: 'Chemical structure',
          title: null,
          width: current.width || '80%',
          align: current.align || 'center',
          chemicalKet: structure.ket,
          chemicalMolfile: structure.molfile,
          chemicalSmiles: structure.smiles
        };
        const nextChain = editor.chain().focus();
        if (editing && editor.isActive('image')) nextChain.updateAttributes('image', attrs).run();
        else nextChain.setImage(attrs).run();
      }).catch((error) => {
        window.alert(error instanceof Error ? error.message : 'Unable to export chemical structure.');
      });
      return;
    }
    if (command === 'image-width-25') chain.updateAttributes('image', { width: '25%' }).run();
    if (command === 'image-width-50') chain.updateAttributes('image', { width: '50%' }).run();
    if (command === 'image-width-75') chain.updateAttributes('image', { width: '75%' }).run();
    if (command === 'image-width-100') chain.updateAttributes('image', { width: '100%' }).run();
    if (command === 'image-align-left') chain.updateAttributes('image', { align: 'left' }).run();
    if (command === 'image-align-center') chain.updateAttributes('image', { align: 'center' }).run();
    if (command === 'image-align-right') chain.updateAttributes('image', { align: 'right' }).run();
    if (command === 'image-delete' && editor.isActive('image')) chain.deleteSelection().run();
  };

  document.querySelectorAll('#editorToolbar [data-cmd], #imageContextBar [data-cmd]').forEach((button) => {
    button.addEventListener('click', () => execCommand(button.dataset.cmd || ''));
  });

  const fontFamilySelect = document.getElementById('fontFamilySelect');
  const fontSizeSelect = document.getElementById('fontSizeSelect');
  const lineHeightSelect = document.getElementById('lineHeightSelect');
  const textPresetSelect = document.getElementById('textPresetSelect');

  const setMarkState = (mark, enabled) => {
    const active = editor.isActive(mark);
    if (enabled !== active) {
      const cmd = `toggle${mark.charAt(0).toUpperCase()}${mark.slice(1)}`;
      if (editor.chain().focus()[cmd]) editor.chain().focus()[cmd]().run();
    }
  };

  const applyPreset = (preset) => {
    if (!preset || isSigned) return;
    if (preset === 'body') {
      editor.chain().focus().setParagraph().setFontSize('16px').setLineHeight('1.5').run();
      setMarkState('bold', false);
      setMarkState('italic', false);
      setMarkState('underline', false);
      setMarkState('highlight', false);
    }
    if (preset === 'subtitle') {
      editor.chain().focus().setHeading({ level: 3 }).setFontSize('20px').setLineHeight('1.35').run();
      setMarkState('bold', true);
      setMarkState('italic', false);
      setMarkState('underline', false);
      setMarkState('highlight', false);
    }
    if (preset === 'note') {
      editor.chain().focus().setParagraph().setFontSize('15px').setLineHeight('1.65').run();
      setMarkState('bold', false);
      setMarkState('italic', true);
      setMarkState('underline', false);
      setMarkState('highlight', false);
    }
    if (preset === 'emphasis') {
      editor.chain().focus().setParagraph().setFontSize('18px').setLineHeight('1.5').run();
      setMarkState('bold', true);
      setMarkState('italic', false);
      setMarkState('underline', true);
      setMarkState('highlight', true);
    }
  };

  fontFamilySelect?.addEventListener('change', () => {
    if (isSigned) return;
    const value = fontFamilySelect.value;
    const chain = editor.chain().focus();
    if (!value) chain.unsetFontFamily().run();
    else chain.setFontFamily(value).run();
  });

  fontSizeSelect?.addEventListener('change', () => {
    if (isSigned) return;
    const value = fontSizeSelect.value;
    const chain = editor.chain().focus();
    if (!value) chain.unsetFontSize().run();
    else chain.setFontSize(value).run();
  });

  lineHeightSelect?.addEventListener('change', () => {
    if (isSigned) return;
    const value = lineHeightSelect.value;
    const chain = editor.chain().focus();
    if (!value) chain.unsetLineHeight().run();
    else chain.setLineHeight(value).run();
  });

  textPresetSelect?.addEventListener('change', () => {
    applyPreset(textPresetSelect.value);
    textPresetSelect.value = '';
  });

  const setSelectValueSafe = (selectEl, value) => {
    if (!selectEl) return;
    if (!value) {
      selectEl.value = '';
      return;
    }
    const options = Array.from(selectEl.options).map((opt) => opt.value);
    selectEl.value = options.includes(value) ? value : '';
  };

  const normalizeFontFamily = (raw) => {
    if (!raw) return '';
    const first = String(raw).split(',')[0]?.trim().replace(/^['"]|['"]$/g, '') || '';
    const map = {
      'Trebuchet MS': 'Trebuchet MS',
      Georgia: 'Georgia',
      Arial: 'Arial',
      'Courier New': 'Courier New'
    };
    return map[first] || '';
  };

  const normalizeLineHeight = (raw, fontSizePx) => {
    if (!raw) return '';
    const text = String(raw).trim().toLowerCase();
    if (!text || text === 'normal') return '';
    if (text.endsWith('px') && Number.isFinite(fontSizePx) && fontSizePx > 0) {
      const px = Number.parseFloat(text);
      if (!Number.isFinite(px)) return '';
      const ratio = px / fontSizePx;
      const allowed = ['1.2', '1.35', '1.5', '1.65', '1.8', '2'];
      const nearest = allowed
        .map((v) => Number(v))
        .reduce((best, cur) => (Math.abs(cur - ratio) < Math.abs(best - ratio) ? cur : best), 1.5);
      return String(nearest);
    }
    return text;
  };

  const readSelectionComputedStyle = () => {
    const sel = window.getSelection();
    const node = sel?.anchorNode || null;
    const el = node && node.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
    if (!el || !(el instanceof Element)) return null;
    const style = window.getComputedStyle(el);
    const fontSizeRaw = style.fontSize || '';
    const fontSizeNum = fontSizeRaw.endsWith('px') ? Number.parseFloat(fontSizeRaw) : Number.NaN;
    return {
      fontFamily: normalizeFontFamily(style.fontFamily),
      fontSize: fontSizeRaw && fontSizeRaw.endsWith('px') ? `${Math.round(fontSizeNum)}px` : '',
      lineHeight: normalizeLineHeight(style.lineHeight, fontSizeNum)
    };
  };

  const syncTextControlsFromSelection = () => {
    if (!editor) return;
    const textStyleAttrs = editor.getAttributes('textStyle') || {};
    const paragraphAttrs = editor.getAttributes('paragraph') || {};
    const headingAttrs = editor.getAttributes('heading') || {};
    const computed = readSelectionComputedStyle();

    const fontFamily = textStyleAttrs.fontFamily || computed?.fontFamily || '';
    const fontSize = textStyleAttrs.fontSize || computed?.fontSize || '';
    const lineHeight = textStyleAttrs.lineHeight || paragraphAttrs.lineHeight || headingAttrs.lineHeight || computed?.lineHeight || '';

    setSelectValueSafe(fontFamilySelect, fontFamily);
    setSelectValueSafe(fontSizeSelect, fontSize);
    setSelectValueSafe(lineHeightSelect, lineHeight);
  };

  const tablePicker = document.getElementById('tablePicker');
  const tablePickerGrid = document.getElementById('tablePickerGrid');
  const tablePickerLabel = document.getElementById('tablePickerLabel');
  const tablePickerToggle = document.getElementById('tablePickerToggle');
  const imageContextBar = document.getElementById('imageContextBar');
  const imageWidthRange = document.getElementById('imageWidthRange');
  const imageWidthValue = document.getElementById('imageWidthValue');
  const chemicalStructureEdit = document.querySelector('[data-cmd="chemical-structure-edit"]');
  const tableOpsGroup = document.getElementById('tableOpsGroup');
  const pickerRows = 10;
  const pickerCols = 10;
  let hoverRows = 3;
  let hoverCols = 3;

  const closeTablePicker = () => {
    if (!tablePicker) return;
    tablePicker.hidden = true;
  };

  const paintPicker = () => {
    if (!tablePickerGrid) return;
    tablePickerGrid.querySelectorAll('.table-picker-cell').forEach((cell) => {
      const row = Number(cell.getAttribute('data-row') || '0');
      const col = Number(cell.getAttribute('data-col') || '0');
      cell.classList.toggle('active', row <= hoverRows && col <= hoverCols);
    });
    if (tablePickerLabel) tablePickerLabel.textContent = `${hoverRows} x ${hoverCols}`;
  };

  const insertTableBySize = (rows, cols) => {
    if (!editor || isSigned) return;
    editor.chain().focus().insertTable({ rows, cols, withHeaderRow: true }).run();
  };

  if (tablePickerGrid) {
    for (let r = 1; r <= pickerRows; r += 1) {
      for (let c = 1; c <= pickerCols; c += 1) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'table-picker-cell';
        cell.setAttribute('data-row', String(r));
        cell.setAttribute('data-col', String(c));
        cell.setAttribute('aria-label', `Insert ${r} by ${c} table`);
        cell.addEventListener('mouseenter', () => {
          hoverRows = r;
          hoverCols = c;
          paintPicker();
        });
        cell.addEventListener('click', () => {
          insertTableBySize(r, c);
          closeTablePicker();
        });
        tablePickerGrid.appendChild(cell);
      }
    }
    paintPicker();
  }

  tablePickerToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    if (!tablePicker || isSigned) return;
    tablePicker.hidden = !tablePicker.hidden;
  });

  tablePicker?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  document.addEventListener('click', () => closeTablePicker());

  const syncContextToolsVisibility = () => {
    const imageActive = editor.isActive('image');
    const tableActive = editor.isActive('table');
    imageContextBar?.classList.toggle('is-visible', imageActive);
    if (chemicalStructureEdit instanceof HTMLElement) {
      chemicalStructureEdit.hidden = !imageActive || !editor.getAttributes('image').chemicalKet;
    }
    tableOpsGroup?.classList.toggle('is-visible', tableActive);
    if (imageActive) {
      const width = normalizeImageWidth(editor.getAttributes('image').width);
      const numericWidth = Number.parseInt(width, 10);
      if (imageWidthRange instanceof HTMLInputElement) imageWidthRange.value = String(numericWidth);
      if (imageWidthValue) imageWidthValue.textContent = width;
    }
  };

  imageWidthRange?.addEventListener('input', () => {
    if (isSigned || !editor.isActive('image') || !(imageWidthRange instanceof HTMLInputElement)) return;
    const width = normalizeImageWidth(imageWidthRange.value);
    editor.chain().focus().updateAttributes('image', { width }).run();
    if (imageWidthValue) imageWidthValue.textContent = width;
  });

  if (isSigned) {
    document.getElementById('editorToolbar')?.classList.add('is-disabled');
    document.querySelectorAll('#editorToolbar button').forEach((btn) => btn.setAttribute('disabled', 'true'));
    document.querySelectorAll('#editorToolbar select').forEach((sel) => sel.setAttribute('disabled', 'true'));
  } else {
    syncTextControlsFromSelection();
    editor.on('selectionUpdate', syncTextControlsFromSelection);
    editor.on('transaction', syncTextControlsFromSelection);
    syncContextToolsVisibility();
    editor.on('selectionUpdate', syncContextToolsVisibility);
    editor.on('transaction', syncContextToolsVisibility);
  }

  const saveBtn = document.getElementById('saveReport');
  if (isSigned) {
    saveBtn?.setAttribute('disabled', 'true');
    saveBtn?.classList.add('button-disabled');
  }

  let saveInFlight = null;
  let lastSavedFingerprint = JSON.stringify(editor.getJSON());
  let pendingFingerprint = lastSavedFingerprint;
  let autosaveTimer = null;
  let isDirty = false;

  const saveStatus = document.getElementById('saveStatus');
  const saveReport = document.getElementById('saveReport');

  const setSavingUi = (saving, manual = false) => {
    if (!saveBtn) return;
    if (!manual) return;
    if (saving) {
      saveBtn.classList.add('is-saving');
      saveBtn.textContent = 'Saving...';
    } else {
      saveBtn.classList.remove('is-saving');
      saveBtn.textContent = 'Save';
    }
  };

  const persistEditor = async (manual = false) => {
    if (isSigned) return;
    const data = editor.getJSON();
    const fingerprint = JSON.stringify(data);
    pendingFingerprint = fingerprint;
    if (!manual && fingerprint === lastSavedFingerprint) return;
    if (saveInFlight) return;
    if (manual) {
      saveStatus.textContent = 'Saving...';
    } else {
      saveStatus.textContent = 'Autosaving...';
    }
    setSavingUi(true, manual);
    const html = editor.getHTML();
    const payload = new URLSearchParams();
    payload.set('content_json', fingerprint);
    payload.set('html_snapshot', html);
    payload.set('content_md', turndown.turndown(html));
    saveInFlight = fetch('/reports/<%= reportConfig.id %>/editor', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: payload
    });
    const resp = await saveInFlight.catch(() => null);
    saveInFlight = null;
    if (resp?.ok) {
      lastSavedFingerprint = fingerprint;
      isDirty = false;
      const now = new Date();
      const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      saveStatus.textContent = manual ? `Saved at ${time}` : `Autosaved at ${time}`;
    } else {
      saveStatus.textContent = 'Error saving';
    }
    setSavingUi(false, manual);
    if (pendingFingerprint !== lastSavedFingerprint) {
      if (autosaveTimer) clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(() => persistEditor(false), 900);
    }
  };

  saveReport?.addEventListener('click', () => persistEditor(true));

  if (!isSigned) {
    const scheduleAutosave = () => {
      if (autosaveTimer) clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(() => persistEditor(false), 1200);
    };

    editor.on('update', () => {
      isDirty = true;
      scheduleAutosave();
    });

    editor.on('blur', () => {
      if (!isDirty) return;
      if (autosaveTimer) clearTimeout(autosaveTimer);
      persistEditor(false);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && isDirty) {
        if (autosaveTimer) clearTimeout(autosaveTimer);
        persistEditor(false);
      }
    });

    window.setInterval(() => {
      if (isDirty && !saveInFlight) {
        persistEditor(false);
      }
    }, 5000);

    window.addEventListener('beforeunload', () => {
      if (isDirty) {
        persistEditor(false);
      }
    });
  }

  const exportPdfBtn = document.getElementById('printReport');
  exportPdfBtn?.addEventListener('click', async () => {
    if (!isSigned) {
      await persistEditor(false);
    }
    if (exportPdfBtn instanceof HTMLButtonElement) {
      exportPdfBtn.disabled = true;
      exportPdfBtn.textContent = 'Exporting...';
    }
    saveStatus.textContent = 'Opening print view...';
    try {
      const url = `/reports/<%= reportConfig.id %>/editor/print?ts=${Date.now()}`;
      const win = window.open(url, '_blank', 'noopener,noreferrer');
      saveStatus.textContent = win ? 'Print view opened' : 'Allow pop-ups to export PDF';
    } catch {
      saveStatus.textContent = 'PDF export failed';
    } finally {      
      if (exportPdfBtn instanceof HTMLButtonElement) {
        exportPdfBtn.disabled = false;
        exportPdfBtn.textContent = 'Export PDF';
      }
    }
  });

  const exportDocxBtn = document.getElementById('exportDocx');
  exportDocxBtn?.addEventListener('click', async () => {
    if (!isSigned) {
      await persistEditor(false);
    }
    if (exportDocxBtn instanceof HTMLButtonElement) {
      exportDocxBtn.disabled = true;
      exportDocxBtn.textContent = 'Preparing...';
    }
    saveStatus.textContent = 'Preparing DOCX...';
    window.location.assign(`/reports/<%= reportConfig.id %>/export.docx?ts=${Date.now()}`);
    window.setTimeout(() => {
      if (exportDocxBtn instanceof HTMLButtonElement) {
        exportDocxBtn.disabled = false;
        exportDocxBtn.textContent = 'Export DOCX';
      }
      saveStatus.textContent = 'DOCX download started';
    }, 900);
  });
</script>
<%- include('partials/foot') %>
