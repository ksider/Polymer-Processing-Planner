  const qualSettingsForm = document.getElementById('qualSettingsForm');
  const qualStepAssigneeInput = document.getElementById('qualStepAssigneeInput');
  const qualStepResponsibleLabel = document.getElementById('qualStepResponsibleLabel');
  const qualAssignableUserById = new Map(<%- jsonForScript((assignableUsers || []).map((user) => [String(user.id), user.name || user.email])) %>);
  const openBtn = document.getElementById('openQualFields');
  const machineParamMap = <%- jsonForScript(machineParamMap || {}) %>;
  // Template tokens (%machineId:paramId%) are resolved in UI summaries while inputs keep the token.
  const applyTemplateMap = () => {
    window.IMPlanner?.setTemplateMap(machineParamMap);
    document.dispatchEvent(new Event('templateMapReady'));
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyTemplateMap);
  } else {
    applyTemplateMap();
  }
  const resolveTemplateValue = (value) => {
    const raw = String(value ?? '');
    if (/%\d+:\d+%/.test(raw) && window.IMPlanner?.resolveTemplate) {
      const result = window.IMPlanner.resolveTemplate(raw);
      if (result?.missing?.length) return raw;
      return result?.resolved ?? raw;
    }
    return raw;
  };
  const showDialog = (dlg) => {
    if (!dlg) return;
    if (typeof dlg.showModal === 'function') {
      dlg.showModal();
    } else {
      dlg.setAttribute('open', '');
    }
  };
  const saveQualificationSettings = async (payload, statusEl) => {
    try {
      const response = await fetch(`/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/settings`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: payload
      });
      if (!response.ok) {
        let detail = '';
        try {
          const body = await response.json();
          detail = body?.error || body?.message || '';
        } catch {
          // A non-JSON error page is still reported through the status below.
        }
        throw new Error(detail || `Request failed (${response.status})`);
      }
      return true;
    } catch (error) {
      if (statusEl) statusEl.textContent = 'Save failed';
      window.IMPlanner?.notify?.({
        type: 'error',
        title: 'Settings were not saved',
        message: 'The calculation remains available locally. Check the connection and retry.'
      });
      console.error('[qualification] Failed to save settings', error);
      return false;
    }
  };
  const parseRange = (value) => {
    if (value == null) return { min: null, max: null };
    const text = resolveTemplateValue(value).trim();
    if (!text) return { min: null, max: null };
    const parseNum = (val) => {
      if (val == null) return NaN;
      const raw = resolveTemplateValue(val).trim();
      if (!raw) return NaN;
      return parseFloat(raw.replace(',', '.'));
    };
    const parts = text.split(',').map((part) => parseNum(part));
    const min = Number.isFinite(parts[0]) ? parts[0] : null;
    const max = Number.isFinite(parts[1]) ? parts[1] : null;
    return { min, max };
  };
