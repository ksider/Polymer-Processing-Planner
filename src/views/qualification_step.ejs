        <button class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50" type="button" data-close>Close</button>
      </div>
      <div class="p-5">
        <div class="grid-two">
          <div>
            <label>Injection speed</label>
            <input type="text" id="coolingInjSpeed" data-template-input value="<%= settings.inj_speed ?? step1Recommended ?? '' %>">
            <div class="template-preview" data-template-preview></div>
          </div>
          <div>
            <label>Melt temperature (°C)</label>
            <input type="text" id="coolingMeltTemp" data-template-input value="<%= settings.melt_temp_c ?? step4CenterTemp ?? '' %>">
            <div class="template-preview" data-template-preview></div>
          </div>
          <div>
            <label>Hold pressure (bar)</label>
            <input type="text" id="coolingHoldPressure" data-template-input value="<%= settings.hold_pressure_bar ?? step4CenterPressure ?? '' %>">
            <div class="template-preview" data-template-preview></div>
          </div>
          <div>
            <label>Gate seal time (s)</label>
            <input type="text" id="coolingGateSeal" data-template-input value="<%= settings.gate_seal_time_s ?? step5GateSealTime ?? '' %>">
            <div class="template-preview" data-template-preview></div>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-200 px-5 py-4">
        <span class="save-status" id="coolingSetupStatus">Saved</span>
        <button class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50" type="button" data-close>Close</button>
      </div>
    </dialog>
  <% } else { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold tracking-tight text-gray-900">Runs</h2>
      <table class="<%= inputTableClass %>">
        <thead>
          <tr>
            <th>Run</th>
            <th>Due date</th>
            <th>Done</th>
            <th>Exclude</th>
          </tr>
        </thead>
        <tbody>
          <% if (runs.length === 0) { %>
            <tr><td colspan="4">No runs yet.</td></tr>
          <% } %>
          <% runs.forEach((run) => { %>
            <tr class="<%= run.done ? 'run-done' : '' %> <%= run.exclude_from_analysis ? 'run-excluded' : '' %>">
              <td><a href="/qual-runs/<%= run.id %>"><%= run.run_code %></a></td>
              <td><input type="date" data-ui-datepicker datepicker-autohide datepicker-format="yyyy-mm-dd" data-qual-list-due data-run-id="<%= run.id %>" value="<%= run.due_at || '' %>"></td>
              <td><%= run.done ? 'Yes' : 'No' %></td>
              <td><%= run.exclude_from_analysis ? 'Yes' : 'No' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <script nonce="<%= cspNonce %>">
        (() => {
          const inputs = Array.from(document.querySelectorAll('input[data-qual-list-due]'));
          inputs.forEach((input) => {
            input.addEventListener('change', async () => {
              const runId = input.getAttribute('data-run-id');
              if (!runId) return;
              const form = new FormData();
              form.append('due_at', input.value || '');
              const resp = await fetch(`/qual-runs/${runId}/due-at`, { method: 'POST', body: form });
              if (!resp.ok) window.alert('Failed to save run date.');
            });
          });
        })();
      </script>
    </div>
  <% } %>
</div></main></div>
<%- include('partials/experiment_workspace_calendar', { workspace }) %>

<dialog class="m-auto w-[min(96vw,48rem)] rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/40" id="qualFieldDialog">
  <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-4">
    <strong>Qualification fields</strong>
    <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-close>Close</button>
  </div>
  <div class="p-5">
    <% if (step.step_number === 2) { %>
      <% const cavityDefs = new Map(); %>
      <% fields.forEach((field) => { %>
        <% const match = /^cavity(\d+)_(.+)$/.exec(field.code); %>
        <% if (!match) return; %>
        <% const suffix = match[2]; %>
        <% if (suffix === 'weight_g' || suffix === 'defect_tags') return; %>
        <% if (!cavityDefs.has(suffix)) { %>
          <% const baseLabel = field.label.replace(/^Cavity\s+\d+\s+/i, ''); %>
          <% cavityDefs.set(suffix, { suffix, label: baseLabel || field.label, unit: field.unit, field_type: field.field_type }); %>
        <% } %>
      <% }); %>
      <div class="text-sm text-gray-500">Manage cavity-specific columns. Changes apply to all cavities.</div>
      <div class="mb-4 flex flex-wrap items-end gap-3">
        <label class="mb-0 block text-sm font-medium text-heading" for="qualLibrarySelect">
          Library
          <select class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-ui-control-exempt id="qualLibrarySelect">
            <option value="">Select parameter…</option>
            <% globalParams.forEach((param) => { %>
              <option
                value="<%= param.id %>"
                data-code="<%= param.code %>"
                data-label="<%= param.label %>"
                data-unit="<%= param.unit || '' %>"
                data-type="<%= param.field_type %>"
              >
                <%- formatInline(param.label) %> (<%= param.code %>)
              </option>
            <% }); %>
          </select>
        </label>
        <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2.5 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="qualImportField">Add from library</button>
        <a class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2.5 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft" href="/param-library">Open library</a>
      </div>
      <div class="overflow-x-auto rounded-base border border-default-medium">
