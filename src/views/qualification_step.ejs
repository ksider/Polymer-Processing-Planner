    <dialog class="m-auto w-[min(96vw,48rem)] rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/40" id="pressureSetupDialog">
      <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-4">
