<%- include('partials/head', { title: 'Polymer Processing Planner | Qualification Step', uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<% const inputTableClass = 'min-w-full border-separate border-spacing-y-2 text-left text-sm text-body [&_thead_th]:whitespace-nowrap [&_thead_th]:px-3 [&_thead_th]:py-2 [&_thead_th]:text-xs [&_thead_th]:font-medium [&_thead_th]:uppercase [&_thead_th]:text-body [&_tbody_td]:border-y [&_tbody_td]:border-default-medium [&_tbody_td]:bg-neutral-primary [&_tbody_td]:px-3 [&_tbody_td]:py-2 [&_tbody_td:first-child]:rounded-s-base [&_tbody_td:first-child]:border-s [&_tbody_td:last-child]:rounded-e-base [&_tbody_td:last-child]:border-e' %>
<div class="flex min-h-[calc(100vh-4rem)] w-full overflow-x-clip bg-gray-50">
  <%- include('partials/experiment_workspace_sidebar', { workspace }) %>
  <main class="min-w-0 flex-1"><div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5">
    <div class="mb-3 flex items-center justify-between gap-3 lg:hidden"><button class="inline-flex items-center gap-2 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs" type="button" data-open-experiment-calendar><span class="material-symbols-rounded text-[19px]" aria-hidden="true">calendar_month</span>Calendar</button><a class="inline-flex items-center gap-2 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs" href="<%= `${experimentPath(experimentId)}#qualification` %>"><span class="material-symbols-rounded text-[19px]" aria-hidden="true">fact_check</span>Qualification</a></div>
  <section class="mb-4 rounded-xl border border-default-medium bg-neutral-primary px-4 py-3 shadow-xs" id="qualification-step-overview">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a class="inline-flex size-9 items-center justify-center rounded-base text-body no-underline hover:bg-neutral-secondary hover:text-heading" href="<%= `${experimentPath(experimentId)}#qualification` %>" aria-label="Back to experiment qualification">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
      </a>
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-base font-semibold tracking-tight text-heading">Step <%= step.step_number %>: <%= stepDef?.name || 'Qualification Step' %></h1>
        <p class="mt-0.5 text-xs text-body">
          Responsible:
          <span id="qualStepResponsibleLabel">
            <% if (stepAssigneeId) { %>
              <a href="/users/<%= stepAssigneeId %>"><%- formatInline(stepAssigneeLabel || `User #${stepAssigneeId}`) %></a>
            <% } else { %>
              <span>-</span>
            <% } %>
          </span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="openQualFields" <%= step.is_blocked === 1 ? 'disabled' : '' %>>
          <%= step.step_number === 2 ? 'Fields' : 'Fields' %>
        </button>
        <% if (canAssignEntities) { %>
          <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" id="openQualSettingsDialog" title="Qualification settings">
            <span class="material-symbols-rounded" aria-hidden="true">edit</span>
          </button>
        <% } %>
        <% if (canBlockQualification) { %>
          <% if (step.is_blocked === 1) { %>
            <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/block" method="post">
              <input type="hidden" name="action" value="unblock">
              <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-heading" title="Unblock this stage">
                <input class="peer sr-only" type="checkbox" checked data-block-toggle>
                <span class="relative h-5 w-9 rounded-full bg-neutral-tertiary after:absolute after:start-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-neutral-primary after:shadow-xs after:transition-all peer-checked:after:translate-x-4"></span>
                Stage blocked
              </label>
            </form>
          <% } else { %>
            <details class="relative">
              <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-medium text-heading [&::-webkit-details-marker]:hidden">
                <span class="relative h-5 w-9 rounded-full bg-emerald-500 after:absolute after:start-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-neutral-primary after:shadow-xs after:transition-all"></span>
                Block stage
              </summary>
              <form class="absolute right-4 z-20 mt-3 grid w-80 gap-3 rounded-base border border-default-medium bg-neutral-primary p-3 shadow-lg" action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/block" method="post">
                <label class="block text-sm font-medium text-heading" for="qualificationBlockReason">Reason</label>
                <input class="block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2.5 text-sm text-heading shadow-xs placeholder:text-body focus:border-brand focus:ring-brand" id="qualificationBlockReason" name="reason" type="text" maxlength="500" required>
                <input type="hidden" name="action" value="block">
                <button class="inline-flex w-fit items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand" type="submit">Confirm block</button>
              </form>
            </details>
          <% } %>
        <% } %>
      </div>
    </div>
    <% if (step.is_blocked === 1) { %>
      <p class="text-sm text-gray-500" role="status">
        This stage is blocked<%= step.blocked_by_label ? ` by ${step.blocked_by_label}` : '' %><%= step.blocked_at ? ` on ${step.blocked_at}` : '' %>.
        Reason: <strong><%= step.blocked_reason || '-' %></strong>
      </p>
    <% } %>
  </section>

  <% if (canAssignEntities) { %>
    <dialog class="m-auto w-[min(96vw,48rem)] rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/40" id="qualSettingsDialog">
      <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-4">
        <strong>Qualification settings</strong>
        <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-close>Close</button>
      </div>
      <form class="grid gap-4" id="qualSettingsForm" action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/assignee" method="post">
        <div class="p-5">
          <label class="mb-2.5 block text-sm font-medium text-heading" for="qualStepAssigneeInput">Responsible</label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3">
              <svg class="size-4 text-body" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m17-9a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>
            </div>
            <select class="block w-full rounded-base border border-default-medium bg-neutral-secondary-medium py-2.5 pe-3 ps-9 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" id="qualStepAssigneeInput" name="assignee_user_id" data-ui-control-exempt>
              <option value="">Unassigned</option>
              <% assignableUsers.forEach((user) => { %>
                <option value="<%= user.id %>" <%= stepAssigneeId === user.id ? 'selected' : '' %>>
                  <%= user.name || user.email %> (<%= user.role || 'user' %>)
                </option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-200 px-5 py-4">
          <span class="text-sm text-gray-500" data-autosave-status></span>
          <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2.5 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-close>Cancel</button>
          <button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand disabled:cursor-not-allowed disabled:opacity-50" type="submit">Save</button>
        </div>
      </form>
    </dialog>
  <% } %>

  <%- include('partials/entity_notes', {
    experimentId: experimentId,
    entityType: 'qualification_step',
    entityId: step.id,
    title: `Step ${step.step_number} Notes`,
    canWrite: currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer')
  }) %>

  <% if (step.step_number === 1) { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Setup</h2>
        <div class="flex flex-wrap items-center gap-2">
          <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2.5 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="openRheoSetup">Edit setup</button>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <div class="text-sm text-gray-500">Intensification coefficient</div>
          <div class="mt-1 text-sm text-gray-900">
            <span data-template-output data-template-source="rheoIntCoeff" data-template-fallback="1"><%= settings.intensification_coeff ?? machineIntensification ?? 1 %></span>
            <span class="text-sm text-gray-500"><%= unitByCode.intensification_coeff || '' %></span>
          </div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Melt temperature</div>
          <div class="mt-1 text-sm text-gray-900">
            <span data-template-output data-template-source="rheoMeltTemp" data-template-fallback="-"><%= settings.melt_temp_c ?? '-' %></span>
            <span class="text-sm text-gray-500"><%= unitByCode.melt_temp || '' %></span>
          </div>
        </div>
        <% if (settings.custom_fields && settings.custom_fields.length) { %>
          <% settings.custom_fields.forEach((field) => { %>
            <div>
              <div class="text-sm text-gray-500"><%- formatInline(field.label) %></div>
              <div class="mt-1 text-sm text-gray-900"><%= field.value ?? '-' %> <span class="text-sm text-gray-500"><%- formatInline(field.unit || '') %></span></div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Rheology Runs</h2>
        <div class="flex items-end gap-3">
          <label class="mb-0 block text-sm font-medium text-heading" for="rheoXAxis">
            X-axis
            <select class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-ui-control-exempt id="rheoXAxis">
              <option value="inj_speed">Injection speed</option>
              <option value="shear_rate_proxy">Shear rate</option>
            </select>
          </label>
        </div>
        <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" id="rheoAddRow" title="Add row">
          <span class="material-symbols-rounded" aria-hidden="true">add</span>
        </button>
      </div>
      <% const fieldByCode = new Map(); fields.forEach((field) => fieldByCode.set(field.code, field)); %>
      <% const injField = fieldByCode.get('inj_speed'); %>
      <% const pressField = fieldByCode.get('peak_inj_pressure_bar'); %>
      <% const fillField = fieldByCode.get('fill_time_s'); %>
      <% const shearRateField = fieldByCode.get('shear_rate_proxy'); %>
      <% const viscField = fieldByCode.get('rel_viscosity'); %>
      <% const injFieldId = injField?.id ?? null; %>
      <% const pressFieldId = pressField?.id ?? null; %>
      <% const fillFieldId = fillField?.id ?? null; %>
      <% const baseCodes = new Set(['inj_speed','peak_inj_pressure_bar','fill_time_s','shear_rate_proxy','rel_viscosity']); %>
      <% const extraFields = fields.filter((field) => !field.is_derived && !baseCodes.has(field.code) && field.is_enabled); %>
      <input type="hidden" id="rheoFieldIds"
        data-inj="<%= injFieldId ?? '' %>"
        data-press="<%= pressFieldId ?? '' %>"
        data-fill="<%= fillFieldId ?? '' %>">
      <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="<%= inputTableClass %> rheo-table">
          <thead>
            <tr>
              <th>Run</th>
              <th>Due date</th>
              <th>Injection speed <span class="text-sm text-gray-500"><%= unitByCode.inj_speed || injField?.unit || '' %></span></th>
              <th>Press pressure <span class="text-sm text-gray-500"><%= (unitByCode.peak_inj_pressure || pressField?.unit || '') %></span></th>
              <th>Fill time <span class="text-sm text-gray-500"><%= (unitByCode.fill_time || fillField?.unit || '') %></span></th>
      <% extraFields.forEach((field) => { %>
        <th
          data-extra-field
          data-field-id="<%= field.id %>"
          data-field-type="<%= field.field_type %>"
          data-field-allowed="<%= field.allowed_values_json || '' %>"
        ><%- formatInline(field.label) %><% if (field.unit) { %> <span class="text-sm text-gray-500"><%= field.unit %></span><% } %></th>
      <% }); %>
              <th data-rheo-derived>Shear rate <span class="text-sm text-gray-500"><%= shearRateField?.unit || '' %></span></th>
              <th>Rel. viscosity <span class="text-sm text-gray-500"><%= viscField?.unit || '' %></span></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (runs.length === 0) { %>
              <tr><td colspan="<%= 8 + extraFields.length %>">No runs yet.</td></tr>
            <% } %>
            <% runs.forEach((run) => { %>
              <% const runValues = runValueMap[String(run.id)] || {}; %>
              <% const injVal = injFieldId ? (runValues[String(injFieldId)]?.value_real ?? '') : ''; %>
              <% const pressVal = pressFieldId ? (runValues[String(pressFieldId)]?.value_real ?? '') : ''; %>
              <% const fillVal = fillFieldId ? (runValues[String(fillFieldId)]?.value_real ?? '') : ''; %>
              <% const shearRateVal = shearRateField?.id ? (runValues[String(shearRateField.id)]?.value_real ?? '') : ''; %>
              <% const viscVal = viscField?.id ? (runValues[String(viscField.id)]?.value_real ?? '') : ''; %>
              <tr data-run-row data-run-id="<%= run.id %>">
                <td><strong><%= run.run_code %></strong></td>
                <td><input type="date" data-ui-datepicker datepicker-autohide datepicker-format="yyyy-mm-dd" data-run-due value="<%= run.due_at || '' %>"></td>
                <td><input type="number" step="any" data-field-id="<%= injFieldId %>" data-field-type="number" value="<%= injVal %>"></td>
                <td><input type="number" step="any" data-field-id="<%= pressFieldId %>" data-field-type="number" value="<%= pressVal %>"></td>
                <td><input type="number" step="any" data-field-id="<%= fillFieldId %>" data-field-type="number" value="<%= fillVal %>"></td>
                <% extraFields.forEach((field) => { %>
                  <% const val = runValues[String(field.id)]; %>
                  <td>
                    <% if (field.field_type === 'boolean') { %>
                      <input type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= val?.value_real === 1 ? 'checked' : '' %>>
                    <% } else if (field.field_type === 'text') { %>
                      <input type="text" data-field-id="<%= field.id %>" data-field-type="text" value="<%= val?.value_text || '' %>">
                    <% } else if (field.field_type === 'tag') { %>
                      <% let allowed = []; %>
                      <% if (field.allowed_values_json) { try { const parsed = JSON.parse(field.allowed_values_json); if (Array.isArray(parsed)) allowed = parsed; } catch {} } %>
                      <% let selected = []; %>
                      <% if (val?.value_tags_json) { try { const parsed = JSON.parse(val.value_tags_json); if (Array.isArray(parsed)) selected = parsed.map(String); } catch {} } %>
                      <div class="tag-select" data-tag-select>
                        <div class="tag-selected" data-tag-selected>
                          <% if (selected.length === 0) { %>
                            <span class="tag-placeholder">Select...</span>
                          <% } %>
                          <% selected.forEach((tag) => { %>
                            <span class="tag-chip"><%- formatInline(tag) %></span>
                          <% }); %>
                        </div>
                        <div class="tag-panel" data-tag-panel>
                          <input class="tag-filter" data-tag-filter type="text" placeholder="Filter...">
                          <div class="tag-options">
                            <% allowed.forEach((tag) => { %>
                              <label class="tag-option" data-tag-option data-tag-label="<%= tag %>">
                                <input type="checkbox" data-field-id="<%= field.id %>" data-field-type="tag" data-tag-value="<%= tag %>" <%= selected.includes(String(tag)) ? 'checked' : '' %>>
                                <span class="tag-chip"><%- formatInline(tag) %></span>
                              </label>
                            <% }); %>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <input type="number" step="any" data-field-id="<%= field.id %>" data-field-type="number" value="<%= val?.value_real ?? '' %>">
                    <% } %>
                  </td>
                <% }); %>
                <td class="font-medium text-heading" data-derived="shear_rate_proxy"><%= formatNumber(shearRateVal) %></td>
                <td class="font-medium text-heading" data-derived="rel_viscosity"><%= formatNumber(viscVal) %></td>
                <td>
                  <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-danger shadow-xs hover:bg-danger-soft focus:outline-none focus:ring-4 focus:ring-danger-soft" type="button" data-run-delete title="Delete row">
                    <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="mt-4 border-t border-default pt-4">
        <div id="rheoChart" style="width: 100%; height: 320px;"></div>
        <div class="mt-4 flex flex-wrap items-end gap-3">
          <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2.5 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="rheoAnalyze">Analyze curve</button>
          <label class="mb-0 block text-sm font-medium text-heading" for="rheoRecommended">
            Recommended injection speed
            <input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-ui-control-exempt type="number" step="any" id="rheoRecommended" value="<%= settings.recommended_inj_speed ?? '' %>">
          </label>
          <span class="pb-2.5 text-sm text-body">cm3/s</span>
        </div>
      </div>
    </div>
  <% } else if (step.step_number === 2) { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Setup</h2>
        <div class="flex flex-wrap items-center gap-2">
          <button class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50" type="button" id="openCavitySetup">Edit setup</button>
          <span class="text-sm text-gray-500">Optional step</span>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <div class="text-sm text-gray-500">Injection speed</div>
          <div class="mt-1 text-sm text-gray-900"><span id="cavityInjSpeedValue"><%= settings.inj_speed ?? step1Recommended ?? '-' %></span> <span class="text-sm text-gray-500">cm3/s</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Target weight</div>
          <div class="mt-1 text-sm text-gray-900"><span id="cavityTargetWeightValue"><%= settings.target_weight_g ?? '-' %></span> <span class="text-sm text-gray-500">g</span></div>
        </div>
      </div>
    </div>

    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Cavities</h2>
        <div class="flex flex-wrap items-center gap-2">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-heading" for="cavityRunDue">Due date</label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3">
                <span class="material-symbols-rounded text-[18px] text-body" aria-hidden="true">calendar_month</span>
              </div>
              <input class="block w-full rounded-base border border-default-medium bg-neutral-secondary-medium py-2 pe-3 ps-9 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="date" id="cavityRunDue" value="<%= runs[0]?.due_at || '' %>" data-ui-datepicker datepicker-autohide datepicker-format="yyyy-mm-dd" data-ui-control-exempt>
            </div>
          </div>
          <button class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900" type="button" id="addCavityBtn" title="Add cavity">
            <span class="material-symbols-rounded" aria-hidden="true">add</span>
          </button>
        </div>
      </div>
      <% const fieldByCode2 = new Map(); fields.forEach((field) => fieldByCode2.set(field.code, field)); %>
      <% const cavityIndices = Array.from(new Set(fields.map((field) => { const match = /^cavity(\d+)_weight_g$/.exec(field.code); return match ? Number(match[1]) : null; }).filter((v) => Number.isFinite(v)))).sort((a, b) => a - b); %>
      <% const cavityFieldDefs = new Map(); %>
      <% fields.forEach((field) => { %>
        <% const match = /^cavity(\d+)_(.+)$/.exec(field.code); %>
        <% if (!match) return; %>
        <% const suffix = match[2]; %>
        <% if (suffix === 'weight_g' || suffix === 'defect_tags') return; %>
        <% if (!cavityFieldDefs.has(suffix)) { %>
          <% const baseLabel = field.label.replace(/^Cavity\\s+\\d+\\s+/i, ''); %>
          <% cavityFieldDefs.set(suffix, { suffix, label: baseLabel || field.label, field_type: field.field_type, unit: field.unit }); %>
        <% } %>
      <% }); %>
      <% const variationField = fieldByCode2.get('cavity_weight_variation_pct'); %>
