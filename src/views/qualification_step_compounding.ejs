<%- include('partials/head', { title: 'Polymer Processing Planner | Qualification Step', uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<% const inputTableClass = 'min-w-full border-separate border-spacing-y-2 text-left text-sm text-body [&_thead_th]:whitespace-nowrap [&_thead_th]:px-3 [&_thead_th]:py-2 [&_thead_th]:text-xs [&_thead_th]:font-medium [&_thead_th]:uppercase [&_thead_th]:text-body [&_tbody_td]:border-y [&_tbody_td]:border-default-medium [&_tbody_td]:bg-neutral-primary [&_tbody_td]:px-3 [&_tbody_td]:py-2 [&_tbody_td:first-child]:rounded-s-base [&_tbody_td:first-child]:border-s [&_tbody_td:last-child]:rounded-e-base [&_tbody_td:last-child]:border-e' %>
<div class="flex min-h-[calc(100vh-4rem)] w-full overflow-x-clip bg-gray-50">
  <%- include('partials/experiment_workspace_sidebar', { workspace }) %>
  <main class="min-w-0 flex-1"><div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5">
    <div class="mb-3 flex items-center justify-between gap-3 lg:hidden"><button class="inline-flex items-center gap-2 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs" type="button" data-open-experiment-calendar><span class="material-symbols-rounded text-[19px]" aria-hidden="true">calendar_month</span>Calendar</button><a class="inline-flex items-center gap-2 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs" href="<%= `${experimentPath(experimentId)}#qualification` %>"><span class="material-symbols-rounded text-[19px]" aria-hidden="true">fact_check</span>Qualification</a></div>
  <section class="mb-4 rounded-xl border border-default-medium bg-neutral-primary px-4 py-3 shadow-xs" id="qualification-step-overview">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a class="inline-flex size-9 items-center justify-center rounded-base text-body no-underline hover:bg-neutral-secondary hover:text-heading" href="<%= `${experimentPath(experimentId)}#qualification` %>" aria-label="Back to experiment qualification">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
      </a>
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-base font-semibold tracking-tight text-heading">Step <%= step.step_number %>: <%= stepDef?.name || 'Qualification Step' %></h1>
        <p class="mt-0.5 text-xs text-body">
          Responsible:
          <span id="qualStepResponsibleLabel">
            <% if (stepAssigneeId) { %>
              <a href="/users/<%= stepAssigneeId %>"><%- formatInline(stepAssigneeLabel || `User #${stepAssigneeId}`) %></a>
            <% } else { %>
              <span>-</span>
            <% } %>
          </span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-tertiary focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="openQualFields" <%= step.is_blocked === 1 ? 'disabled' : '' %>>Fields</button>
        <% if (canAssignEntities) { %>
          <button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" id="openQualSettingsDialog" title="Qualification settings">
            <span class="material-symbols-rounded" aria-hidden="true">edit</span>
          </button>
        <% } %>
        <% if (canBlockQualification) { %>
          <% if (step.is_blocked === 1) { %>
            <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/block" method="post">
              <input type="hidden" name="action" value="unblock">
              <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-heading" title="Unblock this stage">
                <input class="peer sr-only" type="checkbox" checked data-block-toggle>
                <span class="relative h-5 w-9 rounded-full bg-neutral-tertiary after:absolute after:start-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-neutral-primary after:shadow-xs after:transition-all peer-checked:after:translate-x-4"></span>
                Stage blocked
              </label>
            </form>
          <% } else { %>
            <details class="relative">
              <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-medium text-heading [&::-webkit-details-marker]:hidden">
                <span class="relative h-5 w-9 rounded-full bg-emerald-500 after:absolute after:start-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-neutral-primary after:shadow-xs after:transition-all"></span>
                Block stage
              </summary>
              <form class="absolute right-4 z-20 mt-3 grid w-80 gap-3 rounded-base border border-default-medium bg-neutral-primary p-3 shadow-lg" action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/block" method="post">
                <label class="grid gap-1 text-sm font-medium text-heading">Reason <input class="rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="reason" type="text" maxlength="500" required></label>
                <input type="hidden" name="action" value="block">
                <button class="inline-flex w-fit items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand" type="submit">Confirm block</button>
              </form>
            </details>
          <% } %>
        <% } %>
      </div>
    </div>
    <% if (step.is_blocked === 1) { %>
      <p class="mt-3 text-sm text-body" role="status">
        This stage is blocked<%= step.blocked_by_label ? ` by ${step.blocked_by_label}` : '' %><%= step.blocked_at ? ` on ${step.blocked_at}` : '' %>.
        Reason: <strong><%= step.blocked_reason || '-' %></strong>
      </p>
    <% } %>
    <% if (processTypeCode !== 'extrusion_v1') { %>
      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-default pt-3">
        <button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand disabled:cursor-not-allowed disabled:opacity-50" type="button" id="addRunBtn" <%= step.is_blocked === 1 ? 'disabled' : '' %>>Add run</button>
      </div>
    <% } %>
  </section>

  <% let summaryData = null; %>
  <% if (summaryJson) { try { summaryData = JSON.parse(summaryJson); } catch { summaryData = null; } } %>
  <% const settings = stepSettings || {}; %>
  <% const fmt = (value, digits = 2) => (typeof value === 'number' && Number.isFinite(value) ? formatNumber(value, digits) : '-'); %>
  <% if (processTypeCode === 'compounding' && step.step_number === 1) { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Recommended Baseline from RTD Stability</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <div class="text-sm text-gray-500">Recommended run</div>
          <div class="mt-1 text-sm text-gray-900" data-live-step1="recommended_run"><%= summaryData?.recommended_run || '-' %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Screw RPM</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step1="recommended_screw_rpm"><%= fmt(summaryData?.recommended_screw_rpm, 0) %></span> <span class="text-sm text-gray-500">rpm</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">MFR</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step1="recommended_mfr_g_10min"><%= fmt(summaryData?.recommended_mfr_g_10min) %></span> <span class="text-sm text-gray-500">g/10min</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Head temp</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step1="recommended_head_temp_c"><%= fmt(summaryData?.recommended_head_temp_c, 1) %></span> <span class="text-sm text-gray-500">°C</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Mid temp</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step1="recommended_mid_temp_c"><%= fmt(summaryData?.recommended_mid_temp_c, 1) %></span> <span class="text-sm text-gray-500">°C</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Min stabilization</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step1="recommended_stabilization_time_min"><%= fmt(summaryData?.recommended_stabilization_time_min ?? summaryData?.stabilization_time_min, 1) %></span> <span class="text-sm text-gray-500">min</span></div>
        </div>
      </div>
      <div class="text-sm text-gray-500" style="margin-top: .75rem;">
        Window estimate:
        screw <strong><span data-live-step1="window_screw_rpm_min"><%= fmt(summaryData?.window_screw_rpm_min, 0) %></span> - <span data-live-step1="window_screw_rpm_max"><%= fmt(summaryData?.window_screw_rpm_max, 0) %></span> rpm</strong>,
        head temp <strong><span data-live-step1="window_head_temp_c_min"><%= fmt(summaryData?.window_head_temp_c_min, 1) %></span> - <span data-live-step1="window_head_temp_c_max"><%= fmt(summaryData?.window_head_temp_c_max, 1) %></span> °C</strong>,
        mid temp <strong><span data-live-step1="window_mid_temp_c_min"><%= fmt(summaryData?.window_mid_temp_c_min, 1) %></span> - <span data-live-step1="window_mid_temp_c_max"><%= fmt(summaryData?.window_mid_temp_c_max, 1) %></span> °C</strong>
      </div>
    </div>
  <% } %>
  <% if (processTypeCode === 'compounding' && step.step_number === 2) { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Recommended SME Window</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <div class="text-sm text-gray-500">Recommended run</div>
          <div class="mt-1 text-sm text-gray-900" data-live-step2="recommended_run"><%= summaryData?.recommended_run || '-' %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Screw RPM</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step2="recommended_screw_rpm"><%= fmt(summaryData?.recommended_screw_rpm, 0) %></span> <span class="text-sm text-gray-500">rpm</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Throughput</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step2="recommended_throughput_kg_h"><%= fmt(summaryData?.recommended_throughput_kg_h, 2) %></span> <span class="text-sm text-gray-500">kg/h</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">SME</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step2="recommended_sme_kj_kg"><%= fmt(summaryData?.recommended_sme_kj_kg, 2) %></span> <span class="text-sm text-gray-500">kJ/kg</span></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Melt temp</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step2="recommended_melt_temp_c"><%= fmt(summaryData?.recommended_melt_temp_c, 1) %></span> <span class="text-sm text-gray-500">°C</span></div>
        </div>
      </div>
      <div class="text-sm text-gray-500" style="margin-top: .75rem;">
        Window estimate:
        SME <strong><span data-live-step2="window_sme_min_kj_kg"><%= fmt(summaryData?.window_sme_min_kj_kg, 2) %></span> - <span data-live-step2="window_sme_max_kj_kg"><%= fmt(summaryData?.window_sme_max_kj_kg, 2) %></span> kJ/kg</strong>,
        screw <strong><span data-live-step2="window_screw_rpm_min"><%= fmt(summaryData?.window_screw_rpm_min, 0) %></span> - <span data-live-step2="window_screw_rpm_max"><%= fmt(summaryData?.window_screw_rpm_max, 0) %></span> rpm</strong>,
        throughput <strong><span data-live-step2="window_throughput_kg_h_min"><%= fmt(summaryData?.window_throughput_kg_h_min, 2) %></span> - <span data-live-step2="window_throughput_kg_h_max"><%= fmt(summaryData?.window_throughput_kg_h_max, 2) %></span> kg/h</strong>
      </div>
    </div>
  <% } %>
  <% if (processTypeCode === 'compounding' && step.step_number === 3) { %>
    <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900">Setup</h2>
        <div class="flex flex-wrap items-center gap-2">
          <button class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50" type="button" id="openStep3Setup">Edit setup</button>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <div class="text-sm text-gray-500">Target screw RPM</div>
          <div class="mt-1 text-sm text-gray-900"><span data-live-step3="target_screw_rpm"><%= fmt(Number(settings.target_screw_rpm), 0) %></span> <span class="text-sm text-gray-500">rpm</span></div>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('partials/entity_notes', {
    experimentId: experimentId,
    entityType: 'qualification_step',
    entityId: step.id,
    title: `Step ${step.step_number} Notes`,
    canWrite: currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer')
  }) %>

  <% const isExtrusionStepOne = processTypeCode === 'extrusion_v1' && step.step_number === 1; %>
  <% const isExtrusionStepTwo = processTypeCode === 'extrusion_v1' && step.step_number === 2; %>
  <% const isExtrusionStepThree = processTypeCode === 'extrusion_v1' && step.step_number === 3; %>
  <% if (isExtrusionStepOne) { %>
    <%- include('partials/extrusion_step1_program', { fields, runs, runValueMap, seriesDefinitions, runSeries, outputDefinitions, stepOutputs, assignableUsers, inputTableClass, formatNumber, step }) %>
  <% } else if (isExtrusionStepTwo) { %>
    <%- include('partials/extrusion_step2_program', { fields, runs, runValueMap, seriesDefinitions, runSeries, outputDefinitions, stepOutputs, assignableUsers, inputTableClass, formatNumber, step, stepSettings }) %>
  <% } else if (isExtrusionStepThree) { %>
    <%- include('partials/extrusion_step3_program', { fields, runs, runValueMap, outputDefinitions, stepOutputs, assignableUsers, inputTableClass, formatNumber, step, stepSettings, feederThroughputLevels, rheologyReferenceViscosity, stepSummary }) %>
  <% } else { %>
  <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-4">
      <h2 class="text-lg font-semibold tracking-tight text-gray-900">Runs</h2>
    </div>
    <% const activeFields = fields.filter((field) => field.is_enabled === 1); %>
    <% const inputFields = activeFields.filter((field) => String(field.group_label || '').toLowerCase() === 'inputs'); %>
    <% const measurementFields = activeFields.filter((field) => String(field.group_label || '').toLowerCase() === 'measurements'); %>
    <% const summaryFields = activeFields.filter((field) => !['inputs', 'measurements'].includes(String(field.group_label || '').toLowerCase())); %>
    <% const orderedFields = [...inputFields, ...measurementFields, ...summaryFields]; %>
    <div class="overflow-x-auto rounded-lg border border-gray-200">
      <table class="<%= inputTableClass %>" id="compoundingRunsTable">
        <thead>
          <tr>
            <th>Run</th>
            <th>Date</th>
            <th>Responsible</th>
            <% orderedFields.forEach((field) => { %>
              <th>
                <%- formatInline(field.label) %>
                <% if (field.unit) { %><span class="text-sm text-gray-500"> <%= field.unit %></span><% } %>
              </th>
            <% }); %>
            <th>Done</th>
            <th>Exclude</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (runs.length === 0) { %>
            <tr><td colspan="<%= orderedFields.length + 6 %>">No runs yet.</td></tr>
          <% } %>
          <% runs.forEach((run) => { %>
            <% const values = runValueMap[String(run.id)] || {}; %>
            <tr data-run-row data-run-id="<%= run.id %>">
              <td><strong><%= run.run_code %></strong></td>
              <td><input type="date" data-run-performed value="<%= run.performed_at || '' %>"></td>
              <td>
                <select data-run-responsible>
                  <option value="">Unassigned</option>
                  <% assignableUsers.forEach((user) => { %>
                    <option value="<%= user.id %>" <%= Number(run.responsible_user_id) === Number(user.id) ? 'selected' : '' %>><%= user.name || user.email %></option>
                  <% }); %>
                </select>
              </td>
              <% orderedFields.forEach((field) => { %>
                <% const value = values[String(field.id)]; %>
                <td>
                  <% if (field.is_derived) { %>
                    <span class="text-sm text-gray-500" data-derived-code="<%= field.code %>">
                      <% if (field.field_type === 'number') { %>
                        <%= formatNumber(value?.value_real) %>
                      <% } else if (field.field_type === 'tag') { %>
                        <%= value?.value_tags_json || '-' %>
                      <% } else { %>
                        <%= value?.value_text || '-' %>
                      <% } %>
                    </span>
                  <% } else if (field.field_type === 'boolean') { %>
                    <input type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= value?.value_real === 1 ? 'checked' : '' %>>
                  <% } else if (field.field_type === 'number') { %>
                    <input type="number" step="any" data-field-id="<%= field.id %>" data-field-type="number" value="<%= value?.value_real ?? '' %>">
                  <% } else if (field.field_type === 'tag') { %>
                    <% let selected = []; %>
                    <% if (value?.value_tags_json) { try { const parsed = JSON.parse(value.value_tags_json); if (Array.isArray(parsed)) selected = parsed.map(String); } catch {} } %>
                    <input type="text" data-field-id="<%= field.id %>" data-field-type="tag" placeholder="a,b,c" value="<%= selected.join(', ') %>">
                  <% } else { %>
                    <input type="text" data-field-id="<%= field.id %>" data-field-type="text" value="<%= value?.value_text || '' %>">
                  <% } %>
                </td>
              <% }); %>
              <td><input type="checkbox" data-flag="done" <%= run.done === 1 ? 'checked' : '' %>></td>
              <td><input type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td>
              <td>
                <button class="inline-flex size-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-red-600 shadow-sm transition-colors hover:bg-red-50 hover:text-red-700" type="button" data-run-delete title="Delete row">
                  <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                </button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (processTypeCode === 'extrusion_v1' && step.step_number === 1) { %>
    <section class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm" aria-labelledby="extrusionStep1SeriesTitle">
      <div class="mb-5 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900" id="extrusionStep1SeriesTitle">Measurement series</h2>
        <p class="mt-1 text-sm text-gray-500">Import two-column CSV files. The expected axes are fixed by the stage contract and stored with its version.</p>
      </div>
      <div class="mb-5 rounded-lg border border-gray-200 bg-gray-50 p-4">
        <div class="mb-3 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="text-sm font-semibold text-gray-900">Flow curves by temperature</h3>
            <p class="mt-1 text-xs text-gray-500">Calculated from the scalar run table: apparent shear rate versus apparent viscosity.</p>
          </div>
          <span class="rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-800">Calculated</span>
        </div>
        <div class="h-80 w-full" id="extrusionFlowCurveChart"></div>
      </div>
      <div class="grid gap-4 xl:grid-cols-2">
        <% seriesDefinitions.forEach((definition, index) => { %>
          <article class="rounded-lg border border-gray-200 bg-white p-4" data-qual-series-card data-series-code="<%= definition.code %>" data-minimum-points="<%= definition.minimum_points %>">
            <div class="mb-4 flex items-start justify-between gap-3">
              <div>
                <h3 class="text-sm font-semibold text-gray-900"><%= definition.label %></h3>
                <p class="mt-1 text-xs text-gray-500"><%= definition.description %></p>
              </div>
              <span class="shrink-0 rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">v<%= definition.contract_version %></span>
            </div>
            <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
              <label class="block text-sm font-medium text-gray-900">
                Run
                <select class="mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-600 focus:ring-blue-600" data-series-run>
                  <% runs.forEach((run) => { %><option value="<%= run.id %>"><%= run.run_code %></option><% }); %>
                </select>
              </label>
              <label class="block text-sm font-medium text-gray-900">
                CSV file
                <input class="mt-1 block w-full cursor-pointer rounded-lg border border-gray-300 bg-white text-sm text-gray-900 file:me-3 file:border-0 file:border-e file:border-gray-300 file:bg-gray-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700" type="file" accept=".csv,text/csv,text/plain" data-series-file <%= step.is_blocked === 1 ? 'disabled' : '' %>>
              </label>
            </div>
            <p class="mt-2 text-xs text-gray-500"><%= definition.x.label %> (<%= definition.x.unit %>) → <%= definition.y.label %> (<%= definition.y.unit %>). Header may be present.</p>
            <div class="mt-3 flex flex-nowrap items-center gap-2 overflow-x-auto">
              <button class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50" type="button" data-series-import <%= step.is_blocked === 1 ? 'disabled' : '' %>>Import CSV</button>
              <button class="inline-flex shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50" type="button" data-series-clear <%= step.is_blocked === 1 ? 'disabled' : '' %>>Clear</button>
              <span class="shrink-0 text-xs text-gray-500" data-series-status>Choose a run and CSV file.</span>
            </div>
            <div class="mt-4 h-64 w-full" id="extrusionSeriesChart<%= index %>" data-series-chart></div>
          </article>
        <% }); %>
      </div>
    </section>
  <% } %>
  <% } %>

      <% if (processTypeCode === 'compounding' && step.step_number === 1) { %>
