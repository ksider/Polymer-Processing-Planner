<script nonce="<%= cspNonce %>" src="/vendor/echarts/dist/echarts.min.js"></script>
<script nonce="<%= cspNonce %>">
  (function () {
    const experimentId = <%= experimentId %>;
    const stepNumber = <%= step.step_number %>;
    const processTypeCode = <%- jsonForScript(processTypeCode) %>;
    const table = document.querySelector('[data-extrusion-step-one], [data-extrusion-step-two], [data-extrusion-step-three]') || document.getElementById('compoundingRunsTable');
    const runTables = Array.from(document.querySelectorAll('[data-run-table]'));
    if (!runTables.length && table) runTables.push(table);
    const fieldIdByCode = <%- jsonForScript(Object.fromEntries(fields.map((field) => [field.code, field.id]))) %>;
    const qualificationSeriesDefinitions = <%- jsonForScript(seriesDefinitions || []) %>;
    let qualificationRunSeries = <%- jsonForScript(runSeries || []) %>;
    const qualSettingsDialog = document.getElementById('qualSettingsDialog');
    const qualSettingsForm = document.getElementById('qualSettingsForm');
    const step3SetupDialog = document.getElementById('step3SetupDialog');
    const step3SetupForm = document.getElementById('step3SetupForm');
    const extrusionFeederSetupForm = document.getElementById('extrusionFeederSetupForm');
    const qualStepAssigneeInput = document.getElementById('qualStepAssigneeInput');
    const qualStepResponsibleLabel = document.getElementById('qualStepResponsibleLabel');
    const qualAssignableUserById = new Map(<%- jsonForScript((assignableUsers || []).map((user) => [String(user.id), user.name || user.email])) %>);

    const post = async (url, body) => {
      if (window.IMPlanner?.postForm) {
        return window.IMPlanner.postForm(url, body);
      }
      const response = await fetch(url, { method: 'POST', body });
      if (!response.ok) throw new Error(`Request failed (${response.status})`);
      return null;
    };

    const saveTimers = new Map();
    const queueSave = (key, fn) => {
      if (saveTimers.has(key)) clearTimeout(saveTimers.get(key));
      const timer = setTimeout(async () => {
        try { await fn(); } catch {}
      }, 180);
      saveTimers.set(key, timer);
    };
    const parseNumber = (raw) => {
      if (raw == null) return null;
      const text = String(raw).trim().replace(',', '.');
      if (!text) return null;
      const num = Number(text);
      return Number.isFinite(num) ? num : null;
    };
    const numFromRow = (row, code) => {
      const fieldId = fieldIdByCode?.[code];
      if (!fieldId) return null;
      const input = row.querySelector(`[data-field-id="${fieldId}"]`);
      if (!input) return null;
      return parseNumber(input.value);
    };
    const fmtLive = (value, digits = 2) => {
      if (!Number.isFinite(value)) return '-';
      const num = Number(value);
      if (digits <= 0) return String(Math.round(num));
      return num.toFixed(digits).replace(/\.?0+$/, '');
    };
    const setLive = (scope, key, value, digits = 2) => {
      const node = document.querySelector(`[${scope}="${key}"]`);
      if (!node) return;
      if (typeof value === 'number') {
        node.textContent = fmtLive(value, digits);
        return;
      }
      node.textContent = value == null || value === '' ? '-' : String(value);
    };
    const scientificLive = (value) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return '-';
      const [mantissa, exponent] = number.toExponential(4).split('e');
      const superscript = String(Number(exponent)).replace(/[-+0-9]/g, (character) => ({ '-': '⁻', '+': '⁺', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' })[character]);
      return `${Number(mantissa)} × 10${superscript}`;
    };
    const updatePumpCharacteristicResult = (summary) => {
      if (processTypeCode !== 'extrusion_v1' || stepNumber !== 3 || !summary) return;
      const root = document.querySelector('[data-pump-characteristic-result]'); if (!root) return;
      const valid = summary.pump_characteristic_fit_valid === true;
      root.classList.toggle('border-success-medium', valid); root.classList.toggle('bg-success-soft', valid);
      root.classList.toggle('border-warning-medium', !valid); root.classList.toggle('bg-warning-soft', !valid);
      root.querySelector('[data-pump-fit-title]').textContent = valid ? 'Fitted equation' : 'Awaiting valid operating-point data';
      root.querySelector('[data-pump-fit-details]').hidden = !valid;
      root.querySelector('[data-pump-fit-empty]').hidden = valid;
      if (!valid) return;
      root.querySelector('[data-pump-density]').textContent = fmtLive(summary.pump_characteristic_melt_density_kg_m3, 2);
      root.querySelector('[data-pump-viscosity]').textContent = fmtLive(summary.pump_characteristic_reference_viscosity_pa_s, 2);
      root.querySelector('[data-pump-outlet-pressure]').textContent = fmtLive(summary.pump_characteristic_outlet_pressure_bar, 2);
      root.querySelector('[data-pump-a]').textContent = scientificLive(summary.screw_pumping_a_m3_s_rpm);
      root.querySelector('[data-pump-b]').textContent = scientificLive(summary.screw_pumping_b_m3);
      root.querySelector('[data-pump-r-squared]').textContent = fmtLive(summary.screw_pumping_r_squared, 3);
      root.querySelector('[data-pump-point-count]').textContent = String(summary.pump_characteristic_point_count ?? 0);
    };
    const setReasonText = (text) => {
      const node = document.getElementById('step2RecommendationReason');
      if (!node) return;
      node.textContent = text || 'Recommendation reason is unavailable.';
    };
    const setStep3ReasonText = (text) => {
      const node = document.getElementById('step3RecommendationReason');
      if (!node) return;
      node.textContent = text || 'MFR stability interpretation is unavailable.';
    };
    const syncStep3Settings = () => {
      if (stepNumber !== 3) return;
      const input = document.getElementById('targetScrewRpmInput');
      const value = parseNumber(input?.value);
      setLive('data-live-step3', 'target_screw_rpm', value, 0);
    };
    const getActiveRows = () => {
      const rows = Array.from(table?.querySelectorAll('tr[data-run-row]') || []);
      return rows.filter((row) => row.dataset.runGroup !== 'pump_characteristic' && !row.querySelector('input[data-flag="exclude"]')?.checked);
    };
    const quantileSorted = (sorted, p) => {
      if (!sorted.length) return null;
      if (sorted.length === 1) return sorted[0];
      const idx = (sorted.length - 1) * p;
      const lo = Math.floor(idx);
      const hi = Math.ceil(idx);
      if (lo === hi) return sorted[lo];
      const frac = idx - lo;
      return sorted[lo] * (1 - frac) + sorted[hi] * frac;
    };
    const recomputeStep1Recommendations = () => {
      if (stepNumber !== 1) return;
      const rows = getActiveRows();
      const mfrValues = rows
        .map((row) => numFromRow(row, 'MFR_g_10min'))
        .filter((v) => Number.isFinite(v))
        .sort((a, b) => a - b);
      const mfrMedian = mfrValues.length ? mfrValues[Math.floor(mfrValues.length / 2)] : null;
      const candidates = rows.map((row) => {
        const runCode = row.querySelector('td strong')?.textContent?.trim() || '';
        const screw = numFromRow(row, 'screw_rpm');
        const midTemp = numFromRow(row, 'mid_temp_c');
        const headTemp = numFromRow(row, 'head_temp_c');
        const stabilization = numFromRow(row, 'stabilization_time_min');
        const mfr = numFromRow(row, 'MFR_g_10min');
        if (!Number.isFinite(screw) || !Number.isFinite(stabilization)) return null;
        const mfrTerm =
          Number.isFinite(mfr) && Number.isFinite(mfrMedian) && mfrMedian !== 0
            ? Math.abs((mfr - mfrMedian) / mfrMedian) * 10
            : 0;
        const score = stabilization + mfrTerm;
        return { runCode, screw, midTemp, headTemp, stabilization, mfr, score };
      }).filter(Boolean);
      if (!candidates.length) return;
      const best = candidates.reduce((a, b) => (b.score < a.score ? b : a));
      const scoreLimit = best.score * 1.25;
      const windowPoints = candidates.filter((item) => item.score <= scoreLimit);
      const minBy = (arr, key) => Math.min(...arr.map((item) => item[key]).filter((v) => Number.isFinite(v)));
      const maxBy = (arr, key) => Math.max(...arr.map((item) => item[key]).filter((v) => Number.isFinite(v)));
      setLive('data-live-step1', 'recommended_run', best.runCode);
      setLive('data-live-step1', 'recommended_screw_rpm', best.screw, 0);
      setLive('data-live-step1', 'recommended_mfr_g_10min', best.mfr, 2);
      setLive('data-live-step1', 'recommended_head_temp_c', best.headTemp, 1);
      setLive('data-live-step1', 'recommended_mid_temp_c', best.midTemp, 1);
      setLive('data-live-step1', 'recommended_stabilization_time_min', best.stabilization, 1);
      if (windowPoints.length) {
        setLive('data-live-step1', 'window_screw_rpm_min', minBy(windowPoints, 'screw'), 0);
        setLive('data-live-step1', 'window_screw_rpm_max', maxBy(windowPoints, 'screw'), 0);
        setLive('data-live-step1', 'window_head_temp_c_min', minBy(windowPoints, 'headTemp'), 1);
        setLive('data-live-step1', 'window_head_temp_c_max', maxBy(windowPoints, 'headTemp'), 1);
        setLive('data-live-step1', 'window_mid_temp_c_min', minBy(windowPoints, 'midTemp'), 1);
        setLive('data-live-step1', 'window_mid_temp_c_max', maxBy(windowPoints, 'midTemp'), 1);
      }
    };
    const recomputeStep2Recommendations = () => {
      if (stepNumber !== 2) return;
      const rows = getActiveRows();
      const candidates = rows.map((row) => {
        const runCode = row.querySelector('td strong')?.textContent?.trim() || '';
        const rpm = numFromRow(row, 'screw_rpm');
        const throughput = numFromRow(row, 'throughput_kg_h');
        const torque = numFromRow(row, 'torque_pct');
        const current = numFromRow(row, 'motor_current_a');
        const driveSignal = Number.isFinite(torque) && torque !== 0 ? torque : current;
        const melt = numFromRow(row, 'melt_temp_c');
        if (!Number.isFinite(rpm) || !Number.isFinite(throughput) || throughput <= 0 || !Number.isFinite(driveSignal)) return null;
        const sme = (driveSignal * rpm) / throughput * 0.01;
        return { runCode, rpm, throughput, sme, melt };
      }).filter(Boolean);
      if (!candidates.length) {
        setReasonText('No valid runs yet. Fill Screw RPM, Throughput, and Torque or Motor current.');
        return;
      }
      const smeValues = candidates.map((item) => item.sme).sort((a, b) => a - b);
      const q1 = quantileSorted(smeValues, 0.25);
      const q3 = quantileSorted(smeValues, 0.75);
      const median = quantileSorted(smeValues, 0.5);
      const windowBase = smeValues.length >= 4
        ? candidates.filter((item) => item.sme >= q1 && item.sme <= q3)
        : candidates;
      const windowCandidates = windowBase.length ? windowBase : candidates;
      const score = (item) => {
