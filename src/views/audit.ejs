<%- include("partials/head", { title: title, uiKit: true }) %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased">
  <div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row">
    <%- include("partials/admin_sidebar") %>
    <main class="min-w-0 flex-1">
      <header class="border-b border-gray-200 bg-white">
        <div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
          <div><p class="text-sm font-medium text-blue-700">Control center</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900">Logs &amp; Audit</h1></div>
          <div class="flex items-center gap-2"><a class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-900 no-underline hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" href="/admin"><span class="material-symbols-rounded me-2 text-[20px]" aria-hidden="true">arrow_back</span>Administration</a><a class="inline-flex items-center rounded-lg bg-blue-700 px-3.5 py-2.5 text-sm font-medium text-white no-underline hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href="/audit/export.jsonl"><span class="material-symbols-rounded me-2 text-[20px]" aria-hidden="true">download</span>Download full log</a></div>
        </div>
      </header>
      <div class="px-4 py-6 sm:px-6 lg:px-8">
        <section class="flex h-[calc(100vh-12rem)] max-h-full flex-col rounded-lg border border-gray-800 bg-gray-950 shadow-sm" aria-labelledby="auditTitle">
          <div class="flex flex-col gap-3 border-b border-gray-800 px-5 py-5 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="font-mono text-base font-semibold text-gray-100" id="auditTitle">Event console</h2><p class="mt-1 text-sm text-gray-400">Latest <%= audit.length %> events. Download contains the complete audit log.</p></div><span class="inline-flex w-fit items-center gap-2 rounded-full bg-emerald-950 px-3 py-1 text-xs font-medium text-emerald-300"><span class="size-2 rounded-full bg-emerald-400"></span>Recording</span></div>
          <div class="border-b border-gray-800 bg-gray-900/60 px-5 py-3"><label class="flex max-w-xl items-center gap-3 rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-gray-300 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500" for="auditFilter"><span class="material-symbols-rounded text-[20px] text-gray-400" aria-hidden="true">search</span><input class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm text-gray-100 placeholder:text-gray-500 focus:ring-0" id="auditFilter" type="search" placeholder="Filter by action, actor, target, or details" autocomplete="off"></label></div>
          <div class="min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain font-mono text-xs leading-6" id="auditConsole" tabindex="0" aria-label="Audit events, scrollable">
            <% if (!audit.length) { %><div class="px-5 py-12 text-center text-gray-400">No audit events have been recorded.</div><% } %>
            <% audit.forEach(function(row) { const tone = row.action.includes('delete') || row.action.includes('ban') ? 'text-red-300' : row.action.includes('create') || row.action.includes('restore') || row.action.includes('unban') ? 'text-emerald-300' : row.action.includes('update') || row.action.includes('archive') ? 'text-amber-300' : 'text-blue-300'; %>
              <article class="grid gap-x-4 border-b border-gray-800 px-5 py-3 hover:bg-gray-900/70 lg:grid-cols-[11rem_minmax(12rem,1fr)_minmax(9rem,0.7fr)]" data-audit-entry data-audit-search="<%= `${row.created_at} ${row.actor_email ?? row.actor_user_id ?? ''} ${row.action} ${row.target_user_id ?? ''} ${row.details_json ?? ''}`.toLowerCase() %>">
                <time class="text-gray-500"><%= row.created_at %></time><div><span class="font-semibold <%= tone %>"><%= row.action %></span><span class="ms-3 text-gray-400"><%= row.actor_email ?? `user:${row.actor_user_id ?? 'system'}` %></span><% if (row.target_user_id) { %><span class="ms-3 text-gray-500">→ user:<%= row.target_user_id %></span><% } %></div><% if (row.details_json) { %><details class="text-gray-400"><summary class="cursor-pointer text-gray-500 hover:text-gray-200">details</summary><pre class="mt-2 overflow-x-auto whitespace-pre-wrap break-words rounded bg-black/30 p-3 text-[11px] leading-5 text-gray-300"><%= row.details_json %></pre></details><% } else { %><span class="text-gray-600">—</span><% } %>
              </article>
            <% }); %>
          </div>
        </section>
      </div>
    </main>
  </div>
</div>
<script nonce="<%= cspNonce %>">
  const auditFilter = document.getElementById('auditFilter');
  auditFilter?.addEventListener('input', () => {
    const query = auditFilter.value.trim().toLowerCase();
    document.querySelectorAll('[data-audit-entry]').forEach((entry) => {
      entry.classList.toggle('hidden', Boolean(query) && !entry.dataset.auditSearch.includes(query));
    });
  });
  document.querySelectorAll('[data-admin-section]').forEach((button) => {
    button.addEventListener('click', (event) => { event.preventDefault(); window.location.assign(`/admin#${button.dataset.adminSection}`); });
  });
</script>
<%- include("partials/foot", { uiKit: true }) %>
