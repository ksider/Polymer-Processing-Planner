<%- include('partials/head', { title, uiKit }) %>
<% const chipClass = 'cursor-pointer'; const chipState = 'inline-flex items-center rounded-base border border-default-medium bg-neutral-secondary px-2.5 py-1.5 text-xs font-medium text-heading transition hover:bg-neutral-tertiary peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white'; %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased"><div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row"><%- include('partials/admin_sidebar') %><main class="min-w-0 flex-1"><header class="border-b border-gray-200 bg-white"><div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"><div><p class="text-sm font-medium text-blue-700">Control center</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900">File repository</h1><p class="mt-1 text-sm text-gray-500">All stored planner files. File ownership remains with the uploading user.</p></div><a class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 no-underline hover:bg-gray-50" href="/admin">Administration</a></div></header><div class="px-4 py-6 sm:px-6 lg:px-8">
  <form class="mb-5 grid gap-4 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs" method="get" action="/admin/files" id="fileRegistryFilters"><fieldset><legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-body">Uploader</legend><div class="flex max-h-24 flex-wrap gap-2 overflow-y-auto"><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="owner_user_id" value="" <%= !filters.ownerUserId ? 'checked' : '' %>><span class="<%= chipState %>">All users</span></label><% users.forEach((user) => { %><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="owner_user_id" value="<%= user.id %>" <%= filters.ownerUserId === user.id ? 'checked' : '' %>><span class="<%= chipState %>"><%= user.name || user.email %></span></label><% }) %></div></fieldset><div class="grid gap-4 lg:grid-cols-2"><fieldset><legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-body">Entity</legend><div class="flex flex-wrap gap-2"><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="entity_type" value="" <%= !filters.entityType ? 'checked' : '' %>><span class="<%= chipState %>">All entities</span></label><% filterValues.entityTypes.forEach((row) => { %><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="entity_type" value="<%= row.entity_type %>" <%= filters.entityType === row.entity_type ? 'checked' : '' %>><span class="<%= chipState %>"><%= row.entity_type %></span></label><% }) %></div></fieldset><fieldset><legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-body">Location</legend><div class="flex flex-wrap gap-2"><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="placement" value="" <%= !filters.placement ? 'checked' : '' %>><span class="<%= chipState %>">All locations</span></label><% filterValues.placements.forEach((row) => { %><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="placement" value="<%= row.placement %>" <%= filters.placement === row.placement ? 'checked' : '' %>><span class="<%= chipState %>"><%= row.placement %></span></label><% }) %></div></fieldset><fieldset><legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-body">Type</legend><div class="flex flex-wrap gap-2"><% [['', 'All types'], ['image', 'Images'], ['document', 'Documents'], ['other', 'Other']].forEach(([value, label]) => { %><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="type" value="<%= value %>" <%= (filters.mimeGroup || '') === value ? 'checked' : '' %>><span class="<%= chipState %>"><%= label %></span></label><% }) %></div></fieldset><fieldset><legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-body">Sort</legend><div class="flex flex-wrap gap-2"><% [['newest', 'Newest'], ['oldest', 'Oldest'], ['name', 'Name'], ['size', 'Largest']].forEach(([value, label]) => { %><label class="<%= chipClass %>"><input class="peer sr-only" type="radio" name="sort" value="<%= value %>" <%= filters.sort === value ? 'checked' : '' %>><span class="<%= chipState %>"><%= label %></span></label><% }) %></div></fieldset></div></form>
  <section class="overflow-hidden rounded-xl border border-default-medium bg-neutral-primary shadow-xs"><div class="flex items-center justify-between border-b border-default px-4 py-3"><h2 class="text-sm font-semibold text-heading">Files</h2><span class="text-sm text-body"><%= files.length %> shown</span></div><% if (!files.length) { %><p class="px-4 py-10 text-center text-sm text-body">No files match these filters.</p><% } else { %><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-neutral-secondary text-xs uppercase text-body"><tr><th class="px-4 py-3">Preview</th><th class="px-4 py-3">File</th><th class="px-4 py-3">Uploader</th><th class="px-4 py-3">Entity / location</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Size</th><th class="px-4 py-3">Uploaded</th><th class="px-4 py-3"><span class="sr-only">Actions</span></th></tr></thead><tbody class="divide-y divide-default"><% files.forEach((file) => { %><tr><td class="px-4 py-3"><% if (file.mime_type.startsWith('image/')) { %><img class="size-12 rounded-base border border-default-medium bg-neutral-secondary object-cover" src="/files/<%= file.id %>/preview" alt=""><% } else { %><span class="flex size-12 items-center justify-center rounded-base bg-neutral-secondary text-body"><span class="material-symbols-rounded" aria-hidden="true">description</span></span><% } %></td><td class="px-4 py-3 font-medium text-heading"><%= file.original_name %></td><td class="px-4 py-3"><a class="font-medium text-brand no-underline hover:underline" href="/users/<%= file.owner_user_id %>"><%= file.owner_name || file.owner_email %></a></td><td class="px-4 py-3 text-body"><div class="flex flex-wrap gap-2"><% file.links.forEach((link) => { %><% if (link.href) { %><a class="font-medium text-brand no-underline hover:underline" href="<%= link.href %>"><%= link.entity_type %> #<%= link.entity_id %> · <%= link.placement %></a><% } else { %><span><%= link.entity_type %> #<%= link.entity_id %> · <%= link.placement %></span><% } %><% }) %></div></td><td class="px-4 py-3 text-body"><%= file.mime_type %></td><td class="px-4 py-3 text-body"><%= formatBytes(file.size_bytes) %></td><td class="px-4 py-3 text-body"><%= new Date(file.created_at).toLocaleString() %></td><td class="px-4 py-3 text-right"><a class="inline-flex size-9 items-center justify-center rounded-base text-brand hover:bg-brand-soft focus:outline-none focus:ring-4 focus:ring-brand/20" href="/files/<%= file.id %>/download" title="Download" aria-label="Download <%= file.original_name %>"><span class="material-symbols-rounded" aria-hidden="true">download</span></a></td></tr><% }) %></tbody></table></div><% } %></section>
</div></main></div></div>
<%- include('partials/foot', { uiKit: true }) %>
<script nonce="<%= cspNonce %>">
  const fileRegistryFilters = document.getElementById('fileRegistryFilters');
  let fileRegistryRequest = 0;
  fileRegistryFilters?.addEventListener('change', async (event) => {
    if (!(event.target instanceof HTMLInputElement) || event.target.type !== 'radio') return;
    const form = event.currentTarget;
    const requestId = ++fileRegistryRequest;
    const url = new URL(form.action, window.location.origin);
    new FormData(form).forEach((value, key) => url.searchParams.set(key, String(value)));
    form.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(url, { headers: { Accept: 'text/html', 'X-Requested-With': 'fetch' } });
      if (!response.ok) throw new Error('Filter request failed');
      const page = new DOMParser().parseFromString(await response.text(), 'text/html');
      const nextResults = page.querySelector('#fileRegistryFilters')?.nextElementSibling;
      const currentResults = form.nextElementSibling;
      if (!nextResults || !currentResults || requestId !== fileRegistryRequest) return;
      currentResults.replaceWith(nextResults);
      window.history.replaceState({}, '', `${url.pathname}${url.search}`);
    } catch {
      form.requestSubmit();
    } finally {
      if (requestId === fileRegistryRequest) form.removeAttribute('aria-busy');
    }
  });
</script>
