<% const temperatureField = fields.find((field) => field.code === 'resin_temp_c'); %>
<% const viscosityField = fields.find((field) => field.code === 'sla_reference_viscosity_pa_s'); %>
<% const flowField = fields.find((field) => field.code === 'sla_flow_behaviour_class'); %>
<% const runValue = (run, field) => field ? runValueMap[String(run.id)]?.[String(field.id)] : null; %>
<% const tagValue = (run, field) => { try { const parsed = JSON.parse(runValue(run, field)?.value_tags_json || '[]'); return Array.isArray(parsed) ? String(parsed[0] || '') : ''; } catch { return ''; } }; %>
<% const tooltip = (id, label, description) => `<span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="${id}" data-tooltip-placement="top">${label}</span><div id="${id}" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-64 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium normal-case text-white opacity-0 shadow-sm transition-opacity">${description}<div class="tooltip-arrow" data-popper-arrow></div></div>`; %>
<% const flowOptions = ['Newtonian', 'shear-thinning', 'shear-thickening', 'mixed']; %>
<% const seriesByRun = new Map((runSeries || []).filter((series) => series.series_code === 'resin_flow_curve').map((series) => [String(series.run_id), series])); %>
<% const sourceFor = (run) => rheologyCurveFiles?.[String(run.id)] || null; %>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="rheologySetupTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-lg font-semibold tracking-tight text-heading" id="rheologySetupTitle">Material and measurement setup</h2><p class="mt-1 text-sm text-body">This optional study compares measured resin flow. It is material evidence, not a printer-setting or recoating-window experiment.</p></div>
  </div>
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-base border border-default bg-neutral-secondary p-3 text-sm text-body">
    <p><strong class="text-heading">Material provenance from Step 1:</strong> <%= rheologyReference?.materialId || 'Not recorded in Step 1' %><span class="mt-1 block text-xs">The same resin, formulation or supplier-lot ID is used for every curve; it is not entered again for each temperature.</span></p>
    <% if (rheologyReference) { %><a class="inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="<%= rheologyReference.materialHref %>">Open Step 1 <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span></a><% } %>
  </div>
  <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/rheology/setup" data-rheology-setup data-generator-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm font-medium text-heading">Rheology programme<span class="mt-1 block text-xs font-normal text-body">Keep the programme fixed while comparing the curves.</span><select class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="rheology_program" <%= step.is_blocked === 1 ? 'disabled' : '' %>><option value="steady_shear" <%= stepSettings?.rheology_program === 'steady_shear' ? 'selected' : '' %>>Steady shear</option><option value="three_interval_thixotropy" <%= stepSettings?.rheology_program === 'three_interval_thixotropy' ? 'selected' : '' %>>Three-interval thixotropy</option><option value="other" <%= stepSettings?.rheology_program === 'other' ? 'selected' : '' %>>Other</option></select></label>
      <label class="block text-sm font-medium text-heading">Reference shear rate<span class="mt-1 block text-xs font-normal text-body">Use this same γ̇ to read ηref from every curve.</span><span class="relative mt-2 block"><input class="block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 pe-14 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="rheology_reference_shear_rate_s_inv" type="number" min="0.000001" step="any" required value="<%= stepSettings?.rheology_reference_shear_rate_s_inv ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-sm text-body">s⁻¹</span></span></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-rheology-setup-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Save setup</button><span class="text-xs text-body" data-rheology-setup-status>Temperature is the only run-level factor. ηref is read from each uploaded curve at the declared γ̇.</span></div>
  </form>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="rheologyRunsTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4"><div><h2 class="text-lg font-semibold tracking-tight text-heading" id="rheologyRunsTitle">Flow-curve comparison runs</h2><p class="mt-1 text-sm text-body">One row is one temperature condition and one flow curve. Varying temperature is at the left; values read or reviewed from the curve are to its right.</p></div><div class="flex items-center gap-2"><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" id="addRunBtn" title="Add temperature condition" aria-label="Add temperature condition" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded" aria-hidden="true">add</span></button><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#rheologyRunsTable" data-copy-exclude-columns="exclude" data-copy-icon title="Copy flow-comparison runs as TSV" aria-label="Copy flow-comparison runs as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button></div></div>
  <div class="overflow-x-auto rounded-base border border-default"><table class="min-w-full border-separate border-spacing-y-1 text-left text-sm text-body" id="rheologyRunsTable" data-run-table data-rheology-table><thead class="[&_th]:whitespace-nowrap [&_th]:border-b [&_th]:border-default [&_th]:bg-neutral-secondary [&_th]:px-3 [&_th]:py-2 [&_th]:text-xs [&_th]:font-medium [&_th]:uppercase [&_th]:text-body"><tr><th><%- tooltip('rheology-tip-run', 'Run', 'One temperature condition and one imported flow curve.') %></th><th><%- tooltip('rheology-tip-temperature', 'T resin<br><span class="normal-case font-normal">°C</span>', 'Varied resin temperature during this measurement.') %></th><th><%- tooltip('rheology-tip-viscosity', 'η ref<br><span class="normal-case font-normal">Pa·s</span>', 'Viscosity read from this curve at the reference shear rate declared in Setup.') %></th><th><%- tooltip('rheology-tip-flow', 'Flow type', 'Reviewed curve shape; not a printer-setting acceptance decision.') %></th><th data-copy-exclude="true"><%- tooltip('rheology-tip-exclude', 'Excl.', 'Exclude this curve from the reviewed evidence set.') %></th></tr></thead><tbody class="[&_td]:border-y [&_td]:border-default-medium [&_td]:bg-neutral-primary [&_td]:px-3 [&_td]:py-2 [&_td:first-child]:border-s [&_td:last-child]:border-e"><% runs.forEach((run) => { const temp = runValue(run, temperatureField); const viscosity = runValue(run, viscosityField); const flow = tagValue(run, flowField); %><tr data-run-row data-run-id="<%= run.id %>"><td class="rounded-s-base font-medium text-heading"><%= run.run_code %></td><td><input class="w-24 min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= temperatureField?.id %>" data-field-type="number" value="<%= temp?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-24 min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" min="0" step="any" data-field-id="<%= viscosityField?.id %>" data-field-type="number" value="<%= viscosity?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><select class="min-w-32 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-field-id="<%= flowField?.id %>" data-field-type="tag" <%= step.is_blocked === 1 ? 'disabled' : '' %>><option value="">–</option><% flowOptions.forEach((option) => { %><option value="<%= option %>" <%= flow === option ? 'selected' : '' %>><%= option %></option><% }) %></select></td><td class="rounded-e-base text-center" data-copy-exclude="true"><input type="checkbox" title="Exclude from reviewed evidence" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %> <%= step.is_blocked === 1 ? 'disabled' : '' %>></td></tr><% }) %></tbody></table></div>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="rheologyCurvesTitle" id="rheologyCurves">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4"><div><h2 class="text-lg font-semibold tracking-tight text-heading" id="rheologyCurvesTitle">Flow-curve source files</h2><p class="mt-1 text-sm text-body">The plot overlays every available curve. Upload original two-column TXT, CSV or TSV exports: shear rate (s⁻¹), then viscosity (Pa·s).</p></div><div class="flex items-center gap-2"><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#rheologySourcesTable" data-copy-exclude-columns="action" data-copy-icon title="Copy source list as TSV" aria-label="Copy source list as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button><button class="inline-flex items-center gap-2 rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-open-rheology-dialog <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded text-[18px]" aria-hidden="true">upload_file</span>Upload curve</button></div></div>
  <div class="h-96 w-full" id="slaRheologyFlowChart"></div>
  <div class="mt-5 overflow-x-auto rounded-base border border-default"><table class="min-w-full text-left text-sm text-body" id="rheologySourcesTable"><thead class="bg-neutral-secondary text-xs font-medium uppercase text-body"><tr><th class="px-3 py-2"><%- tooltip('rheology-source-tip-run', 'Run', 'Temperature condition represented by this curve.') %></th><th class="px-3 py-2"><%- tooltip('rheology-source-tip-temperature', 'T resin', 'Measured resin temperature in this run.') %></th><th class="px-3 py-2"><%- tooltip('rheology-source-tip-source', 'Source file', 'Untouched instrument export kept in the common file repository.') %></th><th class="px-3 py-2" data-copy-exclude="true"><%- tooltip('rheology-source-tip-action', 'Action', 'Open the upload dialog for this curve.') %></th></tr></thead><tbody class="divide-y divide-default"><% runs.forEach((run) => { const source = sourceFor(run); const series = seriesByRun.get(String(run.id)); const temp = runValue(run, temperatureField); %><tr><td class="px-3 py-2 font-medium text-heading"><%= run.run_code %></td><td class="px-3 py-2"><%= temp?.value_real == null ? '–' : `${formatNumber(temp.value_real, 1)} °C` %></td><td class="px-3 py-2"><% if (source) { %><a class="font-medium text-brand no-underline hover:underline" href="<%= source.downloadUrl %>"><%= source.originalName %></a><span class="ml-2 text-xs text-body">Repository file · <%= Math.max(1, Math.round(source.sizeBytes / 1024)) %> KB</span><% } else if (series) { %><span>Imported trace · no source file attached<%= series.source_name ? ` · ${series.source_name}` : '' %></span><% } else { %><span class="text-body">Not uploaded</span><% } %></td><td class="px-3 py-2 text-right" data-copy-exclude="true"><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-primary text-body shadow-xs hover:bg-neutral-secondary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-open-rheology-dialog data-rheology-run-id="<%= run.id %>" title="Upload or replace <%= run.run_code %> curve" aria-label="Upload or replace <%= run.run_code %> curve" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded" aria-hidden="true"><%= source || series ? 'edit' : 'upload_file' %></span></button></td></tr><% }) %></tbody></table></div>
</section>

<dialog class="modal-frame fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[min(56rem,calc(100vw-2rem))] max-w-none overflow-y-auto rounded-xl border border-default-medium bg-neutral-primary p-0 text-heading shadow-2xl backdrop:bg-black/35" id="rheologyCurveDialog" aria-labelledby="rheologyCurveDialogTitle">
  <div class="flex items-start justify-between gap-4 border-b border-default px-5 py-4"><div><h2 class="text-lg font-semibold tracking-tight" id="rheologyCurveDialogTitle">Upload resin flow curve</h2><p class="mt-1 text-sm text-body">Choose the temperature run, then attach its two-column TXT, CSV or TSV export. A header row is allowed.</p></div><button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base text-body hover:bg-neutral-secondary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-close-rheology-dialog aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
  <div class="grid gap-5 p-5 lg:grid-cols-[minmax(15rem,.8fr)_minmax(0,1.2fr)]"><section aria-labelledby="rheologySpecimensTitle"><h3 class="text-sm font-semibold text-heading" id="rheologySpecimensTitle">Temperature runs</h3><div class="mt-3 space-y-2" data-rheology-choices><% runs.forEach((run, index) => { const source = sourceFor(run); const series = seriesByRun.get(String(run.id)); const temp = runValue(run, temperatureField); %><button class="flex w-full items-center justify-between gap-3 rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-left text-sm hover:border-brand focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-rheology-choice data-run-id="<%= run.id %>" data-run-code="<%= run.run_code %>" data-temperature="<%= temp?.value_real ?? '' %>" data-source-file-id="<%= source?.id ?? '' %>" data-source-name="<%= source?.originalName ?? series?.source_name ?? '' %>" data-has-series="<%= series ? '1' : '0' %>" <%= index === 0 ? 'aria-current="true"' : '' %>><span><strong class="font-medium text-heading"><%= run.run_code %></strong><span class="ml-2 text-body"><%= temp?.value_real == null ? 'temperature not set' : `${formatNumber(temp.value_real, 1)} °C` %></span></span><span class="rounded-base px-2 py-1 text-xs <%= source ? 'bg-success-soft text-success' : series ? 'bg-warning-soft text-warning' : 'bg-neutral-secondary text-body' %>"><%= source ? 'File attached' : series ? 'Imported trace' : 'No file' %></span></button><% }) %></div></section><form data-rheology-curve-upload data-series-code="resin_flow_curve" data-selected-run-id="" data-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>"><p class="text-sm text-body">Selected run: <strong class="text-heading" data-rheology-selected>Choose a temperature run</strong></p><p class="mt-2 rounded-base bg-neutral-secondary p-3 text-xs text-body" data-rheology-source-status>No source file is attached.</p><label class="mt-4 block text-sm font-medium text-heading">Instrument export<input class="mt-2 block w-full cursor-pointer rounded-base border border-default-medium bg-neutral-secondary-medium text-sm text-heading file:me-3 file:border-0 file:border-e file:border-default-medium file:bg-neutral-secondary file:px-3 file:py-2 file:text-sm file:font-medium file:text-heading" type="file" accept=".txt,.csv,.tsv,text/plain,text/csv,text/tab-separated-values" data-rheology-file <%= step.is_blocked === 1 ? 'disabled' : '' %>></label><p class="mt-2 text-xs text-body">The original file is stored in the common file repository and linked to this temperature run. Replacing it detaches the older source from this run without erasing it from the repository.</p><div class="mt-5 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-rheology-upload-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Upload and plot</button><button class="inline-flex items-center justify-center rounded-base border border-danger-medium bg-neutral-primary px-3 py-2 text-sm font-medium text-danger shadow-xs hover:bg-danger-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-rheology-remove disabled <%= step.is_blocked === 1 ? 'disabled' : '' %>>Remove source</button><span class="text-xs text-body" data-rheology-upload-status></span></div></form></div>
</dialog>
