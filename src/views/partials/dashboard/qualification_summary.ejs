<section class="overflow-hidden rounded-lg border border-violet-200 bg-white shadow-sm" aria-labelledby="qualificationTitle">
  <div class="border-b border-violet-200 bg-violet-50 px-5 py-4"><div class="flex items-center gap-2"><span class="material-symbols-rounded text-violet-700" aria-hidden="true">science</span><h2 class="text-base font-semibold text-violet-950" id="qualificationTitle">Qualification progress</h2></div><p class="mt-1 text-sm text-violet-800">Execution states are separate from technical acceptance.</p></div>
  <% if (!qualifications.length) { %><p class="px-5 py-8 text-center text-sm text-gray-500">No active qualification stages in this scope.</p><% } else { %>
    <div class="divide-y divide-gray-100"><% qualifications.forEach((item) => { %><div class="px-5 py-4"><div class="flex flex-wrap items-start justify-between gap-2"><div><p class="font-medium text-gray-900"><%- formatInline(item.experimentName) %></p><p class="mt-0.5 text-sm text-gray-500"><%- formatInline(item.processName || 'No process') %><% if (item.currentStep) { %> · current stage <%= item.currentStep %><% } %></p></div><a class="text-sm font-medium text-blue-700 no-underline hover:underline" href="/experiments/<%= item.experimentId %>/qualification">Open</a></div><div class="mt-3 flex flex-wrap gap-2 text-xs font-medium"><span class="rounded-full bg-emerald-100 px-2 py-1 text-emerald-800">Completed <%= item.done %>/<%= item.active %></span><% if (item.running) { %><span class="rounded-full bg-blue-100 px-2 py-1 text-blue-800">Running <%= item.running %></span><% } %><% if (item.blocked) { %><span class="rounded-full bg-red-100 px-2 py-1 text-red-800">Blocked <%= item.blocked %></span><% } %><% if (item.pending) { %><span class="rounded-full bg-gray-100 px-2 py-1 text-gray-700">Pending <%= item.pending %></span><% } %></div></div><% }) %></div>
  <% } %>
</section>
