<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary shadow-xs" aria-label="Study guide">
  <details class="group">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 marker:content-none hover:bg-neutral-secondary">
      <div class="flex min-w-0 items-start gap-3"><span class="material-symbols-rounded mt-0.5 text-brand">menu_book</span><div><h2 class="text-base font-semibold text-heading">Study guide · <%= studyGuide.title %></h2><p class="mt-1 text-sm text-body"><%= studyGuide.goal %></p></div></div>
      <span class="material-symbols-rounded shrink-0 text-body transition-transform group-open:rotate-180">expand_more</span>
    </summary>
    <div class="grid gap-5 border-t border-default px-5 py-5 xl:grid-cols-3">
      <section><h3 class="text-sm font-semibold text-heading">How to run the study</h3><ol class="mt-3 space-y-2 text-sm leading-5 text-body"><% studyGuide.procedure.forEach((item, index) => { %><li class="flex gap-2"><span class="font-medium text-brand"><%= index + 1 %>.</span><span><%= item %></span></li><% }) %></ol></section>
      <section class="border-default xl:border-s xl:ps-5"><h3 class="text-sm font-semibold text-heading">Theory and calculations</h3><p class="mt-3 text-sm leading-5 text-body"><%= studyGuide.theory %></p><p class="mt-4 text-xs text-body">References: <%= studyGuide.references %></p></section>
      <section class="border-default xl:border-s xl:ps-5"><h3 class="text-sm font-semibold text-heading">Read the result</h3><ul class="mt-3 space-y-2 text-sm leading-5 text-body"><% studyGuide.interpretation.forEach((item) => { %><li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand"></span><span><%= item %></span></li><% }) %></ul><div class="mt-4 rounded-base border border-success-medium bg-success-soft p-3 text-sm leading-5 text-heading"><span class="font-semibold">Next stage:</span> <%= studyGuide.handoff %></div></section>
    </div>
  </details>
</section>
