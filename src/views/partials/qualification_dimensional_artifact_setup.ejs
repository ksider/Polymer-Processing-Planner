<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="dimensionalArtifactSetupTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div>
      <h2 class="text-lg font-semibold tracking-tight text-heading" id="dimensionalArtifactSetupTitle">Experiment setup</h2>
      <p class="mt-1 text-sm text-body">Step 4 inspects one fixed NIST AM Test Artifact. It does not accept an uploaded or custom model: all measurement locations and hidden nominals must stay comparable.</p>
    </div>
    <% if (dimensionalReference) { %>
      <a class="inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="<%= dimensionalReference.href %>">Open Step 3 <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span></a>
    <% } %>
  </div>

  <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/dimensional-artifact/setup" data-dimensional-artifact-setup data-generator-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
    <input name="dimensional_artifact_preset" type="hidden" value="nist_am_test_artifact">
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <div class="rounded-base border border-default bg-neutral-secondary p-3 text-sm">
        <div class="text-xs text-body">Test artifact</div>
        <div class="mt-1 font-medium text-heading">NIST AM Test Artifact</div>
        <div class="mt-1 text-xs text-body">Fixed public reference · no custom-model upload in this study</div>
      </div>
      <label class="block text-sm font-medium text-heading">Qualified layer height
        <span class="mt-1 block text-xs font-normal text-body">Fixed Step 3 handoff · µm</span>
        <input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="dimensional_layer_height_um" type="number" step="any" min="0.000001" required value="<%= stepSettings?.dimensional_layer_height_um ?? dimensionalReference?.layerHeightUm ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>>
      </label>
      <label class="block text-sm font-medium text-heading">Qualified layer exposure
        <span class="mt-1 block text-xs font-normal text-body">Fixed Step 3 handoff · s</span>
        <input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="dimensional_exposure_time_s" type="number" step="any" min="0.000001" required value="<%= stepSettings?.dimensional_exposure_time_s ?? dimensionalReference?.exposureTimeS ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>>
      </label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-dimensional-artifact-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Save setup</button>
      <span class="text-xs text-body" data-dimensional-artifact-status>Step 3 values are copied only into empty setup fields, so a recorded decision is never overwritten.</span>
    </div>
  </form>

  <% if (dimensionalArtifact) { %>
    <div class="mt-5 grid gap-5 rounded-base border border-default bg-neutral-secondary p-4 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)]">
      <div>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="text-sm font-semibold text-heading">Measurement orientation</h3>
            <p class="mt-1 text-xs text-body">Use the map together with the element-level location and method in the table below. It is an orientation aid, not a dimensional drawing.</p>
          </div>
          <div class="flex flex-wrap gap-2 text-xs">
            <a class="text-brand hover:underline" href="<%= dimensionalArtifact.source_url %>" target="_blank" rel="noreferrer">NIST artifact</a>
            <a class="text-brand hover:underline" href="<%= dimensionalArtifact.engineering_drawing_url %>" target="_blank" rel="noreferrer">Engineering drawing</a>
            <a class="text-brand hover:underline" href="<%= dimensionalArtifact.inspection_sheet_url %>" target="_blank" rel="noreferrer">Inspection sheet</a>
          </div>
        </div>
        <div class="relative mt-3 overflow-hidden rounded-base border border-default bg-white" role="img" aria-label="Top and perspective orientation views of the NIST AM Test Artifact. The overlay highlights fine features, X/Y pins and holes, lateral features, and the H-to-opposite-side scale reference.">
          <img class="block h-auto w-full" src="/illustrations/nist_artifact_render.png" alt="" aria-hidden="true">
          <img class="pointer-events-none absolute inset-0 block h-full w-full" src="/illustrations/nist_artifact_map.svg" alt="" aria-hidden="true">
        </div>
      </div>
      <dl class="grid content-start gap-3 text-sm sm:grid-cols-2 lg:grid-cols-1">
        <% dimensionalArtifact.nominal_geometry.forEach((item) => { %>
          <div><dt class="text-xs text-body"><%= item.label %></dt><dd class="mt-1 font-medium text-heading"><%= item.value %></dd></div>
        <% }); %>
        <div class="rounded-base bg-neutral-primary p-3 text-xs text-body"><strong class="text-heading">Why no nominal column?</strong> The prescribed NIST nominal is retained in the fixed preset and used for calculation, but is not entered or edited per measurement row.</div>
      </dl>
    </div>
    <section class="mt-4 rounded-base border border-default bg-neutral-primary p-4" aria-labelledby="nistModelDownloadsTitle">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="text-sm font-semibold text-heading" id="nistModelDownloadsTitle">Official NIST model files</h3>
          <p class="mt-1 text-xs text-body">Download the artifact from NIST in the format required by the slicer or CAD workflow. The archives are kept off-site so this study always refers to the source release.</p>
        </div>
        <a class="text-xs font-medium text-brand hover:underline" href="<%= dimensionalArtifact.source_url %>" target="_blank" rel="noreferrer">Open NIST source <span class="material-symbols-rounded align-[-3px] text-[15px]" aria-hidden="true">open_in_new</span></a>
      </div>
      <div class="mt-3 grid gap-2 sm:grid-cols-3">
        <% dimensionalArtifact.model_downloads.forEach((file) => { %>
          <a class="group rounded-base border border-default bg-neutral-secondary p-3 no-underline hover:border-brand" href="<%= file.url %>" target="_blank" rel="noreferrer">
            <span class="flex items-center justify-between gap-2 text-sm font-medium text-heading"><%= file.format %> <span class="material-symbols-rounded text-[18px] text-brand" aria-hidden="true">download</span></span>
            <span class="mt-1 block text-xs text-body"><%= file.description %> · ZIP</span>
          </a>
        <% }); %>
      </div>
      <p class="mt-3 text-xs leading-5 text-body"><strong class="text-heading">Source &amp; rights:</strong> <a class="text-brand hover:underline" href="<%= dimensionalArtifact.source_url %>" target="_blank" rel="noreferrer">NIST AM Test Artifact</a>. NIST states that its test-part files were produced by U.S. federal employees in their official duties and are public domain under 17 U.S.C. §105; acknowledgement is requested. The design is experimental and may change. <a class="text-brand hover:underline" href="<%= dimensionalArtifact.publication_url %>" target="_blank" rel="noreferrer">Reference publication</a>.</p>
    </section>
  <% } %>
</section>
