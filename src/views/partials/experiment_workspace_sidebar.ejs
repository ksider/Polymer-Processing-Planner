<aside class="w-72 shrink-0 self-stretch border-r border-gray-200 bg-white" id="experimentWorkspaceSidebar" data-experiment-sidebar aria-label="Experiment tree">
  <div class="sticky top-16 flex h-[calc(100vh-4rem)] max-h-[calc(100vh-4rem)] flex-col">
    <div class="flex h-16 shrink-0 items-center justify-between gap-2 border-b border-gray-200 px-3">
      <span class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">Project tree</span>
      <div class="flex items-center gap-1">
        <button class="inline-flex size-8 items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900" type="button" data-open-experiment-calendar title="Open calendar" aria-label="Open calendar"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">calendar_month</span></button>
        <button class="inline-flex size-8 items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900" type="button" data-experiment-sidebar-hide aria-controls="experimentWorkspaceSidebar" aria-expanded="true" title="Hide project tree" aria-label="Hide project tree"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">left_panel_close</span></button>
      </div>
    </div>
    <div class="min-h-0 flex-1 overflow-x-clip overflow-y-auto p-3">
      <%- include('experiment_workspace_tree', { workspace }) %>
    </div>
  </div>
</aside>
<button class="sticky top-20 hidden size-9 shrink-0 self-start items-center justify-center rounded-r-lg border border-l-0 border-gray-200 bg-white text-gray-500 shadow-sm hover:bg-gray-100 hover:text-gray-900" type="button" data-experiment-sidebar-show aria-controls="experimentWorkspaceSidebar" aria-expanded="false" title="Show project tree" aria-label="Show project tree"><span class="material-symbols-rounded text-[19px]" aria-hidden="true">left_panel_open</span></button>
<script nonce="<%= cspNonce %>">
  (() => {
    const sidebar = document.querySelector('[data-experiment-sidebar]');
    const hide = document.querySelector('[data-experiment-sidebar-hide]');
    const show = document.querySelector('[data-experiment-sidebar-show]');
    if (!sidebar || !hide || !show) return;
    const key = 'im-planner:experiment-sidebar-collapsed';
    const setCollapsed = (collapsed) => {
      sidebar.classList.toggle('hidden', collapsed);
      show.classList.toggle('hidden', !collapsed);
      show.classList.toggle('inline-flex', collapsed);
      hide.setAttribute('aria-expanded', String(!collapsed));
      show.setAttribute('aria-expanded', String(collapsed));
      try { window.localStorage.setItem(key, String(collapsed)); } catch (_) { /* storage can be unavailable */ }
    };
    try { setCollapsed(window.localStorage.getItem(key) === 'true'); } catch (_) { setCollapsed(false); }
    hide.addEventListener('click', () => setCollapsed(true));
    show.addEventListener('click', () => setCollapsed(false));

    const tree = sidebar.querySelector('[data-workspace-tree]');
    if (!tree) return;
    const nodes = Array.from(tree.querySelectorAll('details[data-workspace-tree-node]'));
    const treeKey = `im-planner:workspace-tree:${tree.dataset.workspaceTreeId}`;
    const saveTreeState = () => {
      try {
        const openNodes = nodes
          .filter((node) => node.open)
          .map((node) => node.dataset.workspaceTreeNode);
        window.localStorage.setItem(treeKey, JSON.stringify(openNodes));
      } catch (_) { /* storage can be unavailable */ }
    };
    try {
      const saved = window.localStorage.getItem(treeKey);
      if (saved !== null) {
        const openNodes = new Set(JSON.parse(saved));
        nodes.forEach((node) => { node.open = openNodes.has(node.dataset.workspaceTreeNode); });
      }
    } catch (_) { /* keep the server-side defaults */ }

    const isCurrentLocation = (link) => {
      const target = new URL(link.href, window.location.origin);
      return target.pathname === window.location.pathname
        && target.search === window.location.search
        && (!target.hash || target.hash === window.location.hash);
    };
    const currentLinks = Array.from(tree.querySelectorAll('[data-workspace-location]'))
      .filter(isCurrentLocation);
    currentLinks.forEach((link) => {
      link.setAttribute('aria-current', 'page');
      link.closest('summary')?.setAttribute('data-workspace-current', '');
      let parent = link.closest('details');
      while (parent && tree.contains(parent)) {
        parent.open = true;
        parent = parent.parentElement?.closest('details') || null;
      }
    });

    nodes.forEach((node) => node.addEventListener('toggle', saveTreeState));
    Array.from(tree.querySelectorAll('[data-workspace-stage-link]')).forEach((link) => {
      link.addEventListener('click', () => {
        const stageNode = link.closest('details[data-workspace-tree-node]');
        if (stageNode) stageNode.open = true;
        saveTreeState();
      });
    });
    saveTreeState();
  })();
</script>
