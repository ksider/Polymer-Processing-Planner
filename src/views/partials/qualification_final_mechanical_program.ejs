<% const orientationField = fields.find((field) => field.code === 'build_orientation'); %>
<% const tensileField = fields.find((field) => field.code === 'tensile_strength_mpa'); %>
<% const modulusField = fields.find((field) => field.code === 'elastic_modulus_mpa'); %>
<% const elongationField = fields.find((field) => field.code === 'elongation_break_pct'); %>
<% const flexuralField = fields.find((field) => field.code === 'flexural_strength_mpa'); %>
<% const hdtField = fields.find((field) => field.code === 'hdt_c'); %>
<% const tgField = fields.find((field) => field.code === 'final_tg_c'); %>
<% const dimensionalField = fields.find((field) => field.code === 'dimensional_error_um'); %>
<% let orientationOptions = []; try { orientationOptions = JSON.parse(orientationField?.allowed_values_json || '[]'); } catch {} %>
<% const runValue = (run, field) => field ? runValueMap[String(run.id)]?.[String(field.id)] : null; %>
<% const runOrientation = (run) => { try { const values = JSON.parse(runValue(run, orientationField)?.value_tags_json || '[]'); return Array.isArray(values) ? String(values[0] || '') : ''; } catch { return ''; } }; %>
<% const tooltip = (id, label, description) => `<span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="${id}" data-tooltip-placement="top">${label}</span><div id="${id}" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-64 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium normal-case text-white opacity-0 shadow-sm transition-opacity">${description}<div class="tooltip-arrow" data-popper-arrow></div></div>`; %>
<% const orientationSummary = stepSummary?.final_mechanical?.orientations || {}; %>
<% const stressSeriesByRunId = new Map((runSeries || []).filter((series) => series.series_code === 'stress_strain_curve').map((series) => [String(series.run_id), series])); %>
<% const curveFileFor = (run) => finalMechanicalCurveFiles?.[String(run.id)] || null; %>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="finalMechanicalSetupTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-lg font-semibold tracking-tight text-heading" id="finalMechanicalSetupTitle">Specimen and method setup</h2><p class="mt-1 text-sm text-body">Conditioning and test methods are fixed for this qualification set, rather than repeated in every specimen row.</p></div>
    <% if (finalMechanicalReference) { %><a class="inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="<%= finalMechanicalReference.href %>">Open Step 6 <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span></a><% } %>
  </div>
  <% if (finalMechanicalReference) { %>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3 rounded-base border border-default bg-neutral-secondary p-3 text-sm text-body">
      <p><strong class="text-heading">Material provenance from Step 1:</strong> <%= finalMechanicalReference.materialId || 'Not recorded in Step 1' %><span class="mt-1 block text-xs">This is the resin, formulation or supplier-lot identifier recorded with the layer-formation trials; Step 7 does not create a second material code.</span></p>
      <a class="inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="<%= finalMechanicalReference.materialHref %>">Open Step 1 <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span></a>
    </div>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-base border border-default bg-neutral-secondary p-3 text-sm text-body">
      <p><strong class="text-heading">Post-cure reference:</strong> <%= finalMechanicalReference.postCureTimeMin ?? '–' %> min · <%= finalMechanicalReference.postCureTempC ?? '–' %> °C · <%= finalMechanicalReference.postCureIrradianceMwCm2 ?? '–' %> mW/cm² · Tg <%= finalMechanicalReference.finalTgC ?? '–' %> °C</p>
      <button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base border border-default-medium bg-neutral-primary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#finalMechanicalPostCureReference" data-copy-icon title="Copy post-cure reference as TSV" aria-label="Copy post-cure reference as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
    </div>
    <table class="sr-only" id="finalMechanicalPostCureReference"><thead><tr><th>Post-cure time (min)</th><th>Post-cure temperature (°C)</th><th>Post-cure irradiance (mW/cm²)</th><th>Final Tg (°C)</th></tr></thead><tbody><tr><td><%= finalMechanicalReference.postCureTimeMin ?? '' %></td><td><%= finalMechanicalReference.postCureTempC ?? '' %></td><td><%= finalMechanicalReference.postCureIrradianceMwCm2 ?? '' %></td><td><%= finalMechanicalReference.finalTgC ?? '' %></td></tr></tbody></table>
  <% } %>
  <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/mechanical-qualification/setup" data-final-mechanical-setup data-generator-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <label class="block text-sm font-medium text-heading">Conditioning temperature<span class="mt-1 block text-xs font-normal text-body">Fixed before all tests · °C</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="mechanical_conditioning_temp_c" type="number" step="any" required value="<%= stepSettings?.mechanical_conditioning_temp_c ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Conditioning duration<span class="mt-1 block text-xs font-normal text-body">Fixed before all tests · h</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="mechanical_conditioning_time_h" type="number" min="0" step="any" required value="<%= stepSettings?.mechanical_conditioning_time_h ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Relative humidity<span class="mt-1 block text-xs font-normal text-body">Optional fixed condition · %RH</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="mechanical_conditioning_rh_pct" type="number" min="0" max="100" step="any" value="<%= stepSettings?.mechanical_conditioning_rh_pct ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <input name="mechanical_resin_batch" type="hidden" value="<%= finalMechanicalReference?.materialId ?? stepSettings?.mechanical_resin_batch ?? '' %>">
      <label class="block text-sm font-medium text-heading sm:col-span-2">Tensile method<span class="mt-1 block text-xs font-normal text-body">Standard, specimen type and crosshead rate</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="mechanical_tensile_method" type="text" maxlength="500" required value="<%= stepSettings?.mechanical_tensile_method ?? '' %>" placeholder="Example: ISO 527-2, type 1BA, 1 mm/min" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Additional methods<span class="mt-1 block text-xs font-normal text-body">Flexural, HDT, DMA — if used</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="mechanical_additional_methods" type="text" maxlength="500" value="<%= stepSettings?.mechanical_additional_methods ?? '' %>" placeholder="Example: ISO 178; ISO 75" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-final-mechanical-setup-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Save setup</button><span class="text-xs text-body" data-final-mechanical-setup-status>Orientation remains the row-level factor; material ID, conditioning and methods are common evidence.</span></div>
  </form>
</section>

<section class="mb-6 overflow-visible rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="finalMechanicalRunsTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-lg font-semibold tracking-tight text-heading" id="finalMechanicalRunsTitle">Final mechanical specimens</h2><p class="mt-1 text-sm text-body">One row is one conditioned specimen. Build orientation is the row-level factor; all cells to its right are measurements.</p></div>
    <div class="flex items-center gap-2"><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" id="addRunBtn" title="Add specimen" aria-label="Add specimen" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded" aria-hidden="true">add</span></button><button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#finalMechanicalRunsTable" data-copy-exclude-columns="status" data-copy-icon title="Copy specimens as TSV" aria-label="Copy specimens as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button></div>
  </div>
  <div class="overflow-x-auto rounded-base border border-default"><table class="min-w-full border-separate border-spacing-y-1 text-left text-sm text-body" id="finalMechanicalRunsTable" data-run-table data-final-mechanical-table>
    <thead class="[&_th]:whitespace-nowrap [&_th]:border-b [&_th]:border-default [&_th]:bg-neutral-secondary [&_th]:px-3 [&_th]:py-2 [&_th]:text-xs [&_th]:font-medium [&_th]:uppercase [&_th]:text-body"><tr>
      <th><%- tooltip('final-mechanical-tip-run', 'Run', 'One individually tested, conditioned specimen.') %></th><th><%- tooltip('final-mechanical-tip-orientation', 'Orient.', 'Build orientation of the specimen; this is a varied factor.') %></th><th><%- tooltip('final-mechanical-tip-tensile', 'σt<br><span class="normal-case font-normal">MPa</span>', 'Measured tensile strength.') %></th><th><%- tooltip('final-mechanical-tip-modulus', 'E<br><span class="normal-case font-normal">MPa</span>', 'Measured elastic modulus.') %></th><th><%- tooltip('final-mechanical-tip-elongation', 'ε break<br><span class="normal-case font-normal">%</span>', 'Measured elongation at break.') %></th><th><%- tooltip('final-mechanical-tip-flexural', 'σ flex<br><span class="normal-case font-normal">MPa</span>', 'Measured flexural strength, if tested.') %></th><th><%- tooltip('final-mechanical-tip-hdt', 'HDT<br><span class="normal-case font-normal">°C</span>', 'Measured heat-deflection temperature, if tested.') %></th><th><%- tooltip('final-mechanical-tip-tg', 'Tg<br><span class="normal-case font-normal">°C</span>', 'Measured final glass-transition temperature, if tested.') %></th><th><%- tooltip('final-mechanical-tip-dim', 'Δdim<br><span class="normal-case font-normal">µm</span>', 'Measured dimensional error for the declared final specimen check.') %></th><th data-copy-exclude="true"><%- tooltip('final-mechanical-tip-status', 'Excl.', 'Exclude this specimen from calculated orientation statistics.') %></th>
    </tr></thead>
    <tbody class="[&_td]:border-y [&_td]:border-default-medium [&_td]:bg-neutral-primary [&_td]:px-3 [&_td]:py-2 [&_td:first-child]:border-s [&_td:last-child]:border-e">
      <% runs.forEach((run) => { const orientation = runOrientation(run); const tensile = runValue(run, tensileField); const modulus = runValue(run, modulusField); const elongation = runValue(run, elongationField); const flexural = runValue(run, flexuralField); const hdt = runValue(run, hdtField); const tg = runValue(run, tgField); const dimensional = runValue(run, dimensionalField); %><tr data-run-row data-run-id="<%= run.id %>">
        <td class="rounded-s-base font-medium text-heading"><%= run.run_code %></td><td><select class="min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-field-id="<%= orientationField?.id %>" data-field-type="tag" <%= step.is_blocked === 1 ? 'disabled' : '' %>><option value="">–</option><% orientationOptions.forEach((option) => { %><option value="<%= option %>" <%= orientation === option ? 'selected' : '' %>><%= option === '45deg' ? '45°' : option %></option><% }); %></select></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= tensileField?.id %>" data-field-type="number" value="<%= tensile?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-24 min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= modulusField?.id %>" data-field-type="number" value="<%= modulus?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= elongationField?.id %>" data-field-type="number" value="<%= elongation?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= flexuralField?.id %>" data-field-type="number" value="<%= flexural?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= hdtField?.id %>" data-field-type="number" value="<%= hdt?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= tgField?.id %>" data-field-type="number" value="<%= tg?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= dimensionalField?.id %>" data-field-type="number" value="<%= dimensional?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td><td class="rounded-e-base text-center" data-copy-exclude="true"><input type="checkbox" title="Exclude from calculated evidence" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %> <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
      </tr><% }); %>
    </tbody>
  </table></div>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="finalMechanicalSummaryTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4"><div><h2 class="text-lg font-semibold tracking-tight text-heading" id="finalMechanicalSummaryTitle">Calculated orientation summary</h2><p class="mt-1 text-sm text-body">Non-excluded specimens only. SD uses the sample standard deviation; CV = SD / mean. The Z / XY ratio uses orientation medians.</p></div><button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#finalMechanicalSummaryTable" data-copy-icon title="Copy orientation summary as TSV" aria-label="Copy orientation summary as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button></div>
  <div class="overflow-x-auto rounded-base border border-default"><table class="min-w-full text-left text-sm text-body" id="finalMechanicalSummaryTable"><thead class="bg-neutral-secondary text-xs font-medium uppercase text-body"><tr><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-orientation', 'Orient.', 'Build orientation grouped for the calculated statistics.') %></th><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-n', 'n', 'Number of non-excluded specimens with a tensile result.') %></th><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-mean', 'σ mean<br><span class="normal-case font-normal">MPa</span>', 'Arithmetic mean tensile strength.') %></th><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-sd', 'σ SD<br><span class="normal-case font-normal">MPa</span>', 'Sample standard deviation of tensile strength.') %></th><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-cv', 'σ CV<br><span class="normal-case font-normal">%</span>', 'Tensile standard deviation divided by tensile mean.') %></th><th class="px-3 py-2"><%- tooltip('final-mechanical-summary-modulus', 'E median<br><span class="normal-case font-normal">MPa</span>', 'Median elastic modulus.') %></th></tr></thead><tbody><% const entries = Object.entries(orientationSummary); %><% if (!entries.length) { %><tr data-copy-exclude="true"><td class="px-3 py-6 text-center" colspan="6">Enter non-excluded tensile results to calculate the orientation summary.</td></tr><% } %><% entries.forEach(([orientation, result]) => { const tensile = result.tensile_mpa || {}; const modulus = result.elastic_modulus_mpa || {}; %><tr class="border-t border-default"><td class="px-3 py-2 font-medium text-heading"><%= orientation === '45deg' ? '45°' : orientation %></td><td class="px-3 py-2"><%= tensile.n ?? 0 %></td><td class="px-3 py-2"><%= tensile.mean == null ? '–' : formatNumber(tensile.mean, 2) %></td><td class="px-3 py-2"><%= tensile.sd == null ? '–' : formatNumber(tensile.sd, 2) %></td><td class="px-3 py-2"><%= tensile.cv_pct == null ? '–' : formatNumber(tensile.cv_pct, 2) %></td><td class="px-3 py-2"><%= modulus.median == null ? '–' : formatNumber(modulus.median, 0) %></td></tr><% }); %></tbody></table></div>
  <article class="mt-5 border-t border-default pt-5"><h3 class="text-sm font-semibold text-heading">Tensile strength by build orientation</h3><p class="mt-1 text-xs text-body">Dots are individual non-excluded specimens; bars are their orientation means. This chart is descriptive and does not substitute for the stress–strain traces below.</p><div class="mt-3 h-80 w-full" id="slaFinalMechanicalTensileChart"></div></article>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="finalMechanicalCurvesTitle" id="finalMechanicalCurves">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-lg font-semibold tracking-tight text-heading" id="finalMechanicalCurvesTitle">Stress–strain source files and curves</h2><p class="mt-1 text-sm text-body">Each source file is attached to one specimen. The chart overlays every available specimen curve; absent files are not replaced with invented traces.</p></div>
    <div class="flex items-center gap-2"><button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#finalMechanicalCurveFilesTable" data-copy-exclude-columns="action" data-copy-icon title="Copy curve-source list as TSV" aria-label="Copy curve-source list as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button><button class="inline-flex items-center gap-2 rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-open-mechanical-curve-dialog <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded text-[18px]" aria-hidden="true">upload_file</span>Upload curve</button></div>
  </div>
  <div class="h-96 w-full" id="slaFinalMechanicalStressStrainChart"></div>
  <div class="mt-5 overflow-x-auto rounded-base border border-default"><table class="min-w-full text-left text-sm text-body" id="finalMechanicalCurveFilesTable"><thead class="bg-neutral-secondary text-xs font-medium uppercase text-body"><tr><th class="px-3 py-2"><%- tooltip('final-curve-tip-specimen', 'Specimen', 'One final mechanical specimen from the run table.') %></th><th class="px-3 py-2"><%- tooltip('final-curve-tip-orientation', 'Orient.', 'Build orientation recorded for this specimen.') %></th><th class="px-3 py-2"><%- tooltip('final-curve-tip-tensile', 'σt', 'Scalar tensile strength recorded for this specimen.') %></th><th class="px-3 py-2"><%- tooltip('final-curve-tip-source', 'Source file', 'Untouched TXT, CSV or TSV instrument export stored in the common file repository.') %></th><th class="px-3 py-2" data-copy-exclude="true"><%- tooltip('final-curve-tip-action', 'Action', 'Open the upload dialog for this specimen.') %></th></tr></thead><tbody class="divide-y divide-default"><% runs.forEach((run) => { const series = stressSeriesByRunId.get(String(run.id)); const source = curveFileFor(run); const orientation = runOrientation(run); const tensile = runValue(run, tensileField); %><tr><td class="px-3 py-2 font-medium text-heading"><%= run.run_code %></td><td class="px-3 py-2"><%= orientation === '45deg' ? '45°' : (orientation || '–') %></td><td class="px-3 py-2"><%= tensile?.value_real == null ? '–' : `${formatNumber(tensile.value_real, 2)} MPa` %></td><td class="px-3 py-2"><% if (source) { %><a class="font-medium text-brand no-underline hover:underline" href="<%= source.downloadUrl %>"><%= source.originalName %></a><span class="ml-2 text-xs text-body">Repository file · <%= Math.max(1, Math.round(source.sizeBytes / 1024)) %> KB</span><% } else if (series) { %><span>Legacy imported trace<%= series.source_name ? ` · ${series.source_name}` : '' %></span><% } else { %><span class="text-body">Not uploaded</span><% } %></td><td class="px-3 py-2 text-right" data-copy-exclude="true"><button class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-primary text-body shadow-xs hover:bg-neutral-secondary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-open-mechanical-curve-dialog data-mechanical-curve-run-id="<%= run.id %>" title="Upload or replace <%= run.run_code %> curve" aria-label="Upload or replace <%= run.run_code %> curve" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="material-symbols-rounded" aria-hidden="true"><%= source || series ? 'edit' : 'upload_file' %></span></button></td></tr><% }); %></tbody></table></div>
</section>

<dialog class="modal-frame fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[min(56rem,calc(100vw-2rem))] max-w-none overflow-y-auto rounded-xl border border-default-medium bg-neutral-primary p-0 text-heading shadow-2xl backdrop:bg-black/35" id="finalMechanicalCurveDialog" aria-labelledby="finalMechanicalCurveDialogTitle">
  <div class="flex items-start justify-between gap-4 border-b border-default px-5 py-4"><div><h2 class="text-lg font-semibold tracking-tight" id="finalMechanicalCurveDialogTitle">Upload stress–strain source</h2><p class="mt-1 text-sm text-body">Choose the specimen, then attach its two-column TXT, CSV or TSV export: strain (%) followed by stress (MPa). A header row is allowed.</p></div><button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base text-body hover:bg-neutral-secondary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-close-mechanical-curve-dialog aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div>
  <div class="grid gap-5 p-5 lg:grid-cols-[minmax(15rem,.8fr)_minmax(0,1.2fr)]">
    <section aria-labelledby="finalMechanicalCurveSpecimensTitle"><h3 class="text-sm font-semibold text-heading" id="finalMechanicalCurveSpecimensTitle">Specimens</h3><div class="mt-3 space-y-2" data-mechanical-curve-specimens><% runs.forEach((run, index) => { const source = curveFileFor(run); const series = stressSeriesByRunId.get(String(run.id)); const orientation = runOrientation(run); %><button class="flex w-full items-center justify-between gap-3 rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-left text-sm hover:border-brand focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-mechanical-curve-choice data-run-id="<%= run.id %>" data-run-code="<%= run.run_code %>" data-orientation="<%= orientation === '45deg' ? '45°' : orientation %>" data-source-file-id="<%= source?.id ?? '' %>" data-source-name="<%= source?.originalName ?? series?.source_name ?? '' %>" data-has-series="<%= series ? '1' : '0' %>" <%= index === 0 ? 'aria-current="true"' : '' %>><span><strong class="font-medium text-heading"><%= run.run_code %></strong><span class="ml-2 text-body"><%= orientation === '45deg' ? '45°' : (orientation || 'orientation not set') %></span></span><span class="rounded-base px-2 py-1 text-xs <%= source ? 'bg-success-soft text-success' : series ? 'bg-warning-soft text-warning' : 'bg-neutral-secondary text-body' %>"><%= source ? 'File attached' : series ? 'Legacy trace' : 'No file' %></span></button><% }); %></div></section>
    <form data-final-mechanical-curve-upload data-series-code="stress_strain_curve" data-selected-run-id="" data-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
      <p class="text-sm text-body">Selected specimen: <strong class="text-heading" data-mechanical-curve-selected>Choose a specimen</strong></p>
      <p class="mt-2 rounded-base bg-neutral-secondary p-3 text-xs text-body" data-mechanical-curve-source-status>No source file is attached.</p>
      <label class="mt-4 block text-sm font-medium text-heading">Instrument export<input class="mt-2 block w-full cursor-pointer rounded-base border border-default-medium bg-neutral-secondary-medium text-sm text-heading file:me-3 file:border-0 file:border-e file:border-default-medium file:bg-neutral-secondary file:px-3 file:py-2 file:text-sm file:font-medium file:text-heading" type="file" accept=".txt,.csv,.tsv,text/plain,text/csv,text/tab-separated-values" data-mechanical-curve-file <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <p class="mt-2 text-xs text-body">The original file is saved in the common file repository and linked to this qualification specimen. Uploading a replacement detaches the previous source from this specimen; it does not erase the previous repository file.</p>
      <div class="mt-5 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-mechanical-curve-upload-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Upload and plot</button><button class="inline-flex items-center justify-center rounded-base border border-danger-medium bg-neutral-primary px-3 py-2 text-sm font-medium text-danger shadow-xs hover:bg-danger-soft disabled:cursor-not-allowed disabled:opacity-50" type="button" data-mechanical-curve-remove disabled <%= step.is_blocked === 1 ? 'disabled' : '' %>>Remove source</button><span class="text-xs text-body" data-mechanical-curve-upload-status></span></div>
    </form>
  </div>
</dialog>
