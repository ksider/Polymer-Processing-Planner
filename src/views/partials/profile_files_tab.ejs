<% const bytes = (size) => size < 1024 ? `${size} B` : size < 1024 * 1024 ? `${(size / 1024).toFixed(1)} KB` : `${(size / (1024 * 1024)).toFixed(1)} MB`; %>
<section class="mt-4 grid gap-4" id="profile-files" role="tabpanel" aria-label="My files">
  <% if (fileNotice) { %><div class="rounded-base border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800" role="status"><%= fileNotice %></div><% } %>
  <% if (fileError) { %><div class="rounded-base border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert"><%= fileError %></div><% } %>
  <section class="rounded-xl border border-default-medium bg-neutral-primary p-3 shadow-xs"><div class="flex flex-col gap-3 lg:flex-row lg:items-center"><div class="min-w-0 lg:w-80 xl:w-96"><h2 class="text-sm font-semibold text-heading">Upload files</h2><p class="mt-0.5 break-words text-sm text-body sm:truncate" title="Images, PDF, text, spreadsheets, office files and ZIP archives; up to 10 files, 25 MB each.">Images, PDF, text, spreadsheets, office files and ZIP archives; up to 10 files, 25 MB each.</p></div><form class="flex min-w-0 flex-1 items-center gap-2" action="/files/upload" method="post" enctype="multipart/form-data"><div class="min-w-0 flex-1"><label class="sr-only" for="profileFilesUpload">Files</label><input class="block w-full min-w-0 cursor-pointer overflow-hidden rounded-base border border-default-medium bg-neutral-secondary-medium p-0 text-sm text-heading shadow-xs file:me-3 file:shrink-0 file:border-0 file:border-e file:border-default-medium file:bg-neutral-tertiary file:px-3 file:py-2 file:text-sm file:font-medium file:text-heading hover:file:bg-neutral-secondary focus:outline-none" id="profileFilesUpload" name="files" type="file" multiple required></div><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="inline-flex shrink-0 items-center gap-2 rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="submit"><span class="material-symbols-rounded text-[19px]" aria-hidden="true">upload</span><span class="hidden sm:inline">Upload</span></button></form></div></section>
  <section class="overflow-hidden rounded-xl border border-default-medium bg-neutral-primary shadow-xs"><div class="border-b border-default px-4 py-3"><h2 class="text-sm font-semibold text-heading">Uploaded files</h2></div><% if (!files.length) { %><p class="px-4 py-10 text-center text-sm text-body">You have not uploaded any files.</p><% } else { %><div class="overflow-x-auto"><table class="w-full min-w-[56rem] text-left text-sm"><thead class="bg-neutral-secondary text-xs uppercase text-body"><tr><th class="px-4 py-3">Preview</th><th class="px-4 py-3">File</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Size</th><th class="px-4 py-3">Uploaded</th><th class="px-4 py-3">Usage</th><th class="px-4 py-3"><span class="sr-only">Actions</span></th></tr></thead><tbody class="divide-y divide-default"><% files.forEach((file) => { %><tr><td class="px-4 py-3"><% if (file.mime_type.startsWith('image/')) { %><img class="size-12 rounded-base border border-default-medium bg-neutral-secondary object-cover" src="/files/<%= file.id %>/preview" alt=""><% } else { %><span class="flex size-12 items-center justify-center rounded-base bg-neutral-secondary text-body"><span class="material-symbols-rounded" aria-hidden="true">description</span></span><% } %></td><td class="px-4 py-3 font-medium text-heading"><%= file.original_name %></td><td class="px-4 py-3 text-body"><%= file.mime_type %></td><td class="px-4 py-3 text-body"><%= bytes(file.size_bytes) %></td><td class="px-4 py-3 text-body"><%= new Date(file.created_at).toLocaleString() %></td><td class="px-4 py-3 text-body"><% if (file.usageLinks.length) { %><div class="flex flex-wrap gap-2"><% file.usageLinks.forEach((link) => { %><% if (link.href) { %><a class="font-medium text-brand no-underline hover:underline" href="<%= link.href %>"><%= link.entity_type %> #<%= link.entity_id %> · <%= link.placement %></a><% } else { %><span><%= link.entity_type %> #<%= link.entity_id %> · <%= link.placement %></span><% } %><% }) %></div><% } else { %>Not attached<% } %></td><td class="px-4 py-3 text-right"><div class="flex justify-end gap-1"><a class="inline-flex size-9 items-center justify-center rounded-base text-brand hover:bg-brand-soft focus:outline-none focus:ring-4 focus:ring-brand/20" href="/files/<%= file.id %>/download" title="Download" aria-label="Download <%= file.original_name %>"><span class="material-symbols-rounded" aria-hidden="true">download</span></a><% if (file.usageLinks.length) { %><span class="inline-flex size-9 cursor-not-allowed items-center justify-center rounded-base text-disabled" title="Remove the listed attachment before deleting this file" aria-label="File in use"><span class="material-symbols-rounded" aria-hidden="true">delete</span></span><% } else { %><form action="/me/files/<%= file.id %>/delete" method="post" data-confirm="Delete this file permanently?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="inline-flex size-9 items-center justify-center rounded-base text-red-600 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-100" type="submit" title="Delete" aria-label="Delete <%= file.original_name %>"><span class="material-symbols-rounded" aria-hidden="true">delete</span></button></form><% } %></div></td></tr><% }) %></tbody></table></div><% } %></section>
</section>
