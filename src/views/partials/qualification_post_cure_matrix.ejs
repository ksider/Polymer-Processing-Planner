<% const washMethodField = fields.find((field) => field.code === 'wash_method'); %>
<% const postCureTimeField = fields.find((field) => field.code === 'post_cure_time_min'); %>
<% const postCureTempField = fields.find((field) => field.code === 'post_cure_temp_c'); %>
<% const postCureIrradianceField = fields.find((field) => field.code === 'post_cure_irradiance_mw_cm2'); %>
<% const residualEnthalpyField = fields.find((field) => field.code === 'residual_enthalpy_j_g'); %>
<% const finalTgField = fields.find((field) => field.code === 'final_tg_c'); %>
<% const shrinkageField = fields.find((field) => field.code === 'post_cure_shrinkage_pct'); %>
<% const tensileStrengthField = fields.find((field) => field.code === 'tensile_strength_mpa'); %>
<% const deltaTgField = fields.find((field) => field.code === 'post_cure_delta_tg_c'); %>
<% let washOptions = []; try { washOptions = JSON.parse(washMethodField?.allowed_values_json || '[]'); } catch {} %>
<% const runValue = (run, field) => field ? runValueMap[String(run.id)]?.[String(field.id)] : null; %>
<% const conditionRuns = runs.filter((run) => run.run_group === 'post_cure_condition'); %>
<% const tooltip = (id, label, description) => `<span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="${id}" data-tooltip-placement="top">${label}</span><div id="${id}" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-64 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium normal-case text-white opacity-0 shadow-sm transition-opacity">${description}<div class="tooltip-arrow" data-popper-arrow></div></div>`; %>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="postCureSetupTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div>
      <h2 class="text-lg font-semibold tracking-tight text-heading" id="postCureSetupTitle">Experiment setup</h2>
      <p class="mt-1 text-sm text-body">Wash procedure, source, baseline print condition and baseline Tg apply to the whole study. FTIR is held for a dedicated spectrum workflow.</p>
    </div>
    <% if (postCureReference) { %><a class="inline-flex items-center gap-1 rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="<%= postCureReference.href %>">Open Step 3 <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span></a><% } %>
  </div>
  <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/post-cure-matrix/setup" data-post-cure-setup data-generator-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <label class="block text-sm font-medium text-heading">Wash method<span class="mt-1 block text-xs font-normal text-body">Fixed for the complete study</span><select class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_wash_method" required <%= step.is_blocked === 1 ? 'disabled' : '' %>><option value="">Choose method</option><% washOptions.forEach((method) => { %><option value="<%= method %>" <%= stepSettings?.post_cure_wash_method === method ? 'selected' : '' %>><%= method %></option><% }); %></select></label>
      <label class="block text-sm font-medium text-heading">Wash time<span class="mt-1 block text-xs font-normal text-body">Fixed procedure · min</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_wash_time_min" type="number" min="0" step="any" required value="<%= stepSettings?.post_cure_wash_time_min ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Baseline layer height<span class="mt-1 block text-xs font-normal text-body">Step 3 reference · µm</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_layer_height_um" type="number" min="0.000001" step="any" required value="<%= stepSettings?.post_cure_layer_height_um ?? postCureReference?.layerHeightUm ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Baseline exposure<span class="mt-1 block text-xs font-normal text-body">Step 3 reference · s</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_exposure_time_s" type="number" min="0.000001" step="any" required value="<%= stepSettings?.post_cure_exposure_time_s ?? postCureReference?.exposureTimeS ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading">Baseline Tg<span class="mt-1 block text-xs font-normal text-body">Specimen state before post-cure · °C</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_baseline_tg_c" type="number" step="any" required value="<%= stepSettings?.post_cure_baseline_tg_c ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
      <label class="block text-sm font-medium text-heading sm:col-span-2 xl:col-span-3">Post-cure source<span class="mt-1 block text-xs font-normal text-body">Fixed device, wavelength/spectrum, chamber atmosphere and sample position.</span><input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_source_note" type="text" maxlength="500" required value="<%= stepSettings?.post_cure_source_note ?? '' %>" placeholder="Example: 405 nm LED chamber, air, samples centred on turntable" <%= step.is_blocked === 1 ? 'disabled' : '' %>></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-post-cure-setup-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Save setup</button><span class="text-xs text-body" data-post-cure-setup-status>Step 3 values prefill the baseline print condition; saving freezes it for this study.</span></div>
  </form>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="postCureGeneratorTitle">
  <div class="mb-5 border-b border-default pb-4"><h2 class="text-lg font-semibold tracking-tight text-heading" id="postCureGeneratorTitle"><%= generator.title %></h2><p class="mt-1 text-sm text-body"><%= generator.description %></p></div>
  <form action="/experiments/<%= experimentId %>/qualification/<%= step.step_number %>/post-cure-matrix" data-post-cure-generator data-generator-blocked="<%= step.is_blocked === 1 ? '1' : '0' %>">
    <div class="grid gap-4 lg:grid-cols-4">
      <label class="block text-sm font-medium text-heading">Post-cure time levels (min)<input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_time_levels" type="text" required placeholder="<%= generator.variable_fields[0].example_levels %>" value="<%= stepSettings?.post_cure_time_levels ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="mt-1 block text-xs font-normal text-body">Zero is a valid uncured baseline; use semicolons, commas or spaces.</span></label>
      <label class="block text-sm font-medium text-heading">Temperature levels (°C)<input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_temp_levels" type="text" required placeholder="<%= generator.variable_fields[1].example_levels %>" value="<%= stepSettings?.post_cure_temp_levels ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="mt-1 block text-xs font-normal text-body">Measured specimen or chamber temperature.</span></label>
      <label class="block text-sm font-medium text-heading">Irradiance levels (mW/cm²)<input class="mt-2 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" name="post_cure_irradiance_levels" type="text" required placeholder="<%= generator.variable_fields[2].example_levels %>" value="<%= stepSettings?.post_cure_irradiance_levels ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>><span class="mt-1 block text-xs font-normal text-body">Measured at the sample plane.</span></label>
      <div class="rounded-base bg-neutral-secondary p-3 text-xs text-body"><strong class="text-heading">One row = one post-cure programme</strong><br>Each row records the parameters used to obtain a specimen set, then its DSC, shrinkage and mechanical results.</div>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2 text-sm font-medium text-white shadow-xs hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-50" type="submit" data-post-cure-generator-submit <%= step.is_blocked === 1 ? 'disabled' : '' %>>Generate conditions</button><span class="text-xs text-body" data-post-cure-generator-status>Hold wash method, source and baseline print condition fixed while comparing post-cure factors.</span></div>
  </form>
</section>

<section class="mb-6 overflow-visible rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="postCureMeasurementsTitle">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-lg font-semibold tracking-tight text-heading" id="postCureMeasurementsTitle">Post-cure programme and measurements</h2><p class="mt-1 text-sm text-body">The left side defines how the specimen set was obtained. The right side contains all resulting measurements for that same programme.</p></div>
    <button class="inline-flex size-9 shrink-0 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body shadow-xs hover:bg-neutral-tertiary hover:text-heading focus:outline-none focus:ring-4 focus:ring-brand-soft" type="button" data-copy-table="#postCureMeasurementsTable" data-copy-exclude-columns="status" data-copy-icon title="Copy programmes and measurements as TSV" aria-label="Copy programmes and measurements as TSV"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
  </div>
  <div class="overflow-x-auto rounded-base border border-default" aria-label="Post-cure programme table">
    <table class="min-w-full border-separate border-spacing-y-1 text-left text-sm text-body" id="postCureMeasurementsTable" data-run-table data-post-cure-table>
      <thead class="[&_th]:whitespace-nowrap [&_th]:border-b [&_th]:border-default [&_th]:bg-neutral-secondary [&_th]:px-3 [&_th]:py-2 [&_th]:text-xs [&_th]:font-medium [&_th]:uppercase [&_th]:text-body"><tr>
        <th><%- tooltip('post-cure-tip-run', 'Run', 'One post-cure programme and its resulting specimen set.') %></th>
        <th><%- tooltip('post-cure-tip-time', 't post<br><span class="normal-case font-normal">min</span>', 'Varied post-cure duration.') %></th>
        <th><%- tooltip('post-cure-tip-temp', 'T post<br><span class="normal-case font-normal">°C</span>', 'Varied post-cure temperature.') %></th>
        <th><%- tooltip('post-cure-tip-irradiance', 'I post<br><span class="normal-case font-normal">mW/cm²</span>', 'Measured irradiance at the sample plane.') %></th>
        <th><%- tooltip('post-cure-tip-enthalpy', 'ΔH res<br><span class="normal-case font-normal">J/g</span>', 'Residual enthalpy from the declared DSC method.') %></th>
        <th><%- tooltip('post-cure-tip-tg', 'Tg<br><span class="normal-case font-normal">°C</span>', 'Measured glass-transition temperature after post-cure.') %></th>
        <th><%- tooltip('post-cure-tip-delta', 'ΔTg<br><span class="normal-case font-normal">°C</span>', 'Calculated Tg minus the baseline Tg in setup.') %></th>
        <th><%- tooltip('post-cure-tip-shrinkage', 'Shrink<br><span class="normal-case font-normal">%</span>', 'Measured post-cure shrinkage, by the declared method.') %></th>
        <th><%- tooltip('post-cure-tip-strength', 'σt<br><span class="normal-case font-normal">MPa</span>', 'Measured tensile strength after post-cure.') %></th>
        <th><span class="sr-only">Run status</span></th>
      </tr></thead>
      <tbody class="[&_td]:border-y [&_td]:border-default-medium [&_td]:bg-neutral-primary [&_td]:px-3 [&_td]:py-2 [&_td:first-child]:border-s [&_td:last-child]:border-e">
        <% if (!conditionRuns.length) { %><tr data-copy-exclude="true"><td class="py-8 text-center" colspan="10">Save the setup, then generate a post-cure condition matrix.</td></tr><% } %>
        <% conditionRuns.forEach((run) => { const time = runValue(run, postCureTimeField); const temperature = runValue(run, postCureTempField); const irradiance = runValue(run, postCureIrradianceField); const enthalpy = runValue(run, residualEnthalpyField); const tg = runValue(run, finalTgField); const delta = runValue(run, deltaTgField); const shrinkage = runValue(run, shrinkageField); const tensile = runValue(run, tensileStrengthField); %>
          <tr data-run-row data-run-id="<%= run.id %>">
            <td class="rounded-s-base font-medium text-heading"><%= run.run_code %></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" min="0" step="any" data-field-id="<%= postCureTimeField?.id %>" data-field-type="number" value="<%= time?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" min="0" step="any" data-field-id="<%= postCureTempField?.id %>" data-field-type="number" value="<%= temperature?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><input class="w-24 min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" min="0" step="any" data-field-id="<%= postCureIrradianceField?.id %>" data-field-type="number" value="<%= irradiance?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= residualEnthalpyField?.id %>" data-field-type="number" value="<%= enthalpy?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= finalTgField?.id %>" data-field-type="number" value="<%= tg?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><span class="whitespace-nowrap" data-derived-code="post_cure_delta_tg_c"><%= delta?.value_real == null ? '–' : formatNumber(delta.value_real, 2) %></span></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= shrinkageField?.id %>" data-field-type="number" value="<%= shrinkage?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td><input class="w-20 min-w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1.5 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= tensileStrengthField?.id %>" data-field-type="number" value="<%= tensile?.value_real ?? '' %>" <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
            <td class="rounded-e-base text-center"><input type="checkbox" title="Exclude from calculated evidence" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %> <%= step.is_blocked === 1 ? 'disabled' : '' %>></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-body">The programme factors are at the left; measured values are at the right. ΔTg is calculated from the fixed baseline Tg. The future FTIR workflow will attach raw spectra to this same run rather than create a duplicate programme row.</p>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="postCureFtirTitle"><h2 class="text-lg font-semibold tracking-tight text-heading" id="postCureFtirTitle">FTIR conversion</h2><p class="mt-1 text-sm text-body">Deferred until the spectrum workflow is connected. It will import raw spectra, identify the C=C and reference bands, preserve baseline and integration choices, then attach the calculated conversion to the relevant post-cure run.</p></section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-5 shadow-xs" aria-labelledby="postCureChartsTitle">
  <div class="border-b border-default pb-4"><h2 class="text-lg font-semibold tracking-tight text-heading" id="postCureChartsTitle">Post-cure response curves</h2><p class="mt-1 text-sm text-body">Each line is one fixed temperature/irradiance condition. Excluded rows are not plotted.</p></div>
  <div class="space-y-6 pt-4"><article><h3 class="text-sm font-semibold text-heading">Tg vs post-cure time</h3><div class="mt-3 h-80 w-full" id="slaPostCureTgChart"></div></article><article><h3 class="text-sm font-semibold text-heading">Shrinkage vs post-cure time</h3><div class="mt-3 h-80 w-full" id="slaPostCureShrinkageChart"></div></article><article><h3 class="text-sm font-semibold text-heading">Tensile strength vs post-cure time</h3><div class="mt-3 h-80 w-full" id="slaPostCureStrengthChart"></div></article></div>
</section>
