 'checked' : '' %>></td><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td><td><button class="inline-flex size-8 items-center justify-center rounded-base text-danger hover:bg-danger-soft" type="button" data-run-delete title="Delete run"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">delete</span></button></td></tr><% }); %>
