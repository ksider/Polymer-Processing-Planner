    <section class="rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs" aria-label="Vacuum-capacity verification runs">
      <div class="mb-3 flex items-center justify-between gap-3"><div><h3 class="text-sm font-semibold text-heading">2. Throughput-verification runs</h3><p class="mt-1 text-xs text-body">Target melt throughput and screw speed are the varying conditions. The actual throughput is the feeder measurement used for the final capacity limit.</p></div><span class="rounded-full bg-neutral-primary px-2.5 py-1 text-xs font-medium text-body"><%= vacuumCapacityRuns.length %> run<%= vacuumCapacityRuns.length === 1 ? '' : 's' %></span></div>
      <div class="overflow-x-auto"><table class="<%= inputTableClass %> [&_input[type=number]]:min-w-20 [&_input[type=number]]:w-20" data-run-table><thead><tr><th>Run</th><th>Date</th><th>Owner</th><% vacuumCapacityFields.forEach((field) => { const tooltipId = `vacuumCapacityFieldTip-${field.id}`; %><th class="whitespace-nowrap"><span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="<%= tooltipId %>" aria-label="<%= tableFieldTooltip(field) %>"><%= tableFieldLabel(field, 'capacity') %><% if (field.unit) { %> <span class="normal-case text-body">(<%= field.unit %>)</span><% } %></span><div id="<%= tooltipId %>" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-56 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity"><%= tableFieldTooltip(field) %><div class="tooltip-arrow" data-popper-arrow></div></div></th><% }); %><th>Done</th><th>Exclude</th><th></th></tr></thead><tbody>
        <% if (!vacuumCapacityRuns.length) { %><tr><td class="py-8 text-center text-sm text-body" colspan="<%= vacuumCapacityFields.length + 6 %>">Set the selected vacuum and paired throughput/screw-speed levels, then generate capacity runs.</td></tr><% } %>
        <% vacuumCapacityRuns.forEach((run) => { %><tr data-run-row data-run-id="<%= run.id %>" data-run-group="<%= run.run_group %>"><td class="whitespace-nowrap font-medium text-heading"><%= run.run_code %></td><td><input class="min-w-32 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="date" data-run-performed value="<%= run.performed_at || '' %>"></td><td><select class="min-w-36 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-run-responsible><option value="">Unassigned</option><% assignableUsers.forEach((user) => { %><option value="<%= user.id %>" <%= Number(run.responsible_user_id) === Number(user.id) ? 'selected' : '' %>><%= user.name || user.email %></option><% }); %></select></td><% vacuumCapacityFields.forEach((field) => { const value = valuesFor(run, field); %><td><% if (field.is_derived) { %><span class="whitespace-nowrap text-sm text-body" data-derived-code="<%= field.code %>"><%= formatNumber(value?.value_real) %></span><% } else if (field.field_type === 'boolean') { %><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= value?.value_real === 1 ? 'checked' : '' %>><% } else { %><input class="min-w-20 w-20 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="number" step="any" data-field-id="<%= field.id %>" data-field-type="number" value="<%= value?.value_real ?? '' %>"><% } %></td><% }); %><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="done" <%= run.done === 1 ? 'checked' : '' %>></td><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td><td><button class="inline-flex size-8 items-center justify-center rounded-base text-danger hover:bg-danger-soft" type="button" data-run-delete title="Delete run"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">delete</span></button></td></tr><% }); %>
      </tbody></table></div>
      <article class="mt-5 rounded-base border border-default bg-neutral-primary p-4"><div class="border-b border-default pb-3"><h4 class="text-sm font-semibold text-heading">Residual volatiles and carryover versus actual throughput</h4><p class="mt-1 text-xs text-body">Use this check to confirm the highest throughput without vent stuffing at the selected vacuum.</p></div><div class="mt-4 h-72 w-full" id="vacuumCapacityChart"></div></article>
    </section>
  <% } else if (step.step_number === 9) { %>
    <section class="rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs" aria-label="Reactive-extrusion runs">
      <div class="mb-3 flex items-center justify-between gap-3"><div><h3 class="text-sm font-semibold text-heading">3. Reactive-extrusion runs</h3><p class="mt-1 text-xs text-body">Record the off-line chemical result from the selected method. Add REX-specific RTD only when it has actually been measured; without it, Da remains intentionally blank.</p></div><span class="rounded-full bg-neutral-primary px-2.5 py-1 text-xs font-medium text-body"><%= reactiveRuns.length %> run<%= reactiveRuns.length === 1 ? '' : 's' %></span></div>
      <div class="overflow-x-auto"><table class="<%= inputTableClass %> [&_input[type=number]]:min-w-20 [&_input[type=number]]:w-20" data-run-table><thead><tr><th>Run</th><th>Date</th><th>Owner</th><% reactiveFields.forEach((field) => { const tooltipId = `reactiveFieldTip-${field.id}`; %><th class="whitespace-nowrap"><span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="<%= tooltipId %>" aria-label="<%= tableFieldTooltip(field) %>"><%= tableFieldLabel(field, 'reactive') %><% if (field.unit) { %> <span class="normal-case text-body">(<%= field.unit %>)</span><% } %></span><div id="<%= tooltipId %>" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-56 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity"><%= tableFieldTooltip(field) %><div class="tooltip-arrow" data-popper-arrow></div></div></th><% }); %><th>Done</th><th>Exclude</th><th></th></tr></thead><tbody>
        <% if (!reactiveRuns.length) { %><tr><td class="py-8 text-center text-sm text-body" colspan="<%= reactiveFields.length + 6 %>">Set the REX recipe and paired operating conditions, then generate the matrix.</td></tr><% } %>
        <% reactiveRuns.forEach((run) => { %><tr data-run-row data-run-id="<%= run.id %>" data-run-group="<%= run.run_group %>"><td class="whitespace-nowrap font-medium text-heading"><%= run.run_code %></td><td><input class="min-w-32 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="date" data-run-performed value="<%= run.performed_at || '' %>"></td><td><select class="min-w-36 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-run-responsible><option value="">Unassigned</option><% assignableUsers.forEach((user) => { %><option value="<%= user.id %>" <%= Number(run.responsible_user_id) === Number(user.id) ? 'selected' : '' %>><%= user.name || user.email %></option><% }); %></select></td><% reactiveFields.forEach((field) => { const value = valuesFor(run, field); %><td><% if (field.is_derived) { %><span class="whitespace-nowrap text-sm text-body" data-derived-code="<%= field.code %>"><%= formatNumber(value?.value_real) %></span><% } else if (field.field_type === 'boolean') { %><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= value?.value_real === 1 ? 'checked' : '' %>><% } else { %><input class="<%= field.field_type === 'text' ? 'min-w-36 w-36' : 'min-w-20 w-20' %> rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="<%= field.field_type === 'number' ? 'number' : 'text' %>" step="any" data-field-id="<%= field.id %>" data-field-type="<%= field.field_type %>" value="<%= field.field_type === 'number' ? (value?.value_real ?? '') : (value?.value_text ?? '') %>"><% } %></td><% }); %><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="done" <%= run.done === 1 ? 'checked' : '' %>></td><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td><td><button class="inline-flex size-8 items-center justify-center rounded-base text-danger hover:bg-danger-soft" type="button" data-run-delete title="Delete run"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">delete</span></button></td></tr><% }); %>
      </tbody></table></div>
      <div class="mt-5 grid gap-5 xl:grid-cols-2">
        <article class="rounded-base border border-default bg-neutral-primary p-4"><div class="border-b border-default pb-3"><h4 class="text-sm font-semibold text-heading">Chemical result versus REX residence time</h4><p class="mt-1 text-xs text-body">Shown only for REX-specific RTD measurements; a Step 5 reference is not substituted silently.</p></div><div class="mt-4 h-72 w-full" id="reactiveConversionChart"></div></article>
        <article class="rounded-base border border-default bg-neutral-primary p-4"><div class="border-b border-default pb-3"><h4 class="text-sm font-semibold text-heading">Product MFR versus reaction temperature</h4><p class="mt-1 text-xs text-body">All entered reaction points are shown. Green points pass the configured chemistry, MFR, thermal and stability gates.</p></div><div class="mt-4 h-72 w-full" id="reactiveMfrChart"></div></article>
        <article class="rounded-base border border-default bg-neutral-primary p-4"><div class="border-b border-default pb-3"><h4 class="text-sm font-semibold text-heading">Apparent Arrhenius evidence</h4><p class="mt-1 text-xs text-body">ln(kapp) versus 1/T is descriptive evidence only; it is available after REX RTD and chemical results are entered.</p></div><div class="mt-4 h-72 w-full" id="reactiveArrheniusChart"></div></article>
      </div>
      <aside class="mt-5 rounded-base border border-brand-200 bg-brand-50 p-4" aria-label="REX decision status">
        <div class="flex items-start gap-3"><span class="material-symbols-rounded mt-0.5 text-brand" aria-hidden="true">fact_check</span><div><h4 class="text-sm font-semibold text-heading">REX decision status</h4><p class="mt-1 text-xs text-body">Observed operating-window recommendation from the configured acceptance gates and measured runs.</p><div class="mt-3 text-sm text-heading" data-reactive-recommendation>Enter run evidence to evaluate the operating window.</div></div></div>
      </aside>
    </section>
  <% } else { %>
    <div class="overflow-x-auto"><table class="<%= inputTableClass %>" data-run-table><thead><tr><th>Run</th><th>Date</th><th>Responsible</th><% activeFields.forEach((field) => { %><th><%= field.label %><% if (field.unit) { %> <span class="normal-case text-body">(<%= field.unit %>)</span><% } %></th><% }); %><th>Done</th><th>Exclude</th><th></th></tr></thead><tbody>
      <% if (!runs.length) { %><tr><td class="py-8 text-center text-sm text-body" colspan="<%= activeFields.length + 6 %>">Set the study conditions, then generate runs.</td></tr><% } %>
      <% runs.forEach((run) => { %><tr data-run-row data-run-id="<%= run.id %>" data-run-group="<%= run.run_group %>"><td class="whitespace-nowrap font-medium text-heading"><%= run.run_code %></td><td><input class="min-w-32 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="date" data-run-performed value="<%= run.performed_at || '' %>"></td><td><select class="min-w-36 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-run-responsible><option value="">Unassigned</option><% assignableUsers.forEach((user) => { %><option value="<%= user.id %>" <%= Number(run.responsible_user_id) === Number(user.id) ? 'selected' : '' %>><%= user.name || user.email %></option><% }); %></select></td><% activeFields.forEach((field) => { const value = valuesFor(run, field); %><td><% if (field.is_derived) { %><span class="whitespace-nowrap text-sm text-body" data-derived-code="<%= field.code %>"><%= formatNumber(value?.value_real) %></span><% } else if (field.field_type === 'boolean') { %><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= value?.value_real === 1 ? 'checked' : '' %>><% } else { %><input class="min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="<%= field.field_type === 'number' ? 'number' : 'text' %>" step="any" data-field-id="<%= field.id %>" data-field-type="<%= field.field_type %>" value="<%= field.field_type === 'number' ? (value?.value_real ?? '') : (value?.value_text ?? '') %>"><% } %></td><% }); %><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="done" <%= run.done === 1 ? 'checked' : '' %>></td><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td><td><button class="inline-flex size-8 items-center justify-center rounded-base text-danger hover:bg-danger-soft" type="button" data-run-delete title="Delete run"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">delete</span></button></td></tr><% }); %>
    </tbody></table></div>
  <% } %>
  <% if (step.step_number === 10) { %>
    <article class="mt-5 rounded-base border border-default bg-neutral-secondary p-4">
      <div class="border-b border-default pb-3"><h3 class="text-sm font-semibold text-heading">Production convergence to the laboratory point</h3><p class="mt-1 text-xs text-body">The diamond is the laboratory target: 0% SME deviation and laboratory d50. The shaded window is the configured SME/d50 acceptance region; only entered production measurements are plotted.</p></div>
      <div class="mt-4 h-72 w-full" id="scaleUpMorphologyChart" data-source-d50="<%= stepSettings?.scale_up_source_particle_size_d50_um ?? '' %>" data-source-sme="<%= stepSettings?.scale_up_recommendation?.sourceSmeKwhKg ?? stepSettings?.scale_up_source_sme_kwh_kg ?? '' %>" data-morphology-tolerance="<%= stepSettings?.scale_up_morphology_tolerance_pct ?? 5 %>"></div>
    </article>
  <% } %>
</section>
</form>

<section class="mb-6 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs sm:p-5">
  <div class="border-b border-default pb-4"><h2 class="text-base font-semibold text-heading">Transferable result</h2><p class="mt-1 text-sm text-body">Confirm the accepted limits below. DOE will use these values as a documented constraint or factor range, not as an untraceable default.</p></div>
  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <% visibleOutputDefinitions.forEach((definition) => { const output = outputByCode.get(definition.code); %>
      <label class="text-sm font-medium text-heading"><%= definition.label %><% if (definition.unit) { %> <span class="font-normal text-body">(<%= definition.unit %>)</span><% } %>
        <input class="<%= inputClass %>" type="number" step="any" data-step-output="<%= definition.code %>" value="<%= output?.value_real ?? '' %>">
        <span class="mt-1 block text-xs font-normal text-body"><%= definition.description %></span>
      </label>
    <% }) %>
  </div>
</section>
