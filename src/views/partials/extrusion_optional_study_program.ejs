<%
  const sideFeedingMode = step.step_number === 6 && stepSettings?.side_feeding_material_mode === 'fiber' ? 'fiber' : 'particulate';
  const particulateOnlyFieldCodes = new Set(['filler_volume_fraction_pct', 'reduced_filler_volume_fraction', 'composite_viscosity_pa_s']);
  const fiberOnlyFieldCodes = new Set(['fiber_initial_length_mm', 'fiber_final_length_mm', 'specific_mechanical_energy_kwh_kg', 'fiber_length_retention_pct']);
  const activeFields = fields.filter((field) => field.is_enabled === 1 && !(step.step_number === 6 && ((sideFeedingMode === 'fiber' && particulateOnlyFieldCodes.has(field.code)) || (sideFeedingMode === 'particulate' && fiberOnlyFieldCodes.has(field.code)))));
  const sideFeederFieldCodes = new Set(['main_screw_speed_rpm', 'matrix_throughput_kg_h', 'side_feeder_speed_rpm', 'filler_throughput_kg_h', 'side_feeder_torque_nm', 'side_feeder_throughput_cv_pct', 'injection_port_pressure_bar', 'no_powder_accumulation', 'filler_mass_fraction_pct']);
  const feederStabilityFields = activeFields.filter((field) => step.step_number !== 6 || sideFeederFieldCodes.has(field.code));
  const feederStabilityRuns = step.step_number === 6 ? runs.filter((run) => run.run_group === 'feeder_stability' || run.run_group === 'side_feeding') : runs;
  const materialIncorporationRuns = step.step_number === 6 ? runs.filter((run) => run.run_group === 'particulate_filler' || run.run_group === 'fiber_retention') : [];
  const liquidCalibrationRuns = step.step_number === 7 ? runs.filter((run) => run.run_group === 'liquid_pump_calibration') : [];
  const liquidInjectionRuns = step.step_number === 7 ? runs.filter((run) => run.run_group === 'liquid_melt_injection' || run.run_group === 'liquid_dosing') : [];
  const vacuumCalibrationRuns = step.step_number === 8 ? runs.filter((run) => run.run_group === 'vacuum_calibration' || run.run_group === 'devolatilization') : [];
  const vacuumCapacityRuns = step.step_number === 8 ? runs.filter((run) => run.run_group === 'vacuum_capacity') : [];
  const reactiveRuns = step.step_number === 9 ? runs.filter((run) => run.run_group === 'reactive_extrusion' || run.run_group === 'default') : [];
  const liquidCalibrationFieldCodes = ['liquid_target_throughput_kg_h', 'liquid_throughput_kg_h', 'liquid_throughput_cv_pct', 'liquid_throughput_error_pct'];
  const liquidInjectionFieldCodes = ['liquid_target_throughput_kg_h', 'liquid_throughput_kg_h', 'liquid_throughput_cv_pct', 'injection_pressure_bar', 'barrel_pressure_bar', 'motor_torque_nm', 'no_liquid_backflow', 'no_liquid_leak', 'liquid_mass_fraction_pct', 'injection_pressure_delta_bar', 'liquid_throughput_error_pct'];
  const vacuumCalibrationFieldCodes = ['vacuum_target_pressure_mbar', 'vacuum_pressure_mbar', 'residual_volatiles_pct', 'trap_carryover_g', 'vacuum_stable', 'no_vent_foam_or_stuffing', 'devolatilization_efficiency_pct'];
  const vacuumCapacityFieldCodes = ['devol_target_throughput_kg_h', 'screw_speed_rpm', 'throughput_kg_h', 'vacuum_pressure_mbar', 'residual_volatiles_pct', 'trap_carryover_g', 'vacuum_stable', 'no_vent_foam_or_stuffing', 'devolatilization_efficiency_pct'];
  const reactiveFieldCodes = ['reaction_temp_c', 'screw_speed_rpm', 'reaction_target_throughput_kg_h', 'throughput_kg_h', 'mean_residence_time_s', 'chemical_signal_ratio', 'conversion_pct', 'product_mfr_g_10min', 'reaction_exotherm_peak_c', 'reaction_stable', 'reaction_rate_constant_s_inv', 'damkohler_number'];
  const fieldsInOrder = (codes) => codes.map((code) => activeFields.find((field) => field.code === code)).filter(Boolean);
  const liquidCalibrationFields = step.step_number === 7 ? fieldsInOrder(liquidCalibrationFieldCodes) : [];
  const liquidInjectionFields = step.step_number === 7 ? fieldsInOrder(liquidInjectionFieldCodes) : [];
  const vacuumCalibrationFields = step.step_number === 8 ? fieldsInOrder(vacuumCalibrationFieldCodes) : [];
  const vacuumCapacityFields = step.step_number === 8 ? fieldsInOrder(vacuumCapacityFieldCodes) : [];
  const reactiveFields = step.step_number === 9 ? fieldsInOrder(reactiveFieldCodes) : [];
  const visibleOutputDefinitions = outputDefinitions.filter((definition) => !(step.step_number === 6 && ((sideFeedingMode === 'fiber' && ['filler_mass_fraction_max_pct', 'filler_volume_fraction_max_pct'].includes(definition.code)) || (sideFeedingMode === 'particulate' && definition.code === 'fiber_length_retention_min_pct'))));
  const compactSideFeedingLabels = {
    main_screw_speed_rpm: 'Nmain', matrix_throughput_kg_h: 'Qmatrix', side_feeder_speed_rpm: 'Nside', filler_throughput_kg_h: 'Qfiller',
    side_feeder_torque_nm: 'Mside', side_feeder_throughput_cv_pct: 'CV', injection_port_pressure_bar: 'Pinj', no_powder_accumulation: 'Clear 10 min',
    filler_mass_fraction_pct: 'wfiller', filler_volume_fraction_pct: 'φv', reduced_filler_volume_fraction: 'φ/φm', composite_viscosity_pa_s: 'η',
    fiber_initial_length_mm: 'L0', fiber_final_length_mm: 'Ln', specific_mechanical_energy_kwh_kg: 'SME', fiber_length_retention_pct: 'L retention'
  };
  const compactLiquidLabels = {
    screw_speed_rpm: 'N', polymer_throughput_kg_h: 'Qpoly', liquid_target_throughput_kg_h: 'Qliq set', liquid_throughput_kg_h: 'Qliq act',
    liquid_throughput_cv_pct: 'CV', injection_pressure_bar: 'Pinj', barrel_pressure_bar: 'Pbarrel', motor_torque_nm: 'M',
    no_liquid_backflow: 'No backflow', no_liquid_leak: 'No leak', liquid_mass_fraction_pct: 'wliq', injection_pressure_delta_bar: 'ΔPinj', liquid_throughput_error_pct: 'Q error'
  };
  const compactVacuumLabels = {
    vacuum_target_pressure_mbar: 'Pvac set', vacuum_pressure_mbar: 'Pvac act', devol_target_throughput_kg_h: 'Qmelt set',
    screw_speed_rpm: 'N', throughput_kg_h: 'Qmelt act', residual_volatiles_pct: 'wres', trap_carryover_g: 'Trap',
    vacuum_stable: 'Pvac stable', no_vent_foam_or_stuffing: 'Vent OK', devolatilization_efficiency_pct: 'Edevol'
  };
  const compactReactiveLabels = {
    reaction_temp_c: 'Trxn', screw_speed_rpm: 'N', reaction_target_throughput_kg_h: 'Q set', throughput_kg_h: 'Q act', mean_residence_time_s: 't̄ REX',
    chemical_signal_ratio: 'Signal ratio', conversion_pct: 'α chem', product_mfr_g_10min: 'MFR', reaction_exotherm_peak_c: 'Exo peak',
    reaction_stable: 'Stable 15 min', reaction_rate_constant_s_inv: 'kapp', damkohler_number: 'Da'
  };
  const tableFieldLabel = (field, study = '') => {
    if (step.step_number === 6) return compactSideFeedingLabels[field.code] || field.label;
    if (step.step_number === 7 && field.code === 'liquid_throughput_kg_h') return study === 'calibration' ? 'Pump Q act' : 'Qliq act @ Pinj';
    if (step.step_number === 7) return compactLiquidLabels[field.code] || field.label;
    if (step.step_number === 8) return compactVacuumLabels[field.code] || field.label;
    return step.step_number === 9 ? (compactReactiveLabels[field.code] || field.label) : field.label;
  };
  const tableFieldTooltip = (field) => `${field.label}${field.unit ? ` (${field.unit})` : ''}`;
  const fieldByCode = new Map(activeFields.map((field) => [field.code, field]));
  const outputByCode = new Map(stepOutputs.map((output) => [output.output_code, output]));
  const valuesFor = (run, field) => runValueMap[String(run.id)]?.[String(field.id)];
  const inputClass = 'mt-1.5 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs placeholder:text-body focus:border-brand focus:ring-brand';
  const setupByStep = {
    6: {
      title: 'Side-feeder sweep',
      description: 'Hold the main extruder condition fixed and sweep side-feeder speed. Measure the actual filler rate after the feeder reaches steady state.',
      fields: [
        { setting: 'side_feeding_main_screw_speed_rpm', request: 'main_screw_speed_rpm', label: 'Main screw speed', unit: 'rpm', fallback: '' },
        { setting: 'side_feeding_matrix_throughput_kg_h', request: 'matrix_throughput_kg_h', label: 'Matrix throughput', unit: 'kg/h', fallback: '' },
        { setting: 'side_feeding_injection_zone_temp_c', request: 'injection_zone_temp_c', label: 'Injection-zone temperature', unit: '°C', fallback: '' },
        { setting: 'side_feeding_speed_levels_rpm', request: 'side_feeder_speed_levels_rpm', label: 'Side-feeder speeds', unit: 'rpm', fallback: '5, 10, 15' }
      ]
    },
    7: {
      title: 'Liquid dosing and melt injection',
      description: 'First calibrate the liquid pump outside the extruder, then verify injection into a fixed melt condition. This is a sequential sweep, not a factorial DOE.',
      fields: [
        { setting: 'liquid_calibration_target_throughput_levels_kg_h', request: 'liquid_target_throughput_levels_kg_h', label: 'Target liquid throughputs', unit: 'kg/h', fallback: '0.3, 0.6, 0.9' }
      ]
    },
    8: {
      title: 'Vacuum degassing calibration',
      description: 'Calibrate the vacuum requirement at one fixed melt condition, then verify the usable throughput at the selected vacuum. This is a sequential qualification, not a factorial DOE.',
      fields: [
        { setting: 'devol_vacuum_target_levels_mbar', request: 'vacuum_target_pressure_levels_mbar', label: 'Target vacuum pressures', unit: 'mbar', fallback: '50, 100, 200' }
      ]
    },
    9: {
      title: 'Reactive-extrusion operating window',
      description: 'Screen reaction temperature against paired screw-speed and throughput conditions. REX RTD can be added later to confirm kinetics; it is not a prerequisite for the operating-window study.',
      fields: []
    },
    10: {
      title: 'Scale-up verification matrix',
      description: 'Calculate the D³ throughput target from the source and production screw diameters, then generate a verification sweep around it. Use only when the formulation and screw geometry are comparable.',
      fields: [
        { setting: 'scale_up_source_screw_diameter_mm', request: 'source_screw_diameter_mm', label: 'Source screw diameter', unit: 'mm', fallback: '', calculator: true },
        { setting: 'scale_up_production_screw_diameter_mm', request: 'production_screw_diameter_mm', label: 'Production screw diameter', unit: 'mm', fallback: '', calculator: true },
        { setting: 'scale_up_source_throughput_kg_h', request: 'source_throughput_kg_h', label: 'Source throughput', unit: 'kg/h', fallback: '', calculator: true },
        { setting: 'scale_up_source_sme_kwh_kg', request: 'source_sme_kwh_kg', label: 'Source SME target', unit: 'kWh/kg', fallback: '', calculator: true },
        { setting: 'scale_up_production_screw_speed_levels_rpm', request: 'production_screw_speed_levels_rpm', label: 'Production screw-speed levels', unit: 'rpm', fallback: '100, 150, 200' },
        { setting: 'scale_up_production_throughput_multipliers', request: 'production_throughput_multipliers', label: 'Throughput multipliers', unit: '× D³ target', fallback: '0.85, 1, 1.15' }
      ]
    }
  };
  const setup = setupByStep[step.step_number];
  const scaleUpSourceSettings = new Set([
    'scale_up_source_screw_diameter_mm',
    'scale_up_source_throughput_kg_h'
  ]);
%>

<form id="extrusionOptionalSetupForm" action="/experiments/<%= step.experiment_id %>/qualification/<%= step.step_number %>/settings" method="post">
<section class="mb-6 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs sm:p-5">
  <div class="border-b border-default pb-4">
    <h2 class="text-base font-semibold text-heading"><%= setup.title %></h2>
    <p class="mt-1 max-w-3xl text-sm text-body"><%= setup.description %></p>
  </div>
  <div class="mt-4">
    <% if (step.step_number === 10) { %>
      <div class="max-w-7xl">
        <h3 class="mb-1 text-sm font-semibold text-heading">Scale-up start-point recommendation</h3>
        <p class="mb-4 text-sm text-body">Scale a comparable stable laboratory point by diameter, free volume, density and screw-speed limits. RTD remains verification evidence, not a calculation input.</p>
        <div class="grid gap-4 lg:grid-cols-3">
          <fieldset class="rounded-base border border-default-medium bg-neutral-secondary p-4">
            <legend class="px-1 text-sm font-semibold text-heading">Laboratory point</legend>
            <div class="grid gap-4">
              <% setup.fields.filter((item) => scaleUpSourceSettings.has(item.setting)).forEach((item) => { %>
                <label class="text-sm font-medium text-heading"><%= item.label %> <span class="font-normal text-body">(<%= item.unit %>)</span><input class="<%= inputClass %>" name="<%= item.setting %>" data-scale-up-request="<%= item.request %>" data-optional-request="<%= item.request %>" data-scale-up-required value="<%= stepSettings?.[item.setting] ?? item.fallback %>" placeholder="Required"></label>
              <% }) %>
              <label class="text-sm font-medium text-heading">Source screw speed <span class="font-normal text-body">(rpm)</span><input class="<%= inputClass %>" name="scale_up_source_screw_speed_rpm" data-scale-up-request="source_screw_speed_rpm" data-scale-up-required value="<%= stepSettings?.scale_up_source_screw_speed_rpm ?? '' %>" placeholder="Required"></label>
              <label class="text-sm font-medium text-heading">Source free volume <span class="font-normal text-body">(L, optional)</span><input class="<%= inputClass %>" name="scale_up_source_free_volume_l" data-scale-up-request="source_free_volume_l" value="<%= stepSettings?.scale_up_source_free_volume_l ?? '' %>" placeholder="For comparable fill"></label>
              <label class="text-sm font-medium text-heading">Source melt density <span class="font-normal text-body">(kg/L, optional)</span><input class="<%= inputClass %>" name="scale_up_source_melt_density_kg_l" data-scale-up-request="source_melt_density_kg_l" value="<%= stepSettings?.scale_up_source_melt_density_kg_l ?? '' %>" placeholder="For density correction"></label>
              <label class="text-sm font-medium text-heading">Source barrel profile <span class="font-normal text-body">(°C, comma separated)</span><input class="<%= inputClass %>" name="scale_up_source_barrel_temperature_profile_c" data-scale-up-request="source_barrel_temperature_profile_c" data-scale-up-required value="<%= stepSettings?.scale_up_source_barrel_temperature_profile_c ?? '' %>" placeholder="e.g. 170, 180, 190, 195"></label>
              <label class="text-sm font-medium text-heading">Source melt temperature <span class="font-normal text-body">(°C)</span><input class="<%= inputClass %>" name="scale_up_source_melt_temperature_c" data-scale-up-request="source_melt_temperature_c" data-scale-up-required value="<%= stepSettings?.scale_up_source_melt_temperature_c ?? '' %>" placeholder="Required"></label>
              <label class="text-sm font-medium text-heading">Laboratory particle size d50 <span class="font-normal text-body">(µm, optional)</span><input class="<%= inputClass %>" name="scale_up_source_particle_size_d50_um" value="<%= stepSettings?.scale_up_source_particle_size_d50_um ?? '' %>" placeholder="Morphology reference"></label>
              <label class="text-sm font-medium text-heading">d50 acceptance tolerance <span class="font-normal text-body">(%, optional)</span><input class="<%= inputClass %>" name="scale_up_morphology_tolerance_pct" value="<%= stepSettings?.scale_up_morphology_tolerance_pct ?? 5 %>"></label>
            </div>
          </fieldset>
          <fieldset class="rounded-base border border-default-medium bg-neutral-secondary p-4">
            <legend class="px-1 text-sm font-semibold text-heading">Production line</legend>
            <div class="grid gap-4">
              <% setup.fields.filter((item) => item.setting === 'scale_up_production_screw_diameter_mm').forEach((item) => { %>
                <label class="text-sm font-medium text-heading"><%= item.label %> <span class="font-normal text-body">(<%= item.unit %>)</span><input class="<%= inputClass %>" name="<%= item.setting %>" data-scale-up-request="<%= item.request %>" data-optional-request="<%= item.request %>" data-scale-up-required value="<%= stepSettings?.[item.setting] ?? item.fallback %>" placeholder="Required"></label>
              <% }) %>
              <label class="text-sm font-medium text-heading">Production free volume <span class="font-normal text-body">(L)</span><input class="<%= inputClass %>" name="scale_up_production_free_volume_l" data-scale-up-request="production_free_volume_l" data-scale-up-required value="<%= stepSettings?.scale_up_production_free_volume_l ?? '' %>" placeholder="Required for residence time"></label>
              <label class="text-sm font-medium text-heading">Production melt density <span class="font-normal text-body">(kg/L)</span><input class="<%= inputClass %>" name="scale_up_production_melt_density_kg_l" data-scale-up-request="production_melt_density_kg_l" data-scale-up-required value="<%= stepSettings?.scale_up_production_melt_density_kg_l ?? '' %>" placeholder="Required for residence time"></label>
              <label class="text-sm font-medium text-heading">Capacity exponent <span class="font-normal text-body">(x, 2.8–3.0)</span><input class="<%= inputClass %>" name="scale_up_capacity_exponent" data-scale-up-request="capacity_exponent" value="<%= stepSettings?.scale_up_capacity_exponent ?? 3 %>"></label>
              <label class="text-sm font-medium text-heading">Maximum screw speed <span class="font-normal text-body">(rpm, optional)</span><input class="<%= inputClass %>" name="scale_up_production_max_screw_speed_rpm" data-scale-up-request="production_max_screw_speed_rpm" value="<%= stepSettings?.scale_up_production_max_screw_speed_rpm ?? '' %>"></label>
              <label class="text-sm font-medium text-heading">Maximum tip speed <span class="font-normal text-body">(m/s)</span><input class="<%= inputClass %>" name="scale_up_production_max_tip_speed_m_s" data-scale-up-request="production_max_tip_speed_m_s" value="<%= stepSettings?.scale_up_production_max_tip_speed_m_s ?? 1.5 %>"></label>
            </div>
          </fieldset>
          <aside class="rounded-base border border-default-medium bg-neutral-secondary p-4 text-sm text-body">
            <h4 class="font-semibold text-heading">How the recommendation works</h4>
            <ol class="mt-3 list-decimal space-y-2 pl-5">
              <li>It calculates the diameter ratio <span class="font-mono text-xs text-heading">a = D₂ / D₁</span>.</li>
              <li>It recommends throughput <span class="font-mono text-xs text-heading">Q₂ = Q₁ × aˣ</span>, with x from 2.8 to 3.0.</li>
              <li>It sets screw speed to preserve comparable channel fill, using the two free volumes when available, then applies the rpm and tip-speed limits.</li>
              <li>It estimates residence time from <span class="font-mono text-xs text-heading">Vfree₂ × ρ₂ / Q₂</span>, not from RTD.</li>
            </ol>
            <div class="mt-4 border-t border-default pt-3">
              <h5 class="font-medium text-heading">What you get</h5>
              <p class="mt-1 text-xs">A starting throughput, screw speed, tip speed, temperature profile and theoretical residence-time estimate for the first production run. It is a starting point, not proof of process transfer.</p>
            </div>
          </aside>
        </div>
        <fieldset class="mt-4 rounded-base border border-brand-medium bg-brand-soft p-4">
          <legend class="px-1 text-sm font-semibold text-heading">Recommended production start point</legend>
          <div class="flex flex-wrap items-center gap-3">
            <button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand" type="button" data-calculate-scale-up>Recommend start point</button>
            <p class="text-xs text-body">The calculated recommendation is saved automatically. Validate it before approving an operating window.</p>
          </div>
          <div class="mt-4 hidden rounded-base border border-brand-medium bg-neutral-primary p-4 text-sm text-heading" data-scale-up-recommendation aria-live="polite"></div>
        </fieldset>
      </div>
    <% } %>
  </div>
</section>

<section class="mb-6 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs sm:p-5">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3 border-b border-default pb-4">
    <div><h2 class="text-base font-semibold text-heading">Study runs</h2><p class="mt-1 text-sm text-body">Enter actual measurements only after each condition has stabilized. Derived values are calculated from the row.</p></div>
    <span class="rounded-full bg-neutral-secondary px-2.5 py-1 text-xs font-medium text-body"><%= runs.length %> run<%= runs.length === 1 ? '' : 's' %></span>
  </div>
  <% if (step.step_number === 10) { %>
    <% const rtdReferences = rtdReferenceRuns || []; const rtdById = new Map(rtdReferences.map((run) => [String(run.id), run])); const sourceRtd = rtdById.get(String(stepSettings?.scale_up_source_rtd_run_id || '')); %>
    <article class="mb-4 rounded-base border border-brand-medium bg-brand-soft p-4">
      <div class="border-b border-brand-medium pb-3"><h3 class="text-sm font-semibold text-heading">Laboratory convergence target</h3><p class="mt-1 text-xs text-body">Each production row is compared with this laboratory baseline. The target point is 0% SME deviation and the laboratory d50.</p></div>
      <dl class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div><dt class="text-xs text-body">Laboratory SME</dt><dd class="mt-0.5 font-medium text-heading"><%= formatNumber(stepSettings?.scale_up_recommendation?.sourceSmeKwhKg ?? stepSettings?.scale_up_source_sme_kwh_kg) %> kWh/kg</dd></div>
        <div><dt class="text-xs text-body">Laboratory melt temperature</dt><dd class="mt-0.5 font-medium text-heading"><%= formatNumber(stepSettings?.scale_up_source_melt_temperature_c) %> °C</dd></div>
        <div><dt class="text-xs text-body">Laboratory d50</dt><dd class="mt-0.5 font-medium text-heading"><%= formatNumber(stepSettings?.scale_up_source_particle_size_d50_um) %> µm</dd></div>
        <div><dt class="text-xs text-body">d50 tolerance</dt><dd class="mt-0.5 font-medium text-heading">±<%= formatNumber(stepSettings?.scale_up_morphology_tolerance_pct ?? 5) %>%</dd></div>
      </dl>
    </article>
    <fieldset class="mb-4 rounded-base border border-default-medium bg-neutral-secondary p-4">
      <legend class="px-1 text-sm font-semibold text-heading">Laboratory RTD evidence</legend>
      <p class="mb-4 text-sm text-body">Step 5 contains only laboratory tracer runs. Select the laboratory baseline for traceability; industrial RTD does not exist before the production trial and is not requested here.</p>
      <label class="block max-w-xl text-sm font-medium text-heading">Laboratory RTD baseline<select class="<%= inputClass %>" name="scale_up_source_rtd_run_id" data-rtd-reference-select="source"><option value="">Choose an existing Step 5 run (optional)</option><% rtdReferences.forEach((run) => { %><option value="<%= run.id %>" data-rtd-href="<%= run.href %>" <%= Number(stepSettings?.scale_up_source_rtd_run_id) === run.id ? 'selected' : '' %>><%= run.runCode %> · N <%= formatNumber(run.screwSpeedRpm) %> rpm · Q <%= formatNumber(run.throughputKgH) %> kg/h · t̄ <%= formatNumber(run.meanResidenceTimeS) %> s</option><% }) %></select><a class="mt-1 inline-block text-xs font-normal text-brand hover:underline" data-rtd-reference-link="source" href="<%= sourceRtd?.href || `/experiments/${step.experiment_id}/qualification/5` %>">Open RTD study / selected run</a></label>
    </fieldset>
    <fieldset class="mb-4 rounded-base border border-default-medium bg-neutral-secondary p-4">
      <legend class="px-1 text-sm font-semibold text-heading">Machine capability check</legend>
      <p class="mb-4 text-sm text-body">Optional equipment-data assessment. It does not change the recommended start point; it checks whether the selected machine can deliver it.</p>
      <div class="grid gap-4 lg:grid-cols-2">
        <fieldset class="rounded-base border border-default-medium bg-neutral-primary p-4">
          <legend class="px-1 text-sm font-semibold text-heading">Laboratory machine</legend>
          <p class="mb-4 text-xs text-body">Use the stable laboratory operating point. Measured torque takes precedence over the SME target.</p>
          <div class="grid gap-4 md:grid-cols-3">
            <label class="text-sm font-medium text-heading">Source SME target <span class="font-normal text-body">(kWh/kg)</span><input class="<%= inputClass %>" name="scale_up_source_sme_kwh_kg" data-scale-up-request="source_sme_kwh_kg" value="<%= stepSettings?.scale_up_source_sme_kwh_kg ?? '' %>"></label>
            <label class="text-sm font-medium text-heading">Source shaft torque <span class="font-normal text-body">(N·m)</span><input class="<%= inputClass %>" name="scale_up_source_torque_nm" data-scale-up-request="source_torque_nm" value="<%= stepSettings?.scale_up_source_torque_nm ?? '' %>"></label>
            <label class="text-sm font-medium text-heading">Source no-load torque <span class="font-normal text-body">(N·m)</span><input class="<%= inputClass %>" name="scale_up_source_no_load_torque_nm" data-scale-up-request="source_no_load_torque_nm" value="<%= stepSettings?.scale_up_source_no_load_torque_nm ?? '' %>"></label>
          </div>
        </fieldset>
        <fieldset class="rounded-base border border-default-medium bg-neutral-primary p-4">
          <legend class="px-1 text-sm font-semibold text-heading">Production machine</legend>
          <p class="mb-4 text-xs text-body">Enter the production extruder’s nameplate and shaft limits.</p>
          <div class="grid gap-4 md:grid-cols-3">
            <label class="text-sm font-medium text-heading">Nominal power <span class="font-normal text-body">(kW)</span><input class="<%= inputClass %>" name="scale_up_production_nominal_power_kw" data-scale-up-request="production_nominal_power_kw" value="<%= stepSettings?.scale_up_production_nominal_power_kw ?? '' %>"></label>
            <label class="text-sm font-medium text-heading">Max shaft torque <span class="font-normal text-body">(N·m)</span><input class="<%= inputClass %>" name="scale_up_production_max_torque_nm" data-scale-up-request="production_max_torque_nm" value="<%= stepSettings?.scale_up_production_max_torque_nm ?? '' %>"></label>
            <label class="text-sm font-medium text-heading">No-load torque <span class="font-normal text-body">(N·m)</span><input class="<%= inputClass %>" name="scale_up_production_no_load_torque_nm" data-scale-up-request="production_no_load_torque_nm" value="<%= stepSettings?.scale_up_production_no_load_torque_nm ?? '' %>" placeholder="5% of max torque"></label>
            <label class="text-sm font-medium text-heading">Mechanical efficiency <span class="font-normal text-body">(0–1)</span><input class="<%= inputClass %>" name="scale_up_production_mechanical_efficiency" data-scale-up-request="production_mechanical_efficiency" value="<%= stepSettings?.scale_up_production_mechanical_efficiency ?? 0.95 %>"></label>
            <label class="text-sm font-medium text-heading">Twin-screw centre distance <span class="font-normal text-body">(cm)</span><input class="<%= inputClass %>" name="scale_up_production_center_distance_cm" data-scale-up-request="production_center_distance_cm" value="<%= stepSettings?.scale_up_production_center_distance_cm ?? '' %>"></label>
            <label class="text-sm font-medium text-heading">Torque-density limit <span class="font-normal text-body">(N·m/cm³)</span><input class="<%= inputClass %>" name="scale_up_production_torque_density_limit_nm_cm3" data-scale-up-request="production_torque_density_limit_nm_cm3" value="<%= stepSettings?.scale_up_production_torque_density_limit_nm_cm3 ?? '' %>"></label>
          </div>
        </fieldset>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-primary px-3 py-2 text-sm font-medium text-heading shadow-xs hover:bg-neutral-secondary" type="button" data-calculate-machine-capability>Check machine capability</button><p class="text-xs text-body">Requires the start-point fields above plus an SME target or measured source torque.</p></div>
      <div class="mt-4 hidden rounded-base border border-default-medium bg-neutral-primary p-4 text-sm text-heading" data-machine-capability-result aria-live="polite"></div>
    </fieldset>
  <% } %>
  <% if (step.step_number === 6) { %>
  <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
    <legend class="px-1 text-sm font-semibold text-heading">1. Side-feeder stability</legend>
    <p class="mb-4 text-sm text-body">Qualify the side feeder first: actual rate, CV, torque, pressure at the injection zone and no accumulation/bridging for 10 minutes.</p>
    <div class="grid gap-4 md:grid-cols-3 md:items-end">
      <% setup.fields.forEach((item) => { %><label class="text-sm font-medium text-heading"><%= item.label %> <span class="font-normal text-body">(<%= item.unit %>)</span><input class="<%= inputClass %>" name="<%= item.setting %>" data-optional-request="<%= item.request %>" value="<%= stepSettings?.[item.setting] ?? item.fallback %>" placeholder="<%= item.fallback || 'Required' %>"></label><% }) %>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="button" data-generate-side-feeding-program="feeder_stability">Generate feeder-stability runs</button><p class="text-xs text-body">These runs establish the usable side-feeder window before material incorporation.</p></div>
  </fieldset>
  <% } else if (step.step_number === 7) { %>
  <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
    <legend class="px-1 text-sm font-semibold text-heading">1. Liquid-pump calibration</legend>
    <p class="mb-4 text-sm text-body">Run this outside the extruder. At each target rate, collect a timed mass sample and record the actual flow and its CV. A point is accepted at CV ≤ 1.5%.</p>
    <div class="grid gap-4 md:grid-cols-2 md:items-end">
      <label class="text-sm font-medium text-heading">Target liquid-throughput levels <span class="font-normal text-body">(kg/h)</span><input class="<%= inputClass %>" name="liquid_calibration_target_throughput_levels_kg_h" value="<%= stepSettings?.liquid_calibration_target_throughput_levels_kg_h ?? '0.3, 0.6, 0.9' %>" placeholder="e.g. 0.3, 0.6, 0.9"></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="button" data-generate-liquid-program="liquid_pump_calibration">Generate calibration runs</button><p class="text-xs text-body">The accepted actual-flow range becomes the safe starting range for melt injection.</p></div>
  </fieldset>
  <% } else if (step.step_number === 8) { %>
  <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
    <legend class="px-1 text-sm font-semibold text-heading">1. Vacuum calibration</legend>
    <p class="mb-4 text-sm text-body">Use one material batch. Hold the melt condition and vent-zone temperature fixed, then reduce absolute pressure step by step. Lower mbar means deeper vacuum.</p>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      <label class="text-sm font-medium text-heading">Fixed screw speed <span class="font-normal text-body">(rpm)</span><input class="<%= inputClass %>" name="devol_calibration_screw_speed_rpm" value="<%= stepSettings?.devol_calibration_screw_speed_rpm ?? '' %>" placeholder="Required"></label>
      <label class="text-sm font-medium text-heading">Fixed melt throughput <span class="font-normal text-body">(kg/h)</span><input class="<%= inputClass %>" name="devol_calibration_throughput_kg_h" value="<%= stepSettings?.devol_calibration_throughput_kg_h ?? '' %>" placeholder="Measured stable rate"></label>
      <label class="text-sm font-medium text-heading">Vent-zone temperature <span class="font-normal text-body">(°C)</span><input class="<%= inputClass %>" name="devol_vent_zone_temp_c" value="<%= stepSettings?.devol_vent_zone_temp_c ?? '' %>" placeholder="Required"></label>
      <label class="text-sm font-medium text-heading">Incoming volatiles / moisture <span class="font-normal text-body">(%)</span><input class="<%= inputClass %>" name="devol_initial_volatiles_pct" value="<%= stepSettings?.devol_initial_volatiles_pct ?? '' %>" placeholder="Measure this batch"><span class="mt-1 block text-xs font-normal text-body">Re-measure for every new biopolymer batch.</span></label>
      <label class="text-sm font-medium text-heading">Residual-volatiles target <span class="font-normal text-body">(%)</span><input class="<%= inputClass %>" name="devol_residual_volatiles_target_pct" value="<%= stepSettings?.devol_residual_volatiles_target_pct ?? '' %>" placeholder="Acceptance target"></label>
      <label class="text-sm font-medium text-heading md:col-span-2">Target vacuum-pressure levels <span class="font-normal text-body">(mbar)</span><input class="<%= inputClass %>" name="devol_vacuum_target_levels_mbar" value="<%= stepSettings?.devol_vacuum_target_levels_mbar ?? '50, 100, 200' %>" placeholder="e.g. 50, 100, 200"></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="button" data-generate-vacuum-program="vacuum_calibration">Generate vacuum-calibration runs</button><p class="text-xs text-body">A point is acceptable only with stable vacuum and no foam, stuffing or unacceptable carryover at the vent.</p></div>
  </fieldset>
  <% } else if (step.step_number === 9) { %>
  <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
    <legend class="px-1 text-sm font-semibold text-heading">1. Reaction recipe and acceptance criteria</legend>
    <p class="mb-4 text-sm text-body">Keep formulation fixed in this iteration. The chemical result is an off-line measurement; a spectrum itself remains in the laboratory record, not in a second editor here.</p>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <label class="text-sm font-medium text-heading">Reagent / initiator<input class="<%= inputClass %>" name="reaction_reagent_name" value="<%= stepSettings?.reaction_reagent_name ?? '' %>" placeholder="e.g. DCP, MAH"></label>
      <label class="text-sm font-medium text-heading">Fixed reagent concentration <span class="font-normal text-body">(wt.%)</span><input class="<%= inputClass %>" name="reaction_reagent_concentration_pct" value="<%= stepSettings?.reaction_reagent_concentration_pct ?? '' %>" placeholder="Fixed for this study"></label>
      <label class="text-sm font-medium text-heading">Reagent delivery route<select class="<%= inputClass %>" name="reaction_dosing_route"><option value="main_feeder" <%= stepSettings?.reaction_dosing_route === 'main_feeder' ? 'selected' : '' %>>Main feeder</option><option value="side_feeder" <%= stepSettings?.reaction_dosing_route === 'side_feeder' ? 'selected' : '' %>>Side feeder</option><option value="liquid_injection" <%= stepSettings?.reaction_dosing_route === 'liquid_injection' ? 'selected' : '' %>>Liquid injection</option></select></label>
      <label class="text-sm font-medium text-heading">Chemical-analysis method<select class="<%= inputClass %>" name="reaction_chemical_analysis_method"><option value="ftir" <%= stepSettings?.reaction_chemical_analysis_method === 'ftir' ? 'selected' : '' %>>FTIR</option><option value="raman" <%= stepSettings?.reaction_chemical_analysis_method === 'raman' ? 'selected' : '' %>>Raman</option><option value="titration" <%= stepSettings?.reaction_chemical_analysis_method === 'titration' ? 'selected' : '' %>>Titration</option><option value="gc" <%= stepSettings?.reaction_chemical_analysis_method === 'gc' ? 'selected' : '' %>>GC</option><option value="validated_manual" <%= stepSettings?.reaction_chemical_analysis_method === 'validated_manual' ? 'selected' : '' %>>Validated manual result</option></select></label>
      <label class="text-sm font-medium text-heading md:col-span-2">Marker or analytical rule<input class="<%= inputClass %>" name="reaction_chemical_marker" value="<%= stepSettings?.reaction_chemical_marker ?? '' %>" placeholder="e.g. C=O 1780 / CH₂ 1456 cm⁻¹"></label>
      <label class="text-sm font-medium text-heading">Chemical-result target α <span class="font-normal text-body">(%)</span><input class="<%= inputClass %>" name="reaction_conversion_target_pct" value="<%= stepSettings?.reaction_conversion_target_pct ?? '' %>" placeholder="Acceptance target"></label>
      <label class="text-sm font-medium text-heading">Reaction thermal limit <span class="font-normal text-body">(°C)</span><input class="<%= inputClass %>" name="reaction_thermal_limit_c" value="<%= stepSettings?.reaction_thermal_limit_c ?? '' %>" placeholder="From Step 1 / material"></label>
      <label class="text-sm font-medium text-heading">Product MFR minimum <span class="font-normal text-body">(g/10 min)</span><input class="<%= inputClass %>" name="reaction_mfr_min_g_10min" value="<%= stepSettings?.reaction_mfr_min_g_10min ?? '' %>" placeholder="Optional"></label>
      <label class="text-sm font-medium text-heading">Product MFR maximum <span class="font-normal text-body">(g/10 min)</span><input class="<%= inputClass %>" name="reaction_mfr_max_g_10min" value="<%= stepSettings?.reaction_mfr_max_g_10min ?? '' %>" placeholder="Optional"></label>
    </div>
    <% const mainRange = reactiveDosingEvidence?.mainFeeder; const liquidRange = reactiveDosingEvidence?.liquidPump; %>
    <div class="mt-4 rounded-base border border-default bg-neutral-primary px-3 py-2 text-xs text-body" data-reactive-dosing-evidence>
      Main-feeder evidence: <strong class="text-heading"><%= mainRange ? `${formatNumber(mainRange.min)}–${formatNumber(mainRange.max)} kg/h` : 'not qualified in Step 2' %></strong> · Liquid-pump evidence: <strong class="text-heading"><%= liquidRange ? `${formatNumber(liquidRange.min)}–${formatNumber(liquidRange.max)} kg/h` : 'not qualified in Step 7' %></strong> · Side-feeder evidence: <strong class="text-heading"><%= reactiveDosingEvidence?.sideFeederQualified ? 'runs exist in Step 6' : 'not qualified in Step 6' %></strong>. Unqualified delivery remains visible as a warning; it does not block exploratory REX.
    </div>
  </fieldset>
  <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
    <legend class="px-1 text-sm font-semibold text-heading">2. REX operating-condition matrix</legend>
    <p class="mb-4 text-sm text-body">Pair N and Q by position: this produces practical REX conditions, not an N × Q factorial expansion. The generator crosses those pairs with the reaction-temperature levels.</p>
    <div class="grid gap-4 md:grid-cols-3">
      <label class="text-sm font-medium text-heading">Reaction-temperature levels <span class="font-normal text-body">(°C)</span><input class="<%= inputClass %>" name="reaction_temp_levels_c" value="<%= stepSettings?.reaction_temp_levels_c ?? '180, 200, 220' %>" placeholder="e.g. 180, 200, 220"></label>
      <label class="text-sm font-medium text-heading">Matching screw speeds <span class="font-normal text-body">(rpm)</span><input class="<%= inputClass %>" name="reaction_screw_speed_levels_rpm" value="<%= stepSettings?.reaction_screw_speed_levels_rpm ?? '' %>" placeholder="e.g. 150, 250, 350"></label>
      <label class="text-sm font-medium text-heading">Matching melt throughputs <span class="font-normal text-body">(kg/h)</span><input class="<%= inputClass %>" name="reaction_throughput_levels_kg_h" value="<%= stepSettings?.reaction_throughput_levels_kg_h ?? '' %>" placeholder="e.g. 20, 30, 40"></label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="button" data-generate-reactive-program>Generate REX runs</button><p class="text-xs text-body">Empty required fields are highlighted. Existing run evidence is retained.</p></div>
  </fieldset>
  <% } else { %>
  <fieldset class="mb-4 max-w-4xl rounded-base border border-default-medium bg-neutral-secondary p-4">
    <legend class="px-1 text-sm font-semibold text-heading"><%= step.step_number === 10 ? 'Verification sweep' : 'Run generation' %></legend>
    <div class="grid gap-4 md:grid-cols-3 md:items-end">
      <% setup.fields.filter((item) => !item.calculator).forEach((item) => { %>
        <label class="text-sm font-medium text-heading"><%= item.label %> <span class="font-normal text-body">(<%= item.unit %>)</span>
          <input class="<%= inputClass %>" name="<%= item.setting %>" data-optional-request="<%= item.request %>" value="<%= stepSettings?.[item.setting] ?? item.fallback %>" placeholder="<%= item.fallback || 'Required' %>">
        </label>
      <% }) %>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4">
      <button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand" type="button" data-generate-optional-matrix>Generate runs</button>
      <p class="text-xs text-body">Existing rows are retained; generation updates the first rows with the selected conditions.</p>
    </div>
    <div class="mt-3 hidden rounded-base border px-3 py-2 text-sm" data-optional-matrix-message role="alert"></div>
  </fieldset>
  <% } %>
  <% if (step.step_number === 6) { %>
    <section class="mb-6 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs" aria-label="Feeder-stability runs">
      <div class="mb-3 flex items-center justify-between gap-3"><div><h3 class="text-sm font-semibold text-heading">1. Feeder-stability runs</h3><p class="mt-1 text-xs text-body">Calibrate actual side-feeder rate and accept only points with CV ≤ 1.5% and no accumulation.</p></div><span class="rounded-full bg-neutral-secondary px-2.5 py-1 text-xs font-medium text-body"><%= feederStabilityRuns.length %> run<%= feederStabilityRuns.length === 1 ? '' : 's' %></span></div>
      <div class="overflow-x-auto"><table class="<%= inputTableClass %> [&_input[type=number]]:min-w-20 [&_input[type=number]]:w-20" data-run-table><thead><tr><th>Run</th><th>Date</th><th>Owner</th><% feederStabilityFields.forEach((field) => { const tooltipId = `sideFeederFieldTip-${field.id}`; %><th class="whitespace-nowrap"><span class="cursor-help hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand" tabindex="0" data-tooltip-target="<%= tooltipId %>" aria-label="<%= tableFieldTooltip(field) %>"><%= tableFieldLabel(field) %><% if (field.unit) { %> <span class="normal-case text-body">(<%= field.unit %>)</span><% } %></span><div id="<%= tooltipId %>" role="tooltip" class="tooltip invisible absolute z-10 inline-block max-w-56 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity"><%= tableFieldTooltip(field) %><div class="tooltip-arrow" data-popper-arrow></div></div></th><% }); %><th>Done</th><th>Exclude</th><th></th></tr></thead><tbody>
        <% if (!feederStabilityRuns.length) { %><tr><td class="py-8 text-center text-sm text-body" colspan="<%= feederStabilityFields.length + 6 %>">Set the feeder conditions, then generate the stability runs.</td></tr><% } %>
        <% feederStabilityRuns.forEach((run) => { %><tr data-run-row data-run-id="<%= run.id %>" data-run-group="<%= run.run_group %>"><td class="whitespace-nowrap font-medium text-heading"><%= run.run_code %></td><td><input class="min-w-32 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="date" data-run-performed value="<%= run.performed_at || '' %>"></td><td><select class="min-w-36 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" data-run-responsible><option value="">Unassigned</option><% assignableUsers.forEach((user) => { %><option value="<%= user.id %>" <%= Number(run.responsible_user_id) === Number(user.id) ? 'selected' : '' %>><%= user.name || user.email %></option><% }); %></select></td><% feederStabilityFields.forEach((field) => { const value = valuesFor(run, field); %><td><% if (field.is_derived) { %><span class="whitespace-nowrap text-sm text-body" data-derived-code="<%= field.code %>"><%= formatNumber(value?.value_real) %></span><% } else if (field.field_type === 'boolean') { %><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-field-id="<%= field.id %>" data-field-type="boolean" <%= value?.value_real === 1 ? 'checked' : '' %>><% } else { %><input class="min-w-24 rounded-base border border-default-medium bg-neutral-secondary-medium px-3 py-2 text-sm text-heading shadow-xs focus:border-brand focus:ring-brand" type="<%= field.field_type === 'number' ? 'number' : 'text' %>" step="any" data-field-id="<%= field.id %>" data-field-type="<%= field.field_type %>" value="<%= field.field_type === 'number' ? (value?.value_real ?? '') : (value?.value_text ?? '') %>"><% } %></td><% }); %><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="done" <%= run.done === 1 ? 'checked' : '' %>></td><td><input class="size-4 rounded border-default-medium text-brand focus:ring-brand" type="checkbox" data-flag="exclude" <%= run.exclude_from_analysis === 1 ? 'checked' : '' %>></td><td><button class="inline-flex size-8 items-center justify-center rounded-base text-danger hover:bg-danger-soft" type="button" data-run-delete title="Delete run"><span class="material-symbols-rounded text-[18px]" aria-hidden="true">delete</span></button></td></tr><% }); %>
      </tbody></table></div>
      <article class="mt-5 rounded-base border border-default bg-neutral-primary p-4">
        <div class="border-b border-default pb-3"><h4 class="text-sm font-semibold text-heading">Feeder stability</h4><p class="mt-1 text-xs text-body">Measured filler rate versus side-feeder speed. Green points meet CV ≤ 1.5% and the 10-minute clear-path criterion.</p></div>
        <div class="mt-4 h-72 w-full" id="sideFeederStabilityChart"></div>
      </article>
    </section>
    <fieldset class="mb-4 rounded-xl border border-default-medium bg-neutral-secondary p-5 shadow-xs">
      <legend class="px-1 text-sm font-semibold text-heading">2. Material-incorporation scenario</legend>
      <div class="grid gap-4 lg:grid-cols-2">
        <div>
          <label class="text-sm font-medium text-heading">Material introduced through the side feeder<select class="<%= inputClass %>" name="side_feeding_material_mode" data-side-feeding-mode><option value="particulate" <%= sideFeedingMode === 'particulate' ? 'selected' : '' %>>Powder / mineral filler</option><option value="fiber" <%= sideFeedingMode === 'fiber' ? 'selected' : '' %>>Chopped fibre</option></select></label>
          <p class="mt-2 text-xs text-body">The choice preserves prior data but changes the material-specific fields and charts after save.</p>
        </div>
        <% if (sideFeedingMode === 'particulate') { %>
          <div class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium text-heading">Filler density <span class="font-normal text-body">(kg/m³)</span><input class="<%= inputClass %>" name="side_feeding_filler_density_kg_m3" value="<%= stepSettings?.side_feeding_filler_density_kg_m3 ?? '' %>"></label><label class="text-sm font-medium text-heading">Matrix density <span class="font-normal text-body">(kg/m³)</span><input class="<%= inputClass %>" name="side_feeding_matrix_density_kg_m3" value="<%= stepSettings?.side_feeding_matrix_density_kg_m3 ?? '' %>"></label><label class="text-sm font-medium text-heading">Maximum packing φm <span class="font-normal text-body">(0–1)</span><input class="<%= inputClass %>" name="side_feeding_max_packing_fraction" value="<%= stepSettings?.side_feeding_max_packing_fraction ?? 0.64 %>"></label></div>
          <div class="mt-4 grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium text-heading">Filler-throughput levels <span class="font-normal text-body">(kg/h)</span><input class="<%= inputClass %>" name="side_feeding_filler_throughput_levels_kg_h" data-optional-request="filler_throughput_levels_kg_h" value="<%= stepSettings?.side_feeding_filler_throughput_levels_kg_h ?? '' %>" placeholder="e.g. 5, 8, 12"></label><label class="text-sm font-medium text-heading">Matching side-feeder speeds <span class="font-normal text-body">(rpm)</span><input class="<%= inputClass %>" name="side_feeding_incorporation_speed_levels_rpm" data-optional-request="incorporation_side_feeder_speed_levels_rpm" value="<%= stepSettings?.side_feeding_incorporation_speed_levels_rpm ?? '' %>" placeholder="e.g. 18, 27, 36"></label></div>
        <% } else { %>
          <div class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium text-heading">Reference initial fibre length L0 <span class="font-normal text-body">(mm)</span><input class="<%= inputClass %>" name="side_feeding_fiber_initial_length_mm" data-optional-request="fiber_initial_length_mm" value="<%= stepSettings?.side_feeding_fiber_initial_length_mm ?? '' %>" placeholder="Required"></label><label class="text-sm font-medium text-heading">Fibre-throughput levels <span class="font-normal text-body">(kg/h)</span><input class="<%= inputClass %>" name="side_feeding_filler_throughput_levels_kg_h" data-optional-request="filler_throughput_levels_kg_h" value="<%= stepSettings?.side_feeding_filler_throughput_levels_kg_h ?? '' %>" placeholder="e.g. 3, 5, 7"></label><label class="text-sm font-medium text-heading">Matching side-feeder speeds <span class="font-normal text-body">(rpm)</span><input class="<%= inputClass %>" name="side_feeding_incorporation_speed_levels_rpm" data-optional-request="incorporation_side_feeder_speed_levels_rpm" value="<%= stepSettings?.side_feeding_incorporation_speed_levels_rpm ?? '' %>" placeholder="e.g. 18, 27, 36"></label></div>
          <p class="mt-3 text-sm text-body">The generator copies L0 into each run. Measure final length Ln and SME in the run table; retention is calculated from Ln/L0.</p>
        <% } %>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-default pt-4"><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong" type="button" data-generate-side-feeding-program="material_incorporation">Generate <%= sideFeedingMode === 'fiber' ? 'fibre-retention' : 'filler-incorporation' %> runs</button><p class="text-xs text-body">Uses the fixed main-extruder condition and paired feeder settings above.</p></div>
    </fieldset>
