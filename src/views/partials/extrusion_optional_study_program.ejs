        <label class="text-sm font-medium text-heading">Injection-zone temperature <span class="font-normal text-body">(°C)</span><input class="<%= inputClass %>" name="liquid_injection_zone_temp_c" value="<%= stepSettings?.liquid_injection_zone_temp_c ?? '' %>" placeholder="Required"></label>
