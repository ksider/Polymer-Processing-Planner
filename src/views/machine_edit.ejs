<%- include('partials/head', { title: `Polymer Processing Planner | ${machine ? 'Edit machine' : 'Add machine'}`, uiKit: true }) %>
<% const machineParamMap = machineParamByCode || {}; const imageFiles = myImageFiles || []; const tokenFor = (code) => { const param = machineParamMap[code]; return machine?.id && param?.id ? `%${machine.id}:${param.id}%` : ''; }; const keyFields = [['clamp_force_kN','Clamp force (kN)'],['clamp_force_t','Clamp force (t)'],['intensification_ratio','Intensification ratio'],['injection_pressure_bar','Injection pressure (bar)'],['screw_diameter_mm','Screw diameter (mm)']]; const specFields = [['tie_bar_distance_mm','Tie bar distance (mm)'],['platen_size_mm','Platen size (mm)'],['opening_stroke_mm','Opening stroke (mm)'],['min_mold_height_mm','Min mold height (mm)'],['max_mold_height_mm','Max mold height (mm)'],['injection_volume_cm3','Injection volume (cm3)'],['injection_weight_g','Injection weight (g)'],['screw_speed_rpm','Screw speed (rpm)'],['plasticizing_rate_g_s','Plasticizing rate (g/s)']]; %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased"><div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row"><%- include('partials/admin_sidebar') %><main class="min-w-0 flex-1">
  <header class="border-b border-gray-200 bg-white"><div class="flex items-center gap-4 px-4 py-4 sm:px-6 lg:px-8"><a class="inline-flex size-9 items-center justify-center rounded-lg text-gray-500 no-underline hover:bg-gray-100" href="/machines" aria-label="Back to equipment"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span></a><div><p class="text-sm font-medium text-blue-700">Equipment</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900"><%= machine ? 'Edit machine' : 'Add machine' %></h1></div></div></header>
  <form class="space-y-6 px-4 py-6 sm:px-6 lg:px-8" action="<%= machine ? `/machines/${machine.id}` : '/machines' %>" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input id="selectedMachineFileId" type="hidden" name="selected_file_id" value="">
    <section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900">Identity</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><% [['name','Name',true],['vendor','Vendor',false],['model','Model',false]].forEach(([key,label,required]) => { %><div><label class="mb-2 block text-sm font-medium text-gray-900" for="machine-<%= key %>"><%= label %></label><input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" id="machine-<%= key %>" type="text" name="<%= key %>" <%= required ? 'required' : '' %> value="<%= machine?.[key] ?? '' %>"></div><% }); %></div>
      <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 p-4"><div class="flex flex-wrap items-start justify-between gap-4"><div><h3 class="text-sm font-semibold text-gray-900">Equipment photo</h3><p class="mt-1 text-sm text-gray-500">Choose an image from your files or upload a new one. The selected image replaces the current cover.</p></div><% if (machine?.image_url) { %><img id="machinePhotoPreview" class="size-20 rounded-lg border border-gray-200 bg-white object-cover" src="<%= machine.image_url %>" alt="Current equipment photo"><% } else { %><div id="machinePhotoPreviewPlaceholder" class="flex size-20 items-center justify-center rounded-lg border border-dashed border-gray-300 bg-white text-gray-400"><span class="material-symbols-rounded" aria-hidden="true">image</span></div><img id="machinePhotoPreview" class="hidden size-20 rounded-lg border border-gray-200 bg-white object-cover" alt="Selected equipment photo"><% } %></div>
        <div class="mt-4 grid gap-4 md:grid-cols-2"><div><p class="mb-2 block text-sm font-medium text-gray-900">Previously uploaded images</p><button class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-100" type="button" data-modal-target="machineImagePicker" data-modal-toggle="machineImagePicker"><span class="material-symbols-rounded text-[19px]" aria-hidden="true">photo_library</span>Choose from my files</button></div><div><label class="mb-2 block text-sm font-medium text-gray-900" for="machineImageUpload">Upload new image</label><input class="block w-full cursor-pointer rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-900 focus:outline-none" type="file" name="machine_image" id="machineImageUpload" accept="image/png,image/jpeg,image/gif,image/webp"><p class="mt-2 text-sm text-gray-500">PNG, JPEG, GIF or WebP.</p></div></div>
      </div>
    </section>
    <div id="machineImagePicker" tabindex="-1" aria-hidden="true" class="hidden fixed inset-0 z-50 h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden p-4 md:inset-0"><div class="relative max-h-full w-full max-w-2xl"><div class="relative rounded-xl bg-white shadow"><div class="flex items-center justify-between rounded-t border-b border-gray-200 px-5 py-4"><div><h2 class="text-lg font-semibold text-gray-900">Choose an uploaded image</h2><p class="mt-1 text-sm text-gray-500">Only files you uploaded are available.</p></div><button class="inline-flex size-8 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-900" type="button" data-modal-hide="machineImagePicker" aria-label="Close"><span class="material-symbols-rounded" aria-hidden="true">close</span></button></div><div class="max-h-[60vh] overflow-y-auto p-5"><% if (!imageFiles.length) { %><p class="text-sm text-gray-500">No uploaded images yet. Use the file input to add one.</p><% } else { %><div class="grid gap-3 sm:grid-cols-2"><% imageFiles.forEach((file) => { %><button class="group overflow-hidden rounded-lg border border-gray-200 bg-white text-left hover:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100" type="button" data-machine-file-id="<%= file.id %>" data-machine-file-url="/files/<%= file.id %>/download"><img class="h-32 w-full bg-gray-100 object-cover" src="/files/<%= file.id %>/download" alt=""><span class="block truncate px-3 py-2 text-sm font-medium text-gray-700 group-hover:text-blue-700"><%= file.original_name %></span></button><% }) %></div><% } %></div></div></div></div>
    <% [['Key parameters', keyFields], ['Additional specifications', specFields]].forEach(([title, fields]) => { %><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900"><%= title %></h2><div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3"><% fields.forEach(([key,label]) => { %><div><label class="mb-2 block text-sm font-medium text-gray-900" for="machine-<%= key %>"><%= label %></label><input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" id="machine-<%= key %>" type="text" name="<%= key %>" value="<%= settings[key] ?? '' %>"><p class="mt-2 rounded bg-gray-100 px-2 py-1 font-mono text-xs text-gray-500"><%= tokenFor(key) || 'Save to generate token' %></p></div><% }); %></div></section><% }); %>
    <section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900">Notes / scheme</h2><textarea class="mt-5 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="notes" rows="6"><%= machine?.notes ?? '' %></textarea></section>
    <section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between gap-4"><div><h2 class="text-lg font-semibold text-gray-900">Custom fields</h2><p class="mt-1 text-sm text-gray-500">Additional machine-specific values. Saving creates usable machine tokens.</p></div><button class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100" type="button" id="addMachineCustomField"><span class="material-symbols-rounded me-2 text-[18px]" aria-hidden="true">add</span>Add field</button></div><div class="mt-5 space-y-3" id="machineCustomFields" data-show-machine-code="1" data-machine-id="<%= machine?.id ?? '' %>"></div><input type="hidden" id="machineCustomFieldsJson" name="custom_fields_json" value=""></section>
    <div class="flex justify-end gap-3"><a class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-900 no-underline hover:bg-gray-100" href="/machines">Cancel</a><button class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" type="submit"><%= machine ? 'Save machine' : 'Create machine' %></button></div>
  </form>
</main></div></div>
<%- include('partials/foot', { uiKit: true }) %>
<script nonce="<%= cspNonce %>">
window.addEventListener('DOMContentLoaded', () => {
  const listEl = document.getElementById('machineCustomFields'); const addBtn = document.getElementById('addMachineCustomField'); const hiddenInput = document.getElementById('machineCustomFieldsJson'); const initialFields = <%- jsonForScript(machineParams || []) %>;
  const updateHidden = () => { if (!hiddenInput || !listEl) return; hiddenInput.value = JSON.stringify(Array.from(listEl.querySelectorAll('[data-custom-field]')).map((row) => ({ id: row.dataset.fieldId || '', code: row.querySelector('[data-custom-code]')?.value || '', label: row.querySelector('[data-custom-label]')?.value || '', unit: row.querySelector('[data-custom-unit]')?.value || '', value: row.querySelector('[data-custom-value]')?.value ?? '' })).filter((item) => item.label)); };
  const manager = window.IMPlanner?.createCustomFieldManager({ listEl, onChange: updateHidden, ui: 'flowbite', rowClass: 'grid gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.5fr)_minmax(12rem,0.8fr)_auto]' });
  if (manager) { initialFields.forEach((field) => manager.addRow(field)); updateHidden(); addBtn?.addEventListener('click', () => manager.addRow({})); }
  const picker = document.getElementById('machineImagePicker'); const selectedFile = document.getElementById('selectedMachineFileId'); const uploadInput = document.getElementById('machineImageUpload'); const preview = document.getElementById('machinePhotoPreview'); const placeholder = document.getElementById('machinePhotoPreviewPlaceholder');
  picker?.querySelectorAll('[data-machine-file-id]').forEach((button) => button.addEventListener('click', () => { selectedFile.value = button.dataset.machineFileId || ''; uploadInput.value = ''; preview.src = button.dataset.machineFileUrl || ''; preview.classList.remove('hidden'); placeholder?.classList.add('hidden'); picker.querySelector('[data-modal-hide="machineImagePicker"]')?.click(); }));
  uploadInput?.addEventListener('change', () => { const file = uploadInput.files?.[0]; if (!file) return; selectedFile.value = ''; preview.src = URL.createObjectURL(file); preview.classList.remove('hidden'); placeholder?.classList.add('hidden'); });
});
</script>
