<%- include('partials/head', { title: `Polymer Processing Planner | ${machine ? 'Edit machine' : 'Add machine'}`, uiKit: true }) %>
<% const machineParamMap = machineParamByCode || {}; const tokenFor = (code) => { const param = machineParamMap[code]; return machine?.id && param?.id ? `%${machine.id}:${param.id}%` : ''; }; const keyFields = [['clamp_force_kN','Clamp force (kN)'],['clamp_force_t','Clamp force (t)'],['intensification_ratio','Intensification ratio'],['injection_pressure_bar','Injection pressure (bar)'],['screw_diameter_mm','Screw diameter (mm)']]; const specFields = [['tie_bar_distance_mm','Tie bar distance (mm)'],['platen_size_mm','Platen size (mm)'],['opening_stroke_mm','Opening stroke (mm)'],['min_mold_height_mm','Min mold height (mm)'],['max_mold_height_mm','Max mold height (mm)'],['injection_volume_cm3','Injection volume (cm3)'],['injection_weight_g','Injection weight (g)'],['screw_speed_rpm','Screw speed (rpm)'],['plasticizing_rate_g_s','Plasticizing rate (g/s)']]; %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased"><div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row"><%- include('partials/admin_sidebar') %><main class="min-w-0 flex-1"><header class="border-b border-gray-200 bg-white"><div class="flex items-center gap-4 px-4 py-4 sm:px-6 lg:px-8"><a class="inline-flex size-9 items-center justify-center rounded-lg text-gray-500 no-underline hover:bg-gray-100" href="/machines" aria-label="Back to equipment"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span></a><div><p class="text-sm font-medium text-blue-700">Equipment</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900"><%= machine ? 'Edit machine' : 'Add machine' %></h1></div></div></header><form class="space-y-6 px-4 py-6 sm:px-6 lg:px-8" action="<%= machine ? `/machines/${machine.id}` : '/machines' %>" method="post"><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900">Identity</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><% [['name','Name',true],['image_url','Image URL',false],['vendor','Vendor',false],['model','Model',false]].forEach(([key,label,required]) => { %><div><label class="mb-2 block text-sm font-medium text-gray-900"><%= label %></label><input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="text" name="<%= key %>" <%= required ? 'required' : '' %> value="<%= machine?.[key] ?? '' %>"></div><% }); %></div></section>
<% [['Key parameters', keyFields], ['Additional specifications', specFields]].forEach(([title, fields]) => { %><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900"><%= title %></h2><div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3"><% fields.forEach(([key,label]) => { %><div><label class="mb-2 block text-sm font-medium text-gray-900"><%= label %></label><input class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="text" name="<%= key %>" value="<%= settings[key] ?? '' %>"><p class="mt-2 rounded bg-gray-100 px-2 py-1 font-mono text-xs text-gray-500"><%= tokenFor(key) || 'Save to generate token' %></p></div><% }); %></div></section><% }); %>
<section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-semibold text-gray-900">Notes / scheme</h2><textarea class="mt-5 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="notes" rows="6"><%= machine?.notes ?? '' %></textarea></section>
<section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between gap-4"><div><h2 class="text-lg font-semibold text-gray-900">Custom fields</h2><p class="mt-1 text-sm text-gray-500">Additional machine-specific values. Saving creates usable machine tokens.</p></div><button class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100" type="button" id="addMachineCustomField"><span class="material-symbols-rounded me-2 text-[18px]" aria-hidden="true">add</span>Add field</button></div><div class="mt-5 space-y-3" id="machineCustomFields" data-show-machine-code="1" data-machine-id="<%= machine?.id ?? '' %>"></div><input type="hidden" id="machineCustomFieldsJson" name="custom_fields_json" value=""></section><div class="flex justify-end gap-3"><a class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-900 no-underline hover:bg-gray-100" href="/machines">Cancel</a><button class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" type="submit"><%= machine ? 'Save machine' : 'Create machine' %></button></div></form></main></div></div>
<%- include('partials/foot', { uiKit: true }) %>
<script nonce="<%= cspNonce %>">
  window.addEventListener('DOMContentLoaded', () => {
    const listEl = document.getElementById('machineCustomFields');
    const addBtn = document.getElementById('addMachineCustomField');
    const hiddenInput = document.getElementById('machineCustomFieldsJson');
    const initialFields = <%- jsonForScript(machineParams || []) %>;
    const updateHidden = () => {
      if (!hiddenInput || !listEl) return;
      hiddenInput.value = JSON.stringify(Array.from(listEl.querySelectorAll('[data-custom-field]'))
        .map((row) => ({
          id: row.dataset.fieldId || '',
          code: row.querySelector('[data-custom-code]')?.value || '',
          label: row.querySelector('[data-custom-label]')?.value || '',
          unit: row.querySelector('[data-custom-unit]')?.value || '',
          value: row.querySelector('[data-custom-value]')?.value ?? ''
        }))
        .filter((item) => item.label));
    };
    const manager = window.IMPlanner?.createCustomFieldManager({
      listEl,
      onChange: updateHidden,
      ui: 'flowbite',
      rowClass: 'grid gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.5fr)_minmax(12rem,0.8fr)_auto]'
    });
    if (!manager) return;
    initialFields.forEach((field) => manager.addRow(field));
    updateHidden();
    addBtn?.addEventListener('click', () => manager.addRow({}));
  });
</script>
