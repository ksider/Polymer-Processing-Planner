<%- include('partials/head', { title: 'Polymer Processing Planner | Dashboard', uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<% const formatDashboardDate = (value) => { const parsed = new Date(`${String(value).slice(0, 10)}T00:00:00`); return Number.isNaN(parsed.getTime()) ? String(value) : parsed.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); }; const isPortfolioRole = dashboard.role === 'manager' || dashboard.role === 'admin'; const experimentSectionTitle = isPortfolioRole ? 'Portfolio overview' : dashboard.role === 'viewer' ? 'Accessible experiments' : dashboard.role === 'operator' ? 'Assigned experiments' : 'Continue working'; const upcomingTitle = dashboard.role === 'operator' ? "Today's & upcoming runs" : 'Upcoming'; const upcomingDescription = dashboard.role === 'operator' ? 'Assigned runs and task deadlines for the next seven days.' : 'Your next seven days.'; const metricStyles = [{ card: 'border-blue-200 bg-blue-50', icon: 'bg-blue-100 text-blue-700', iconName: 'science', value: 'text-blue-900' }, { card: 'border-indigo-200 bg-indigo-50', icon: 'bg-indigo-100 text-indigo-700', iconName: 'task_alt', value: 'text-indigo-900' }, { card: 'border-red-200 bg-red-50', icon: 'bg-red-100 text-red-700', iconName: 'priority_high', value: 'text-red-800' }, { card: 'border-amber-200 bg-amber-50', icon: 'bg-amber-100 text-amber-700', iconName: 'verified', value: 'text-amber-800' }]; %>
<main class="min-h-[calc(100vh-4rem)] bg-gray-50">
  <div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5">
    <section class="mb-5 flex flex-col gap-4 rounded-lg bg-gradient-to-r from-blue-800 to-blue-600 p-5 shadow-sm sm:flex-row sm:items-start sm:justify-between">
      <div><div class="flex flex-wrap items-center gap-2"><span class="inline-flex size-9 items-center justify-center rounded-lg bg-white/15 text-white"><span class="material-symbols-rounded" aria-hidden="true">dashboard</span></span><h1 class="text-xl font-semibold tracking-tight text-white">R&amp;D dashboard</h1><span class="rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium text-blue-50"><%= dashboard.scopeLabel %></span></div><p class="mt-2 text-sm text-blue-100">Prioritized operational work across experiments, qualification, DOE, and reporting.</p></div>
      <div class="flex flex-wrap items-center gap-2"><form method="get" action="/" class="flex items-center gap-2"><label class="sr-only" for="dashboardProcess">Filter by process</label><select class="block rounded-lg border border-white/30 bg-white/10 py-2 ps-3 pe-8 text-sm text-white focus:border-white focus:ring-white/30" id="dashboardProcess" name="process_id" onchange="this.form.submit()"><option class="text-gray-900" value="">All processes</option><% dashboard.processOptions.forEach((process) => { %><option class="text-gray-900" value="<%= process.id %>" <%= dashboard.selectedProcessId === process.id ? 'selected' : '' %>><%- formatInline(process.name) %></option><% }) %></select></form><a class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-3 py-2 text-sm font-medium text-white no-underline hover:bg-white/20" href="/processes"><span class="material-symbols-rounded me-1 text-[18px]" aria-hidden="true">account_tree</span>Processes</a><% if (dashboard.canCreateExperiment && !dashboard.isReadOnly) { %><a class="inline-flex items-center justify-center rounded-lg bg-white px-3 py-2 text-sm font-medium text-blue-700 no-underline hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-white/30" href="/experiments/new"><span class="material-symbols-rounded me-1 text-[18px]" aria-hidden="true">add</span>Create experiment</a><% } %></div>
    </section>
    <section class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Summary"><% dashboard.metrics.forEach((metric, index) => { const style = metricStyles[index]; %><div class="rounded-lg border p-4 shadow-sm <%= style.card %>"><div class="flex items-start justify-between gap-3"><p class="text-sm font-medium text-gray-700"><%= metric.label %></p><span class="inline-flex size-9 items-center justify-center rounded-lg <%= style.icon %>"><span class="material-symbols-rounded text-[20px]" aria-hidden="true"><%= style.iconName %></span></span></div><p class="mt-3 text-2xl font-semibold <%= style.value %>"><%= metric.value %></p></div><% }) %></section>
    <div class="grid gap-5 xl:grid-cols-3">
      <div class="space-y-5 xl:col-span-2"><%- include('partials/dashboard/action_inbox', { actions: dashboard.actions, formatDashboardDate }) %>
        <section class="overflow-hidden rounded-lg border border-blue-100 bg-white shadow-sm" aria-labelledby="experimentsTitle"><div class="flex items-center justify-between border-b border-blue-100 bg-blue-50 px-5 py-4"><div><h2 class="text-base font-semibold text-blue-950" id="experimentsTitle"><%= experimentSectionTitle %></h2><p class="mt-1 text-sm text-blue-800">Owned, assigned, or otherwise accessible active experiments.</p></div><a class="text-sm font-medium text-blue-700 no-underline hover:underline" href="/my-experiments">View all</a></div><% if (!dashboard.continueWorking.length) { %><p class="px-5 py-8 text-center text-sm text-gray-500">No active experiments are available in this scope.</p><% } else { %><div class="divide-y divide-gray-100"><% dashboard.continueWorking.forEach((experiment) => { %><a class="flex items-center justify-between gap-4 px-5 py-4 no-underline hover:bg-blue-50/40" href="<%= experimentPath(experiment) %>"><div class="min-w-0"><p class="truncate font-medium text-gray-900"><%- formatInline(experiment.name) %></p><p class="mt-1 truncate text-sm text-gray-500"><%- formatInline(experiment.process_name || 'No process') %> · Owner: <%- formatInline(experiment.owner_name || experiment.owner_email || 'Unassigned') %></p></div><span class="material-symbols-rounded text-blue-400" aria-hidden="true">chevron_right</span></a><% }) %></div><% } %></section>
        <%- include('partials/dashboard/qualification_summary', { qualifications: dashboard.qualifications }) %>
      </div>
      <aside class="space-y-5"><%- include('partials/dashboard/upcoming', { upcoming: dashboard.upcoming, formatDashboardDate, title: upcomingTitle, description: upcomingDescription }) %>
        <section class="overflow-hidden rounded-lg border border-amber-200 bg-white shadow-sm" aria-labelledby="reportsTitle"><div class="border-b border-amber-200 bg-amber-50 px-5 py-4"><h2 class="text-base font-semibold text-amber-950" id="reportsTitle">Reports requiring attention</h2></div><% if (!dashboard.reports.length) { %><p class="px-5 py-7 text-center text-sm text-gray-500">No pending reports in this scope.</p><% } else { %><ul class="divide-y divide-gray-100" role="list"><% dashboard.reports.forEach((report) => { %><li><a class="block px-5 py-3 no-underline hover:bg-amber-50/40" href="<%= report.href %>"><p class="truncate text-sm font-medium text-gray-900"><%- formatInline(report.name) %></p><p class="mt-1 text-xs text-gray-500"><%- formatInline(report.experimentName) %><% if (report.signatureDueAt || report.dueAt) { %> · due <%= formatDashboardDate(report.signatureDueAt || report.dueAt) %><% } %></p></a></li><% }) %></ul><% } %></section>
        <% if (dashboard.workload.length && dashboard.showWorkload) { %><section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" aria-labelledby="workloadTitle"><div class="border-b border-gray-200 px-5 py-4"><h2 class="text-base font-semibold text-gray-900" id="workloadTitle">Team workload</h2><p class="mt-1 text-sm text-gray-500">Assigned open tasks, not labor capacity.</p></div><ul class="divide-y divide-gray-100" role="list"><% dashboard.workload.forEach((entry) => { %><li class="flex items-center justify-between gap-3 px-5 py-3 text-sm"><span class="truncate text-gray-700"><%- formatInline(entry.userLabel) %></span><span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700"><%= entry.openTasks %></span></li><% }) %></ul></section><% } %>
        <% if (dashboard.adminHealth) { %><section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" aria-labelledby="systemTitle"><div class="border-b border-gray-200 px-5 py-4"><div class="flex items-center justify-between gap-3"><h2 class="text-base font-semibold text-gray-900" id="systemTitle">System status</h2><a class="text-sm font-medium text-blue-700 no-underline hover:underline" href="/system-health">Details</a></div></div><div class="space-y-2 px-5 py-4 text-sm text-gray-600"><p>Database: <span class="font-medium text-gray-900"><%= dashboard.adminHealth.database.status %></span></p><p>Background jobs: <span class="font-medium text-gray-900"><%= dashboard.adminHealth.jobs.failed %> failed · <%= dashboard.adminHealth.jobs.running %> running</span></p><p>Email configured: <span class="font-medium text-gray-900"><%= dashboard.adminHealth.smtp.configured ? 'yes' : 'no' %></span></p></div></section><% } %>
      </aside>
    </div>
    <% if (dashboard.recentActivity.length) { %><section class="mt-5 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" aria-labelledby="activityTitle"><div class="border-b border-gray-200 px-5 py-4"><h2 class="text-base font-semibold text-gray-900" id="activityTitle">Recent activity</h2></div><ul class="divide-y divide-gray-100" role="list"><% dashboard.recentActivity.forEach((item) => { %><li><a class="flex items-center justify-between gap-4 px-5 py-3 no-underline hover:bg-gray-50" href="<%= item.href %>"><span class="min-w-0 truncate text-sm text-gray-700"><span class="font-medium text-gray-900"><%= item.label %></span> · <%- formatInline(item.detail) %></span><time class="shrink-0 text-xs text-gray-500" datetime="<%= item.at %>"><%= formatDashboardDate(item.at) %></time></a></li><% }) %></ul></section><% } %>
  </div>
</main>
<%- include('partials/foot', { uiKit: true }) %>
