<%- include('partials/head', { title: `Run ${run.run_code}`, uiKit: true }) %>
<%- include('partials/experiment_workspace_nav') %>
<% const tableClass = 'min-w-full border-separate border-spacing-y-2 text-left text-sm text-body [&_thead_th]:whitespace-nowrap [&_thead_th]:px-3 [&_thead_th]:py-2 [&_thead_th]:text-xs [&_thead_th]:font-medium [&_thead_th]:uppercase [&_thead_th]:text-body [&_tbody_td]:border-y [&_tbody_td]:border-default-medium [&_tbody_td]:bg-neutral-primary [&_tbody_td]:px-3 [&_tbody_td]:py-2 [&_tbody_td:first-child]:rounded-s-base [&_tbody_td:first-child]:border-s [&_tbody_td:last-child]:rounded-e-base [&_tbody_td:last-child]:border-e' %>
<div class="flex min-h-[calc(100vh-4rem)] w-full overflow-x-clip bg-gray-50">
  <%- include('partials/experiment_workspace_sidebar', { workspace }) %>
  <main class="min-w-0 flex-1"><div class="w-full max-w-none px-3 py-3 sm:px-4 lg:px-5">
    <section class="mb-4 rounded-xl border border-default-medium bg-neutral-primary px-4 py-3 shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a class="inline-flex size-9 items-center justify-center rounded-base text-body no-underline hover:bg-neutral-secondary hover:text-heading" href="<%= `${experimentPath(experiment)}/doe/${run.doe_id}?tab=runs` %>" aria-label="Back to DOE runs"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span></a>
        <div class="min-w-0 flex-1"><h1 class="truncate text-base font-semibold tracking-tight text-heading">Run <%= run.run_code %></h1><p class="mt-0.5 text-xs text-body"><%- formatInline(experiment.name) %><% if (recipe) { %> · <%- formatInline(recipe.name) %><% } %></p></div>
        <div class="flex items-center gap-2">
          <% if (prevId) { %><a class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body no-underline shadow-xs hover:bg-neutral-tertiary hover:text-heading" href="/experiments/<%= experiment.id %>/runs/<%= prevId %>" aria-label="Previous run"><span class="material-symbols-rounded" aria-hidden="true">chevron_left</span></a><% } %>
          <% if (nextId) { %><a class="inline-flex size-9 items-center justify-center rounded-base border border-default-medium bg-neutral-secondary text-body no-underline shadow-xs hover:bg-neutral-tertiary hover:text-heading" href="/experiments/<%= experiment.id %>/runs/<%= nextId %>" aria-label="Next run"><span class="material-symbols-rounded" aria-hidden="true">chevron_right</span></a><% } %>
          <a class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="/experiments/<%= experiment.id %>/doe/<%= run.doe_id %>?tab=runs">All runs</a>
        </div>
      </div>
    </section>

    <% if (recipe) { %><section class="mb-4 overflow-hidden rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs"><h2 class="text-sm font-semibold text-heading">Recipe · <%- formatInline(recipe.name) %></h2><div class="mt-3 overflow-x-auto"><table class="<%= tableClass %>"><thead><tr><th>Component</th><th>PHR</th></tr></thead><tbody><% components.forEach((component) => { %><tr><td><%- formatInline(component.component_name) %></td><td><%= component.phr %></td></tr><% }); %></tbody></table></div></section><% } %>

    <%- include('partials/entity_notes', { experimentId: experiment.id, entityType: 'run', entityId: run.id, title: 'Run Notes', canWrite: currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer') }) %>

    <form class="grid gap-4" action="/experiments/<%= experiment.id %>/runs/<%= run.id %>" method="post">
      <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs"><h2 class="text-sm font-semibold text-heading">Inputs</h2><div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3"><% inputParams.forEach((param) => { const value = valueMap.get(param.id); %><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><div class="text-xs text-body"><%- formatInline(param.label) %><% if (param.unit) { %> · <%- formatInline(param.unit) %><% } %></div><div class="mt-1 text-sm font-medium text-heading"><%= param.field_type === 'text' ? (value?.value_text ?? '-') : formatNumber(value?.value_real) %></div></div><% }); %></div></section>

      <section class="rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs">
        <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-sm font-semibold text-heading">Measured responses</h2><p class="mt-0.5 text-xs text-body">Enter measurements for this run.</p></div><a class="inline-flex items-center justify-center rounded-base border border-default-medium bg-neutral-secondary px-3 py-2 text-sm font-medium text-heading no-underline shadow-xs hover:bg-neutral-tertiary" href="/experiments/<%= experiment.id %>/doe/<%= run.doe_id %>?tab=design&amp;manage_fields=1">Configure fields</a></div>
        <% if (analysisGroups.length === 0) { %><p class="mt-3 text-sm text-body">No active measured responses. Configure them in DOE Design.</p><% } %>
        <% analysisGroups.forEach((group) => { %><div class="mt-4 border-t border-default pt-4"><h3 class="text-xs font-medium uppercase tracking-wide text-body"><%- formatInline(group.group) %></h3><div class="mt-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><% group.fields.forEach((field) => { const valueRow = analysisValueMap.get(field.id); %><div class="rounded-base border border-default-medium bg-neutral-secondary p-3"><label><%- formatInline(field.label) %><% if (field.unit) { %> · <span class="text-body"><%- formatInline(field.unit) %></span><% } %></label><% if (field.field_type === 'tag') { %><% let selected = []; if (valueRow?.value_tags_json) { try { const parsed = JSON.parse(valueRow.value_tags_json); if (Array.isArray(parsed)) selected = parsed.map(String); } catch {} } %><input type="hidden" name="analysis_<%= field.id %>" value=""><div class="tag-select" data-tag-select><div class="tag-selected" data-tag-selected><% if (selected.length === 0) { %><span class="tag-placeholder">Select…</span><% } %><% selected.forEach((tag) => { %><span class="tag-chip"><%- formatInline(tag) %></span><% }); %></div><div class="tag-panel" data-tag-panel><input class="tag-filter" data-tag-filter type="text" placeholder="Filter…"><div class="tag-options"><% field.allowedValues.forEach((tag) => { %><label class="tag-option" data-tag-option data-tag-label="<%= tag %>"><input type="checkbox" name="analysis_<%= field.id %>" value="<%= tag %>" <%= selected.includes(tag) ? 'checked' : '' %>><span class="tag-chip"><%- formatInline(tag) %></span></label><% }); %></div></div></div><% } else if (field.field_type === 'text') { %><input type="text" name="analysis_<%= field.id %>" value="<%= valueRow?.value_text ?? '' %>"><% } else if (field.field_type === 'boolean') { %><label class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-heading"><input type="hidden" name="analysis_<%= field.id %>" value="0"><input type="checkbox" name="analysis_<%= field.id %>" value="1" <%= valueRow?.value_real ? 'checked' : '' %>> Yes</label><% } else { %><input type="number" step="any" name="analysis_<%= field.id %>" value="<%= valueRow?.value_real ?? '' %>"><% } %></div><% }); %></div></div><% }); %>
      </section>

      <section class="flex flex-wrap items-end justify-between gap-4 rounded-xl border border-default-medium bg-neutral-primary p-4 shadow-xs"><div class="flex flex-wrap items-end gap-4"><div><label for="runDueDate">Due date</label><input id="runDueDate" type="date" data-ui-datepicker datepicker-autohide datepicker-format="yyyy-mm-dd" name="due_at" value="<%= run.due_at || '' %>"></div><label class="inline-flex items-center gap-2 text-sm font-medium text-heading"><input type="checkbox" name="done" <%= run.done ? 'checked' : '' %>> Done</label><% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer')) { %><label class="inline-flex items-center gap-2 text-sm font-medium text-heading"><input type="checkbox" name="exclude" <%= run.exclude_from_analysis ? 'checked' : '' %>> Exclude from analysis</label><% } %></div><% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager' || currentUser.role === 'engineer' || currentUser.role === 'operator')) { %><button class="inline-flex items-center justify-center rounded-base bg-brand px-3 py-2.5 text-sm font-medium text-white shadow-xs hover:bg-brand-strong focus:outline-none focus:ring-4 focus:ring-brand" type="submit">Save run</button><% } %></section>
    </form>
  </div></main>
</div>
<%- include('partials/experiment_workspace_calendar', { workspace }) %>
<%- include('partials/foot', { uiKit: true }) %>
