<%- include('partials/head', { title: `Polymer Processing Planner | ${title}`, uiKit: true }) %>
<% const statusStyle = (status) => status === 'healthy' ? 'bg-emerald-100 text-emerald-800' : status === 'warning' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-700'; const statusLabel = (status) => status === 'healthy' ? 'Healthy' : status === 'warning' ? 'Needs attention' : 'Not checked'; const jobStyle = (status) => status === 'FAILED' ? 'bg-red-100 text-red-800' : status === 'RUNNING' ? 'bg-blue-100 text-blue-800' : status === 'QUEUED' ? 'bg-amber-100 text-amber-800' : status === 'SUCCEEDED' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700'; %>
<div class="min-h-screen w-full bg-gray-50 font-sans text-gray-900 antialiased"><div class="flex min-h-screen w-full flex-col bg-gray-50 lg:flex-row"><%- include('partials/admin_sidebar') %><main class="min-w-0 flex-1"><header class="border-b border-gray-200 bg-white"><div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"><div><p class="text-sm font-medium text-blue-700">Administration</p><h1 class="mt-0.5 text-2xl font-semibold tracking-tight text-gray-900">System Health</h1><p class="mt-1 text-sm text-gray-500">Safe diagnostics and the current DOE background-job queue.</p></div><button class="inline-flex items-center rounded-lg bg-blue-700 px-3.5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 disabled:cursor-not-allowed disabled:opacity-60" type="button" id="runHealthCheck"><span class="material-symbols-rounded me-2 text-[20px]" aria-hidden="true">troubleshoot</span>Run diagnostics</button></div></header><div class="space-y-6 px-4 py-6 sm:px-6 lg:px-8"><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-gray-500">SQLite database</p><p class="mt-2 text-lg font-semibold text-gray-900">Connected</p></div><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= statusStyle(health.database.status) %>"><%= statusLabel(health.database.status) %></span></div><p class="mt-4 text-sm text-gray-500">Read-only connection check.</p></section><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-gray-500">R analytics</p><p class="mt-2 text-lg font-semibold text-gray-900" data-analytics-title>Not checked</p></div><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= statusStyle(health.analytics.status) %>" data-analytics-status><%= statusLabel(health.analytics.status) %></span></div><p class="mt-4 text-sm text-gray-500">Mode: <span class="font-mono"><%= health.analytics.mode %></span>. Run diagnostics to contact the service.</p></section><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-gray-500">SMTP</p><p class="mt-2 text-lg font-semibold text-gray-900"><%= health.smtp.configured ? 'Configured' : 'Not configured' %></p></div><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= health.smtp.configured ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= health.smtp.configured ? 'Ready' : 'Optional' %></span></div><p class="mt-4 text-sm text-gray-500">No test email is sent from this page.</p></section><section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-gray-500">AI key encryption</p><p class="mt-2 text-lg font-semibold text-gray-900"><%= health.aiSettings.configured ? 'Configured' : 'Not configured' %></p></div><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= health.aiSettings.configured ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= health.aiSettings.configured ? 'Ready' : 'Optional' %></span></div><p class="mt-4 text-sm text-gray-500">Required only to store provider API keys.</p></section></div><section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm"><div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 px-5 py-5"><div><h2 class="text-lg font-semibold text-gray-900">DOE background jobs</h2><p class="mt-1 text-sm text-gray-500">Persisted calculations recover queued work after an application restart.</p></div><div class="flex flex-wrap gap-2 text-sm"><span class="rounded-full bg-amber-100 px-3 py-1 font-medium text-amber-800"><%= health.jobs.queued %> queued</span><span class="rounded-full bg-blue-100 px-3 py-1 font-medium text-blue-800"><%= health.jobs.running %> running</span><span class="rounded-full bg-red-100 px-3 py-1 font-medium text-red-800"><%= health.jobs.failed %> failed</span></div></div><div class="relative overflow-x-auto"><table class="w-full text-left text-sm text-gray-500"><thead class="bg-gray-50 text-xs uppercase text-gray-700"><tr><th class="px-5 py-3">Job</th><th class="px-5 py-3">Analysis</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Created</th><th class="px-5 py-3">Finished</th><th class="px-5 py-3">Error code</th></tr></thead><tbody class="divide-y divide-gray-200"><% if (!health.recentJobs.length) { %><tr><td class="px-5 py-10 text-center text-gray-500" colspan="6">No DOE calculation jobs yet.</td></tr><% } %><% health.recentJobs.forEach((job) => { %><tr class="bg-white hover:bg-gray-50"><td class="px-5 py-3 font-mono text-gray-900">#<%= job.id %></td><td class="px-5 py-3">DOE <%= job.doeId %> · analysis <%= job.analysisId %></td><td class="px-5 py-3"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= jobStyle(job.status) %>"><%= job.status %></span></td><td class="px-5 py-3 whitespace-nowrap"><%= job.createdAt %></td><td class="px-5 py-3 whitespace-nowrap"><%= job.finishedAt || '—' %></td><td class="px-5 py-3 font-mono text-xs"><%= job.errorCode || '—' %></td></tr><% }); %></tbody></table></div></section><p class="text-sm text-gray-500" id="healthCheckResult" role="status" aria-live="polite">Diagnostics do not send email, create calculations, or retry jobs.</p></div></main></div></div>
<%- include('partials/foot', { uiKit: true }) %>
<script nonce="<%= cspNonce %>">
  document.getElementById('runHealthCheck')?.addEventListener('click', async (event) => {
    const button = event.currentTarget;
    const result = document.getElementById('healthCheckResult');
    button.disabled = true;
    result.textContent = 'Running safe diagnostics…';
    try {
      const response = await fetch('/system-health/check', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } });
      const payload = await response.json();
      if (!response.ok || !payload.ok) throw new Error('Health check failed');
      const analytics = payload.checks.analytics;
      const title = document.querySelector('[data-analytics-title]');
      const badge = document.querySelector('[data-analytics-status]');
      const healthy = analytics.status === 'healthy';
      if (title) title.textContent = healthy ? (analytics.engine || 'Available') : 'Unavailable';
      if (badge) { badge.textContent = healthy ? 'Healthy' : 'Needs attention'; badge.className = `inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${healthy ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`; }
      result.textContent = analytics.message;
    } catch {
      result.textContent = 'Diagnostics could not be completed. Try again later.';
    } finally {
      button.disabled = false;
    }
  });
</script>
