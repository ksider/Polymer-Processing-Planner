# Production configuration. Never commit the real .env file.
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/im_doe.sqlite

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-48-byte-secret

# Used only when no user exists with this email. Rotate the actual account
# password separately after the first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_TEMP_PASSWORD=replace-with-a-random-temporary-password

# Set to the exact number of trusted reverse-proxy hops. Do not use "true".
TRUST_PROXY=1

# Optional comma-separated browser origins for API/CORS requests.
# Keep this limited to the actual Planner origin(s); do not use *.
ALLOWED_ORIGINS=https://planner.example.com

# DOE Analysis V2. The R service stays on the private Compose network.
# production: http; local development auto-selects rscript when available
DOE_ANALYTICS_MODE=http
DOE_ANALYTICS_URL=http://analytics-r:8000
DOE_ANALYTICS_TIMEOUT_MS=15000
# Current DOE workspace. Set false only for a deliberate rollback.
DOE_ANALYSIS_V2_ENABLED=true

# Required only when an administrator stores an API key for an LLM provider in
# Admin → AI providers. Generate with: openssl rand -base64 32
# Keep this value outside SQLite backups; changing it makes stored provider keys
# unreadable until they are re-entered. Keyless local Ollama profiles do not
# need it.
LLM_SETTINGS_ENCRYPTION_KEY=
# Keep false until an enabled default provider has been configured in
# Admin → AI providers. Set true to expose the sparkle action in Analysis V2.
DOE_ANALYSIS_LLM_ENABLED=false

# Optional: when set, setup links are emailed. Without SMTP, an admin copies a
# one-time link from the UI and transfers it through a secure channel.
# APP_ORIGIN must be the public HTTPS origin used in email links.
APP_ORIGIN=https://planner.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=IM Planner <no-reply@example.com>

# Optional, only if Google sign-in is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
